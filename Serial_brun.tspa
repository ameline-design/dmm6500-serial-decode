-- Returns the generator's name for a vector id, or nil. Never guesses: a fallback to the id itself is
-- exactly the silent failure this table exists to prevent.
function barb.of(vid)
  if vid == nil then return nil end
  return barb.name[vid]
end


-- ================= bench/sdg_net.tsp =================
bsdg = bsdg or {}

bsdg.ip      = bsdg.ip or '10.0.1.79'
bsdg.port    = bsdg.port or 5025
bsdg.id      = nil                 -- tspnet connection id, nil when closed
bsdg.why     = nil                 -- why the last call failed, for the status file
bsdg.nfail   = 0                   -- consecutive failures, so a caller can give up deliberately
bsdg.ncmd    = 0
bsdg.timeout = bsdg.timeout or 5   -- seconds; the tspnet default of 20 is far too long to spend on
bsdg.maxvpp = bsdg.maxvpp or 20.0
bsdg.minsrate = bsdg.minsrate or 1e-6
bsdg.maxsrate = bsdg.maxsrate or 40e6

bsdg.arwvtries = bsdg.arwvtries or 4
bsdg.arwvwait = bsdg.arwvwait or 0.4

bsdg.cur     = nil     -- waveform name last CONFIRMED by ARWV?; nil means unknown
bsdg.curamp  = nil     -- the BSWV/SRATE values last written and not since disturbed
bsdg.curofst = nil
bsdg.cursrate = nil
bsdg.nskip   = 0       -- consecutive selects that skipped the ARWV verify
bsdg.nsame   = 0       -- selects that skipped the conversation entirely, for the run's own accounting

bsdg.arwvevery = bsdg.arwvevery or 50

-- Connection
-- OPEN IS IDEMPOTENT and never raises: a soak that dies because the generator was slow to answer is
-- worse than one that records the miss and tries again at the next cell.
function bsdg.open()
  if bsdg.id ~= nil then return true end
  local ok, err = pcall(function()
    tspnet.timeout = bsdg.timeout
    bsdg.id = tspnet.connect(bsdg.ip, bsdg.port, '')
    tspnet.termination(bsdg.id, tspnet.TERM_CRLF)
  end)
  if not ok or bsdg.id == nil then
    bsdg.id = nil
    bsdg.why = 'connect failed: ' .. tostring(err)
    bsdg.nfail = bsdg.nfail + 1
    return false, bsdg.why
  end
  bsdg.why = nil
  return true
end

-- FORGET WHAT THE GENERATOR IS PLAYING. Called wherever the answer stops being knowable: a dropped
-- session, a reset, and every failure inside select(). Cheap, and the only safe default -- a cache that
-- survives a reconnect would let the next cell skip the one verify that could have caught a generator
-- that came back playing something else.
function bsdg.forget()
  bsdg.cur, bsdg.curamp, bsdg.curofst, bsdg.cursrate = nil, nil, nil, nil
  bsdg.nskip = 0
end

function bsdg.close()
  if bsdg.id == nil then return end
  pcall(function() tspnet.disconnect(bsdg.id) end)
  bsdg.id = nil
  bsdg.forget()
end

-- EVERY SESSION, not just ours. tspnet sessions survive a script ending, and a stale one holds the
-- generator's single client slot -- so the next run cannot connect and the failure looks like a dead
-- generator. Called at both ends of a run.
function bsdg.reset()
  bsdg.id = nil
  bsdg.forget()
  pcall(function() tspnet.reset() end)
end

-- Commands
-- The interlock described at the top of this file, applied to every write.
function bsdg.forbidden(s)
  if s == nil then return 'nil command' end
  local up = string.upper(s)
  if string.find(up, 'WVDT', 1, true) ~= nil then
    return 'WVDT is refused: a waveform upload can wedge this generator\'s LAN service, and '
           .. 'recovery is a power cycle by hand. Every waveform is already in internal flash -- '
           .. 'select it by name with ARWV. Uploading is tools/upload_vectors.py\'s job, not a run\'s.'
  end
  if string.find(up, '*RST', 1, true) ~= nil then
    return '*RST is refused: it would clear the loaded waveform and the output state mid-run.'
  end
  return nil
end

-- Write one command. Returns true, or false and a reason. Never raises.
function bsdg.cmd(s)
  local bad = bsdg.forbidden(s)
  if bad ~= nil then bsdg.why = bad; return false, bad end
  if not bsdg.open() then return false, bsdg.why end
  local ok, err = pcall(function() tspnet.write(bsdg.id, s .. '\n') end)
  if not ok then
    bsdg.close()
    bsdg.why = 'write failed: ' .. tostring(err)
    bsdg.nfail = bsdg.nfail + 1
    return false, bsdg.why
  end
  bsdg.ncmd = bsdg.ncmd + 1
  bsdg.nfail = 0
  return true
end

-- Write a query and return the reply, or nil and a reason.
--   [...]
-- the week. readavailable() lets this give up on its own terms and, more importantly, lets the caller
-- distinguish "no reply" from "wrong reply" -- which for TrueArb is the whole point: a timeout is not
-- a wrong answer and must be retried, while a reply that arrives and says DDS is a real fault.
function bsdg.ask(s)
  local bad = bsdg.forbidden(s)
  if bad ~= nil then bsdg.why = bad; return nil, bad end
  if not bsdg.cmd(s) then return nil, bsdg.why end
  local waited, step = 0, 0.05
  while waited < bsdg.timeout do
    local avail = 0
    local ok = pcall(function() avail = tspnet.readavailable(bsdg.id) or 0 end)
    if not ok then
      bsdg.close()
      bsdg.why = 'readavailable failed on ' .. s
      bsdg.nfail = bsdg.nfail + 1
      return nil, bsdg.why
    end
    if avail > 0 then
      local rep = nil
      local rok = pcall(function() rep = tspnet.read(bsdg.id) end)
      if not rok or rep == nil then
        bsdg.close()
        bsdg.why = 'read failed on ' .. s
        bsdg.nfail = bsdg.nfail + 1
        return nil, bsdg.why
      end
      bsdg.nfail = 0
      return rep
    end
    delay(step)
    waited = waited + step
  end
  bsdg.why = 'no reply to ' .. s .. ' within ' .. tostring(bsdg.timeout) .. ' s'
  bsdg.nfail = bsdg.nfail + 1
  return nil, bsdg.why
end

-- Does the generator answer at all? Everything else is meaningless if this fails, so a caller checks
--   [...]
-- back with `srate=0S` and the SRATE reply sitting in the `outp=` field, every value plausible and every
-- label wrong. The soak's own two queries survive this because they are substring tests on content that
-- arrives in the first chunk -- so ask() is deliberately left alone, and the draining is done here.
function bsdg.drain()
  if bsdg.id == nil then return 0 end
  local n, guard = 0, 0
  while guard < 40 do
    guard = guard + 1
    local avail = 0
    if not pcall(function() avail = tspnet.readavailable(bsdg.id) or 0 end) then return n end
    if avail <= 0 then return n end
    if not pcall(function() tspnet.read(bsdg.id) end) then return n end
    n = n + 1
  end
  return n
end

-- IT MUST NOT DISTURB bsdg.nfail, AND THAT IS NOT TIDINESS. nfail is the wedge detector:
--   [...]
-- instead of five -- turning a recoverable late ARWV switch into a hard failure and printing GENERATOR
-- SILENT within the first lap of the very run this diagnostic was added for. A read that mutates shared
-- failure state is not a read. Saved and restored around the whole snapshot.
function bsdg.snapshot()
  local out, k = {}, nil
  local keep, keepwhy = bsdg.nfail, bsdg.why
  if keep > 0 then return 'skipped: nfail=' .. tostring(keep) end
  local keept = bsdg.timeout
  bsdg.timeout = 1
  local q = {{'arwv', 'C1:ARWV?'}, {'bswv', 'C1:BSWV?'}, {'srate', 'C1:SRATE?'}, {'outp', 'C1:OUTP?'}}
  for k = 1, table.getn(q) do
    bsdg.drain()
    local r = bsdg.ask(q[k][2])
    if r == nil then
      out[k] = q[k][1] .. '=nil'
    else
      r = string.gsub(r, '[\r\n]', '')
      r = string.gsub(r, ',', ';')
      out[k] = q[k][1] .. '=' .. r
    end
  end
  bsdg.nfail, bsdg.why, bsdg.timeout = keep, keepwhy, keept
  return table.concat(out, ' ')
end

function bsdg.alive()
  local r = bsdg.ask('*IDN?')
  if r == nil then return false, bsdg.why end
  if string.find(string.upper(r), 'SDG', 1, true) == nil then
    return false, 'IDN does not look like an SDG: ' .. tostring(r)
  end
  return true, r
end

function bsdg.output(on)
  if on then return bsdg.cmd('C1:OUTP ON,LOAD,HZ') end
  return bsdg.cmd('C1:OUTP OFF,LOAD,HZ')
end

-- Selecting a vector
--   [...]
-- path-quoting and .bin-stripping below are DEFENSIVE AND UNEXERCISED on this bench; they exist only for
-- the "U-disk0/<file>.bin" form, which nothing here sends. ARWV NAME with an unknown name does nothing and
-- the previous waveform keeps playing, so the reply is compared rather than assumed.
function bsdg.select(name, amp, ofst, srate)
  if name == nil or name == '' then return false, 'no waveform name' end
  if amp == nil or amp <= 0 or amp > bsdg.maxvpp then
    return false, string.format('amplitude %s Vpp is outside 0..%.1f', tostring(amp), bsdg.maxvpp)
  end
  if srate == nil or srate < bsdg.minsrate or srate > bsdg.maxsrate then
    return false, string.format('sample rate %s is outside %g..%g', tostring(srate),
                                bsdg.minsrate, bsdg.maxsrate)
  end
  if name == bsdg.cur and amp == bsdg.curamp and (ofst or 0) == bsdg.curofst
      and srate == bsdg.cursrate and bsdg.id ~= nil and bsdg.nskip < bsdg.arwvevery then
    bsdg.nskip = bsdg.nskip + 1
    bsdg.nsame = bsdg.nsame + 1
    return true
  end

  if name == bsdg.cur and bsdg.id ~= nil and bsdg.nskip < bsdg.arwvevery then
    bsdg.nskip = bsdg.nskip + 1
  else
    bsdg.forget()
    local sel = name
    if string.find(name, '/', 1, true) ~= nil then sel = '"' .. name .. '"' end
    if not bsdg.cmd('C1:ARWV NAME,' .. sel) then return false, bsdg.why end
    local want = string.gsub(name, '^.*/', '')
    want = string.gsub(want, '%.bin$', '')
    local vok, r, tries = false, nil, nil
    for tries = 1, bsdg.arwvtries do
      if tries > 1 then delay(bsdg.arwvwait) end
      r = bsdg.ask('C1:ARWV?')
      if r ~= nil and string.find(string.upper(r), string.upper(want), 1, true) ~= nil then
        vok = true
        break
      end
    end
    if not vok then
      if r == nil then return false, bsdg.why end
      return false, string.format('ARWV? still names %s after %d tries selecting %s -- the switch did '
                                  .. 'not land, or the generator does not have it',
                                  tostring(r), bsdg.arwvtries, name)
    end
    bsdg.cur, bsdg.nskip = name, 0
  end
  if not bsdg.cmd(string.format('C1:BSWV AMP,%.4f,OFST,%.4f', amp, ofst or 0)) then
    bsdg.forget()
    return false, bsdg.why
  end
  if not bsdg.cmd('C1:SRATE MODE,TARB') then bsdg.forget(); return false, bsdg.why end
  if not bsdg.cmd(string.format('C1:SRATE VALUE,%.6f', srate)) then
    bsdg.forget()
    return false, bsdg.why
  end
  local ok, why = bsdg.truearb()
  if not ok then bsdg.forget(); return false, why end
  local ook, owhy = bsdg.output(true)
  if not ook then bsdg.forget(); return false, owhy end
  bsdg.curamp, bsdg.curofst, bsdg.cursrate = amp, ofst or 0, srate
  return true
end

-- THREE TRIES, HALF A SECOND APART. After a large upload this generator stops answering for a moment,
-- and reading that timeout as "not in TrueArb" fails a channel that is configured correctly. A reply
-- that ARRIVES and says the wrong thing fails at once: that is the real fault being guarded against.
function bsdg.truearb()
  local i, r
  for i = 1, 3 do
    r = bsdg.ask('C1:SRATE?')
    if r ~= nil then
      if string.find(string.upper(r), 'TARB', 1, true) ~= nil then return true end
      return false, 'C1 is not in TrueArb: ' .. tostring(r) .. ' -- DDS would resample the points '
                    .. 'and corrupt edge timing silently'
    end
    delay(0.5)
  end
  return false, 'C1:SRATE? did not answer in 3 tries, so TrueArb is unconfirmed'
end


-- ================= bench/bench_rec.tsp =================
brec = brec or {}

brec.dir      = brec.dir or '/usb1/SERDEC'
brec.pfx      = brec.pfx or (brec.dir .. '/SOAK')   -- SOAK.CSV, 8.3 like everything else here
brec.ext      = brec.ext or '.csv'
brec.maxfile  = brec.maxfile or 268435456   -- 256 MB, far under the 2 GB per-file ceiling and still
brec.maxtotal = brec.maxtotal or 4294967296 -- 4 GB, inside the 6 GB budget with headroom
brec.syncrows = brec.syncrows or 50         -- rows between close/reopen

brec.fh       = nil     -- the one open file, or nil
brec.path     = nil
brec.nrow     = 0       -- rows in the current file
brec.ntotrow  = 0       -- rows this run
brec.nbyte    = 0       -- bytes in the current file
brec.ntotbyte = 0       -- bytes this run, across rolled files
brec.nfile    = 0
brec.sincesync = 0
brec.why      = nil     -- why recording stopped, if it did
brec.stopped  = false   -- true once the byte budget is spent; the run may continue, unrecorded,
brec.schema = brec.schema or 'serdec-soak-1'

-- One-line escape for a CSV field. Commas and quotes cannot reach a field here -- vector ids, formats
-- and hex are all plain -- but a note can carry anything, so it is escaped rather than trusted.
function brec.q(s)
  if s == nil then return '' end
  local t = tostring(s)
  t = string.gsub(t, '"', "''")
  t = string.gsub(t, '[\r\n,]', ' ')
  return t
end

-- ONE FIXED NAME, OPENED FOR APPEND, AND NOT A NUMBERED SLOT. ulog.next_free finds a free number by
--   [...]
-- RUNS ARE SEPARATED BY THEIR HEADER, not by their filename: every run writes a '# serdec-soak-1 tag=..'
-- line first and a reader splits the file on those. brec.roll numbers ROLLED files, which happens only
-- when one run passes brec.maxfile, and the roll opens for append too.
function brec.newfile(pfx)
  if ulog ~= nil and ulog.ensuredir ~= nil then
    pcall(function() ulog.ensuredir(brec.dir) end)
  end
  local path = pfx .. brec.ext
  if brec.nfile > 1 then path = pfx .. tostring(brec.nfile) .. brec.ext end
  local fh = nil
  pcall(function() fh = file.open(path, file.MODE_APPEND) end)
  if fh == nil then return nil, path, 'cannot open ' .. path end
  return fh, path, nil
end

function brec.rawwrite(fh, s)
  if fh == nil then return false end
  local ok = pcall(function() file.write(fh, s) end)
  if not ok then return false end
  pcall(function() file.flush(fh) end)
  return true
end

-- Start recording. `tag` names the run in the header so two runs on one key are never confused.
function brec.begin(tag, iterations, planid)
  brec.why, brec.stopped = nil, false
  brec.nrow, brec.ntotrow, brec.nbyte, brec.ntotbyte, brec.nfile, brec.sincesync = 0, 0, 0, 0, 0, 0
  local fh, path, why = brec.newfile(brec.pfx)
  if fh == nil then brec.why = why; brec.stopped = true; return false, why end
  brec.fh, brec.path, brec.nfile = fh, path, 1
  brec.header(tag, iterations, planid)
  return true
end

-- HEADER BYTES COUNT TOWARDS THE BUDGETS. A header is ~250 bytes and three paths write one; brec.reopen
-- writes another on every recovery, so a key that fails and recovers repeatedly would pass maxfile and
-- maxtotal while both counters said otherwise. -> the bytes written, so callers can add them.
function brec.hwrite(s)
  if not brec.rawwrite(brec.fh, s) then return 0 end
  brec.nbyte = brec.nbyte + string.len(s)
  brec.ntotbyte = brec.ntotbyte + string.len(s)
  return string.len(s)
end

function brec.header(tag, iterations, planid)
  local rsub = 'all'
  if brun ~= nil and brun.planrsub ~= nil then rsub = tostring(brun.planrsub) end
  local n = brec.hwrite(string.format('# %s tag=%s iterations=%s plan=%s randomperlap=%s file=%d\n',
                                     brec.schema, brec.q(tag), tostring(iterations or 'forever'),
                                     brec.q(planid), brec.q(rsub), brec.nfile))
  n = n + brec.hwrite(
    '# R,iter,cell,vid,baud,kind,amp_vpp,ofst_v,srate,wait_ms,fs,sa_bit,'
    .. 'ran,read_baud,fmt,nf,ngood,nbad,nflag,headsusp,snapped,snapfirm,why,hex\n')
  n = n + brec.hwrite('# S,stamp_s,iter,cell,ncell,nrow,nbad,nsdgfail,note\n')
  return n > 0
end

-- ROLL rather than grow past the per-file cap, and count the total so an indefinite run cannot fill
-- the key behind everyone's back.
function brec.roll()
  if brec.fh ~= nil then pcall(function() file.close(brec.fh) end) end
  brec.fh = nil
  if brec.ntotbyte >= brec.maxtotal then
    brec.stopped = true
    brec.why = string.format('byte budget spent: %d bytes over %d file(s)', brec.ntotbyte, brec.nfile)
    brec.note(-1, -1, 0, brec.why)
    return false
  end
  local fh, path, why = brec.newfile(brec.pfx)
  if fh == nil then
    brec.stopped = true
    brec.why = 'cannot roll to a new file: ' .. tostring(why)
    brec.note(-1, -1, 0, brec.why)
    return false
  end
  brec.fh, brec.path = fh, path
  brec.nfile = brec.nfile + 1
  brec.nrow, brec.nbyte, brec.sincesync = 0, 0, 0
  brec.header('roll', nil, nil)
  return true
end

-- Append one row. Returns false once recording has stopped, so a caller can report that its cells are
-- no longer being written down instead of carrying on as if they were.
function brec.row(s)
  if brec.stopped then return false end
  if brec.fh == nil then return false end
  local line = 'R,' .. s .. '\n'
  if not brec.rawwrite(brec.fh, line) then
    pcall(function() file.close(brec.fh) end)
    brec.fh = nil
    local fh = nil
    pcall(function() fh = file.open(brec.path, file.MODE_APPEND) end)
    if fh == nil then
      brec.stopped = true
      brec.why = 'write failed and ' .. tostring(brec.path) .. ' will not reopen -- key pulled?'
      return false
    end
    brec.fh = fh
    if not brec.rawwrite(brec.fh, line) then
      brec.stopped = true
      brec.why = 'write failed twice on ' .. tostring(brec.path)
      return false
    end
  end
  brec.nrow = brec.nrow + 1
  brec.ntotrow = brec.ntotrow + 1
  brec.nbyte = brec.nbyte + string.len(line)
  brec.ntotbyte = brec.ntotbyte + string.len(line)
  brec.sincesync = brec.sincesync + 1
  if brec.sincesync >= brec.syncrows then
    pcall(function() file.close(brec.fh) end)
    brec.fh = nil
    local fh = nil
    pcall(function() fh = file.open(brec.path, file.MODE_APPEND) end)
    if fh == nil then
      brec.stopped = true
      brec.why = 'reopen after sync failed on ' .. tostring(brec.path)
      return false
    end
    brec.fh = fh
    brec.sincesync = 0
  end
  if brec.nbyte >= brec.maxfile then return brec.roll() end
  return true
end

-- Try to record again after recording stopped. -> true if the record is live again.
--   [...]
-- spent budget is still spent in five minutes. brec.stopped stays true and the run says so.
-- A HEADER MARKS THE GAP, tagged `resumed`, which judge_bench's split_runs reads as a continuation --
-- otherwise the rows either side look like one unbroken run.
function brec.reopen()
  if brec.ntotbyte >= brec.maxtotal then return false end
  if brec.fh ~= nil and not brec.stopped then return true end
  if brec.fh ~= nil then pcall(function() file.close(brec.fh) end) end
  brec.fh = nil
  local fh, path = brec.newfile(brec.pfx)
  if fh == nil then return false end
  brec.fh, brec.path = fh, path
  brec.sincesync = 0
  if not brec.header('resumed', nil, nil) then
    pcall(function() file.close(brec.fh) end)
    brec.fh = nil
    return false
  end
  brec.stopped, brec.why = false, nil
  return true
end

-- One progress line. Cheap and frequent: this is what a reader looks at first, and what says how far
-- an interrupted run got.
function brec.note(iter, cell, ncell, note, nbad, nsdgfail)
  if brec.fh == nil then return end
  if brun ~= nil then
    if iter == nil or iter == -1 then iter = brun.iter end
    if cell == nil or cell == -1 then cell = brun.cell end
  end
  local t = 0
  pcall(function() t = os.time() end)
  brec.rawwrite(brec.fh, string.format('S,%d,%d,%d,%d,%d,%d,%d,%s\n',
                                       t, iter or -1, cell or -1, ncell or 0,
                                       brec.ntotrow, nbad or 0, nsdgfail or 0, brec.q(note)))
end

function brec.finish(note)
  brec.note(-1, -1, 0, note or 'finished')
  if brec.fh ~= nil then pcall(function() file.close(brec.fh) end) end
  brec.fh = nil
end


-- ================= bench/expect.tsp =================
bexp = bexp or {}

bexp.LOREM =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod ' ..
  'tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim ' ..
  'veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea ' ..
  'commodo consequat. Duis aute irure dolor in reprehenderit in voluptate ' ..
  'velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint ' ..
  'occaecat cupidatat non proident, sunt in culpa qui officia deserunt ' ..
  'mollit anim id est laborum. '

-- Exactly nwant bytes of wrapped prose. math.mod rather than math.fmod: this is Lua 5.0.2 and fmod does
-- not exist. Truncated hard at the end rather than rounded to a line, so the count here is the count on
-- the wire.
function bexp.lorem_text(nwant, cols)
  local out, no = {}, 0
  local col, i, total = 0, 0, 0
  local ln = string.len(bexp.LOREM)
  while total < nwant do
    i = i + 1
    local at = math.mod(i - 1, ln) + 1
    local ch = string.sub(bexp.LOREM, at, at)
    no = no + 1; out[no] = ch; total = total + 1
    col = col + 1
    if col >= cols and ch == ' ' and total + 2 <= nwant then
      no = no + 1; out[no] = '\013'
      no = no + 1; out[no] = '\010'
      total = total + 2
      col = 0
    end
  end
  return table.concat(out)
end

bexp.VEC = {
  v98a = {kind = 'lorem', n = 130, cols = 64},
  v98b = {kind = 'lorem', n = 130, cols = 64},
  v98c = {kind = 'lorem', n = 130, cols = 64},
  v99a = {kind = 'lorem', n = 80, cols = 64},
  v99b = {kind = 'lorem', n = 80, cols = 64},
  v99c = {kind = 'lorem', n = 80, cols = 64},
  v98d = {kind = 'lorem', n = 130, cols = 64},
  v99d = {kind = 'lorem', n = 80, cols = 64},
}

bexp.cache = bexp.cache or {}

-- The bytes a vector should have sent, or nil when this file does not know. nil is a real answer and the
-- caller must treat it as "no verdict" rather than as a mismatch.
function bexp.bytes(vid)
  if vid == nil then return nil end
  if bexp.cache[vid] ~= nil then return bexp.cache[vid] end
  local d = bexp.VEC[vid]
  if d == nil then return nil end
  local s = nil
  if d.kind == 'lorem' then s = bexp.lorem_text(d.n, d.cols) end
  bexp.cache[vid] = s
  return s
end

bexp.barr_cache = bexp.barr_cache or {}

function bexp.barr(vid)
  if vid == nil then return nil end
  if bexp.barr_cache[vid] ~= nil then return bexp.barr_cache[vid] end
  local s = bexp.bytes(vid)
  if s == nil then return nil end
  local a, i = {}, nil
  for i = 1, string.len(s) do a[i] = string.byte(s, i) end
  bexp.barr_cache[vid] = a
  return a
end

bexp.alignn = 12

bexp.mincmp = 12

bexp.cmpmax = 200000




-- Compare a decode against what the vector sends. -> nmatch, ncmp, shift; nil when there is no verdict.
--   [...]
-- separately; counting them here too would report one defect as two and make a framing problem look like
-- a payload problem. So ncmp is the number of confident bytes compared, which is exactly the population
-- the question "were the bytes right" is about.
function bexp.match(res, vid)
  local want = bexp.bytes(vid)
  if want == nil or res == nil or (res.nf or 0) < 1 then return nil end
  local wl = string.len(want)
  if wl < 1 then return nil end
  local arr = bexp.barr(vid)
  if arr == nil then return nil end

  local idx, val, nc, k = {}, {}, 0, nil
  for k = 1, res.nf do
    if res.errs[k] == nil then
      nc = nc + 1
      idx[nc] = k
      val[nc] = math.mod(res.vals[k] or 0, 256)
    end
  end
  if nc < bexp.mincmp then return nil end

  local function count(sh)
    local n, i = 0, nil
    for i = 1, nc do
      if val[i] == arr[math.mod(sh + idx[i] - 1, wl) + 1] then n = n + 1 end
    end
    return n
  end

  local run, at0, sh = 0, nil, nil
  for k = 1, res.nf do
    if res.errs[k] == nil then
      if run == 0 then at0 = k end
      run = run + 1
      if run >= bexp.alignn then break end
    else
      run = 0
    end
  end
  if at0 ~= nil and run >= bexp.alignn then
    local nd = ''
    for k = at0, at0 + bexp.alignn - 1 do
      nd = nd .. string.char(math.mod(res.vals[k] or 0, 256))
    end
    local found = string.find(want .. want, nd, 1, true)
    if found ~= nil then sh = math.mod(found - 1 - (at0 - 1) + wl * 2, wl) end
  end

  if sh == nil then
    if wl * nc > bexp.cmpmax then return nil end
    local best, bs, s = -1, nil, nil
    for s = 0, wl - 1 do
      local n = count(s)
      if n > best then best, bs = n, s end
      if best == nc then break end
    end
    return best, nc, bs
  end
  return count(sh), nc, sh
end


-- ================= bench/bench_run.tsp =================
brun = brun or {}

brun.dir      = brun.dir or '/usb1/SERDEC'
brun.planpath = brun.planpath or (brun.dir .. '/PLAN.CSV')
brun.stoppath = brun.stoppath or (brun.dir .. '/STOP.TXT')
brun.listenip   = brun.listenip or nil    -- optional host listener for live progress; nil = none
brun.listenport = brun.listenport or 5099

brun.pfh      = nil      -- plan handle while streaming
brun.nwrap    = 0        -- times the plan file has been re-read from the start
brun.ncell    = 0        -- cells attempted this run
brun.nbadsdg  = 0        -- consecutive generator failures
brun.stopwhy  = nil
brun.stopbad  = false   -- did it park because something is wrong, or finish what it was asked?
brun.tag      = brun.tag or 'soak'   -- what this run is: the panel title and the record header both say it

brun.maxsdgfail = brun.maxsdgfail or 20

brun.holdsecs = brun.holdsecs or 300      -- seconds between retries; 0 parks, and nothing asks for that
brun.holdslice = brun.holdslice or 10     -- how long a single delay() may be, so the panel stays alive
brun.holdmax = brun.holdmax or 0          -- give up after this many seconds of holding; 0 = never
brun.nhold = 0                            -- retries attempted this run
brun.heldsecs = 0                         -- seconds spent holding this run

brun.recretry = brun.recretry or 50      -- cells between attempts to record again
brun.nrecfail = 0                        -- consecutive cells measured but not recorded
brun.nreclost = 0                        -- cells this run that were never written down
brun.nrecback = 0                        -- times recording recovered
brun.nsdgalive = 0                       -- cells with no stimulus while the generator answered

brun.selretry = brun.selretry or 5
brun.selwait = brun.selwait or 0.5       -- seconds between attempts
brun.nselback = 0                        -- cells whose stimulus needed more than one attempt

brun.stopevery = brun.stopevery or 0     -- 0 = never look; see the note in the loop
brun.idlediag = brun.idlediag or false
brun.ratediag = brun.ratediag or false

brun.sdgverify = brun.sdgverify or false

brun.timing = brun.timing or false

brun.maxcell = brun.maxcell or 0

brun.nmeascol = 12

-- The rate a cell is captured at is the app's own choice, sdec.pick_fs(c.baud, 8), with nothing added to
--   [...]
-- loop and its test both need has to come from one place.
-- sdec.fs_sabit rather than a literal 8: the reference bench asks the instrument for fs_for_baud, which
-- is that same constant, so a copy here is a copy to forget when the app's oversampling target moves.
function brun.cell_fs(baud)
  return sdec.pick_fs(baud, sdec.fs_sabit)
end

brun.evbudget = brun.evbudget or 3      -- events per cell above which a cell counts as noisy

brun.paywrong_frac = brun.paywrong_frac or 0.5
brun.frameflag_frac = brun.frameflag_frac or 0.10
brun.framemin = brun.framemin or 50
brun.red_cells = brun.red_cells or 3
brun.red_bauds = brun.red_bauds or 2
brun.evstreak = brun.evstreak or 5      -- consecutive noisy cells before shedding a subsystem
brun.nevstreak = 0
brun.evshed = nil                       -- what was switched off, for the record
brun.nevtot = 0

-- The plan file
-- Split one CSV line on commas. No quoting is honoured, deliberately: soakplan.py emits plain numbers
-- and short ids, and a parser that pretends to handle quoting it never receives is a parser whose
-- failure mode nobody has seen.
function brun.split(s)
  local out, n, i0 = {}, 0, 1
  while true do
    local a = string.find(s, ',', i0, true)
    if a == nil then
      n = n + 1; out[n] = string.sub(s, i0)
      break
    end
    n = n + 1; out[n] = string.sub(s, i0, a - 1)
    i0 = a + 1
  end
  return out, n
end

brun.planrows = 0
brun.planread = 0
brun.iter = 0
brun.cell = 0
brun.planrsub = nil
brun.percell = 0          -- cells per lap, 0 until known
brun.nidle, brun.nlevels, brun.nswing, brun.nwhyother = 0, 0, 0, 0
brun.nspin = 0
brun.nspinlast = 0

brun.gcevery = brun.gcevery or 500
brun.memk = nil           -- heap KB after the last collection, shown on the note line
brun.cellmax = 0          -- highest cell number seen this lap
brun.lapcell = 0

function brun.planopen()
  brun.planclose()
  local fh = nil
  pcall(function() fh = file.open(brun.planpath, file.MODE_READ) end)
  if fh == nil then return false, 'cannot open ' .. brun.planpath end
  brun.pfh = fh
  brun.planread = 0
  return true
end

function brun.planclose()
  if brun.pfh == nil then return end
  pcall(function() file.close(brun.pfh) end)
  brun.pfh = nil
end

-- One cell, or nil at end of file. Header and blank lines are skipped here so callers never see them.
-- THE HANDLE IS CLOSED OUTSIDE THE pcall, matching usb_log.tsp's own note: a file.read that raises --
-- the key pulled mid-line -- must not leave the handle open, because the allocator then cannot reuse it.
function brun.nextrow()
  if brun.pfh == nil then return nil end
  if brun.planrows > 0 and brun.planread >= brun.planrows then return nil end
  local ln = nil
  local ok = pcall(function() ln = file.read(brun.pfh, file.READ_LINE) end)
  if not ok then brun.planclose(); return nil end
  if ln == nil or ln == '' then return nil end
  ln = string.gsub(ln, '[\r\n]', '')
  if ln == '' then return brun.nextrow() end
  if string.sub(ln, 1, 1) == '#' then
    local _, _, n = string.find(ln, 'rows=(%d+)')
    if n ~= nil then brun.planrows = tonumber(n) end
    local _, _, rs = string.find(ln, 'random%-per%-lap=(%a*%d*)')
    if rs ~= nil and rs ~= '' then brun.planrsub = rs end
    local _, _, cp = string.find(ln, 'cells%-per%-lap=(%d+)')
    if cp ~= nil then brun.percell = tonumber(cp) end
    return brun.nextrow()
  end
  local f, nf = brun.split(ln)
  if nf < 10 then return brun.nextrow() end
  if tonumber(f[1]) == nil or tonumber(f[5]) == nil then return brun.nextrow() end
  brun.planread = brun.planread + 1
  return {iter = tonumber(f[1]), cell = tonumber(f[2]), vid = f[3], arb = f[4],
          baud = tonumber(f[5]), kind = f[6], amp = tonumber(f[7]), ofst = tonumber(f[8]),
          srate = tonumber(f[9]), wait = tonumber(f[10])}
end

brun.filt_baudlo = brun.filt_baudlo          -- Bd, inclusive floor
brun.filt_baudhi = brun.filt_baudhi          -- Bd, inclusive ceiling
brun.filt_stdonly = brun.filt_stdonly        -- true: standard rates only
brun.filt_interstit = brun.filt_interstit    -- Bd: no non-standard rate below this
brun.filt_advonly = brun.filt_advonly        -- true: only vectors known to produce errors

-- Does this row survive the filters? -> true to run it.
function brun.wanted(c)
  if c == nil then return false end
  if brun.filt_baudlo ~= nil and (c.baud or 0) < brun.filt_baudlo then return false end
  if brun.filt_baudhi ~= nil and (c.baud or 0) > brun.filt_baudhi then return false end
  local std = (c.kind == 'std')
  if brun.filt_stdonly and not std then return false end
  if brun.filt_interstit ~= nil and not std and (c.baud or 0) < brun.filt_interstit then
    return false
  end
  if brun.filt_advonly then
    local adv = false
    if barb ~= nil and barb.loud ~= nil and barb.loud(c.vid) then adv = true end
    if not adv then return false end
  end
  return true
end

-- The next row the filters accept, or nil at end of plan.
--   [...]
-- calls, so the recursive form costs no stack either; a mutation that made this function recurse
-- passed the whole suite including a 4000-reject fixture. The loop is kept for being the plainer
-- statement of 'scan forward until one survives', which is the only claim it can support.
function brun.nextcell()
  while true do
    local c = brun.nextrow()
    if c == nil then return nil end
    if brun.wanted(c) then return c end
    brun.nfilt = (brun.nfilt or 0) + 1
  end
end

-- One measurement
-- MIRRORS bench_point() IN tools/bench_uart.py. Changing one without the other makes this soak
-- incomparable to every bench result on record; test_bench_engine.lua compares them.
function brun.point(fs, baud, lock, vid)
  local r = {ran = false, why = nil}
  pcall(function() eventlog.clear() end)
  sdec.force_baud, sdec.force_nbits = nil, nil
  sdec.force_par, sdec.force_nstop, sdec.force_invert = nil, nil, nil
  sdec.baud_raw, sdec.bittime, sdec.fitratio = nil, nil, nil
  sdec.fitq, sdec.snapped, sdec.snapfirm = nil, nil, nil
  brun.tacq, brun.tdec = nil, nil
  if lock then sdec.force_baud = baud end
  sdec.fs, sdec.fs_want = fs, fs
  local ok, why = false, nil
  local okc
  sdec.trigmode = 'free'
  local perr = nil
  okc, perr = pcall(function() ok, why = sdec.acquire() end)
  if not okc then r.raisewhy = tostring(perr) end
  r.remade = sdec.acq_remade
  if brun.timing then pcall(function() brun.tacq = timer.gettime() end) end
  brun.spin_tick()                      -- 3 of 6: the capture is in
  if not okc then
    r.why = 'acquire raised'
    if r.raisewhy ~= nil then r.why = r.why .. ': ' .. r.raisewhy end
    return r
  end
  if not ok then r.why = 'acq: ' .. tostring(why); return r end

  local okd, whyd = false, nil
  local okc2
  sdec.ck_stop, sdec.ck_cancel = false, nil
  okc2 = pcall(function() okd, whyd = sdec.decode() end)
  if brun.timing then pcall(function() brun.tdec = timer.gettime() end) end
  brun.spin_tick()                      -- 4 of 6: the decode is done
  if not okc2 then r.why = 'decode raised'; return r end
  if not okd then
    r.why = 'dec: ' .. tostring(whyd)
    r.probe = sdec.baud_probe
    r.fs = sdec.acq_fs
    r.nread = sdec.nread
    r.nev = brun.eventcount()
    return r
  end

  local res = sdec.res
  r.ran     = true
  r.overread = sdec.strm_overread
  r.fs      = sdec.acq_fs
  r.nread   = sdec.nread
  r.baud    = sdec.baud
  r.snapped = sdec.snapped
  r.snapfirm = sdec.snapfirm
  r.nf      = (res ~= nil and res.nf) or 0
  r.ngood   = (res ~= nil and res.ngood) or 0
  r.nbad    = (res ~= nil and res.nbad) or 0
  r.headsusp = (res ~= nil and res.headsusp) or 0
  r.fmt     = brun.fmtname(res)
  r.nev     = brun.eventcount()
  r.hex     = brun.hex(res)
  r.nflag   = brun.flagcount(res)
  if vid ~= nil and bexp ~= nil and res ~= nil then
    pcall(function()
      local m, c = bexp.match(res, vid)
      if m ~= nil and c ~= nil and c > 0 then r.paymatch, r.paycmp = m, c end
    end)
  end
  return r
end

-- EVENTS ARE A RESULT, not diagnostics. The app's hardest rule is that it must never put a message in
-- front of the operator, and a count of what it filed is the only way a soak can police that.
function brun.eventcount()
  local n = 0
  pcall(function() n = eventlog.getcount() or 0 end)
  return n
end

-- Kept in step with sdec.fmt_text(), which marks MSB and leaves LSB bare: this is the record's `fmt`
-- column and judge_bench parses it, so an 'M' here must mean what it means on the panel. No
-- historical value moves, because no capture before 2026-10-20 could be MSB.
function brun.fmtname(res)
  if res == nil or res.nbits == nil then return '' end
  local p = 'N'
  if res.par == sdec.PAR_EVEN then p = 'E' elseif res.par == sdec.PAR_ODD then p = 'O' end
  local s = string.format('%d%s%d', res.nbits, p, res.nstop or 1)
  if res.msb then s = s .. 'M' end
  return s
end

function brun.flagcount(res)
  if res == nil or res.errs == nil then return 0 end
  local n, k = 0, nil
  for k = 1, (res.nf or 0) do
    if res.errs[k] ~= nil then n = n + 1 end
  end
  return n
end

-- '??' FOR A FLAGGED FRAME, and this is not cosmetic. bench_uart.py emits the same: a frame with an error
-- still has a value, so printing that value lets a byte pass the host's substring check only because the
-- error was ignored. Plain hex here silently weakens the judge.
function brun.hex(res)
  if res == nil or (res.nf or 0) < 1 then return '' end
  local s, k, n = {}, nil, 0
  for k = 1, res.nf do
    n = n + 1
    if res.errs[k] == nil then
      s[n] = string.format('%02X', res.vals[k] or 0)
    else
      s[n] = '??'
    end
  end
  return table.concat(s, '')
end

brun.panellim1 = 20      -- TEXT1, characters. Firmware limit, not a style choice.
brun.panellim2 = 32      -- TEXT2
brun.panelw = 58

brun.backlight = brun.backlight or display.STATE_LCD_25
brun.nevpanel = 0

-- CLIPPED HERE RATHER THAN BY THE FIRMWARE, because the firmware charges an event for the service.
-- Every caller below is width-checked by a test, so reaching this is already a bug; it exists so that
-- the bug is a shortened line instead of a message on the screen.
function brun.fit(s, lim)
  local t = tostring(s or '')
  if string.len(t) <= lim then return t end
  return string.sub(t, 1, lim)
end

function brun.settext(l1, l2)
  local n0 = brun.eventcount()
  pcall(function()
    display.settext(display.TEXT1, brun.fit(l1, brun.panellim1))
    display.settext(display.TEXT2, brun.fit(l2, brun.panellim2))
  end)
  local d = brun.eventcount() - n0
  if d > 0 then
    brun.nevpanel = brun.nevpanel + d
    brun.nevtot = brun.nevtot + d
  end
end

-- THE FRAME FORMAT OF THE STIMULUS, read out of the generator's own name for the waveform -- which is
--   [...]
-- format, not what the decoder read: the panel says what is being played, and whether the app agreed is
-- a question for the record. Six vectors have no format token in their name -- the three LIN frames and
-- the three jitter waveforms -- and they get an empty string rather than a guess.
function brun.fmtof(arb)
  if arb == nil then return '' end
  local _, _, f = string.find(arb, '_(%d[NEO]%d)_')
  if f == nil then return '' end
  return f
end

-- THE WAVEFORM, MINUS THE BOILERPLATE EVERY NAME CARRIES. All 41 begin 'SER_' and end '_x10' or
-- '_x100', so those characters distinguish nothing on a 32-character line; the format token is dropped
-- too because it is printed as its own field beside it. 'SER_Hello_8N1_Drift10_x10' -> 'Hello_Drift10',
-- which is 13 characters instead of 25 and is what makes the whole line fit at 153600 baud.
function brun.wave(arb)
  if arb == nil or arb == '' then return '?' end
  local s = string.gsub(arb, '^SER_', '')
  s = string.gsub(s, '_x%d+$', '')
  local f = brun.fmtof(arb)
  if f ~= '' then
    s = string.gsub(s, '_' .. f .. '_', '_')
    s = string.gsub(s, '_' .. f .. '$', '')
  end
  return s
end

-- FAILED CELLS AS A PERCENTAGE OF CELLS RUN. One decimal below 10 % and none above, so the field is
--   [...]
-- which says "something is very wrong" more usefully than an exponent nobody reads at a glance.
-- nil UNTIL THE FIRST CELL COMPLETES. brun.ui_show computes the rate as el/ncell, so before any cell has
-- finished there is no rate to print and '0.00' would be a lie rather than a placeholder.
function brun.sig3(x)
  if x == nil then return '--' end
  local v = x + 0.0
  if v < 0 then return '--' end
  if v >= 999.5 then return '>999' end
  return string.format('%.3g', v)
end

function brun.pct(nbad, ncell)
  local n = ncell or 0
  if n < 1 then return '0%' end
  local p = 100.0 * (nbad or 0) / n
  if p >= 9.95 then return string.format('%.0f%%', p) end
  return string.format('%.1f%%', p)
end

-- WHAT COUNTS AS A FAILURE HERE: a cell that produced no decode -- no stimulus, a refused acquire, or
-- 'no frame fits'. It is deliberately NOT a byte-level verdict: whether the bytes were right is decided
-- by tools/judge_bench.py against the oracle, off the key, and 0.0 % on this screen does not mean every
-- byte was correct. It means every cell came back with something.
function brun.screen(c, arb)
  if brun.ui ~= nil then brun.ui_show(c, arb) end
  brun.settext(string.format('L%sC%s F%s %s',
                             brun.int(c.iter), brun.int(c.cell), brun.int(brun.nbad),
                             brun.pct(brun.nbad, brun.ncell)),
               brun.cellline(c, arb))
end

brun.c_lab  = (sdec ~= nil and sdec.ui_c_lab) or 0xA8A8A8       -- grey: labels
brun.c_val  = (sdec ~= nil and sdec.ui_c_data) or 0xFFFFFF      -- white: values
brun.c_ok   = (sdec ~= nil and sdec.ui_c_sb_on) or 0x00DCFF     -- the panel blue
brun.c_warn = (sdec ~= nil and sdec.ui_c_warn) or 0xFFC000      -- amber
brun.c_bad  = (sdec ~= nil and sdec.ui_c_err) or 0xFF6060       -- red
brun.c_good = (sdec ~= nil and sdec.ui_c_locked) or 0x40FF40    -- green
brun.ui = nil

brun.msgn = brun.msgn or 5
brun.msgs = nil          -- oldest first; the newest is at the bottom of the screen
brun.lastmsg = nil       -- so an unchanged state is not pushed again
brun.lastshape = nil     -- the same state with a different count in it, ditto
brun.lastn = 0

-- ONE CONDITION MUST NOT FILL THE RING. Dedup on exact text lets a counter push a new line every time it
--   [...]
-- SO THE DIGITS COME OUT and the message is compared by SHAPE. A repeat is pushed again only when its
-- number has DOUBLED, which gives 1, 2, 4, 8 ... about ten lines over a fortnight. Every occurrence is on
-- the key regardless.
function brun.shape(s)
  return string.gsub(tostring(s or ''), '%d', '')
end

function brun.firstn(s)
  local _, _, d = string.find(tostring(s or ''), '(%d+)')
  if d == nil then return 0 end
  return tonumber(d) or 0
end

-- -> true if this message says something the log is not already showing.
function brun.newsworthy(msg)
  if msg == brun.lastmsg then return false end
  local sh, n = brun.shape(msg), brun.firstn(msg)
  if sh ~= brun.lastshape then
    brun.lastshape, brun.lastn = sh, n
    return true
  end
  if n >= brun.lastn * 2 then
    brun.lastn = n
    return true
  end
  return false
end

-- WHEN, AS WALL CLOCK IF THE FIRMWARE HAS IT AND ELAPSED TIME IF IT DOES NOT. After six days away
-- '03:14' answers a question that '2:41 into the run' does not, so os.date is tried first -- guarded,
-- because bench_rec.tsp's note says os.time() is the only clock this instrument agrees with itself about
-- and does not claim os.date exists at all. A nil field raises, pcall catches it, and nothing is posted.
function brun.stamp()
  local t = nil
  pcall(function() t = os.date('%H:%M') end)
  if type(t) == 'string' and string.len(t) >= 4 then return t end
  local el = 0
  if brun.t0 ~= nil then pcall(function() el = os.time() - brun.t0 end) end
  return string.format('%d:%02d', math.floor(el / 3600), math.floor(math.mod(el, 3600) / 60))
end

-- NEWEST AT THE BOTTOM, so the log reads the way a log reads and the eye follows it downward. The array
-- is oldest-first and the head is dropped when it is full.
-- THE CELL NUMBER AS WELL AS THE TIME, because 'the generator missed a cell' matters much less than which
-- one, and this screen is the only place a reader sees it before the key is fetched.
function brun.msg(col, txt)
  if brun.msgs == nil then brun.msgs = {} end
  local n = table.getn(brun.msgs)
  if n >= brun.msgn then
    local k
    for k = 1, brun.msgn - 1 do brun.msgs[k] = brun.msgs[k + 1] end
    brun.msgs[brun.msgn] = nil
    n = brun.msgn - 1
  end
  brun.msgs[n + 1] = {txt = brun.stamp() .. ' L' .. brun.int(brun.iter) .. 'C' .. brun.int(brun.cell)
                            .. ' ' .. tostring(txt),
                      col = col or brun.c_lab}
  brun.ui_msgs()
end

function brun.ui_msgs()
  local u = brun.ui
  if u == nil or u.msg == nil then return end
  local k
  for k = 1, brun.msgn do
    local m = (brun.msgs ~= nil and brun.msgs[k]) or nil
    if m == nil then
      brun.ui_set(u.msg[k], '', brun.c_lab)
    else
      brun.ui_set(u.msg[k], brun.fit(m.txt, brun.panelw), m.col)
    end
  end
end

brun.warnrate = brun.warnrate or 20      -- % of cells refusing UNEXPECTEDLY: amber above this
brun.badrate  = brun.badrate  or 40      -- and red above this
brun.raten    = brun.raten    or 100     -- but neither before this many cells have run, and the
brun.badsdgwarn = brun.badsdgwarn or 3   -- consecutive generator failures that mean the stimulus is gone

function brun.ui_destroy()
  if brun.ui == nil then return end
  local u, k = brun.ui, nil
  for k = u.n, 1, -1 do
    if sdec ~= nil and sdec.del_obj ~= nil then
      pcall(function() sdec.del_obj(u.all[k]) end)
    else
      pcall(function() display.delete(u.all[k]) end)
    end
    u.all[k] = nil
  end
  brun.ui = nil
end

-- THE RUN'S OWN NAME, UPPER CASE. -> 'SOAK', 'SMOKE', 'RESUMED', or whatever brun.soak was passed
-- A SMOKE AND A SOAK DRAW THE SAME SCREEN, because both run through brun.soak, and the cell count
-- halfway down the panel is the only other thing separating them. That is too little for an operator
-- glancing at the glass: a smoke read as a stray soak is a TRIGGER press, and the key stops whichever run
-- is really there.
function brun.tagword()
  local t = brun.tag
  if t == nil or t == '' then t = 'soak' end
  return string.upper(t)
end

function brun.ui_build()
  brun.ui_destroy()
  if display == nil or display.create == nil then return false end
  local u = {all = {}, n = 0}
  local ok = pcall(function()
    local create, small, left = display.create, display.FONT_MEDIUM, display.JUST_LEFT
    local function add(h)
      if h == nil then error('display object pool exhausted', 0) end
      u.n = u.n + 1
      u.all[u.n] = h
      return h
    end
    u.scr  = add(create(display.ROOT, display.OBJ_SCREEN,
                        'SD ' .. brun.tagword() .. ' - TRIGGER TO STOP'))
    u.health = add(create(u.scr, display.OBJ_TEXT, 12, 20, brun.tagword() .. ' HEALTH --',
                          brun.c_ok, small, left))
    u.spin = add(create(u.scr, display.OBJ_TEXT, 788, 20, '|', brun.c_good, small, display.JUST_RIGHT))
    u.prog = add(create(u.scr, display.OBJ_TEXT, 12, 58, '--', brun.c_val, small, left))
    u.time = add(create(u.scr, display.OBJ_TEXT, 12, 92, '--', brun.c_lab, small, left))
    u.stim = add(create(u.scr, display.OBJ_TEXT, 12, 126, '--', brun.c_val, small, left))
    u.fail = add(create(u.scr, display.OBJ_TEXT, 12, 160, '--', brun.c_lab, small, left))
    u.vfail = add(create(u.scr, display.OBJ_TEXT, 12, 194, '--', brun.c_val, small, left))
    u.errs = add(create(u.scr, display.OBJ_TEXT, 12, 228 + brun.msgn * 34, 'Errors: 0',
                        brun.c_good, small, left))
    u.msg = {}
    local mk
    for mk = 1, brun.msgn do
      u.msg[mk] = add(create(u.scr, display.OBJ_TEXT, 12, 228 + (mk - 1) * 34, '',
                             brun.c_lab, small, left))
    end
  end)
  if not ok then
    brun.ui = u                    -- so ui_destroy frees whatever did get created
    brun.ui_destroy()
    return false
  end
  brun.ui = u
  pcall(function() display.changescreen(u.scr) end)
  return true
end

function brun.ui_set(h, txt, col)
  if h == nil then return end
  pcall(function() display.settext(h, txt) end)
  if col ~= nil then pcall(function() display.setcolor(h, col) end) end
end

-- HOURS, NOT SECONDS, and '--' where it cannot be known. An indefinite run has no end to count down to,
-- and a run that has finished no cells has no rate to extrapolate from -- printing 0.0 there would be a
-- number standing in for an unknown, which is the kind of screen that gets believed.
function brun.hours(sec)
  if sec == nil or sec < 0 then return '--' end
  return string.format('%.1f h', sec / 3600.0)
end

-- THE SAME FIGURE WITHOUT THE SPACE, for the two lines that carry four of them. At FONT_MEDIUM the
-- glass holds 58 characters and MEDIUM is the largest font this firmware has, so the four spaces this
-- saves are the difference between the layout fitting and the field at the end being clipped away.
function brun.hshort(sec)
  if sec == nil or sec < 0 then return '--' end
  return string.format('%.1fh', sec / 3600.0)
end

-- THE ONE INSTRUCTION THAT HAS TO INTERRUPT, as a suffix for the error count. -> string, '' for nothing
--   [...]
-- still nil, which is the state before brun.soak initialises them -- and a raise anywhere in the UI path
-- puts a modal box on the panel of an instrument nobody is standing at. A nag is decoration; it must
-- never be the thing that stops a soak.
function brun.stopnag()
  if brun.stopwhy ~= nil then return '' end
  if not brun.keyarmed then return ' - TRIGGER NOT ARMED: CUT POWER TO STOP' end
  if (brun.ncell or 0) > 0 then
    local red = false
    pcall(function() red = (brun.ui_status() == brun.c_bad) end)
    if red then return ' - ABORT NOW WITH TRIGGER BUTTON' end
  end
  return ''
end

-- THE TRAFFIC LIGHT. It answers one question -- is this worth walking over for -- so every red is
--   [...]
-- something put an event in the log (which on this instrument means a box on the panel), or the no-decode
-- rate has gone past brun.badrate over enough cells to mean it.
-- AMBER: a generator hiccup that recovered, a rate above brun.warnrate, the progress push switched off.
function brun.ui_status()
  if brun.stopwhy ~= nil then
    if brun.stopbad then
      return brun.c_bad, brun.fit('STOPPED: ' .. tostring(brun.stopwhy), brun.panelw)
    end
    return brun.c_ok, brun.fit('finished: ' .. tostring(brun.stopwhy), brun.panelw)
  end
  if brec ~= nil and brec.stopped then
    return brun.c_bad, brun.fit('NOT RECORDING: ' .. tostring(brec.why), brun.panelw)
  end
  if brun.nbadsdg >= brun.badsdgwarn then
    return brun.c_bad, string.format('GENERATOR SILENT %d cells -- power cycle the SDG',
                                     brun.nbadsdg)
  end
  if brun.nevtot > 0 then
    return brun.c_bad, string.format('%d EVENTS POSTED -- a message reached the panel',
                                     brun.nevtot)
  end
  local rate = 0
  if brun.ncell > 0 then rate = 100.0 * brun.nunexp / brun.ncell end
  if brun.ncell >= brun.raten and rate > brun.badrate then
    return brun.c_bad, string.format('%.0f %% refused unexpectedly -- check wiring, restart', rate)
  end
  if brun.ncell >= brun.raten and rate > brun.warnrate then
    return brun.c_warn, string.format('%.0f %% refused unexpectedly -- worth watching', rate)
  end
  if (brun.nreclost or 0) > 0 then
    return brun.c_warn, string.format('%d cell(s) were never recorded -- gap in the file',
                                      brun.nreclost)
  end
  if brun.nbadsdg > 0 then
    return brun.c_warn, string.format('no stimulus for %d cell(s) now -- retrying', brun.nbadsdg)
  end
  if brun.nsdgtot > 0 then
    return brun.c_warn, string.format('generator missed %d cell(s) and recovered', brun.nsdgtot)
  end
  if brun.evshed ~= nil then
    return brun.c_warn, brun.fit('the ' .. tostring(brun.evshed) .. ' was switched off',
                                 brun.panelw)
  end
  if brun.keyarmed then
    return brun.c_ok, 'Running -- press TRIGGER to stop and flush'
  end
  return brun.c_ok, 'running'
end

-- THE LAST THING THE SCREEN SAYS, and it has to keep saying it for days. The cell lines are left showing
-- whatever ran last; the two that change are the totals and the verdict, because after six days away the
-- questions are 'did it finish' and 'is anything wrong', in that order.
function brun.ui_end()
  if sdec ~= nil then sdec.tick = nil end
  local u = brun.ui
  if u == nil then return end
  local el = nil
  if brun.t0 ~= nil then el = os.time() - brun.t0 end
  local wend, wcol = brun.stateword()
  brun.ui_set(u.prog,
              string.format('%s  %s lap(s)  %s cell(s)  ran %s', wend,
                            brun.int(brun.iter), brun.int(brun.ncell), brun.hours(el)),
              wcol)
  brun.ui_set(u.time, 'ran ' .. brun.hours(el) .. '    ended    '
                      .. brun.int(brun.ncell) .. ' cell(s) done', brun.c_lab)
  brun.ui_set(u.fail, string.format('Refusals: Allowed %s Unexpected %s of %s cells',
                                    brun.int(brun.nexp), brun.int(brun.nunexp),
                                    brun.int(brun.ncell)), brun.c_lab)
  brun.ui_set(u.vfail, brun.fit(string.format('nostim %s idle %s lvl %s sw %s other %s',
                                     brun.int(brun.nsdgtot), brun.int(brun.nidle),
                                     brun.int(brun.nlevels), brun.int(brun.nswing),
                                     brun.int(brun.nwhyother)), brun.panelw), brun.c_val)
  local hl, hcol = brun.headline(true)
  brun.ui_set(u.health, hl, hcol)
  local el_, ecol_ = brun.errsline()
  brun.ui_set(u.errs, el_, ecol_)
  brun.ui_note()
end

-- ONE NUMBER FOR THE WHOLE RUN: the share of cells that behaved as they were supposed to. A cell counts
--   [...]
-- tools/judge_bench.py's job against the oracle, and doing it here would be a second judge, which is the
-- failure this project keeps writing comments about. 100 % health means every cell produced the KIND of
-- result it should have. Whether it produced the right one is decided off the key.
function brun.health()
  if brun.ncell == nil or brun.ncell < 1 then return 100.0 end
  return 100.0 * (brun.ncell - brun.nunexp) / brun.ncell
end

brun.healthwarn = brun.healthwarn or 99
brun.healthbad = brun.healthbad or 60

brun.heapwarnk = brun.heapwarnk or 3300
brun.heapbadk = brun.heapbadk or 3600

-- THE DIAGNOSTIC FLAGS IN FORCE, as a short suffix. A run configured wrongly is silently worthless and
-- nothing on the panel said which flags were on. bsdg.arwvevery is included for a specific reason: Lua
-- treats 0 as TRUE, so `bsdg.arwvevery = bsdg.arwvevery or 50` cannot undo a 0 and a run can inherit one
-- from the run before it -- an A/B whose second arm silently repeated the first is exactly the error this
-- makes visible. Only non-default values are named, so a plain soak's headline is unchanged.
function brun.diagflags()
  local f = ''
  if brun.ratediag then f = f .. ' rate' end
  if brun.idlediag then f = f .. ' idle' end
  if brun.sdgverify then f = f .. ' sdg' end
  if brun.timing then f = f .. ' timing' end
  if bsdg ~= nil and bsdg.arwvevery ~= nil and bsdg.arwvevery ~= 50 then
    f = f .. ' arwv' .. brun.int(bsdg.arwvevery)
  end
  if f == '' then return '' end
  f = f .. ' spin' .. brun.int(brun.nspinlast or 0)
  if brun.memk ~= nil then f = f .. ' mem' .. brun.int(brun.memk) .. 'k' end
  return '   diag:' .. f
end

brun.spinchars = {'|', '/', '-', '\\'}
brun.spini = 0

function brun.spin()
  brun.spini = math.mod(brun.spini + 1, 4)
  return brun.spinchars[brun.spini + 1]
end

brun.spinmin = brun.spinmin or 0.5        -- seconds between redraws: 2 fps ceiling. The FLOOR is
brun.spint = nil

brun.spinyield = brun.spinyield or 0

function brun.spin_tick()
  if brun.ui == nil or brun.ui.spin == nil then return end
  local t = nil
  pcall(function() t = timer.gettime() end)
  if t ~= nil then
    if brun.spint ~= nil and t >= brun.spint and t - brun.spint < brun.spinmin then return end
    brun.spint = t
  end
  brun.ui_set(brun.ui.spin, brun.spin(), brun.c_good)
  brun.nspin = (brun.nspin or 0) + 1
  if brun.spinyield ~= nil and brun.spinyield > 0 then
    pcall(function() delay(brun.spinyield) end)
  end
end

-- THE ERROR COUNT AND ITS COLOUR. -> text, colour
-- GREEN AT ZERO, AMBER AT 1-5, RED ABOVE 5. Deliberately NOT a rate: a proportion needs a denominator and
-- reads 0.0 % for the first several cells of a run, which is exactly when one error matters most. The raw
-- count is the number an operator acts on, and the three bands are what make it readable from across the
-- room without doing arithmetic.
function brun.errsline()
  local n = brun.nbad or 0
  local nx = brun.nexp or 0
  local nw, nfr = brun.nwrong or 0, brun.nframe or 0
  local act = nw + nfr
  local col = brun.c_good
  if n > nx then
    col = brun.c_bad
  elseif n > 0 then
    col = brun.c_warn
  end
  local nb = 0
  if brun.bad_bauds ~= nil then
    local k
    for k in pairs(brun.bad_bauds) do nb = nb + 1 end
  end
  if act >= brun.red_cells and nb >= brun.red_bauds then
    col = brun.c_bad
  elseif act > 0 and col == brun.c_good then
    col = brun.c_warn
  end
  local nag = brun.stopnag()
  if nag ~= '' then col = brun.c_bad end
  local head = 'Errors: ' .. brun.int(n + act)
  if (brun.ncmpb or 0) > 0 then
    head = head .. string.format('  Bad: %s/%s', brun.int(brun.nbadb or 0), brun.int(brun.ncmpb))
  end
  local ex = ''
  if (brun.nunexp or 0) > 0 then ex = ex .. '  nodec ' .. brun.int(brun.nunexp) end
  if nfr > 0 then ex = ex .. '  flag ' .. brun.int(nfr) end
  if nw > 0 or (brun.npayj or 0) > 0 then
    ex = ex .. string.format('  wrong %s/%s', brun.int(nw), brun.int(brun.npayj or 0))
  end
  if string.len(head .. ex .. nag) > brun.panelw then ex = '' end
  return head .. ex .. nag, col
end

function brun.stateword()
  if brun.stopwhy == nil then
    if (brun.ncell or 0) < 1 then return 'STARTING', brun.c_ok end
    return 'RUNNING', brun.c_good
  end
  if brun.stopbad then return 'ABORTED', brun.c_warn end
  if string.find(tostring(brun.stopwhy), 'TRIGGER', 1, true) ~= nil then
    return 'ABORTED', brun.c_warn
  end
  return 'FINISHED', brun.c_ok
end

-- THE SAME WORD AS A HEADLINE SUFFIX. Two lines carry the state -- the headline while the run lives, and
-- the progress line once it has ended -- and they must not be able to disagree: a screen reading
-- 'ABORTED' above 'FINISHED' makes a reader distrust both. One function, two callers.
function brun.statesuffix()
  local w, col = brun.stateword()
  return ' - ' .. w, col
end

function brun.healthline()
  local ncol = brun.ui_status()

  if brun.ncell == nil or brun.ncell < brun.raten then
    local col0 = brun.c_ok
    if ncol == brun.c_bad then col0 = brun.c_bad end
    return string.format('Health: %s of %s cells',
                         brun.int(brun.ncell), brun.int(brun.raten)), col0
  end

  local h = brun.health()
  local col = brun.c_good
  if h <= brun.healthwarn then col = brun.c_warn end
  if h < brun.healthbad then col = brun.c_bad end
  if ncol == brun.c_bad then col = brun.c_bad end
  return string.format('Health: %.2f%%', h), col
end

-- THERE IS NO SOUND GUESS AT THE LAP SIZE, so this no longer makes one. It returns 0 -- 'not known yet' --
--   [...]
-- common -- a plan that simply holds more laps than were requested. Nothing derivable from those two
-- numbers distinguishes them, so the honest answer is that the lap size is unknown. Generators declare
-- it instead: `# cells-per-lap=N`, read at brun.nextrow, which makes the total right from cell 1.
function brun.perlap_guess()
  return 0
end

function brun.ui_show(c, arb)
  local u = brun.ui
  if u == nil then return end
  brun.nspinlast = brun.nspin or 0
  brun.nspin = 0
  local vid = tostring(c.vid or '?')
  local nlap = brun.percell
  if nlap <= 0 then nlap = brun.perlap_guess() end
  local lap = 'Lap: ' .. brun.int(c.iter)
  if brun.iterwant ~= nil and brun.iterwant > 0 then
    lap = lap .. '/' .. brun.int(brun.iterwant)
  end
  local el, left, lapleft, lapel = nil, '--', '--', nil
  if brun.t0 ~= nil then el = os.time() - brun.t0 end
  if brun.tlap ~= nil then lapel = os.time() - brun.tlap end
  local ntot = 0
  if brun.iterwant ~= nil and brun.iterwant > 0 and nlap > 0 then ntot = brun.iterwant * nlap end
  local rate = nil                      -- seconds a cell, over THIS session only
  if el ~= nil and el > 0 and brun.ncell > 0 then rate = el / brun.ncell end
  local ndone = brun.ncell + (brun.nskipped or 0)
  if rate ~= nil and ntot > ndone then
    left = brun.hours(rate * (ntot - ndone))
  end
  local pos = c.pos or c.cell or 0
  if nlap > 0 and pos > nlap then
    local lbl = c.cell or 0
    if lbl >= 1 and lbl <= nlap then pos = lbl end
  end
  local cellsleft = nil
  if nlap > 0 and pos <= nlap then cellsleft = nlap - pos end
  if rate ~= nil and cellsleft ~= nil then lapleft = brun.hshort(rate * cellsleft) end

  local cell = 'Cell ' .. brun.int(pos)
  if nlap > 0 and pos <= nlap then
    cell = cell .. '/' .. brun.int(nlap)
                .. string.format(' (%.0f%%)', 100.0 * pos / nlap)
  end
  if (c.cell or 0) ~= pos then cell = cell .. ' r' .. brun.int(c.cell) end
  if nlap > 0 then
    cell = cell .. ' Ran: ' .. brun.hshort(lapel) .. ' Left: ' .. lapleft
  end
  brun.ui_set(u.prog, lap .. ' ' .. cell, brun.c_val)
  local tot = '--'
  if rate ~= nil and ntot > 0 then tot = brun.hshort(rate * ntot) end
  local done = brun.int(ndone)
  if ntot > 0 then
    done = done .. '/' .. brun.int(ntot) .. ' c'
                .. string.format(' (%.1f%%)', 100.0 * ndone / ntot)
  else
    done = done .. ' c done'
  end
  local percell = nil
  if rate ~= nil then percell = brun.sig3(rate) .. 's/c' end
  local elshown = el
  if rate ~= nil then elshown = rate * ndone end
  local ran = 'Total: ' .. brun.hshort(elshown)
  if tot ~= '--' then ran = ran .. ' of ' .. tot end
  if percell ~= nil then done = done .. ' ' .. percell end
  brun.ui_set(u.time, ran .. ' - ' .. done, brun.c_lab)

  brun.ui_set(u.stim, vid .. '  ' .. brun.int(c.baud) .. ' Bd  ' .. brun.fmtof(arb)
                      .. '  ' .. tostring(arb or '?'), brun.c_val)

  local vn, vb = brun.vcell[vid] or 0, brun.vbad[vid] or 0
  brun.ui_set(u.fail, string.format('Refusals: Allowed %s Unexpected %s of %s cells',
                                    brun.int(brun.nexp), brun.int(brun.nunexp),
                                    brun.int(brun.ncell)), brun.c_lab)
  brun.ui_set(u.vfail, string.format('Vec: %s  %d of %d bad   I%s L%s S%s',
                                     vid, vb, vn, brun.int(brun.nidle), brun.int(brun.nlevels),
                                     brun.int(brun.nswing)), brun.c_val)
  local hl, hcol = brun.headline(false)
  brun.ui_set(u.health, hl, hcol)
  local el_, ecol_ = brun.errsline()
  brun.ui_set(u.errs, el_, ecol_)
end

-- ANYTHING WORTH SAYING GOES TO THE LOG, ONCE. The prompt above keeps saying how to stop the run, which
--   [...]
-- without fetching the key, and a miss named one cell late lands on the SECOND cell of a vector's block,
-- which reads as a refutation of only-the-39-switches-can-fail. It is not enough for the key to be right.
-- OUTSIDE THE u == nil GUARD, so the ring is maintained whether or not the status objects exist.
function brun.ui_note()
  local col, msg = brun.ui_status()
  if col ~= brun.c_ok and brun.newsworthy(msg) then
    brun.lastmsg = msg
    brun.msg(col, msg)
  end
end

function brun.cellline(c, arb)
  local s = tostring(c.vid or '?') .. ' ' .. brun.int(c.baud)
  local f = brun.fmtof(arb)
  if f ~= '' then s = s .. ' ' .. f end
  return s .. ' ' .. brun.wave(arb)
end

-- %.0f for the same reason as brun.pct, and tostring() would print 9600 as '9600' but a rate that
-- arrived as a float as '9600.0000001'.
function brun.int(n)
  if n == nil then return '0' end
  return string.format('%.0f', n)
end

-- THE HEAP IN KB, ON BOTH LUAS. -> number or nil
--   [...]
-- pcall that keeps it safe also hides which: written as gcinfo() alone this field displayed on hardware and
-- was silently unreachable in every offline test, so nothing could check it. Probing both is what puts a
-- panel field under test, and an untested panel field is what put 'Errs' on a clipped line.
function brun.heapk()
  local k = nil
  pcall(function() k = gcinfo() end)
  if k == nil then pcall(function() k = collectgarbage('count') end) end
  return k
end

-- AND THE LIVE SET, WHICH IS THE FIGURE THAT MEANS SOMETHING. -> number or nil, in kB
--   [...]
-- from the same call that gives the count, with no second reading to disagree with the first.
-- nil OFFLINE, which is correct rather than unfortunate: 5.5 has no gcinfo(), collectgarbage('count')
-- has no threshold to report, and a made-up figure would colour the field by something imaginary.
function brun.heapsetk()
  local thr = nil
  pcall(function() local _; _, thr = gcinfo() end)
  if thr == nil or thr <= 0 then return nil end
  return thr / 2
end

-- THE SAME FIGURE AS THE HEADLINE'S LAST FIELD, or '' when there is nothing to put there. -> string
--   [...]
-- THE COLOUR COMES BACK WITH THE TEXT, from the SAME reading. Asking twice would put a number on the glass
-- and colour it by a different one -- and this figure moves with every allocation between the two calls.
-- nil means 'no opinion': the headline then keeps whatever the health figure and the run state gave it.
function brun.heapfield()
  if brun.diagflags() ~= '' then return '', nil end
  local k = brun.heapk()
  if k == nil then return '', nil end
  local col = nil
  local set = brun.heapsetk()
  if set ~= nil then
    if set > brun.heapbadk then
      col = brun.c_bad
    elseif set > brun.heapwarnk then
      col = brun.c_warn
    end
  end
  return string.format(' - Heap: %.1fK', k), col
end

-- THE WHOLE FIRST LINE, TEXT AND COLOUR, IN ONE PLACE. -> string, colour
--   [...]
-- atend: the state word's colour REPLACES the health figure's rather than yielding to it. After six days
-- away the first question is which of the two endings happened, and the health figure is still on the line
-- in full for anybody who wants it.
function brun.headline(atend)
  local hl, hcol = brun.healthline()
  local sfx, scol = brun.statesuffix()
  local hf, hfcol = brun.heapfield()
  hl = hl .. sfx .. hf .. brun.diagflags()
  if atend or hcol == brun.c_ok then hcol = scol end
  if hfcol == brun.c_bad then
    hcol = brun.c_bad
  elseif hfcol == brun.c_warn and hcol ~= brun.c_bad then
    hcol = brun.c_warn
  end
  return brun.fit(hl, brun.panelw), hcol
end

brun.nannfail = 0
brun.maxannfail = brun.maxannfail or 5

function brun.announce(s)
  if brun.listenip == nil then return end
  if brun.nannfail >= brun.maxannfail then return end
  local sent = false
  pcall(function()
    local id = tspnet.connect(brun.listenip, brun.listenport, '')
    if id ~= nil then
      tspnet.write(id, s .. '\n')
      tspnet.disconnect(id)
      sent = true
    end
  end)
  if sent then
    brun.nannfail = 0
  else
    brun.nannfail = brun.nannfail + 1
    if brun.nannfail == brun.maxannfail then
      brec.note(-1, -1, 0, 'progress pushes disabled after ' .. tostring(brun.maxannfail)
                           .. ' failures -- nothing is listening at ' .. tostring(brun.listenip))
    end
  end
end

-- Stopping on purpose
--   [...]
-- exist, and searching its listing costs no event at all. usb_log.tsp's ensuredir uses the same
-- technique and its comment is why the directory is called SERDEC: only an 8.3 name can be found by one
-- string.find in the FAT table.
function brun.stopped()
  local fh = nil
  pcall(function() fh = file.open(brun.dir, file.MODE_READ) end)
  if fh == nil then return false end
  local raw = nil
  pcall(function() raw = file.read(fh, file.READ_ALL) end)
  pcall(function() file.close(fh) end)
  if raw == nil then return false end
  return string.find(raw, 'STOP', 1, true) ~= nil
end

-- Resuming a run that stopped
--   [...]
-- as a box on the panel, and this runs at the start of a run that must not put one there. The 8.3 name in
-- the FAT table carries the file's length at offset 28, which is the same trick tools/run_bench.py's
-- fetch uses -- measured: SOAK    CSV at offset 7425 of a 16384-byte table, size 76514.
function brun.keysize(n83)
  local fh = nil
  pcall(function() fh = file.open(brun.dir, file.MODE_READ) end)
  if fh == nil then return nil end
  local raw = nil
  pcall(function() raw = file.read(fh, file.READ_ALL) end)
  pcall(function() file.close(fh) end)
  if raw == nil then return nil end
  local a = string.find(raw, n83, 1, true)
  if a == nil then return nil end
  local sz = nil
  pcall(function()
    sz = string.byte(raw, a + 28) + string.byte(raw, a + 29) * 256
         + string.byte(raw, a + 30) * 65536 + string.byte(raw, a + 31) * 16777216
  end)
  return sz
end

-- -> iter, cell of the last complete result row, or nil if there is not one.
function brun.resume_scan()
  local sz = brun.keysize('SOAK    CSV')
  if sz == nil or sz <= 0 then return nil end
  local fh = nil
  pcall(function() fh = file.open(brec.path, file.MODE_READ) end)
  if fh == nil then return nil end
  local nb, it, ce = 0, nil, nil
  while nb < sz do
    local l = nil
    local ok = pcall(function() l = file.read(fh, file.READ_LINE) end)
    if not ok or l == nil then break end
    nb = nb + string.len(l)
    if string.sub(l, 1, 2) == 'R,' then
      local f, nf = brun.split(l)
      if nf >= 3 and tonumber(f[2]) ~= nil and tonumber(f[3]) ~= nil then
        it, ce = tonumber(f[2]), tonumber(f[3])
      end
    end
  end
  pcall(function() file.close(fh) end)
  return it, ce
end

-- Discard plan rows up to and including (iter, cell). -> true when positioned, false if it is not there.
-- REFUSES RATHER THAN STARTING OVER. A resume point the plan does not contain means the plan on the key is
-- not the plan that produced the record -- a different --random-per-lap, a different skip, a regenerated
-- file -- and silently starting from row one would replay days of stimulus while reporting a resume.
function brun.resume_to(iter, cell)
  if iter == nil or cell == nil then return false end
  local n = 0
  while true do
    local c = brun.nextcell()
    if c == nil then return false end
    n = n + 1
    if c.iter == iter and c.cell == cell then
      brun.nskipped = n
      return true
    end
  end
end

brun.stopkey = brun.stopkey or true      -- assign false AFTER load to disable; a preset false is ignored

function brun.stopkey_setup()
  if not brun.stopkey then return false end
  if sdec == nil or sdec.cancel_setup == nil then return false end
  local ok = false
  pcall(function() ok = sdec.cancel_setup() end)
  if ok then pcall(function() sdec.cancel_clear() end) end
  return ok == true
end

function brun.stopkey_hit()
  if not brun.stopkey then return false end
  if sdec == nil or sdec.cancel_pressed == nil then return false end
  local hit = false
  pcall(function() hit = sdec.cancel_pressed() end)
  return hit == true
end

-- ONE HOLD, USED BY EVERY FAULT THAT WAITS. -> true to retry, false to stop -- and the only two things
--   [...]
-- Its own name so a test can watch the hold WAIT, rather than infer it from a counter incremented
-- beside the call. delay() is also the plan's per-cell wait, so spying on delay itself cannot separate
-- the two -- measured, 24 calls and 9.05 s where the hold accounted for 4.
function brun.holddelay(secs)
  pcall(function() delay(secs) end)
end

function brun.holdwait(what)
  local waited = 0
  while waited < brun.holdsecs do
    local slice = brun.holdslice
    if slice < 1 then slice = 1 end
    if slice > brun.holdsecs - waited then slice = brun.holdsecs - waited end
    brun.holddelay(slice)
    waited = waited + slice
    brun.heldsecs = brun.heldsecs + slice
    if brun.keyarmed and brun.stopkey_hit() then
      brun.stopwhy = 'TRIGGER Pressed'
      return false
    end
    if brun.holdmax > 0 and brun.heldsecs >= brun.holdmax then
      brun.stopwhy = string.format('L%dC%d: gave up after %d s holding for %s',
                                   brun.iter, brun.cell, brun.heldsecs, what)
      brun.stopbad = true
      return false
    end
    brun.ui_hold(what)
  end
  brun.nhold = brun.nhold + 1
  return true
end

-- Wait for the generator to come back. -> true if it answered, false to give up.
-- EVERY WAIT IS ACCOUNTED FOR ON THE KEY. A gap in a fortnight's record is only readable if the record
-- says it was a gap: without a note per retry, a reader sees cells stop and cells resume with nothing
-- between, which is indistinguishable from a run that was restarted by hand.
function brun.sdghold()
  if brun.holdsecs <= 0 then return false end
  local live0 = false
  pcall(function() live0 = bsdg.alive() end)
  if live0 then
    brun.nsdgalive = brun.nsdgalive + 1
    brec.note(brun.iter, brun.cell, brun.ncell,
              string.format('%d cell(s) in a row had no stimulus but the generator ANSWERS -- the fault '
                            .. 'is not the wire; carrying on', brun.nbadsdg),
              brun.nbad, brun.nbadsdg)
    if brun.nsdgalive == 1 then
      brun.msg(brun.c_bad, 'no stimulus but the generator answers -- check arb names')
    end
    brun.nbadsdg = 0
    return true
  end
  brun.msg(brun.c_bad, 'generator silent -- holding, will retry')
  while true do
    if not brun.holdwait('the generator') then return false end
    bsdg.reset()
    local live, idn = bsdg.alive()
    brec.note(brun.iter, brun.cell, brun.ncell,
              string.format('holding for the generator: retry %d after %d s -- %s',
                            brun.nhold, brun.heldsecs, live and 'BACK' or tostring(idn)),
              brun.nbad, brun.nbadsdg)
    if live then
      brun.msg(brun.c_warn, string.format('generator back after %d s and %d retry(s)',
                                          brun.heldsecs, brun.nhold))
      brun.nbadsdg = 0
      return true
    end
    brun.msg(brun.c_bad, string.format('generator still silent -- retry %d, %d s held',
                                       brun.nhold, brun.heldsecs))
  end
end

-- The screen during a hold: the counters do not change, so the one thing worth refreshing is that it is
-- still waiting rather than wedged -- and WHAT it is waiting for, because 'HOLDING' alone sends an
-- operator to power cycle the generator when the fault is a key that came loose.
function brun.ui_hold(what)
  if brun.ui == nil then return end
  brun.ui_set(brun.ui.time, brun.fit(string.format('HOLDING for %s -- %d s, %d retry(s)',
                                                   tostring(what or 'the generator'),
                                                   brun.heldsecs, brun.nhold), brun.panelw),
              brun.c_bad)
end

-- A record that stopped, and a plan that went away
--   [...]
-- NO HOLD HERE, deliberately: unlike a silent generator, an unwritable record still exercises the app --
-- only the transcript is missing -- so the cadence is kept and only the retry is paced. What is lost is
-- COUNTED, or the file would have a gap with nothing to say how wide.
function brun.rechold()
  local why = tostring(brec.why)
  brun.nrecfail = brun.nrecfail + 1
  brun.nreclost = brun.nreclost + 1
  if brun.nrecfail == 1 then
    brun.msg(brun.c_bad, brun.fit('NOT RECORDING: ' .. why, brun.panelw))
  end
  if math.mod(brun.nrecfail, brun.recretry) ~= 1 then return false end
  if not brec.reopen() then return false end
  brun.nrecback = brun.nrecback + 1
  brec.note(brun.iter, brun.cell, brun.ncell,
            string.format('recording resumed after %d unrecorded cell(s) (%d total): %s',
                          brun.nrecfail, brun.nreclost, why), brun.nbad, brun.nbadsdg)
  brun.msg(brun.c_warn, string.format('recording resumed -- %d cell(s) never written down',
                                      brun.nreclost))
  brun.nrecfail = 0
  return true
end

-- The next plan row, waiting for the plan file if it has to. -> a cell, or nil only when the run is to
--   [...]
-- than ends the run. An empty plan is the same fault arriving differently -- the open succeeded, the
-- first read gave nothing -- and is paced the same way, or it spins as fast as the interpreter can
-- reopen it.
function brun.planwait()
  local nfail = 0
  while true do
    if brun.planopen() then
      local c = brun.nextcell()
      if c ~= nil then
        if nfail > 0 then
          brec.note(brun.iter, brun.cell, brun.ncell,
                    string.format('plan file readable again after %d attempt(s)', nfail),
                    brun.nbad, brun.nbadsdg)
          brun.msg(brun.c_warn, string.format('plan file back after %d attempt(s)', nfail))
        end
        return c
      end
    end
    nfail = nfail + 1
    if nfail == 1 then brun.msg(brun.c_bad, 'PLAN FILE unreadable -- holding, will retry') end
    brec.note(brun.iter, brun.cell, brun.ncell,
              string.format('plan file %s is unreadable or empty -- attempt %d, holding',
                            tostring(brun.planpath), nfail), brun.nbad, brun.nbadsdg)
    if brun.holdsecs <= 0 then
      brun.stopwhy, brun.stopbad = 'plan file will not reopen', true
      return nil
    end
    if not brun.holdwait('the plan file') then return nil end
  end
end

-- The loop
function brun.soak(iterations, tag)
  if sdec == nil or sdec.acquire == nil then
    return false, 'the app is not loaded, so there is nothing to soak'
  end
  local forever = (iterations == nil or iterations == 0)
  brun.tag = tag or 'soak'
  brun.ncell, brun.nwrap, brun.nbadsdg, brun.stopwhy = 0, 0, 0, nil
  brun.stopbad = false
  brun.nevtot, brun.nevstreak, brun.nevpanel = 0, 0, 0
  brun.nbad, brun.nsdgtot = 0, 0
  brun.nhold, brun.heldsecs = 0, 0
  brun.nrecfail, brun.nreclost, brun.nrecback, brun.nsdgalive = 0, 0, 0, 0
  brun.nselback = 0
  brun.iter, brun.cell = 0, 0
  if sdec ~= nil then sdec.tick = brun.spin_tick end
  brun.nidle, brun.nlevels, brun.nswing, brun.nwhyother = 0, 0, 0, 0
  brun.nspin, brun.nspinlast = 0, 0
  brun.cellmax = 0
  brun.lapcell = 0
  brun.nexp, brun.nunexp = 0, 0
  brun.nwrong, brun.nframe, brun.npayj = 0, 0, 0
  brun.nbadb, brun.ncmpb = 0, 0
  brun.bad_bauds = {}
  brun.vcell, brun.vbad = {}, {}
  brun.iterwant = 0
  if not forever then brun.iterwant = iterations end
  brun.t0 = nil
  pcall(function() brun.t0 = os.time() end)
  brun.tlap = brun.t0

  brun.startfault = nil
  if not brec.begin(brun.tag, forever and 0 or iterations, brun.planpath) then
    brun.startfault = 'cannot record: ' .. tostring(brec.why)
  end
  if not brun.planopen() then
    brun.startfault = (brun.startfault and (brun.startfault .. '; ') or '')
                      .. 'no plan file at ' .. brun.planpath
  end
  brun.nskipped = 0
  if brun.resume then
    local rit, rce = brun.resume_scan()
    if rit == nil then
      brec.note(0, 0, 0, 'resume asked for but the record holds no completed cell -- starting at the top')
    else
      if not brun.resume_to(rit, rce) then
        brec.finish(string.format('REFUSED to resume: the plan does not contain L%dC%d, so it is not '
                                  .. 'the plan that produced this record', rit, rce))
        return false, string.format('the plan does not contain L%dC%d', rit, rce)
      end
      brun.iter, brun.cell = rit, rce
      brec.note(rit, rce, 0, string.format('resumed after L%dC%d, skipping %d plan row(s)',
                                           rit, rce, brun.nskipped))
    end
  end

  pcall(function() sdec.mute_events() end)
  if brun.backlight ~= nil then
    pcall(function() display.lightstate = brun.backlight end)
  end
  brun.keyarmed = brun.stopkey_setup()
  if not brun.ui_build() then
    pcall(function() display.changescreen(display.SCREEN_USER_SWIPE) end)
  end
  brun.settext('SOAK starting', 'reaching the generator')
  bsdg.reset()
  local live, idn = bsdg.alive()
  brun.settext('SOAK starting', live and tostring(idn) or 'SDG UNREACHABLE')
  if brun.ui ~= nil then
    if live then
      brun.msg(brun.c_ok, 'started -- ' .. brun.fit(tostring(idn), 34))
    else
      brun.msg(brun.c_bad, 'SDG UNREACHABLE at start')
    end
  end
  if brun.startfault ~= nil then
    brun.msg(brun.c_bad, brun.fit('AT START: ' .. brun.startfault, brun.panelw))
    brec.note(0, 0, 0, 'start fault, holding rather than refusing: ' .. brun.startfault)
  end
  brec.note(0, 0, 0, 'start: sdg ' .. (live and tostring(idn) or ('UNREACHABLE ' .. tostring(idn))))
  brun.announce(string.format('START iterations=%s sdg=%s', tostring(iterations or 'forever'),
                              tostring(live)))

  local lastiter = nil
  while true do
    local c = brun.nextcell()
    if c == nil then
      brun.nwrap = brun.nwrap + 1
      if not forever and lastiter ~= nil and lastiter >= iterations then
        brun.stopwhy = string.format('%d iteration(s) complete', iterations)
        break
      end
      if lastiter ~= nil then
        brec.note(lastiter, -1, 0, string.format('plan wrapped, pass %d', brun.nwrap + 1))
        brun.msg(brun.c_lab, string.format('plan wrapped -- pass %d, stimulus repeats', brun.nwrap + 1))
      else
        brun.nwrap = brun.nwrap - 1     -- nothing has been read, so nothing has wrapped
      end
      c = brun.planwait()
      if c == nil then break end
    end
    if not forever and c.iter > iterations then
      brun.stopwhy = string.format('%d iteration(s) complete', iterations)
      break
    end
    local previter = lastiter
    lastiter = c.iter

    if brun.stopevery > 0 and (brun.ncell == 0 or math.mod(brun.ncell, brun.stopevery) == 0) then
      if brun.stopped() then brun.stopwhy = 'STOP.TXT found'; break end
    end
    if brun.keyarmed and brun.stopkey_hit() then
      brun.stopwhy = 'TRIGGER Pressed'
      break
    end
    if brun.maxcell > 0 and brun.ncell >= brun.maxcell then
      brun.stopwhy = string.format('cell cap %d reached', brun.maxcell)
      break
    end
    if brec.stopped then
      brun.iter, brun.cell = c.iter or 0, c.cell or 0
      brun.rechold()
    end

    local arb = barb.of(c.vid)
    if arb == nil then
      arb = c.arb
    elseif c.arb ~= nil and c.arb ~= '' and c.arb ~= arb then
      arb = nil
    end
    if brun.gcevery > 0
       and (math.mod(brun.ncell, brun.gcevery) == 0 or (previter ~= nil and c.iter ~= previter)) then
      pcall(function() collectgarbage() end)
      brun.memk = brun.heapk()
    end
    if previter ~= nil and c.iter ~= previter and brun.lapcell > 0 then
      pcall(function()
        brec.note(previter, brun.cell or 0, brun.ncell or 0,
                  string.format('lap %s end: heap %s kB, %d cell(s) this lap, %d in the run',
                                tostring(previter), brun.int(brun.memk), brun.lapcell, brun.ncell or 0))
      end)
      brun.percell = brun.lapcell
      brun.lapcell = 0
      brun.cellmax = 0
      pcall(function() brun.tlap = os.time() end)
    end
    brun.lapcell = brun.lapcell + 1
    c.pos = brun.lapcell
    if (c.cell or 0) > brun.cellmax then brun.cellmax = c.cell end
    brun.iter, brun.cell = c.iter or 0, c.cell or 0
    local vk = tostring(c.vid or '?')
    brun.vcell[vk] = (brun.vcell[vk] or 0) + 1
    brun.screen(c, arb)
    brun.spin_tick()                    -- 1 of 6: the cell has started
    if brun.timing then
      sdec.strm_stopped_by_press = nil
      pcall(function() timer.cleartime() end)
    end
    local sok, swhy
    if arb == nil then
      sok, swhy = false, string.format('arb_names.tsp says %s for %s and the plan says %s -- '
                                       .. 'regenerate with tools/gen_arb_names.py',
                                       tostring(barb.of(c.vid)), tostring(c.vid), tostring(c.arb))
    else
      local why1 = nil
      local try
      for try = 1, brun.selretry do
        sok, swhy = bsdg.select(arb, c.amp, c.ofst, c.srate)
        if sok then
          if why1 ~= nil then
            brun.nselback = brun.nselback + 1
            brec.note(c.iter, c.cell, brun.ncell,
                      string.format('sdg select recovered on try %d: %s', try, tostring(why1)),
                      brun.nbad, brun.nbadsdg)
          end
          break
        end
        if why1 == nil then why1 = swhy end
        if bsdg.nfail > 0 then break end
        brun.holddelay(brun.selwait)
      end
    end
    if not sok then
      brun.nbadsdg = brun.nbadsdg + 1
      brun.nsdgtot = brun.nsdgtot + 1
      brun.nbad = brun.nbad + 1
      brun.vbad[vk] = (brun.vbad[vk] or 0) + 1
      brun.nunexp = brun.nunexp + 1
      if not brec.row(string.format('%d,%d,%s,%d,%s,%.4f,%.4f,%.6f,%.3f',
                             c.iter, c.cell, brec.q(c.vid), c.baud, brec.q(c.kind),
                             c.amp or 0, c.ofst or 0, c.srate or 0, c.wait or 0)
               .. string.rep(',', brun.nmeascol + 1) .. 'SDG:' .. brec.q(swhy) .. ',') then
        brun.rechold()
      end
      brec.note(c.iter, c.cell, brun.ncell, 'sdg failed: ' .. tostring(swhy), brun.nbad, brun.nbadsdg)
      if brun.nbadsdg >= brun.maxsdgfail then
        if not brun.sdghold() then
          if brun.stopwhy == nil then
            brun.stopwhy = string.format('L%dC%d: the generator failed %d cells in a row: %s',
                                         c.iter or 0, c.cell or 0, brun.nbadsdg, tostring(swhy))
            brun.stopbad = true
          end
          break
        end
      end
      brun.ncell = brun.ncell + 1
    else
      brun.nbadsdg = 0
      if c.wait ~= nil and c.wait > 0 then delay(c.wait / 1000) end

      if brun.timing then pcall(function() brun.tsel = timer.gettime() end) end
      brun.spin_tick()                  -- 2 of 6: stimulus selected and the plan wait is over
      local fs = brun.cell_fs(c.baud)
      local p = brun.point(fs, c.baud, false, c.vid)
      pcall(function() sdec.mute_events() end)
      if not p.ran then
        brun.nbad = brun.nbad + 1
        brun.vbad[vk] = (brun.vbad[vk] or 0) + 1
        if brun.sdgverify then
          local snap = nil
          pcall(function() snap = bsdg.snapshot() end)
          brec.note(c.iter, c.cell, brun.ncell,
                    string.format('nostim %s: %s', tostring(p.why), tostring(snap)),
                    brun.nbad, brun.nbadsdg)
        end
        local w = tostring(p.why or '')
        if string.find(w, 'line is idle', 1, true) ~= nil then
          brun.nidle = brun.nidle + 1
        elseif string.find(w, 'no clear logic levels', 1, true) ~= nil then
          brun.nlevels = brun.nlevels + 1
        elseif string.find(w, 'swing only', 1, true) ~= nil then
          brun.nswing = brun.nswing + 1
        else
          brun.nwhyother = brun.nwhyother + 1
        end
        if barb ~= nil and barb.loud ~= nil and barb.loud(vk) then
          brun.nexp = brun.nexp + 1
        else
          brun.nunexp = brun.nunexp + 1
        end
      else
        if p.paycmp ~= nil and p.paycmp > 0 then
          brun.npayj = brun.npayj + 1
          brun.ncmpb = (brun.ncmpb or 0) + p.paycmp
          brun.nbadb = (brun.nbadb or 0) + (p.paycmp - p.paymatch)
          if p.paymatch < p.paycmp * brun.paywrong_frac then
            brun.nwrong = brun.nwrong + 1
            brun.bad_bauds[c.baud] = true
          end
        end
        if (p.nf or 0) >= brun.framemin and
           not (barb ~= nil and barb.loud ~= nil and barb.loud(vk)) then
          if (p.nflag or 0) > (p.nf or 0) * brun.frameflag_frac then
            brun.nframe = brun.nframe + 1
            brun.bad_bauds[c.baud] = true
          end
        end
      end
      if not brec.row(string.format(
                             '%d,%d,%s,%d,%s,%.4f,%.4f,%.6f,%.3f,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s',
                             c.iter, c.cell, brec.q(c.vid), c.baud, brec.q(c.kind),
                             c.amp or 0, c.ofst or 0, c.srate or 0, c.wait or 0,
                             brun.fsnum(p.fs), brun.num(p.fs, c.baud),
                             p.ran and 'y' or 'n', tostring(p.baud or ''), brec.q(p.fmt),
                             tostring(p.nf or ''), tostring(p.ngood or ''), tostring(p.nbad or ''),
                             tostring(p.nflag or ''), tostring(p.headsusp or ''),
                             tostring(p.snapped), tostring(p.snapfirm),
                             brec.q(p.why)) .. ',' .. (p.hex or '')) then
        brun.rechold()
      end
      brun.spin_tick()                  -- 5 of 6: the row is on the key
      brun.ncell = brun.ncell + 1
      brun.announce(string.format('CELL %d/%d %s@%d %s nf=%s ev=%s', c.iter, c.cell,
                                  tostring(c.vid), c.baud, p.ran and 'ok' or 'FAIL',
                                  tostring(p.nf or 0), tostring(p.nev or 0)))
      local cellev = brun.eventcount()
      if (p.nev or 0) > cellev then cellev = p.nev end
      brun.nevtot = brun.nevtot + cellev
      local nt = p.ran and 'ok' or ('FAIL ' .. tostring(p.why))
      if cellev > 0 then nt = nt .. ' ev=' .. brun.int(cellev) end
      if p.overread ~= nil then nt = nt .. string.format(' over=%.2f', p.overread) end
      if p.paycmp ~= nil then
        nt = nt .. string.format(' pay=%s/%s', brun.int(p.paymatch or 0), brun.int(p.paycmp))
      end
      if (p.remade or 0) > 0 then nt = nt .. ' remade=' .. brun.int(p.remade) end
      if brun.idlediag then
        local lg = sdec.run1 or 0
        if (sdec.run0 or 0) > lg then lg = sdec.run0 end
        local ob = sdec.onebit
        nt = nt .. string.format(' idle=%s weak=%s run0=%.1f run1=%.1f onebit=%s ratio=%s lo=%s hi=%s',
                                 tostring(sdec.idle), sdec.idle_weak and 'y' or 'n',
                                 sdec.run0 or -1, sdec.run1 or -1,
                                 (ob ~= nil) and string.format('%.3f', ob) or 'nil',
                                 (ob ~= nil and ob > 0) and string.format('%.3f', lg / ob) or 'nil',
                                 (sdec.lo ~= nil) and string.format('%.3f', sdec.lo) or 'nil',
                                 (sdec.hi ~= nil) and string.format('%.3f', sdec.hi) or 'nil')
      end
      if brun.timing then
        local function ts(v) if v == nil then return 'nil' end return string.format('%.3f', v) end
        local trow = nil
        pcall(function() trow = timer.gettime() end)
        nt = nt .. string.format(' t=%s/%s/%s/%s', ts(brun.tsel), ts(brun.tacq), ts(brun.tdec), ts(trow))
      end
      if brun.ratediag then
        local br = sdec.baud_raw
        local q1 = nil
        if sdec.fitratio ~= nil and sdec.fitratio ~= 1 and sdec.fitratio ~= 0
            and sdec.bittime ~= nil and sdec.w ~= nil and (sdec.nw or 0) > 0 then
          pcall(function()
            local _, q = sdec.sig_fit(sdec.w, sdec.nw, sdec.bittime / sdec.fitratio)
            q1 = q
          end)
        end
        nt = nt .. string.format(' q1=%s',
                                 (q1 ~= nil) and string.format('%.4f', q1) or 'nil')
        nt = nt .. string.format(' rawbaud=%s fitratio=%s fitq=%s snap=%s/%s',
                                 (br ~= nil) and string.format('%.2f', br) or 'nil',
                                 (sdec.fitratio ~= nil) and string.format('%.4f', sdec.fitratio)
                                                        or 'nil',
                                 tostring(sdec.fitq),
                                 tostring(sdec.snapped), tostring(sdec.snapfirm))
      end
      brec.note(c.iter, c.cell, brun.ncell, nt, brun.nbad, 0)
      brun.spin_tick()                  -- 6 of 6: the status note is written
      if cellev > brun.evbudget then
        brun.nevstreak = brun.nevstreak + 1
        if brun.nevstreak >= brun.evstreak and brun.evshed == nil then
          brun.evshed = 'progress push'
          brun.listenip = nil
          brec.note(c.iter, c.cell, brun.ncell,
                    string.format('%d cells in a row posted more than %d event(s) -- progress push '
                                  .. 'switched off to stop them', brun.nevstreak, brun.evbudget))
        end
      else
        brun.nevstreak = 0
      end
    end
    brun.ui_note()
  end

  brun.planclose()
  bsdg.output(false)
  bsdg.reset()
  brun.settext(string.format('DONE F%s %s', brun.int(brun.nbad), brun.pct(brun.nbad, brun.ncell)),
               tostring(brun.stopwhy or 'ended'))
  brun.ui_end()
  if brun.gcevery > 0 then
    pcall(function() collectgarbage() end)
    brun.memk = brun.heapk()
  end
  brec.note(brun.iter, brun.cell, brun.ncell,
            string.format('run total: %d cell(s), %d failed, %d event(s) instigated (%d from the panel), '
                          .. 'held %d s over %d retry(s), %d cell(s) unrecorded in %d gap(s), '
                          .. '%d stimulus retry(s), heap %s kB',
                          brun.ncell, brun.nbad, brun.nevtot, brun.nevpanel,
                          brun.heldsecs, brun.nhold, brun.nreclost, brun.nrecback, brun.nselback,
                          brun.int(brun.memk)))
  local why = tostring(brun.stopwhy or 'ended')
  if string.find(why, '^L%d+C%d+:') == nil then
    why = string.format('L%dC%d: %s', brun.iter, brun.cell, why)
  end
  brec.finish(why)
  pcall(function() sdec.unmute_events() end)
  brun.announce('END ' .. tostring(brun.stopwhy))
  return true, brun.stopwhy
end

-- samples per bit, for the row. Written as a helper because a division by a plan field that arrived
-- as text would otherwise raise inside string.format and lose the whole cell.
function brun.num(fs, baud)
  if fs == nil or baud == nil or baud <= 0 then return '' end
  return string.format('%.3f', fs / baud)
end

-- THE CAPTURE RATE, ROUNDED. tostring() on a float here writes 1000000.0000000001 -- seventeen digits
-- of noise over the one fact that matters. Three of the app's ladder rates are genuinely fractional
-- (66e6/413 is 159806.295), so it is not truncated to an integer either.
function brun.fsnum(fs)
  if fs == nil then return '' end
  return string.format('%.4f', fs)
end


-- ================= bench/bench_panel.tsp =================
brun = brun or {}

brun.pn_laps_max = brun.pn_laps_max or 210

brun.pn_sdg = brun.pn_sdg or {'10.0.1.79', '10.0.1.78', '192.168.0.79'}

brun.pn_laptypes = brun.pn_laptypes or
  {{t = 'Full',         std = nil,  adv = nil},
   {t = 'Normal',       std = true, adv = nil},
   {t = 'Adversarial',  std = nil,  adv = true}}

brun.pn_baudlo = brun.pn_baudlo or 300
brun.pn_baudhi = brun.pn_baudhi or 250000

brun.pn_interstit = brun.pn_interstit or 2400

-- Geometry, taken from the app's own form rather than chosen again
-- The options form's numbers are already fitted to this screen, and a second set of constants here
-- would drift from them silently. Read through sdec so a changed form moves this one with it.
function brun.pn_geom()
  local g = {}
  g.x    = sdec.ui_opt_x or 22
  g.x2   = sdec.ui_opt_x_c2 or 420
  g.y0   = sdec.ui_opt_y0 or 60
  g.dy   = sdec.ui_opt_dy or 54
  g.btny = sdec.ui_opt_btn_y or 380
  return g
end

brun.pnscr = nil
brun.pn_obj = nil

-- Hand every object back, screen last. Switch away first, then delete: ui_destroy's rule, because a
-- delete against the screen in front leaves the panel drawing a dead object.
function brun.destroy_panel()
  if brun.pnscr == nil then return false end
  display.changescreen(display.SCREEN_HOME)
  local i
  if brun.pn_obj ~= nil then
    for i = 1, table.getn(brun.pn_obj) do sdec.del_obj(brun.pn_obj[i]) end
  end
  brun.pn_obj = nil
  sdec.del_obj(brun.pnscr)
  brun.pnscr = nil
  return true
end

-- The plan on the key, as a line the operator can read before committing to a run. Opened and closed
-- here rather than left open: brun.planopen is the run's own handle and a second reader would share
-- the position. -> rows, variant or nil.
function brun.pn_plan()
  local keep = brun.planrows
  brun.planrows = 0
  local ok = brun.planopen()
  if not ok then
    brun.planrows = keep
    return nil
  end
  brun.nextrow()
  local n, v = brun.planrows, brun.planrsub
  brun.planclose()
  brun.planrows = keep
  return n, v
end

-- Build the settings screen. Returns the screen handle, or raises with a reason the operator can act
-- on -- the same contract as sdec.build_options, and for the same reason: a Run screen that opens
-- nothing is worse than a refusal that says why.
function brun.build_panel()
  brun.destroy_panel()
  local create = display.create
  local g = brun.pn_geom()
  brun.pn_obj = {}
  local function keep(h)
    if h ~= nil then brun.pn_obj[table.getn(brun.pn_obj) + 1] = h end
    return h
  end

  brun.pnscr = create(display.ROOT, display.OBJ_SCREEN, 'BENCH SOAK')
  if brun.pnscr == nil then
    error('display object pool exhausted building the soak screen -- power cycle the instrument.', 0)
  end

  local nf = 8
  local nrows = math.ceil(nf / 2)
  local maxdy = math.floor((g.btny - 52 - g.y0) / nrows)
  if g.dy > maxdy then g.dy = maxdy end
  local n = 0
  local function nextpos()
    local col, rowy = g.x, g.y0 + n * g.dy
    if n >= nrows then col, rowy = g.x2, g.y0 + (n - nrows) * g.dy end
    n = n + 1
    return col, rowy
  end

  local fx, fy = nextpos()
  brun.pn_laps = keep(create(brun.pnscr, display.OBJ_EDIT_NUMBER, fx, fy,
                             'Laps', 'plan passes',
                             display.NFORMAT_INTEGER, 1, 1, brun.pn_laps_max, '', 4))
  fx, fy = nextpos()
  local i
  local st, sn = {}, 0
  if bsdg ~= nil and bsdg.ip ~= nil then sn, st[1] = 1, bsdg.ip end
  for i = 1, table.getn(brun.pn_sdg) do
    if brun.pn_sdg[i] ~= st[1] then sn = sn + 1; st[sn] = brun.pn_sdg[i] end
  end
  brun.pn_sdgf = keep(create(brun.pnscr, display.OBJ_EDIT_OPTION, fx, fy,
                             'SDG Address', 'generator', st[1], st[2], st[3]))
  fx, fy = nextpos()
  local lt = {}
  for i = 1, table.getn(brun.pn_laptypes) do lt[i] = brun.pn_laptypes[i].t end
  brun.pn_lapt = keep(create(brun.pnscr, display.OBJ_EDIT_OPTION, fx, fy,
                             'Lap Type', 'narrows the plan', lt[1], lt[2], lt[3], lt[4]))
  fx, fy = nextpos()
  brun.pn_lo = keep(create(brun.pnscr, display.OBJ_EDIT_NUMBER, fx, fy,
                           'Speed Low', 'slowest rate run',
                           display.NFORMAT_PREFIX, brun.pn_baudlo, 110, 250000, 'Bd', 6))
  fx, fy = nextpos()
  brun.pn_hi = keep(create(brun.pnscr, display.OBJ_EDIT_NUMBER, fx, fy,
                           'Speed High', 'fastest rate run',
                           display.NFORMAT_PREFIX, brun.pn_baudhi, 110, 250000, 'Bd', 6))
  fx, fy = nextpos()
  brun.pn_inter = keep(create(brun.pnscr, display.OBJ_EDIT_NUMBER, fx, fy,
                              'Interstitial', '0 any, else from',
                              display.NFORMAT_PREFIX, brun.pn_interstit, 0, 250000, 'Bd', 6))

  local rows, rsub = brun.pn_plan()
  local ptxt
  if rows == nil then
    ptxt = 'PLAN: none on the key -- push one with run_bench.py --push-plan'
  else
    ptxt = string.format('plan: %s row(s)%s', brun.int(rows),
                         (rsub ~= nil and rsub ~= '') and (', random-per-lap ' .. rsub) or '')
  end
  fx, fy = nextpos()
  brun.pn_ptxt = keep(create(brun.pnscr, display.OBJ_TEXT, g.x, g.btny - 44, ptxt))

  local bdef = {{x = 22,  w = 200, t = 'Run Soak', e = 'brun.panel_run'},
                {x = 234, w = 200, t = 'Cancel',   e = 'brun.panel_cancel'}}
  local nb = 0
  for i = 1, table.getn(bdef) do
    local b = create(brun.pnscr, display.OBJ_BUTTON, bdef[i].x, g.btny, bdef[i].t, bdef[i].w)
    if b ~= nil then
      display.setevent(b, display.EVENT_PRESS, 'sdec.guard(' .. bdef[i].e .. ')')
      keep(b)
      nb = nb + 1
    end
  end
  if nb < table.getn(bdef) then
    error(string.format('only %d of %d soak buttons could be created -- display object pool '
                        .. 'exhausted. Power cycle the instrument.', nb, table.getn(bdef)), 0)
  end

  display.setevent(brun.pnscr, display.EVENT_ENDAPP, 'sdec.guard(brun.panel_cancel)')
  return brun.pnscr
end

-- Run
--   [...]
-- idle -- and that guard is host-side, so a panel start would walk straight past it. SMOKED is the
-- global bench_smoke.py sets before its first stage; a power cycle clears it and nothing else sets
-- it. -> nil when it is safe to run, or the reason it is not.
function brun.pn_poisoned()
  if SMOKED == nil then return nil end
  return 'a smoke has run on this power cycle -- power cycle the DMM before a soak, or every cell '
         .. 'will read "line is idle"'
end

-- Read the form, apply it, and start. Nothing here is applied until every field has been read: a
-- raise half way would otherwise commit a partial configuration, which is options_apply's rule.
function brun.panel_run()
  local laps, ip, lt, lo, hi, inter
  local readok, readerr = pcall(function()
    laps = display.getvalue(brun.pn_laps)
    local si = display.getvalue(brun.pn_sdgf)
    if type(si) == 'number' then ip = brun.pn_sdgtxt(math.floor(si + 0.5)) end
    local li = display.getvalue(brun.pn_lapt)
    if type(li) == 'number' then lt = brun.pn_laptypes[math.floor(li + 0.5)] end
    lo = display.getvalue(brun.pn_lo)
    hi = display.getvalue(brun.pn_hi)
    inter = display.getvalue(brun.pn_inter)
  end)
  if not readok then
    brun.pn_say('could not read the form: ' .. tostring(readerr))
    return false
  end

  local why = brun.pn_poisoned()
  if why ~= nil then
    brun.pn_say('REFUSED: ' .. why)
    return false
  end
  local rows = brun.pn_plan()
  if rows == nil then
    brun.pn_say('REFUSED: no plan on the key -- run_bench.py --push-plan first')
    return false
  end

  if type(laps) ~= 'number' or laps < 1 then laps = 1 end
  laps = math.floor(laps + 0.5)

  if lt == nil then lt = brun.pn_laptypes[1] end
  brun.filt_stdonly, brun.filt_advonly = lt.std, lt.adv
  brun.nfilt = 0
  if type(lo) ~= 'number' then lo = nil end
  if type(hi) ~= 'number' then hi = nil end
  if lo ~= nil and hi ~= nil and lo > hi then lo, hi = hi, lo end
  brun.filt_baudlo, brun.filt_baudhi = lo, hi
  if type(inter) == 'number' and inter > 0 then brun.filt_interstit = inter
  else brun.filt_interstit = nil end
  if ip ~= nil and bsdg ~= nil then
    if bsdg.close ~= nil then pcall(bsdg.close) end
    bsdg.ip = ip
  end

  brun.destroy_panel()
  brun.soak(laps, 'soak')
  return true
end

-- The address text for an option index, which is the same list build_panel assembled -- rebuilt here
-- rather than stashed, so a field and its meaning cannot drift apart across a rebuild.
function brun.pn_sdgtxt(i)
  local st, sn = {}, 0
  if bsdg ~= nil and bsdg.ip ~= nil then sn, st[1] = 1, bsdg.ip end
  local k
  for k = 1, table.getn(brun.pn_sdg) do
    if brun.pn_sdg[k] ~= st[1] then sn = sn + 1; st[sn] = brun.pn_sdg[k] end
  end
  return st[i]
end

-- Say something on the form itself. The plan line is the one text object this screen has, so a
-- message that needs a second object can fail to appear for want of one. -> false only where the
-- object was never built: display.settext posts and returns, so there is no other failure to report.
function brun.pn_say(s)
  if brun.pn_ptxt == nil then return false end
  display.settext(brun.pn_ptxt, string.sub(tostring(s), 1, 58))
  return true
end

function brun.panel_cancel()
  brun.destroy_panel()
  return true
end

-- The entry point the bench package's App header calls. Builds the form and shows it; takes no
-- capture and starts nothing, so the instrument comes up waiting for a press.
function brun.panel()
  if sdec == nil or sdec.acquire == nil then
    return false, 'the app is not loaded, so there is nothing to soak'
  end
  local ok, err = pcall(brun.build_panel)
  if not ok then
    brun.destroy_panel()
    return false, tostring(err)
  end
  display.changescreen(brun.pnscr)
  return true
end


-- ==================== TTI App entry point ====================
-- The soak settings screen, and nothing else: no capture is taken and no lap is started until
-- Run Soak is pressed. sdec.start() is deliberately NOT called -- the bench builds its own status
-- screen, and the analyser's two would spend display objects the soak needs. docs/BRUN.md.
brun.panel()
endscript

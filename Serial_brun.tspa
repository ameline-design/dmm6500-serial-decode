-- ================= tsp/usb_log.tsp =================
ulog = ulog or {}

ulog.usbdir    = ulog.usbdir or '/usb1/SERDEC'
ulog.path      = ulog.path or (ulog.usbdir .. '/dmm6500_log.txt')
if ulog.path == '/usb1/dmm6500_log.txt' then ulog.path = ulog.usbdir .. '/dmm6500_log.txt' end
ulog.on        = ulog.on or false      -- true once a file is genuinely open
ulog.nlines    = ulog.nlines or 0
ulog.dropped   = ulog.dropped or 0     -- lines refused after the cap
ulog.maxlines  = ulog.maxlines or 20000  -- cap, so a runaway loop cannot fill the key
ulog.nwritten  = ulog.nwritten or 0
ulog.tag       = ulog.tag or '?'       -- short app name, prefixed to every line
if ulog.enabled == nil then ulog.enabled = true end
if ulog.autoflush == nil then ulog.autoflush = true end
if ulog.keybad == nil then ulog.keybad = false end
if ulog.keyout == nil then ulog.keyout = false end
ulog.keygen    = ulog.keygen or 0
ulog.keyopen   = ulog.keyopen or 0


-- Is a key in the slot? The only question answerable without naming a path.
function ulog.haskey()
  if file.usbdriveexists() == 0 then return false end
  return true
end

-- Stop touching the key until one is inserted. A latch rather than a reason per attempt, because
-- presence is the only file failure the app can observe -- docs/MEASUREMENTS.md, 'A key pulled from
-- under a running app'.
function ulog.keylost(why)
  ulog.keybad = true
  ulog.keywhy = tostring(why or 'the USB key stopped accepting writes')
  ulog.lasterr = ulog.keywhy
  ulog.dirok = nil
  ulog.keyout = false
  local h = ulog.fh
  ulog.fh, ulog.on = nil, false
  if h ~= nil then file.close(h) end
  return true
end

-- Is the key there and still accepting writes? One usbdriveexists, 237 us and silent, so it is
-- askable per line, per capture and per panel refresh. keylost() runs only from the no-key branch,
-- so keybad is set only with the slot empty; a refusing key is reported by its writer.
function ulog.keyok()
  if not ulog.haskey() then
    if not ulog.keybad and (ulog.on or ulog.dirok ~= nil) then
      ulog.keylost('no USB key -- removed while running')
    end
    ulog.keyout = true          -- after keylost, which clears it
    return false
  end
  if ulog.keyout then
    ulog.keybad, ulog.keywhy, ulog.keyout = false, nil, false
    ulog.dirok = nil
    ulog.keygen = (ulog.keygen or 0) + 1
  elseif ulog.keybad then
    return false
  end
  return true
end

-- Re-open the log on a key just inserted, which nothing else does: the debug log is held open
-- across captures where ensuredir and flog_alloc re-establish themselves at the next write. Keyed
-- on keygen, so one insertion causes one re-open however many callers ask, and that one attempt is
-- the whole allowance -- an open per line would post an event per line. An open that fails on a
-- present key waits for another, showing 'log: NOT LOGGING'.
function ulog.resume()
  if not ulog.enabled then return false end
  if not ulog.keyok() then return false end
  if ulog.keyopen == ulog.keygen then return ulog.on end
  ulog.keyopen = ulog.keygen
  return ulog.open(nil, false)
end

-- Is `name` listed in the USB root? true, false, or nil when the root could not be read; nil taken
-- as absence orders a mkdir on no evidence and posts 2208, so the two must not be merged. Only an
-- 8.3-clean name is contiguous in the FAT table, hence 'SERDEC' -- docs/MEASUREMENTS.md, 'Why the
-- directory is called SERDEC'. Not a FAT parser: a stale entry errs towards 'present'.
function ulog.rootlists(name)
  if name == nil or name == '' then return nil end
  local fh = file.open('/usb1', file.MODE_READ)
  if fh == nil then return nil end
  local raw = file.read(fh, file.READ_ALL)
  file.close(fh)
  if raw == nil then return nil end
  if string.find(raw, string.upper(name), 1, 1) ~= nil then return true end
  return false
end

-- Make sure ulog.usbdir exists. true, or false and why not. Silent in every ordinary case, and
-- mkdir is never speculative, because there is no free one.
function ulog.ensuredir(dir)
  if dir == nil then dir = ulog.usbdir end
  if dir == nil or dir == '' then return false, 'no directory configured' end
  if not ulog.keyok() then return false, tostring(ulog.keywhy or 'no USB key') end
  if ulog.dirok == dir then return true end
  if string.sub(dir, 1, 1) ~= '/' then return false, 'directory must be absolute: ' .. dir end
  local leafchk = string.gsub(dir, '^.*/', '')
  if string.len(leafchk) > 8 or leafchk ~= string.upper(leafchk) then
    return false, 'directory name must be 8 upper-case characters or fewer: ' .. leafchk
  end
  local leaf = string.gsub(dir, '^.*/', '')
  local listed = ulog.rootlists(leaf)
  if listed == true then ulog.dirok = dir; return true end
  if listed == nil then return false, 'cannot read the USB root' end
  file.mkdir(dir)
  if ulog.rootlists(leaf) == true then ulog.dirok = dir; return true end
  return false, 'cannot create ' .. dir
end

-- Forget that the directory was confirmed, for the harness and the no-key gate.
function ulog.dirlost()
  ulog.dirok = nil
end

-- Open a file for writing. Handle, or nil and why. sdec.start() calls ensuredir(), so the 64 kB
-- listing is paid once per launch and the call below is a cached no-op. A failed open is reported
-- and not retried, having already posted its event; an inserted key is recovered from by resume().
function ulog.open_write(path, mode)
  if path == nil then return nil, 'no filename available' end
  if mode == nil then mode = file.MODE_APPEND end
  if not ulog.keyok() then
    return nil, tostring(ulog.keywhy or 'no USB key') .. ' -- ' .. tostring(path)
  end
  local ready, rwhy = ulog.ensuredir()
  if not ready then return nil, tostring(rwhy) .. ' -- cannot open ' .. tostring(path) end
  local fh = file.open(path, mode)
  if fh ~= nil then return fh end
  return nil, 'cannot open ' .. tostring(path)
                .. ' -- key may be absent, full, write-protected, or refusing the directory'
end

-- Open the log. `truncate` starts a fresh file and the default appends, since comparing this run
-- against the last is usually the point. open_write owns the no-key gate and the reason.
function ulog.open(path, truncate)
  ulog.close()
  ulog.nlines, ulog.dropped, ulog.lasterr = 0, 0, nil
  if not ulog.enabled then return false end
  if path ~= nil then ulog.path = path end

  local mode = file.MODE_APPEND
  if truncate then mode = file.MODE_WRITE end
  local why = nil
  ulog.fh, why = ulog.open_write(ulog.path, mode)
  ulog.keyopen = ulog.keygen
  if ulog.fh == nil then
    ulog.on = false
    ulog.lasterr = tostring(why)
    return false
  end

  ulog.on = true
  local stamp = ''
  if os ~= nil then
    local tok, tv = pcall(os.time)
    if tok and tv ~= nil then stamp = ' t=' .. tostring(tv) end
  end
  ulog.line('==== session start ' .. tostring(ulog.tag) .. stamp .. ' ====')
  return true
end

-- Write one line. No key, a pulled key and a missing directory are all gates that return false.
function ulog.line(s)
  if not ulog.enabled then return false end
  if not ulog.on then
    if not ulog.resume() then return false end
  end
  if not ulog.keyok() then return false end
  if ulog.nlines >= ulog.maxlines or ulog.nwritten >= ulog.maxlines then
    ulog.dropped = ulog.dropped + 1
    return false
  end
  ulog.nlines = ulog.nlines + 1
  ulog.nwritten = (ulog.nwritten or 0) + 1
  local txt = string.format('%05d %s %s\r\n', ulog.nlines or 0, tostring(ulog.tag),
                            tostring(s))
  if ulog.fh == nil then
    ulog.on = false
    ulog.lasterr = 'the log handle went away'
    return false
  end
  file.write(ulog.fh, txt)
  if ulog.autoflush then file.flush(ulog.fh) end
  return true
end

-- string.format wrapper with explicit parameters: the 5.0.2 idiom string.format(f, unpack(arg))
-- relies on an implicit `arg` table host Lua removed. Five slots cover every call site.
function ulog.fmt(f, a, b, c, d, e)
  if not ulog.enabled then return false end
  local ok, s = pcall(string.format, f, a, b, c, d, e)
  if not ok then s = tostring(f) .. ' <ulog: bad format args>' end
  return ulog.line(s)
end

-- Flush buffered lines to the key without closing the file.
function ulog.flush()
  if not ulog.on or ulog.fh == nil then return false end
  file.flush(ulog.fh)
  return true
end

-- Flush and close the log, leaving no handle behind.
function ulog.close()
  if ulog.fh ~= nil then
    local h = ulog.fh
    ulog.fh = nil
    file.flush(h)
    file.close(h)
  end
  ulog.on = false
  return true
end

-- Does this file exist, without logging an error if it does not? true or false, never nil. The open
-- probe posts 2205, the one severity showevents still raises a box for -- docs/MEASUREMENTS.md,
-- 'fs.is_file against the open probe'.
function ulog.exists(path)
  if path == nil then return false end
  local got = fs.is_file(path)
  if got == nil then
    local fh = file.open(path, file.MODE_READ)
    local taken = fh ~= nil
    if fh ~= nil then file.close(fh) end
    return taken
  end
  return got == true
end

-- First unused '<prefix>NNN<ext>' on the key. A path, or nil if every NNN is taken; 1000 names.
function ulog.next_free(prefix, ext, limit)
  if limit == nil then limit = 1000 end
  local dok, dwhy = ulog.ensuredir()
  if not dok then
    ulog.idx_why = tostring(dwhy)
    return nil
  end
  local idxpath = prefix .. 'idx.txt'

  ulog.idx_ram = ulog.idx_ram or {}
  local start = ulog.idx_ram[prefix]
  if start ~= nil and (start < 0 or start >= limit) then start = nil end
  if start == nil and ulog.exists(idxpath) then
    local fh = file.open(idxpath, file.MODE_READ)
    if fh ~= nil then
      local ln = file.read(fh, file.READ_LINE)
      file.close(fh)
      local n = tonumber(ln)
      if n ~= nil and n >= 0 and n < limit then start = math.floor(n) end
    end
  end
  if start == nil then start = 0 end

  local i, k
  for k = 0, limit - 1 do
    i = start + k
    if i >= limit then i = i - limit end      -- both are < limit, so one subtraction wraps it
    local path = string.format('%s%03d%s', tostring(prefix), i or 0, tostring(ext))
    if not ulog.exists(path) then
      ulog.idx_ram[prefix] = i
      local wh = nil
      wh = ulog.open_write(idxpath, file.MODE_WRITE)
      local wrote = false
      if wh ~= nil then
        file.write(wh, tostring(i) .. '\n')
        file.flush(wh)
        file.close(wh)
        wrote = ulog.keyok()
      end
      if wrote then ulog.idx_why = nil
      else ulog.idx_why = 'log index not saved -- numbering restarts after a power cycle' end
      return path
    end
  end
  local leaf = string.gsub(tostring(prefix), '^.*/', '')
  ulog.idx_why = string.format('all %d %sNNN%s names are taken', limit or 0, tostring(leaf), tostring(ext))
  return nil
end


-- Write an array of lines to its own file and close it. ok, reason. The handle never outlives it.
function ulog.write_file(path, lines, n)
  if path == nil then return false, 'no filename available' end
  local fh, why = ulog.open_write(path, file.MODE_WRITE)
  if fh == nil then return false, tostring(why) end

  local gone = false
  local i
  for i = 1, n do
    if not ulog.keyok() then gone = true; break end
    file.write(fh, tostring(lines[i]) .. '\r\n')
  end
  file.flush(fh)
  file.close(fh)
  if gone or not ulog.keyok() then
    return false, 'the USB key went away -- the file is empty or truncated'
  end
  return true
end

-- One-line state summary for the panel. Name only: the status row shows ~45 proportional characters.
function ulog.status()
  if not ulog.enabled then return 'log off' end
  if not ulog.on then
    local why = ulog.lasterr
    if why == nil then why = 'not open' end
    return 'log: ' .. why
  end
  local extra = ''
  if ulog.dropped > 0 then extra = string.format(' (+%d dropped)', ulog.dropped or 0) end
  local base = string.gsub(tostring(ulog.path), '^.*/', '')
  return string.format('log: %d ln %s%s', ulog.nlines or 0, tostring(base), tostring(extra))
end


-- ================= tsp/serial_core.tsp =================
sdec = sdec or {}   -- the single global this app exposes
local ns, nskey = nil, nil
if     dmm ~= nil and dmm.digitize ~= nil then ns, nskey = dmm, 'dmm_'
elseif smu ~= nil and smu.digitize ~= nil then ns, nskey = smu, 'smu_' end

sdec.ns_key = nskey
sdec.dig    = nil       -- the digitize table itself
sdec.meas   = nil       -- the BASIC measure table, used only to save and restore the entry mode
sdec.atrig  = nil       -- .analogtrigger, or nil where the instrument has no comparator
sdec.atedge = nil       -- .analogtrigger.edge
sdec.k      = {}        -- the constants, copied by value

if ns ~= nil then
  sdec.dig = ns.digitize
  sdec.meas = ns.measure
  if ns.digitize.analogtrigger ~= nil then
    sdec.atrig = ns.digitize.analogtrigger
    if ns.digitize.analogtrigger.edge ~= nil then
      sdec.atedge = ns.digitize.analogtrigger.edge
    end
  end
  sdec.k.FUNC_VOLT     = ns.FUNC_DIGITIZE_VOLTAGE
  sdec.k.MODE_EDGE     = ns.MODE_EDGE
  sdec.k.MODE_OFF      = ns.MODE_OFF
  sdec.k.SLOPE_RISING  = ns.SLOPE_RISING
  sdec.k.SLOPE_FALLING = ns.SLOPE_FALLING
  sdec.k.FUNC_NONE     = ns.FUNC_NONE
end

local PREP = {
  dmm_ = function() end,
  smu_ = function()
    smu.source.output = smu.OFF
    if smu.source.output ~= smu.OFF then
      error('cannot confirm the SMU source output is off -- refusing to capture', 0)
    end
  end,
}
sdec.acq_prep = PREP[nskey] or function() end
sdec.rates      = {1000, 1250, 2500, 5000, 10000, 15000, 20000, 30000, 40000,
                   50000, 60000, 80000, 100000, 120000, 160000, 200000, 250000,
                   300000, 320000, 400000, 500000, 640000, 1000000}
sdec.fs         = 1000000   -- requested sample rate
sdec.n          = 20000     -- capture depth, samples (see sdec.acq_cap)
sdec.range      = 10
sdec.vover      = 1e6
sdec.nover      = 0
sdec.probe_n    = 2000      -- samples in the level-learning probe capture
sdec.probe_fs = sdec.probe_fs or {1000000, 100000, 10000}
sdec.pretrig    = 5         -- pre-trigger percentage for the analog-trigger path
sdec.trigmode   = sdec.trigmode or 'edge'
if sdec.trigext == nil then sdec.trigext = false end
if sdec.trigext_only == nil then sdec.trigext_only = false end
if sdec.fc_out == nil then sdec.fc_out = false end
sdec.fc_pulse = sdec.fc_pulse or 100e-6
sdec.trigwait     = sdec.trigwait or 3.0        -- seconds to wait for a start-bit edge
sdec.trigwait_ext = sdec.trigwait_ext or 30.0   -- see acq_triggered: a person or a DUT event
sdec.nread      = sdec.nread or 0

sdec.swing           = sdec.swing or 0     -- hi - lo
sdec.thr             = sdec.thr or 0       -- decision threshold, volts
sdec.hyst            = sdec.hyst or 0      -- hysteresis half-width, volts
sdec.hystfrac        = 0.15       -- hysteresis as a fraction of the swing
sdec.minswing        = 0.10       -- below this the line is treated as dead, volts
sdec.family          = '?'        -- inferred logic family, for the summary line

sdec.ne  = sdec.ne or 0
sdec.st0 = sdec.st0 or 1    -- physical level at the start of the capture
sdec.maxback = 64   -- how far to walk back from a hysteresis trip for the crossing

sdec.fitq     = sdec.fitq or 0    -- 0..1 quality of the least-squares fit
sdec.snapped  = sdec.snapped or false
sdec.snaptol  = 0.02  -- snap when within 2 % of a standard rate
sdec.maxmult  = 12    -- a gap longer than this many bit times is idle, not data

sdec.stdbaud = {110, 300, 600, 1200, 1800, 2400, 4800, 7200, 9600, 14400,
                19200, 28800, 31250, 38400, 57600, 76800, 115200, 128000,
                153600, 172800, 192000, 230400, 250000, 460800, 921600}

sdec.nbins     = 512
sdec.binocc    = 16    -- target samples per BIN
sdec.minhump   = 2
sdec.flatfloor = 1.0    -- below this an idle level counts as sitting at ground

sdec.armlevel     = sdec.armlevel or 1.0
sdec.armlevel_min = 0.33
sdec.armlevel_max = 6.0

sdec.armwait     = sdec.armwait or 10.0
sdec.armwait_min = 2.0
sdec.armwait_max = 120.0

if sdec.armkey == nil then sdec.armkey = true end





-- Both read through one function each, by the capture and by the form, so a typed value cannot mean one thing
-- to the field and another to the comparator. Clamped rather than refused.
function sdec.arm_level_v()
  local v = tonumber(sdec.armlevel)
  if v == nil or v < sdec.armlevel_min then return sdec.armlevel_min end
  if v > sdec.armlevel_max then return sdec.armlevel_max end
  return v
end

-- Clamped to the same [min, max] the field offers, so the form and the comparator cannot disagree.
function sdec.arm_wait_s()
  local w = tonumber(sdec.armwait)
  if w == nil or w < sdec.armwait_min then return sdec.armwait_min end
  if w > sdec.armwait_max then return sdec.armwait_max end
  return w
end

sdec.arm_baud  = 38400
sdec.arm_sabit = 5

-- One sample over sdec.minsabit, deliberately not the sdec.fs_sabit target of 8: this is the rate the window is
-- traded against. The suite asserts the relation, so raising minsabit cannot leave this below it.
function sdec.arm_fs()
  return sdec.pick_fs(sdec.arm_baud, sdec.arm_sabit)
end

sdec.arm_try = {9600, 19200, 28800, 31250, 38400}

-- Is this capture waiting for a device that has not started? sdec.probe_idle alone is not the condition, which is
-- why this is a function: it is equally true of every flow-controlled capture, where the probe runs nofc.
function sdec.arm_silent()
  if sdec.probe_idle == nil then return false end
  if sdec.fc_out then return false end
  return true
end
sdec.idlemult  = 10.5
sdec.minmodal  = 0.15
sdec.warnmodal = 0.50

sdec.humpfrac = 0.2

-- The two densest amplitudes within [v0, v1]. Returns lo, hi and the share of in-range samples belonging to
-- either hump, or nil when no pair is separable. Each level is the true mean of the samples in its hump.
function sdec.sig_pair(rd, n, v0, v1)
  local floor = math.floor
  local nb = floor(n / sdec.binocc)
  if nb > sdec.nbins then nb = sdec.nbins end
  if nb < 24 then nb = 24 end
  if v0 == nil or v1 == nil or v1 <= v0 then return nil end
  local scale = (nb - 1) / (v1 - v0)
  local hist = {}
  local bsum = {}
  local i
  for i = 1, nb do hist[i] = 0; bsum[i] = 0 end
  local cnt = 0
  for i = 1, n do
    local v = rd[i]
    if v ~= nil and v >= v0 and v <= v1 then
      local b = floor((v - v0) * scale) + 1
      hist[b] = hist[b] + 1
      bsum[b] = bsum[b] + v
      cnt = cnt + 1
    end
  end
  if cnt < 4 then return nil end

  local m1, c1 = 1, -1
  for i = 1, nb do
    if hist[i] > c1 then m1, c1 = i, hist[i] end
  end

  local edge = sdec.humpfrac * c1
  if edge < 1 then edge = 1 end
  local a1, b1 = m1, m1
  while a1 > 1 and hist[a1 - 1] >= edge do a1 = a1 - 1 end
  while b1 < nb and hist[b1 + 1] >= edge do b1 = b1 + 1 end

  local sep = floor(sdec.minswing * scale)
  if sep < 1 then sep = 1 end
  local m2, c2 = nil, -1
  for i = 1, nb do
    if i < a1 or i > b1 then
      local d = i - m1
      if d < 0 then d = -d end
      if d >= sep and hist[i] > c2 then m2, c2 = i, hist[i] end
    end
  end
  if m2 == nil or c2 < 1 then return nil end

  local edge2 = sdec.humpfrac * c2
  if edge2 < 1 then edge2 = 1 end
  local a2, b2 = m2, m2
  while a2 > 1 and hist[a2 - 1] >= edge2 and (a2 - 1 < a1 or a2 - 1 > b1) do
    a2 = a2 - 1
  end
  while b2 < nb and hist[b2 + 1] >= edge2 and (b2 + 1 < a1 or b2 + 1 > b1) do
    b2 = b2 + 1
  end

  local sa, na, sb, nbb = 0, 0, 0, 0
  for i = a1, b1 do
    sa = sa + bsum[i]
    na = na + hist[i]
  end
  for i = a2, b2 do
    sb = sb + bsum[i]
    nbb = nbb + hist[i]
  end
  if na < 1 or nbb < sdec.minhump then return nil end
  local v1m, v2m = sa / na, sb / nbb
  if v2m < v1m then v1m, v2m = v2m, v1m end
  return v1m, v2m, (na + nbb) / cnt
end

-- Every field the signal chain measures, back to its power-on value. Called from sdec.acquire() and
-- sdec.clear_result(). docs/MEASUREMENTS.md, 'A measurement must not cross a capture boundary'.
function sdec.clear_measured()
  sdec.acq_fs, sdec.acq_fs_est = nil, nil
  sdec.arm_thr, sdec.arm_idle = nil, nil
  sdec.w, sdec.nw, sdec.wmed, sdec.wshort = nil, 0, nil, nil
  sdec.snr_db, sdec.noise_v = nil, nil
  sdec.nover = 0
  sdec.idle, sdec.idle_weak = nil, nil
  sdec.acq_pretrig, sdec.leadrun, sdec.idlerec = nil, nil, nil
  sdec.modal, sdec.run0, sdec.run1 = nil, nil, nil
  sdec.st0 = 1
  return true
end

-- Returns ok, reason. Sets lo/hi/thr/hyst/swing/family, wlo/whi, modal, and the remembered
-- lvl_thr/lvl_hyst/lvl_swing that serial_app saves and restores.
function sdec.sig_levels(rd, n)
  sdec.snr_db, sdec.noise_v = nil, nil
  local vmin, vmax, nv, nov = nil, nil, 0, 0
  local i

  for i = 1, n do
    local v = rd[i]
    if v ~= nil then
      if v > -sdec.vover and v < sdec.vover then
        nv = nv + 1
        if vmin == nil then
          vmin, vmax = v, v
        else
          if v < vmin then vmin = v end
          if v > vmax then vmax = v end
        end
      else
        nov = nov + 1
      end
    end
  end
  sdec.nover = nov
  if vmin == nil then
    sdec.vmin, sdec.vmax, sdec.swing = nil, nil, 0
    sdec.lo, sdec.hi, sdec.thr, sdec.hyst = nil, nil, 0, 0
    sdec.wlo, sdec.whi = nil, nil
    sdec.family = '?'
    if nov > 0 then
      return false, string.format('all %d reading(s) are over range', nov)
    end
    return false, 'capture is empty'
  end
  sdec.vmin, sdec.vmax = vmin, vmax
  sdec.modal = nil

  local lo, hi, modal = sdec.sig_pair(rd, n, vmin, vmax)
  if lo ~= nil and (vmax - vmin) > 3 * (hi - lo) then
    local pad = 0.5 * (hi - lo)
    if pad < sdec.minswing then pad = sdec.minswing end
    local lo2, hi2, modal2 = sdec.sig_pair(rd, n, lo - pad, hi + pad)
    if lo2 ~= nil and modal2 >= modal then lo, hi, modal = lo2, hi2, modal2 end
  end

  if lo == nil or hi - lo < sdec.minswing then
    sdec.wlo, sdec.whi = vmin, vmax
    sdec.lo, sdec.hi = vmin, vmax
    sdec.thr, sdec.hyst = 0.5 * (vmin + vmax), 0
    sdec.swing = vmax - vmin
    sdec.family = sdec.sig_family(vmin, vmax)
    if lo ~= nil then
      sdec.lo, sdec.hi, sdec.swing = lo, hi, hi - lo
      sdec.thr = 0.5 * (lo + hi)
      sdec.family = sdec.sig_family(lo, hi)
      return false, string.format('swing only %.3f V', hi - lo)
    end
    return false, 'line is idle (no transitions)'
  end

  sdec.wlo, sdec.whi = lo, hi        -- the working range, for diagnostics
  sdec.lo, sdec.hi = lo, hi
  sdec.modal = modal
  sdec.swing = hi - lo
  sdec.thr   = 0.5 * (lo + hi)
  sdec.hyst  = sdec.hystfrac * sdec.swing
  sdec.family = sdec.sig_family(lo, hi)
  if modal < sdec.minmodal then
    return false, string.format('no clear logic levels (%.0f %% of samples near them)',
                                100 * modal)
  end
  sdec.lvl_thr, sdec.lvl_hyst, sdec.lvl_swing = sdec.thr, sdec.hyst, sdec.swing
  sdec.sig_noise(rd, n)
  return true
end

sdec.noise_nsamp = 1000

-- Signal-to-noise on the two logic levels, in dB. Positive because sig_levels has already refused a capture whose
-- noise swallowed its swing. docs/MEASUREMENTS.md, 'Noise is excluded by position, not by amplitude'.
function sdec.sig_noise(rd, n)
  local floor, sqrt, log = math.floor, math.sqrt, math.log
  sdec.snr_db, sdec.noise_v = nil, nil
  if rd == nil or n == nil or n < 8 then return end
  local thr, hy, sw = sdec.thr, sdec.hyst, sdec.swing
  if thr == nil or hy == nil or sw == nil or sw <= 0 then return end
  local step = floor(n / sdec.noise_nsamp)
  if step < 1 then step = 1 end
  local nlo, slo, qlo, nhi, shi, qhi = 0, 0, 0, 0, 0, 0
  local i = 2
  local vo = sdec.vover
  while i <= n - 1 do
    local v = rd[i]
    if v ~= nil and v > -vo and v < vo then
      local up = v > thr + hy
      local dn = v < thr - hy
      local a, b = rd[i - 1], rd[i + 1]
      if a ~= nil and (a <= -vo or a >= vo) then a = nil end
      if b ~= nil and (b <= -vo or b >= vo) then b = nil end
      if up and a ~= nil and b ~= nil and a > thr + hy and b > thr + hy then
        nhi = nhi + 1; shi = shi + v; qhi = qhi + v * v
      elseif dn and a ~= nil and b ~= nil and a < thr - hy and b < thr - hy then
        nlo = nlo + 1; slo = slo + v; qlo = qlo + v * v
      end
    end
    i = i + step
  end
  local ss, k = 0, 0
  if nlo > 1 then ss = ss + (qlo - slo * slo / nlo); k = k + nlo - 1 end
  if nhi > 1 then ss = ss + (qhi - shi * shi / nhi); k = k + nhi - 1 end
  if k < 1 then return end
  if ss < 0 then ss = 0 end          -- rounding only, but a negative would kill the sqrt
  local rms = sqrt(ss / k)
  sdec.noise_v = rms
  if rms < 1e-6 then rms = 1e-6 end
  sdec.snr_db = 20 * (log(sw / rms) / log(10))
end

-- Wire-quality warning about the levels, for the note line. sig_quality is about the sample rate.
function sdec.sig_levelwarn()
  if sdec.modal == nil then return nil end
  if sdec.modal >= sdec.warnmodal then return nil end
  return string.format('baseline unstable -- only %.0f %% of samples sit at a logic level (drift or noise)',
                       100 * sdec.modal)
end

-- Name the logic family from the measured levels: the fastest way to spot a probe on the wrong pin.
function sdec.sig_family(lo, hi)
  if lo == nil or hi == nil then return '?' end
  if lo < -1.5 and hi > 1.5 then return 'RS-232' end
  if hi >= 4.0 and hi <= 5.75 then return '5V TTL' end
  if hi >= 2.7 and hi < 4.0 then return '3V3 CMOS' end
  if hi >= 1.6 and hi < 2.7 then return '1V8 CMOS' end
  return string.format('%.1fVpp', hi - lo)
end

-- Edge extraction
-- Fractional position of the threshold crossing at or before sample i. Hysteresis makes this necessary: the trip
-- is at thr +- hyst, so thr itself is crossed earlier, and the bit-time fit reads these positions as timing.
function sdec.sig_cross(rd, i, thr)
  local j   = i
  local lim = i - sdec.maxback
  if lim < 2 then lim = 2 end
  while j >= lim do
    local a, b = rd[j-1], rd[j]
    if a ~= nil and b ~= nil then
      local da, db = a - thr, b - thr
      if (da < 0 and db >= 0) or (da >= 0 and db < 0) then
        local d = b - a
        if d == 0 then return j end
        local f = (thr - a) / d
        if f < 0 then f = 0 end
        if f > 1 then f = 1 end
        return (j - 1) + f
      end
    end
    j = j - 1
  end
  return i        -- no straddling pair in range: fall back to the trip sample
end

-- Build the edge list. Returns the edge count.
function sdec.sig_edges(rd, n)
  local thr = sdec.thr
  local hy  = sdec.hyst
  local hiT, loT = thr + hy, thr - hy
  local cross = sdec.sig_cross
  local ei, es = {}, {}
  local ne = 0
  local st = nil
  local i

  for i = 1, n do
    local v = rd[i]
    if v ~= nil then
      if v >= thr then st = 1 else st = 0 end
      break
    end
  end
  if st == nil then
    sdec.ne, sdec.ei, sdec.es, sdec.st0 = 0, ei, es, 1
    return 0
  end
  sdec.st0 = st

  for i = 2, n do
    local v = rd[i]
    if v ~= nil then
      if st == 1 then
        if v < loT then
          ne = ne + 1
          ei[ne] = cross(rd, i, thr)
          es[ne] = 0
          st = 0
        end
      else
        if v > hiT then
          ne = ne + 1
          ei[ne] = cross(rd, i, thr)
          es[ne] = 1
          st = 1
        end
      end
    end
  end

  sdec.ne, sdec.ei, sdec.es = ne, ei, es
  return ne
end

-- Which physical level is idle (the UART mark level): the longest single run where the runs can settle it, the
-- levels where they cannot. A prior either way, so ua_autoformat scores both polarities.
function sdec.sig_idle(rd, n)
  local ne, ei, es = sdec.ne, sdec.ei, sdec.es
  if ne == 0 then
    sdec.run1, sdec.run0 = 0, 0
    sdec.idle = sdec.st0
    return sdec.st0
  end

  local best1, best0 = 0, 0
  local onebit = sdec.sig_onebit(ei, ne)
  local idlelen = nil
  if onebit ~= nil then idlelen = sdec.idlemult * onebit end

  local k
  local nlong1, nlong0 = 0, 0
  for k = 1, ne - 1 do
    local len = ei[k+1] - ei[k]
    if es[k] == 1 then
      if len > best1 then best1 = len end
      if idlelen ~= nil and len >= idlelen then nlong1 = nlong1 + 1 end
    else
      if len > best0 then best0 = len end
      if idlelen ~= nil and len >= idlelen then nlong0 = nlong0 + 1 end
    end
  end

  local tail = n - ei[ne]
  if es[ne] == 1 then
    if tail > best1 then best1 = tail end
  else
    if tail > best0 then best0 = tail end
  end

  local lead = ei[1] - 1
  sdec.leadrun = lead
  local nrec = nlong1
  if nlong0 > nrec then nrec = nlong0 end
  sdec.idlerec = nrec
  local thin = false
  if sdec.acq_pretrig then
    thin = nrec < 2
  else
    if sdec.st0 == 1 then
      if lead > best1 then best1 = lead end
    else
      if lead > best0 then best0 = lead end
    end
  end

  sdec.run1, sdec.run0 = best1, best0

  sdec.onebit = onebit
  local longest = best1
  if best0 > longest then longest = best0 end
  if thin or (onebit ~= nil and longest < sdec.idlemult * onebit) then
    sdec.idle_weak = true
    if sdec.lo ~= nil and sdec.hi ~= nil and
       sdec.lo < -sdec.flatfloor and sdec.hi > sdec.flatfloor then
      sdec.idle = 0
    else
      sdec.idle = 1
    end
    return sdec.idle
  end

  sdec.idle_weak = false
  if best1 >= best0 then sdec.idle = 1 else sdec.idle = 0 end
  return sdec.idle
end

-- One bit time in samples, from the edge list and not from sdec.w, which is always nil here. A low percentile, not
-- the minimum, so one narrow glitch cannot halve the estimate; interior gaps only.
function sdec.sig_onebit(ei, ne)
  if ei == nil or ne == nil or ne < 5 then return nil end
  local t, nt = {}, 0
  local k
  for k = 1, ne - 1 do
    local d = ei[k + 1] - ei[k]
    if d > 0 then
      nt = nt + 1
      t[nt] = d
    end
  end
  if nt < 4 then return nil end
  table.sort(t)
  local i = math.floor(nt * 0.1)
  if i < 1 then i = 1 end
  local v = t[i]
  if v == nil or v <= 0 then return nil end
  return v
end

-- Bit-time recovery
-- Least-squares refinement from a seed bit time. Returns bittime, quality, nfit, or nil when nothing fits. Every
-- pulse width is an integer multiple of the bit time, so this is a fit through the origin: sum(w*m)/sum(m*m).
function sdec.sig_fit(w, nw, seed)
  local floor = math.floor
  local maxm = sdec.maxmult
  local T = seed
  local it, k

  for it = 1, 6 do
    local sn, snn = 0, 0
    local tol = 0.35 * T
    for k = 1, nw do
      local wk = w[k]
      local m = floor(wk / T + 0.5)
      if m >= 1 and m <= maxm then
        local d = wk - m * T
        if d < 0 then d = -d end
        if d < tol then
          sn  = sn + wk * m
          snn = snn + m * m
        end
      end
    end
    if snn <= 0 then return nil, 0, 0 end
    local newT = sn / snn
    local moved = newT - T
    if moved < 0 then moved = -moved end
    T = newT
    if moved < 1e-9 * T then break end
  end

  local serr, nfit, nsmall = 0, 0, 0
  local tol = 0.35 * T
  local maxw = (maxm + 0.5) * T
  for k = 1, nw do
    local wk = w[k]
    if wk <= maxw then
      nsmall = nsmall + 1
      local m = floor(wk / T + 0.5)
      if m < 1 then m = 1 end
      local e = wk - m * T
      if e < 0 then e = -e end
      if e < tol then
        nfit = nfit + 1
        serr = serr + e
      end
    end
  end
  if nfit == 0 or nsmall == 0 then return nil, 0, 0 end

  local q = (1 - (serr / nfit) / T) * (nfit / nsmall)
  if q < 0 then q = 0 end
  return T, q, nfit
end

-- Recover the bit time from the edge list. Returns bittime, reason.
function sdec.sig_bittime()
  local ne, ei = sdec.ne, sdec.ei
  sdec.bittime, sdec.baud_raw, sdec.baud = nil, nil, nil
  sdec.fitq, sdec.snapped, sdec.snapfirm = 0, false, true
  if ne == nil or ne < 2 then return nil, 'need at least two edges' end

  local nw = ne - 1
  local w, s = {}, {}
  local k
  for k = 1, nw do
    local d = ei[k+1] - ei[k]
    w[k] = d
    s[k] = d
  end
  sdec.nw, sdec.w = nw, w
  table.sort(s)
  sdec.wmed = s[math.floor(nw / 2) + 1]

  sdec.wshort = s[math.floor(nw * 0.05) + 1]

  local seeds, nseed, last = {}, 0, 0
  for k = 1, nw do
    local v = s[k]
    local corrob = (k < nw and s[k+1] <= 1.25 * v) or nw < 3
    if v > 0 and corrob and (nseed == 0 or v > 1.3 * last) then
      nseed = nseed + 1
      seeds[nseed] = v
      last = v
      if nseed >= 4 then break end
    end
  end
  if nseed == 0 then return nil, 'no usable pulse widths' end

  local bestT, bestq = nil, -1
  for k = 1, nseed do
    local T, q = sdec.sig_fit(w, nw, seeds[k])
    if T ~= nil and q > bestq then bestT, bestq = T, q end
  end
  if bestT == nil then return nil, 'no bit time fits the pulse widths' end

  sdec.bittime = bestT
  sdec.fitq    = bestq
  local fs = sdec.acq_fs or sdec.fs
  sdec.baud_raw = fs / bestT
  sdec.baud, sdec.snapped, sdec.snapfirm = sdec.sig_snap(sdec.baud_raw)
  return bestT
end

sdec.snaptol_firm = sdec.snaptol_firm or 0.0125

-- Snap a measured rate to a standard one when it is within tolerance. Returns rate, snapped, firm -- the third
-- separate on purpose: `snapped` is evidence ua_best acts on, `firm` is read only where confidence is claimed.
function sdec.sig_snap(b)
  if b == nil then return nil, false, false end
  local best, bestd = nil, nil
  local i
  local nb = table.getn(sdec.stdbaud)
  for i = 1, nb do
    local r = sdec.stdbaud[i]
    local d = b / r - 1
    if d < 0 then d = -d end
    if bestd == nil or d < bestd then best, bestd = r, d end
  end
  if bestd ~= nil and bestd <= sdec.snaptol then
    return best, true, bestd <= sdec.snaptol_firm
  end
  return b, false, true
end

sdec.baud_round_lo   = 10       -- step below the crossover
sdec.baud_round_hi   = 100      -- step above it
sdec.baud_round_at   = 10000    -- crossover
sdec.baud_round_fine = 1        -- the fallback: always inside the cap above sdec.minbaud
sdec.baud_round_tol  = 0.01     -- largest shift any step may make
-- Round a measured rate to a credible setting: the coarsest step that moves it less than 1 %. Returns rate,
-- credible. docs/MEASUREMENTS.md, 'baud_round cascades through three steps'.
function sdec.baud_round(b)
  if b == nil or b <= 0 then return b, false end
  local i
  for i = 1, table.getn(sdec.stdbaud) do
    if sdec.stdbaud[i] == b then return b, true end
  end
  local steps, ns = {}, 0
  if b >= sdec.baud_round_at then ns = ns + 1; steps[ns] = sdec.baud_round_hi end
  ns = ns + 1; steps[ns] = sdec.baud_round_lo
  ns = ns + 1; steps[ns] = sdec.baud_round_fine
  local k
  for k = 1, ns do
    local r = math.floor(b / steps[k] + 0.5) * steps[k]
    if r > 0 then
      local d = r / b - 1
      if d < 0 then d = -d end
      if d <= sdec.baud_round_tol then return r, true end
    end
  end
  return b, false
end

sdec.minsabit = 4
sdec.maxbaud  = 250000
sdec.minbaud  = 100

-- One-line verdict on the signal, for the panel and the log.
function sdec.sig_quality()
  local T = sdec.bittime
  if T == nil then return nil, 'no bit time' end
  if T <= sdec.minsabit then
    local fs = sdec.acq_fs or sdec.fs
    if fs ~= nil and fs > 0 and fs / T > sdec.maxbaud * (1 - sdec.plaustol) then
      return T, string.format('only %.1f samples/bit -- at or past the %d kBd ceiling',
                              T or 0, sdec.maxbaud / 1000)
    end
    return T, string.format('only %.1f samples/bit at %.0f kSa/s -- no margin left in the capture rate',
                            T or 0, (fs or 0) / 1000)
  end
  return T
end

-- Acquisition
-- Pick the lowest listed sample rate giving at least `want` samples per bit. A lower rate covers more time in
-- the same buffer, which is what decides how many bytes a capture holds.
function sdec.pick_fs(baud, want)
  if want == nil then want = 8 end
  local need = baud * want
  local i
  local nr = table.getn(sdec.rates)
  for i = 1, nr do
    if sdec.rates[i] >= need then return sdec.rates[i] end
  end
  return sdec.rates[nr]
end

-- Derive the true sample rate from the buffer's own timestamps, the only trustworthy source. Guarded at the proxy
-- read: a buffer the firmware has dropped raises rather than returning nil.
function sdec.acq_measure_fs(buf, n)
  if buf == nil or n == nil or n < 2 then return nil end
  local first = sdec.acq_first(buf, n)
  local last = first + n - 1
  if last > n then last = last - n end
  local t1, tn = nil, nil
  local ok = pcall(function()
    local ts = buf.relativetimestamps
    if ts ~= nil then t1, tn = ts[first], ts[last] end
  end)
  if not ok then return nil end
  if t1 == nil or tn == nil then return nil end
  local span = tn - t1
  if span <= 0 then return nil end
  return (n - 1) / span
end





-- The measured rate, or the requested one with a flag saying so: every byte is scaled by acq_fs, so a silent
-- substitution would report confident bytes from an untrustworthy number.
function sdec.acq_fs_or_requested(buf, n)
  local m = sdec.acq_measure_fs(buf, n)
  if m ~= nil then
    sdec.acq_fs_est = nil
    return m
  end
  sdec.acq_fs_est = true
  return sdec.fs
end

sdec.fs_default = 1000000
sdec.fs_sabit   = 8

-- Lowest listed sample rate giving at least sdec.fs_sabit samples per bit at this baud rate.
function sdec.fs_for_baud(baud)
  local top = sdec.rates[table.getn(sdec.rates)]
  if baud == nil or baud <= 0 then return sdec.fs_default end
  local want = baud * sdec.fs_sabit
  local i
  for i = 1, table.getn(sdec.rates) do
    if sdec.rates[i] >= want then return sdec.rates[i] end
  end
  return top                      -- faster than the instrument can sample; clamp
end

sdec.acq_overhead = 0.510e-6

sdec.minsabit_tier = {{9600, 8}, {19200, 5}}

sdec.fs_cap_tier = {{19200, 100000}}

sdec.sabit_max = 12

-- The rate that delivers `want` samples per bit, not the rate that would without overhead, and nil when no listed
-- rate can. `md` is optional and bounds the boost by what the buffer can afford, so that ceiling is per mode
-- rather than per baud. docs/MEASUREMENTS.md, 'What the ck_bufmax bound on oversampling is worth'.
function sdec.fs_for_burst(baud, md)
  if baud == nil or baud <= 0 then return sdec.fs_default end
  local want = sdec.minsabit
  if sdec.minsabit_tier ~= nil then
    local ti
    for ti = 1, table.getn(sdec.minsabit_tier) do
      local tier = sdec.minsabit_tier[ti]
      if baud <= tier[1] then
        if tier[2] > want then want = tier[2] end
        break
      end
    end
  end
  local ideal = 1 / (baud * want)
  if ideal <= sdec.acq_overhead then return nil end   -- unreachable at any rate
  local need = 1 / (ideal - sdec.acq_overhead)
  local i
  local lowest = nil
  for i = 1, table.getn(sdec.rates) do
    if sdec.rates[i] >= need then
      lowest = sdec.rates[i]
      break
    end
  end
  if lowest == nil then return nil end                -- past the top listed rate

  local cap = nil
  if sdec.fs_cap_tier ~= nil then
    local ci
    for ci = 1, table.getn(sdec.fs_cap_tier) do
      if baud <= sdec.fs_cap_tier[ci][1] then
        cap = sdec.fs_cap_tier[ci][2]
        break
      end
    end
  end
  local sabcap = nil
  if md ~= nil and md.cap ~= nil and sdec.ck_bufmax ~= nil then
    local nbits = sdec.force_nbits or 8
    local parbits = 0
    if sdec.force_par ~= nil and sdec.force_par ~= sdec.PAR_NONE then parbits = 1 end
    local framebits = 1 + nbits + parbits + (sdec.force_nstop or 1)
    local nmax = sdec.ck_bufmax - 100
    if sdec.trigmode ~= 'free' then
      nmax = math.floor((sdec.ck_bufmax - 100) * (100 - (sdec.pretrig or 0)) / 100)
    end
    sabcap = nmax / (md.cap * framebits)
  end

  if cap ~= nil and lowest > cap then
    local fallback = nil
    for i = 1, table.getn(sdec.rates) do
      local r = sdec.rates[i]
      if r > cap then break end
      if sdec.fs_delivered(r) / baud >= sdec.minsabit then fallback = r end
    end
    if fallback ~= nil then return fallback end
    return lowest
  end
  if cap ~= nil then
    local best = lowest
    for i = 1, table.getn(sdec.rates) do
      local r = sdec.rates[i]
      if r > cap then break end
      if r >= lowest then
        local t = sdec.fs_delivered(r) / baud
        local ok = (sdec.sabit_max == nil or t <= sdec.sabit_max)
        if ok and sabcap ~= nil and (r / baud) > sabcap then ok = false end
        if ok then best = r end
      end
    end
    return best
  end
  return lowest
end

-- What a requested rate actually delivers. Used by the panel so the operator sees the delivered figure: SA/BIT
-- comes from acq_fs after a capture, and before one there is nothing measured to show.
function sdec.fs_delivered(fs)
  if fs == nil or fs <= 0 then return nil end
  return 1 / (1 / fs + sdec.acq_overhead)
end

-- Call before every capture. Stateless by construction: it derives fs from the current forced rate and the current
-- mode each time rather than remembering anything.
function sdec.fs_select()
  if sdec.fs_want ~= nil then
    sdec.fs = sdec.fs_want
    sdec.fs_want = nil
    return sdec.fs
  end
  if sdec.force_baud ~= nil and sdec.force_baud > 0 then
    local md = nil
    if sdec.mode_cur ~= nil then md = sdec.mode_cur() end
    if md ~= nil and md.needbaud then
      sdec.fs = sdec.fs_for_burst(sdec.force_baud, md) or
                sdec.rates[table.getn(sdec.rates)]
    else
      sdec.fs = sdec.fs_for_baud(sdec.force_baud)
    end
  else
    sdec.fs = sdec.fs_default
  end
  return sdec.fs
end

-- A reading buffer's capacity. -> the number, or nil; second result true when the READ ITSELF raised.
--   [...]
-- The second result is not decoration: acq_bufmode and acq_bufhave clear their slot when the read raises,
-- which is a dead handle, and must not clear it when the buffer merely answered something odd. Offline a
-- dead buffer keeps its capacity and on hardware it raises, so this is the one place that difference lives.
function sdec.bufcap(b)
  if b == nil then return nil, false end
  local c = nil
  if not pcall(function() c = b.capacity end) then return nil, true end
  if type(c) ~= 'number' then return nil, false end
  return c, false
end

-- Make a reading buffer of `cap` readings. -> the buffer and its capacity, or nil.
-- One site, for sdec.bufcap's reason. THE READ-BACK IS THE VERDICT AND NOT THE pcall: a refused
-- buffer.make returns nil while pcall reports success, and deleting what a refused call returned posts
-- 1138 "expected type 'reading buffer', but found type 'unknown'". Standard style and not compact, and not
-- by choice -- docs/MEASUREMENTS.md, 'buffer.STYLE_COMPACT is nil on this firmware'.
function sdec.bufmake(cap)
  local mok, nb = pcall(buffer.make, cap, buffer.STYLE_STANDARD)
  if not mok then return nil end
  local c = sdec.bufcap(nb)
  if c == nil or c < 10 then return nil end
  return nb, c
end

-- Delete a reading buffer, answering for it. -> true if the instrument took it.
-- ONE GUARDED SITE for every delete this app makes, for sdec.bufcap's reason: the site count is a shipping
-- constraint, not a style preference. And the verdict is RETURNED and never swallowed, because a refused
-- delete has to leave the handle in place -- dropping it strands the readings for the rest of the power
-- cycle, which a 6 000 000-reading buffer did, taking the pool to 764 400 free with no way back.
function sdec.bufdel(b)
  if b == nil then return false end
  return (pcall(buffer.delete, b))
end

-- Clear a reading buffer. -> true if it answered. One site, the same argument. A clear is O(1) on this
-- firmware -- measured at 0.0001 s at both 20 000 and 262 144 readings -- so this costs nothing to route.
function sdec.bufclear(b)
  if b == nil then return false end
  return (pcall(function() b.clear() end))
end

-- Capacity a capture of n samples needs. Frame only -- SimpleLoop has no reserve.
-- docs/MEASUREMENTS.md, 'The pre-trigger reserve comes out of capacity, not out of count'.
function sdec.acq_cap(n)
  if n == nil then n = sdec.n end
  if n == nil then return nil end
  if sdec.trigmode == 'free' then return n end
  return n + math.ceil(n * (sdec.pretrig or 0) / 100) + 100
end

sdec.acq_posfloor = 0.001

sdec.acq_premin = 1000

-- READINGS of pre-roll the analog comparator needs before it will evaluate at all. The firmware takes
--   [...]
-- 92 readings already armed the comparator and those cells were failing on the capture LENGTH instead -- see
-- acq_bufplan. Lowering it again would make the post-trigger count LARGER, position being what the count is
-- taken from, so it stays where it is.
function sdec.acq_pospct(n, buf)
  local pt = sdec.pretrig or 0
  if pt <= 0 then return pt end
  if buf == nil then return pt end
  local cap = sdec.bufcap(buf)
  if cap == nil or cap < 10 then return pt end
  sdec.acq_poscap = cap
  if n == nil then n = sdec.n end
  if n == nil or n <= 0 then return pt end
  local want = math.ceil(n * pt / 100)
  local pos = want * 100 / cap
  local floorpct = 100 * sdec.acq_premin / n
  if pos < floorpct then pos = floorpct end
  if pos < sdec.acq_posfloor then pos = sdec.acq_posfloor end
  if pos > pt then pos = pt end
  return pos
end

sdec.acq_bufbudget = 6500000
sdec.acq_bufplan = {
  {id = 'frame', cap = 32768,   least = 24576},
  {id = 'rec',   cap = 6000000, least = 3952383},
  n = 2,
}
sdec.acq_buffor = {frame = 'frame', sml = 'rec', med = 'rec'}
sdec.acq_bufs = sdec.acq_bufs or {}

sdec.acq_framerungs = {12288, 16384, 20480, 24576, 40960, 49152}

-- The buffer id a rung is allocated under. One function so acq_bufinit, acq_buffree and acq_framefit
-- cannot disagree about the name.
function sdec.acq_rungid(cap)
  return 'fr' .. tostring(cap)
end

-- The smallest allocated frame buffer that can hold `want` readings. -> buffer, capacity, or nil.
-- Smallest-that-fits and not first-that-fits: the rungs are in ascending order here, but a refused one
-- leaves a gap and the plan's 32 768 sits outside the list entirely, so the comparison is what orders
-- them rather than the table.
function sdec.acq_framefit(want)
  local best, bcap = nil, nil
  local b, c = sdec.acq_bufhave('frame')
  if b ~= nil and c ~= nil and c >= want then best, bcap = b, c end
  local i
  for i = 1, table.getn(sdec.acq_framerungs) do
    local rb, rc = sdec.acq_bufhave(sdec.acq_rungid(sdec.acq_framerungs[i]))
    if rb ~= nil and rc ~= nil and rc >= want and (bcap == nil or rc < bcap) then
      best, bcap = rb, rc
    end
  end
  return best, bcap
end

-- The static buffer this mode records into, or nil before acq_bufinit has run. Live-checked, because a
-- dead handle raises on hardware where the offline mock answers.
function sdec.acq_bufmode(id, want)
  if id == nil then id = sdec.capmode end
  local bid = sdec.acq_buffor[id] or 'frame'
  if bid == 'frame' and want ~= nil and want > 0 then
    local fb, fc = sdec.acq_framefit(want)
    if fb ~= nil then return fb, fc end
  end
  local b = sdec.acq_bufs[bid]
  if b == nil then return nil end
  local cap, dead = sdec.bufcap(b)
  if dead then
    sdec.acq_bufs[bid] = nil
    return nil
  end
  if type(cap) ~= 'number' or cap < 10 then return nil end
  return b, cap
end

-- Is the static buffer with THIS BUFFER ID allocated and alive? Separate from acq_bufmode, which takes a
-- MODE id and maps it -- 'rec' is not a mode, so asking acq_bufmode for it answered about the frame
-- buffer instead and acq_bufinit could believe the record was in hand when it was not.
function sdec.acq_bufhave(bufid)
  local b = sdec.acq_bufs[bufid]
  if b == nil then return nil end
  local cap, dead = sdec.bufcap(b)
  if dead then
    sdec.acq_bufs[bufid] = nil
    return nil
  end
  if type(cap) ~= 'number' or cap < 10 then return nil end
  return b, cap
end

-- Is this handle one of ours? Identity, not capacity: two buffers can share a size and only the handle
--   [...]
-- buf_sweep -- the live capture buffer is not a stranger -- and useless to a caller holding sdec.buf itself,
-- for which it answers true whatever the buffer is. acq_make_buffer asked it that way and so declined to free
-- any buffer at all, which stranded one per capture.
function sdec.acq_isstatic(v)
  if v == nil then return false end
  local i
  for i = 1, sdec.acq_bufplan.n do
    if sdec.acq_bufs[sdec.acq_bufplan[i].id] == v then return true end
  end
  for i = 1, table.getn(sdec.acq_framerungs) do
    if sdec.acq_bufs[sdec.acq_rungid(sdec.acq_framerungs[i])] == v then return true end
  end
  return false
end

function sdec.acq_isours(v)
  if v == nil then return false end
  if v == sdec.buf then return true end
  return sdec.acq_isstatic(v)
end

-- Readings the static set is holding right now, across the plan and the frame ladder.
--   [...]
-- to subtract everything except the record -- must not ask twice: between two passes the record can die,
-- which leaves a non-nil capacity beside a total that no longer contains it and a subtraction that goes
-- negative. One pass makes them consistent by construction rather than by luck.
function sdec.acq_bufheld()
  local tot, rcap, i = 0, nil, nil
  for i = 1, sdec.acq_bufplan.n do
    local id = sdec.acq_bufplan[i].id
    local _, c = sdec.acq_bufhave(id)
    if c ~= nil then
      tot = tot + c
      if id == 'rec' then rcap = c end
    end
  end
  for i = 1, table.getn(sdec.acq_framerungs) do
    local _, c = sdec.acq_bufhave(sdec.acq_rungid(sdec.acq_framerungs[i]))
    if c ~= nil then tot = tot + c end
  end
  return tot, rcap
end

-- Allocate the whole set, once. -> true when every mode has one.
--   [...]
-- call asks, which cost three raised cells when the record was allocated per capture.
-- Idempotent: sdec.start() can run more than once per power cycle, and a second allocation on top of the
-- first would strand the first.
function sdec.acq_bufinit()
  sdec.acq_bufsmall = nil
  local order, i = {2, 1}, nil
  local nok, firstwhy = 0, nil
  for i = 1, sdec.acq_bufplan.n do
    local p = sdec.acq_bufplan[order[i]]
    if sdec.acq_bufhave(p.id) ~= nil then
      nok = nok + 1
    else
      sdec.trig_settle()
      local tries, ti = {p.cap, p.least}, nil
      local got = nil
      for ti = 1, 2 do
        if tries[ti] ~= nil and got == nil then
          local nb, cap = sdec.bufmake(tries[ti])
          if cap ~= nil then got = nb end
        end
      end
      if got ~= nil then
        sdec.acq_fillmode(got)
        sdec.acq_bufs[p.id] = got
        _G['SDEC_SBUF_' .. string.upper(p.id)] = got
        nok = nok + 1
        local c2 = sdec.bufcap(got)
        if c2 ~= nil and c2 < p.cap then
          sdec.acq_bufsmall = (sdec.acq_bufsmall or '') .. p.id .. '=' .. tostring(c2) .. ' '
        end
      elseif firstwhy == nil then
        firstwhy = string.format('%s wanted %d or %d readings', p.id, p.cap,
                                 p.least or p.cap)
      end
    end
  end
  local nrung, nrungok = table.getn(sdec.acq_framerungs), 0
  for i = nrung, 1, -1 do
    local rcap = sdec.acq_framerungs[i]
    local rid = sdec.acq_rungid(rcap)
    if sdec.acq_bufhave(rid) ~= nil then
      nrungok = nrungok + 1
    else
      local nb, cap = sdec.bufmake(rcap)
      if cap ~= nil then
        sdec.acq_fillmode(nb)
        sdec.acq_bufs[rid] = nb
        _G['SDEC_SBUF_' .. string.upper(rid)] = nb
        nrungok = nrungok + 1
      end
    end
  end
  sdec.acq_rungok, sdec.acq_rungwant = nrungok, nrung
  local b, cap = sdec.acq_bufmode()
  if b ~= nil then
    sdec.buf, sdec.acq_bufgot, sdec.acq_bufperm = b, cap, true
  end
  sdec.acq_bufnok = nok
  if nok < sdec.acq_bufplan.n then
    return false, firstwhy or 'not every mode got a static buffer'
  end
  return true
end

-- Hand the whole set back, for the app's exit. Deleted rather than dropped: a nil over the handle strands
-- the readings in a pool the next launch has to find room in.
function sdec.acq_buffree()
  sdec.trig_settle()
  local bufwasours = sdec.acq_isstatic(sdec.buf)
  local i
  for i = 1, sdec.acq_bufplan.n do
    local id = sdec.acq_bufplan[i].id
    local b = sdec.acq_bufs[id]
    if b ~= nil then
      local delok = sdec.bufdel(b)
      if delok then
        sdec.acq_bufs[id] = nil
        _G['SDEC_SBUF_' .. string.upper(id)] = nil
      else
        sdec.acq_delfail = (sdec.acq_delfail or 0) + 1
      end
    end
  end
  for i = 1, table.getn(sdec.acq_framerungs) do
    local rid = sdec.acq_rungid(sdec.acq_framerungs[i])
    local rb = sdec.acq_bufs[rid]
    if rb ~= nil then
      local rok = sdec.bufdel(rb)
      if rok then
        sdec.acq_bufs[rid] = nil
        _G['SDEC_SBUF_' .. string.upper(rid)] = nil
      else
        sdec.acq_delfail = (sdec.acq_delfail or 0) + 1
      end
    end
  end
  sdec.acq_rungok, sdec.acq_rungwant = nil, nil
  if bufwasours and not sdec.acq_isstatic(sdec.buf) then sdec.buf = nil end
  sdec.acq_bufperm, sdec.acq_bufgot, sdec.acq_scrgot = nil, nil, nil
  sdec.acq_bufnok = nil
  return next(sdec.acq_bufs) == nil
end

-- Readings a loaded position reserves in buf, which is the figure leadmax needs: the decoder is told how much
-- silence the record may open with, and after acq_pospct that is no longer a percentage of the capture.
function sdec.acq_leadmax(buf)
  if buf == nil then return nil end
  local pos = sdec.acq_posloaded
  if pos == nil then pos = sdec.pretrig or 0 end
  if pos <= 0 then return nil end
  local cap = sdec.bufcap(buf)
  if cap == nil or cap < 10 then return nil end
  return cap - math.floor(cap * (100 - pos) / 100)
end

-- Fill continuously, so nothing is ever stored past the end of the buffer, and the numeric assignment is the only
-- route to it. docs/MEASUREMENTS.md, 'A reserve in a FILL_ONCE buffer posts 4915 per discard'.
function sdec.acq_fillmode(buf)
  if buf == nil then return false end
  return pcall(function() buf.fillmode = 1 end)
end

-- Readings the pre-trigger reserve holds, and how long that is in time, which decides whether it wraps.
-- docs/MEASUREMENTS.md, 'A reserve in a FILL_ONCE buffer posts 4915 per discard'.
function sdec.acq_reserve(n)
  if n == nil then n = sdec.n end
  local pt = sdec.pretrig or 0
  if pt <= 0 then return 0 end
  return math.ceil((sdec.acq_cap(n) or n) * pt / 100)
end

-- How many samples a capture actually delivers, which is not sdec.n on the armed path, and a floor never a
-- ceiling. docs/MEASUREMENTS.md, 'The pre-trigger reserve comes out of capacity, not out of count'.
function sdec.n_deliv(n)
  if n == nil then n = sdec.n end
  if n == nil then return nil end
  if sdec.trigmode == 'free' then return n end
  local pt = sdec.pretrig or 0
  if pt <= 0 then return n end
  local cap = sdec.acq_cap(n) or n
  return math.floor(cap * (100 - pt) / 100)
end

-- How many bytes one capture window can hold, from acq_fs rather than the requested rate: the only way to know
-- whether a message was seen whole. docs/MEASUREMENTS.md, 'window_bytes: one division, not two'.
function sdec.window_bytes(baud, nbits, par, nstop)
  local fs = sdec.acq_fs or sdec.fs
  if baud == nil or baud <= 0 or fs == nil or fs <= 0 then return nil end
  local parbits = 0
  if par ~= nil and par ~= sdec.PAR_NONE then parbits = 1 end
  local framebits = 1 + (nbits or 8) + parbits + (nstop or 1)
  if fs / baud <= 0 then return nil end
  return math.floor((sdec.n * baud) / (fs * framebits))
end

-- Configure the rear EXT TRIG OUT line for flow control, or leave it alone. Re-applied per capture,
-- trigger.extout.logic being reset by an I/O trigger reset. LOGIC_POSITIVE, so a rising edge.
function sdec.fc_config()
  if not sdec.fc_out then return false end
  if trigger.extout == nil then return false end
  trigger.extout.logic = trigger.LOGIC_POSITIVE
  if trigger.extout.pulsewidth ~= nil then
    pcall(function() trigger.extout.pulsewidth = sdec.fc_pulse end)
  end
  return true
end

-- Keep the panel's event popups down to real faults. Normal operation files entries -- 2731 and 2732 per armed
-- capture, 2205 per byte-log probe -- and showevents selects which severities are displayed, not which are
-- logged, so sdec.errcount still sees them all. What raises a dialog for a given event is unresolved:
-- docs/UNDOCUMENTED.md, 'eventlog.suppress(N) appears in no manual, and what it suppresses is not the log entry'.
-- From hw_config, because another app may have set it.
function sdec.quiet_events()
  localnode.showevents = eventlog.SEV_ERROR
  local ev
  for ev = 1, 3 do
    local n = ({4919, 4920, 4915})[ev]
    local ok = pcall(eventlog.suppress, n)
    if not ok then sdec.suppress_why = 'eventlog.suppress unavailable' end
  end
  return true
end

-- Mute the panel's event popups where the firmware honours the mute, which for 4915 it does not.
-- docs/MEASUREMENTS.md, 'A reserve in a FILL_ONCE buffer posts 4915 per discard'.
function sdec.mute_events()
  localnode.showevents = 0
  return true
end

function sdec.unmute_events()
  localnode.showevents = eventlog.SEV_ERROR
  return true
end

-- Remember the measurement mode the instrument was left in, because choosing a digitize function deselects the
-- basic one. Both branches save which table and which function; only the digitize branch saves the range, writing
-- dmm.measure.range back being what would disable a meter's autorange. One-shot: the entry value.
function sdec.mode_save()
  if sdec.entrymode ~= nil then return true end
  if sdec.dig == nil then return false end
  local m = nil
  local ok = pcall(function()
    local df = sdec.dig.func
    if sdec.k.FUNC_NONE ~= nil and df == sdec.k.FUNC_NONE then
      m = {side = 'measure', func = sdec.meas.func}
    else
      m = {side = 'digitize', func = df, range = sdec.dig.range,
           samplerate = sdec.dig.samplerate, aperture = sdec.dig.aperture}
    end
  end)
  if not ok or m == nil or m.func == nil then return false end
  sdec.entrymode = m
  return true
end

-- Is a digitize function selected right now? Writing sdec.dig or sdec.atrig under a basic function posts 2800, an
-- event rather than a Lua error. True when it cannot tell, the safe direction.
function sdec.digitizing()
  if sdec.dig == nil then return false end
  if sdec.k.FUNC_NONE == nil then return true end
  local f = nil
  if not pcall(function() f = sdec.dig.func end) then return true end
  return f ~= sdec.k.FUNC_NONE
end

-- Put back what mode_save() found. Safe to call with nothing saved, and safe to call twice.
function sdec.mode_restore()
  local m = sdec.entrymode
  if m == nil then return true end
  sdec.entrymode = nil
  local ok = pcall(function()
    if m.side == 'measure' then
      sdec.meas.func = m.func
    else
      sdec.dig.func = m.func
      if m.range      ~= nil then sdec.dig.range      = m.range      end
      if m.samplerate ~= nil then sdec.dig.samplerate = m.samplerate end
      if m.aperture   ~= nil then sdec.dig.aperture   = m.aperture   end
    end
  end)
  return ok
end

-- Every detection setting back to automatic, and every rear-BNC option off: none reset themselves, and only a
-- power cycle nils `sdec`. The lock goes through unlock_all(), the one place that knows all five force_ fields.
function sdec.reset_options()
  sdec.unlock_all()
  sdec.proto = 'uart'
  sdec.proto_why = nil
  sdec.capmode = 'frame'
  sdec.ui_mode = 'text'
  sdec.widths_any = false
  sdec.trigmode = 'edge'
  sdec.trigext = false
  sdec.trigext_only = false
  sdec.fc_out = false
  return true
end

-- Relative compare for a readback: a float attribute can come back a bit-wobble away from what went in, and that
-- is not a snap. Non-numbers compare by identity, which the func constant needs.
function sdec.hw_same(want, got)
  if type(want) ~= 'number' or type(got) ~= 'number' then return want == got end
  local d = want - got
  if d < 0 then d = -d end
  local s = want
  if s < 0 then s = -s end
  if s < 1 then s = 1 end
  return d / s < 1e-9
end

sdec.hw_checked = nil

-- What the digitizer actually took. -> true if everything matched. One pcall for all three reads, at one boundary.
-- docs/MEASUREMENTS.md, 'hw_verify reads back three attributes, once a launch'.
function sdec.hw_verify()
  if sdec.hw_checked then return true end
  sdec.hw_checked = true
  local ok, f, r, a = pcall(function()
    return sdec.dig.func, sdec.dig.range, sdec.dig.aperture
  end)
  if not ok then return true end
  sdec.hw_snap = {func = f, range = r, aperture = a}
  local w = {sdec.k.FUNC_VOLT, sdec.range, 1e-6}
  local g = {f, r, a}
  local nm = {'func', 'range', 'aperture'}
  local allok, i = true, nil
  for i = 1, 3 do
    if not sdec.hw_same(w[i], g[i]) then
      allok = false
      ulog.line(string.format('digitizer %s: asked %s, took %s -- the instrument snapped it',
                              nm[i], tostring(w[i]), tostring(g[i])))
    end
  end
  return allok
end

-- Apply the range, sample rate and trigger settings to the digitizer before a capture. The fixed range and the
-- 1 us aperture are both non-negotiable: autorange would rescale mid-capture, and APERTURE_AUTO rounds off the
-- very edges this decoder measures. The rate goes in before the aperture, or an aperture too high for the rate
-- is adjusted silently.
function sdec.hw_config()
  sdec.quiet_events()
  sdec.fs_select()
  sdec.fc_config()
  sdec.acq_prep()
  sdec.dig.func       = sdec.k.FUNC_VOLT
  sdec.dig.range      = sdec.range
  sdec.dig.samplerate = sdec.fs
  sdec.dig.aperture   = 1e-6
  sdec.hw_verify()
end

-- Clamp a request to what the buffer can hold, reserve included. A store past capacity posts 4915.
function sdec.acq_fit(n, buf)
  if buf == nil then return n end
  local cap = sdec.bufcap(buf)
  if cap == nil or cap < 10 then return n end
  local room = cap
  if sdec.trigmode ~= 'free' and (sdec.pretrig or 0) > 0 then
    room = cap - math.ceil(cap * (sdec.pretrig or 0) / 100)
  end
  if room < 10 then room = 10 end
  if n > room then return room end
  return n
end

sdec.acq_bufgot = nil
sdec.acq_bufperm = nil
sdec.acq_freesettle = 0.05
sdec.acq_remade = 0
sdec.acq_presettle = 0

-- Free and remake the capture buffer. Follows the project's object-lifetime rule -- delete, nil, then create --
-- because creating over a live handle leaves the buffer beneath allocated and unreachable until a power cycle.
function sdec.acq_make_buffer(n)
  if n == nil then n = 10 end
  if n < 10 then n = 10 end     -- buffer.make() minimum, the figure 4920 names itself
  local sb, scap = sdec.acq_bufmode(nil, n)
  if sb ~= nil and scap ~= nil and scap >= n then
    sdec.trig_settle()
    sdec.bufclear(sb)
    sdec.acq_fillmode(sb)
    sdec.buf, sdec.acq_bufgot, sdec.acq_bufperm = sb, scap, true
    return sb
  end
  if sdec.buf ~= nil then
    local cap = sdec.bufcap(sdec.buf)
    if cap ~= nil and cap == n then
      sdec.trig_settle()
      sdec.bufclear(sdec.buf)
      sdec.acq_fillmode(sdec.buf)
      sdec.acq_bufperm = false
      return sdec.buf
    end
  end
  sdec.trig_settle()
  local freed = false
  if sdec.buf ~= nil and sdec.acq_isstatic(sdec.buf) then
    sdec.buf = nil
  elseif sdec.buf ~= nil then
    local b = sdec.buf
    local delok = sdec.bufdel(b)
    if not delok then
      sdec.delfails = (sdec.delfails or 0) + 1
      sdec.stickyerr = 'the capture buffer could not be freed -- power cycle the instrument'
      return sdec.buf                    -- KEEP the handle: it is the only way to retry
    end
    sdec.buf = nil
    freed = true
  end
  if freed then
    collectgarbage()
    delay(sdec.acq_freesettle)
    sdec.acq_presettle = (sdec.acq_presettle or 0) + 1
  end
  local nb, cap = sdec.bufmake(n)
  if (type(cap) ~= 'number' or cap < 10) and freed then
    delay(sdec.acq_freesettle)
    nb, cap = sdec.bufmake(n)
    if type(cap) == 'number' and cap >= 10 then
      sdec.acq_remade = (sdec.acq_remade or 0) + 1
    end
  end
  if type(cap) == 'number' and cap >= 10 then
    sdec.buf = nb
    sdec.acq_bufgot = cap
    sdec.acq_bufperm = false
    sdec.acq_fillmode(sdec.buf)
    return sdec.buf
  end
  sdec.acq_bufgot, sdec.acq_bufperm = nil, nil
  return nil
end

sdec.tick = nil
sdec.tickevery = sdec.tickevery or 2000    -- samples between hook calls; the bench caps the
-- Where the oldest reading is, as an index into buf.readings. 1 unless the buffer has wrapped, and the
-- firmware answers it in one proxy read. docs/MEASUREMENTS.md, 'A record can come back rotated'.
function sdec.acq_first(buf, n)
  if buf == nil or n == nil or n < 1 then return 1 end
  local cap, dead = sdec.bufcap(buf)
  if dead then return 1 end
  if cap ~= nil and n < cap then return 1 end
  local s = nil
  local ok = pcall(function() s = buf.startindex end)
  if not ok or s == nil then return 1 end
  s = math.floor(s)
  if s < 1 or s > n then return 1 end
  return s
end

-- Where the next reading will go, or nil when it cannot be read: the only progress counter that survives a wrap,
-- being a position in the ring. docs/MEASUREMENTS.md, 'A record can come back rotated'.
function sdec.acq_end(buf)
  if buf == nil then return nil end
  local e = nil
  if not pcall(function() e = buf.endindex end) then return nil end
  if e == nil then return nil end
  return math.floor(e)
end

-- Copy the capture out of the reading buffer into a plain Lua array, once: `buf.readings` is a proxy, so every
-- index is a firmware round trip. docs/MEASUREMENTS.md, 'Reading a sample out of a reading buffer'. Chunked so
-- the liveness hook costs nothing per sample: a modulo inside the loop would land on all 20 000 iterations of the
-- hottest loop in the acquisition path, where slicing the range leaves it what it was.
function sdec.acq_copy(buf, n)
  local rd = buf.readings
  local t = {}
  local step = sdec.tickevery
  if step == nil or step < 1 then step = n end
  local off = sdec.acq_first(buf, n) - 1
  local i = 1
  while i <= n do
    local j = i + step - 1
    if j > n then j = n end
    local k
    for k = i, j do
      local p = k + off
      if p > n then p = p - n end
      t[k] = rd[p]
    end
    if sdec.tick ~= nil then sdec.tick() end
    i = j + 1
  end
  sdec.smp = t
  return t
end

-- Untriggered capture of n samples, for the level-learning probe and for 'free' mode. ncopy caps the Lua copy: the
-- streaming fallback arrives with nsmp at 2.8 to 4.1 million, bufmax_for() starting at ck_bufwant.
function sdec.acq_free(n, ncopy, nofc)
  local buf = sdec.buf
  sdec.trig_settle()
  n = sdec.acq_fit(n, buf)
  sdec.dig.count = n
  buf.clear()
  if sdec.fc_out and not nofc then
    sdec.fc_credit()
  end
  sdec.dig.read(buf)
  sdec.nread = buf.n or 0
  sdec.acq_fs = sdec.acq_fs_or_requested(buf, sdec.nread)
  local ncp = sdec.nread
  if ncopy ~= nil and ncopy < ncp then ncp = ncopy end
  sdec.acq_copy(buf, ncp)
  sdec.acq_pretrig = nil
  return sdec.nread
end

-- Is the trigger model finished, as opposed to not started yet? idle is also the state before initiate(), hence
-- the buffer check. pcall'd because a state read that raises must degrade to "not finished".
function sdec.trig_done(buf)
  local sok, st = pcall(trigger.model.state)
  if not sok then st = nil end
  if st == nil then return false end
  return st == trigger.STATE_IDLE and (buf.n or 0) > 0
end

sdec.arm_settle_s = 10.0

-- Is the model sitting in a wait block? -> true, false, or nil when it cannot be told; nil means degrade rather
-- than retry. docs/MEASUREMENTS.md, 'buf.n is not evidence of a trigger'.
function sdec.trig_waiting()
  local sok, st = pcall(trigger.model.state)
  if not sok or st == nil then return nil end
  return st == trigger.STATE_WAITING
end

-- Stop the trigger model and wait for it to stop, abort() being asynchronous. Bounded, because a model that will
-- not idle must not hang the panel. Every caller is bare: each firmware call here carries its own guard.
function sdec.trig_settle()
  trigger.model.abort()
  local i
  local unread = 0
  for i = 1, 50 do
    local sok, st = pcall(trigger.model.state)
    if not sok then st = nil end
    if sok then
      if st == nil or st == trigger.STATE_IDLE or st == trigger.STATE_ABORTED then
        return true
      end
      unread = 0
    else
      unread = unread + 1
      if unread >= 10 then return false end
    end
    delay(0.01)
  end
  return false
end

sdec.cancel_blender = 2
sdec.cancel_poll_s = 0.001

-- Send one flow-control credit out of the rear EXT TRIG OUT. Returns whether the pulse went.
function sdec.fc_credit()
  local ok = false
  if trigger.extout ~= nil then ok = pcall(trigger.extout.assert) end
  if not ok then
    sdec.stickyerr = 'the flow-control credit pulse was refused -- the device was never told to send'
  end
  return ok
end

-- Wire the TRIGGER key to blender 2's latch and discard anything latched. -> whether the latch is available.
function sdec.cancel_setup()
  local b = sdec.cancel_blender
  local ok = pcall(function()
    trigger.blender[b].reset()
    trigger.blender[b].orenable = true
    trigger.blender[b].stimulus[1] = trigger.EVENT_DISPLAY
    trigger.blender[b].clear()
  end)
  sdec.cancel_ok = ok
  return ok
end

-- Discard any latched press: the operator who stopped the last run must not stop this one too.
function sdec.cancel_clear()
  if not sdec.cancel_ok then return false end
  return (pcall(trigger.blender[sdec.cancel_blender].clear))
end

-- Has TRIGGER been pressed since the last cancel_clear() or cancel_pressed()? The detector auto-resets on read
-- (ref 14-334), so one press answers true exactly once and callers record the answer.
function sdec.cancel_pressed()
  if not sdec.cancel_ok then return false end
  local ok, got = pcall(trigger.blender[sdec.cancel_blender].wait, sdec.cancel_poll_s or 0.001)
  if not ok then return false end
  return got == true
end
-- Which event arms a capture, and what that costs in shared instrument state. -> ev, useanalog, blended. Called by
-- both armed paths; ev is nil when the event constant is absent.
function sdec.arm_source()
  local ev = trigger.EVENT_ANALOGTRIGGER
  if sdec.trigmode == 'front' then ev = trigger.EVENT_DISPLAY end
  local useanalog = (ev == trigger.EVENT_ANALOGTRIGGER)

  local blended = false
  if not sdec.trigext then
    trigger.blender[1].reset()
  end
  if sdec.trigext and sdec.trigext_only and sdec.trigmode ~= 'free' then
    ev = trigger.EVENT_EXTERNAL
    useanalog = false
    trigger.blender[1].reset()
  elseif sdec.trigext and sdec.trigmode ~= 'free' then
    local bok = pcall(function()
      trigger.blender[1].reset()
      trigger.blender[1].orenable = true
      trigger.blender[1].stimulus[1] = ev
      trigger.blender[1].stimulus[2] = trigger.EVENT_EXTERNAL
    end)
    if bok then
      ev = trigger.EVENT_BLENDER1
      blended = true
    else
      ev = trigger.EVENT_EXTERNAL
      sdec.lasterr = 'no trigger blender; using the rear BNC alone'
    end
  end

  if sdec.arm_silent() and sdec.armkey and sdec.trigmode ~= 'front' and
     not (sdec.trigext and sdec.trigext_only) then
    local kok = pcall(function()
      if not blended then
        trigger.blender[1].reset()
        trigger.blender[1].orenable = true
        trigger.blender[1].stimulus[1] = ev
      end
      trigger.blender[1].stimulus[3] = trigger.EVENT_DISPLAY
    end)
    if kok then
      ev = trigger.EVENT_BLENDER1
      blended = true
      sdec.armkeyed = true
    else
      sdec.armkeyed = nil
      local knote = 'the TRIGGER key will not cut the arm short'
      if sdec.lasterr == nil then
        sdec.lasterr = 'no trigger blender; ' .. knote
      else
        sdec.lasterr = sdec.lasterr .. '; ' .. knote
      end
    end
  else
    sdec.armkeyed = nil
  end

  sdec.trigblended = blended
  return ev, useanalog, blended
end

-- Where to arm on a line the probe found silent, in volts, written to sdec.thr with the matching sdec.idle. ->
-- false when there is not even a level to work from. Shared by both armed paths.
function sdec.arm_threshold()
  sdec.arm_thr, sdec.arm_idle = nil, nil
  if sdec.vmax == nil then return false end
  local idlev = sdec.vmax
  if math.abs(sdec.vmin) > math.abs(sdec.vmax) then idlev = sdec.vmin end
  sdec.hyst = 0
  if math.abs(idlev) < sdec.flatfloor then
    sdec.thr, sdec.idle = idlev + sdec.arm_level_v(), 0
    sdec.arm_thr, sdec.arm_idle = sdec.thr, sdec.idle
    return true
  end
  local off = sdec.arm_level_v()
  local half = 0.5 * math.abs(idlev)
  if off > half then off = half end
  if idlev < 0 then
    sdec.thr, sdec.idle = idlev + off, 0
  else
    sdec.thr, sdec.idle = idlev - off, 1
  end
  sdec.arm_thr, sdec.arm_idle = sdec.thr, sdec.idle
  return true
end

-- The slope the start bit takes, or nil where the comparator is not the source and a slope would be dead state
-- on the board. Shared, so the frame path and the armed recording arm on the same edge of the same line.
function sdec.arm_slope()
  if sdec.trigmode ~= 'edge' then return nil end
  local side = sdec.arm_idle
  if side == nil then side = sdec.idle end
  if side == 0 then return sdec.k.SLOPE_RISING end
  return sdec.k.SLOPE_FALLING
end

-- Point the comparator at sdec.thr, or turn it off where it is not a source. -> whether the writes went through.
-- Guarded, a digitizer with no comparator being supported: a bare write with atrig nil raised.
function sdec.arm_comparator(useanalog, slope)
  if sdec.atrig == nil then return false end
  return pcall(function()
    if useanalog then
      sdec.atrig.mode   = sdec.k.MODE_EDGE
      sdec.atedge.level = sdec.arm_thr or sdec.thr
      sdec.atedge.slope = slope
    else
      sdec.atrig.mode = sdec.k.MODE_OFF
    end
  end)
end


















-- Capture armed on a signal edge, on the front-panel TRIGGER key or on the rear BNC, degrading to a free-running
-- read if the source is refused. It keeps sdec.pretrig percent of the buffer from before the trigger, because a
-- start bit is only a start bit if the line was at mark first, and the comparison runs on the analog board's
-- Cortex-M4 rather than in Lua, so arming costs nothing per sample.
function sdec.acq_triggered(n, slope)
  local buf = sdec.buf
  buf.clear()
  sdec.acq_fillmode(buf)
  n = sdec.acq_fit(n, buf)
  sdec.dig.count = n
  sdec.mute_events()

  local wait = sdec.trigwait or 3.0
  if sdec.trigmode == 'front' or sdec.trigext then wait = sdec.trigwait_ext or 30.0 end

  if sdec.arm_silent() and sdec.trigmode == 'edge' and
     not (sdec.trigext and sdec.trigext_only) then
    local armw = sdec.arm_wait_s()
    if armw > wait then wait = armw end
  end

  local dur = nil
  if sdec.fs ~= nil and sdec.fs > 0 then dur = n / sdec.fs end
  if dur ~= nil and wait < dur * 1.5 + 1.0 then wait = dur * 1.5 + 1.0 end

  local ev, useanalog = sdec.arm_source()
  if ev == nil then
    sdec.unmute_events()
    sdec.lasterr = 'no front-panel TRIGGER event on this firmware; captured free-running'
    return sdec.acq_free(n)
  end

  local expired = false
  local ok, perr = pcall(function()
    if not sdec.arm_comparator(useanalog, slope) then
      error('no analog comparator on this digitizer', 0)
    end
    local pos = sdec.acq_pospct(n, buf)
    sdec.acq_posloaded = pos
    trigger.model.load('LoopUntilEvent', ev,
                       pos, trigger.CLEAR_ENTER, 0, buf)
    trigger.model.initiate()

    if sdec.fc_out then
      if trigger.extout ~= nil then trigger.extout.assert() end
    end

    if sdec.arm_silent() and sdec.armnote ~= nil then
      pcall(sdec.armnote, wait, sdec.arm_thr or sdec.thr or sdec.arm_level_v(), sdec.armkeyed)
    end

    local waited, step = 0, 0.05
    while waited < wait do
      if sdec.trig_done(buf) then break end
      if (buf.n or 0) >= n and sdec.pretrig <= 0 then break end
      delay(step)
      waited = waited + step
    end
    local full = (buf.n or 0) >= n and sdec.pretrig <= 0
    if not sdec.trig_done(buf) and not full then
      expired = true
      local why = 'no trigger in ' .. tostring(wait) .. ' s (' .. tostring(sdec.trigmode) .. ')'
      if sdec.arm_silent() and useanalog then
        why = why .. ' -- nothing crossed ' ..
              string.format('%.2f', sdec.thr or sdec.arm_level_v()) ..
              ' V; raise Arm/Idle Wait or lower Arm At'
      else
        why = why .. ' -- try Free run'
      end
      error(why, 0)
    end
  end)

  sdec.trig_settle()

  sdec.unmute_events()
  if not ok then
    sdec.lasterr = tostring(sdec.trigmode) ..
                   ' trigger unavailable; captured free-running'
    if expired and perr ~= nil then
      sdec.lasterr = sdec.lasterr .. ' (' .. tostring(perr) .. ')'
    end
    sdec.armraise = perr
    if sdec.atrig ~= nil then sdec.atrig.mode = sdec.k.MODE_OFF end
    return sdec.acq_free(n)
  end

  sdec.nread = buf.n or 0
  sdec.acq_fs = sdec.acq_fs_or_requested(buf, sdec.nread)
  sdec.acq_copy(buf, sdec.nread)
  sdec.acq_pretrig = (sdec.pretrig or 0) > 0
  return sdec.nread
end

-- Full acquisition: learn the levels, then capture for real. Returns ok, reason. Two stages because the analog
-- trigger level is a voltage and the logic levels are unknown until a short probe has measured them.
function sdec.acquire()
  sdec.lasterr = nil
  sdec.clear_measured()
  sdec.hw_config()
  local nwant = sdec.n
  if (sdec.strm_overread or 0) > 0 then
    nwant = math.ceil(sdec.n * (1 + sdec.strm_overread))
  end
  sdec.acq_make_buffer(sdec.acq_cap(nwant))
  if sdec.buf == nil then
    return false, string.format('cannot allocate %d readings for the capture',
                                sdec.acq_cap(nwant) or nwant or 0)
  end

  local pn = sdec.probe_n
  if pn > sdec.n then pn = sdec.n end
  if sdec.acq_free(pn, nil, true) < 2 then return false, 'probe capture returned nothing' end

  local ok, why = sdec.sig_levels(sdec.smp, sdec.nread)
  sdec.probe_idle = nil
  if ok then
    sdec.sig_edges(sdec.smp, sdec.nread)
    sdec.sig_idle(sdec.smp, sdec.nread)
  else
    if not sdec.arm_threshold() then return false, why end
    sdec.probe_idle = why
    if sdec.trigmode == 'free' and (sdec.n <= pn or sdec.trig_restore ~= nil) then
      return false, why
    end
  end

  if sdec.trigmode == 'edge' or sdec.trigmode == 'front' then
    if sdec.acq_triggered(nwant, sdec.arm_slope()) < 2 then
      return false, 'triggered capture returned nothing'
    end
  else
    if sdec.acq_free(nwant) < 2 then return false, 'capture returned nothing' end
  end

  ok, why = sdec.sig_levels(sdec.smp, sdec.nread)
  if not ok then return false, why end
  if sdec.trigmode == 'free' then sdec.probe_idle = nil end
  if sdec.tick ~= nil then sdec.tick() end
  sdec.sig_edges(sdec.smp, sdec.nread)
  if sdec.tick ~= nil then sdec.tick() end
  sdec.sig_idle(sdec.smp, sdec.nread)
  return true
end


-- ================= tsp/uart_decode.tsp =================
sdec = sdec or {}

sdec.PAR_NONE = 0
sdec.PAR_EVEN = 1
sdec.PAR_ODD  = 2

sdec.try_nbits     = {8, 7}              -- the default: the two widths that actually occur
sdec.try_nbits_all = {8, 7, 6, 5}        -- with "Auto (any width)"; 9 is forced-only, see above
sdec.try_par       = {0, 1, 2}

if sdec.widths_any == nil then sdec.widths_any = false end

-- The width list in force. Everything that searches widths goes through here.
function sdec.ua_widths()
  if sdec.force_nbits ~= nil then return {sdec.force_nbits} end
  if sdec.widths_any then return sdec.try_nbits_all end
  return sdec.try_nbits
end

-- A forced field narrows the candidate list rather than bypassing the search, leaving every scoring
-- and margin rule below unchanged: a one-entry list has nothing to lose to.
function sdec.ua_parities()
  if sdec.force_par ~= nil then return {sdec.force_par} end
  return sdec.try_par
end

function sdec.ua_stops()
  if sdec.force_nstop ~= nil then return {sdec.force_nstop} end
  return sdec.try_stop
end

sdec.force_msb = nil
sdec.msb_used = nil

sdec.try_stop  = {1}

sdec.ratios      = {1, 0.5, 2, 0.3333333333, 3, 0.25, 4, 0.2, 5, 0.1666666667, 6, 8, 10}
sdec.probe_nbits = {8, 7, 5}

sdec.ratemargin = sdec.ratemargin or 0.04

sdec.qgate = 0.8

sdec.alt_minframes = sdec.alt_minframes or 8

sdec.fitratio = sdec.fitratio or 1    -- the rescaling ua_best() settled on

-- Bit sampling
-- Sample the logical bit level at fractional sample position x. Returns 0, 1, or nil outside the
-- capture. Three taps are majority-voted: docs/MEASUREMENTS.md, 'Three-tap majority sampling'.
function sdec.ua_bit(rd, n, x, invert, T)
  local thr = sdec.thr
  local floor = math.floor

  local ic = floor(x + 0.5)
  if ic < 1 or ic > n then return nil end
  local vc = rd[ic]
  if vc == nil then return nil end

  local ones, votes = 0, 1
  if vc >= thr then ones = 1 end

  if T ~= nil and T >= 6 then
    local off = 0.2 * T
    local j
    for j = -1, 1, 2 do
      local i = floor(x + j * off + 0.5)
      if i >= 1 and i <= n then
        local v = rd[i]
        if v ~= nil then
          votes = votes + 1
          if v >= thr then ones = ones + 1 end
        end
      end
    end
  end

  local b
  if ones * 2 > votes then b = 1
  elseif ones * 2 < votes then b = 0
  elseif vc >= thr then b = 1
  else b = 0 end

  if invert then b = 1 - b end
  return b
end

sdec.ua_pc = nil
-- Set bits in v, there being no bitwise operators in 5.0.2. Table over the 9-bit domain, built on
-- first use; the loop is kept for anything wider. docs/MEASUREMENTS.md, "ua_popcount's lookup table".
function sdec.ua_popcount(v)
  local t = sdec.ua_pc
  if t == nil then
    t = {}
    local floor = math.floor
    local i = 0
    while i < 512 do
      local ones, x = 0, i
      while x > 0 do
        local h = x * 0.5
        local f = floor(h)
        if h ~= f then ones = ones + 1 end
        x = f
      end
      t[i] = ones
      i = i + 1
    end
    sdec.ua_pc = t
  end
  local c = t[v]
  if c ~= nil then return c end
  local ones, x = 0, v
  local floor = math.floor
  while x > 0 do
    local h = x * 0.5
    local f = floor(h)
    if h ~= f then ones = ones + 1 end
    x = f
  end
  return ones
end

-- One frame
--   [...]
-- default LSB path, and a descending weight means halving, which yields a FLOAT on Lua 5.3+ that
-- `string.format('%02X', v)` then refuses -- while 5.0.2 on the instrument has no integer subtype and
-- would have hidden it until a host-side suite printed `65.0`. Integer arithmetic throughout here.
function sdec.ua_revbits(v, nbits)
  if v == nil or nbits == nil or nbits < 2 then return v end
  local out, src, i = 0, v, nil
  for i = 1, nbits do
    out = out * 2 + math.mod(src, 2)
    src = math.floor(src / 2)
  end
  return out
end

-- Decode the frame whose start-bit leading edge sits at fractional sample t0. Bit cell k spans
--   [...]
-- returns the value: a byte with a bad stop bit is usually the right byte at the wrong baud rate. The
-- sampling is ua_bit inline, expression for expression, a call costing about as much as the sampling
-- it wraps. docs/MEASUREMENTS.md, 'Three-tap majority sampling'.
function sdec.ua_frame(rd, n, t0, T, nbits, par, nstop, invert, msb)
  local thr = sdec.thr
  local floor = math.floor
  local three, off = false, 0
  if T ~= nil and T >= 6 then
    three = true
    off = 0.2 * T
  end

  local pslot = -1
  if par ~= sdec.PAR_NONE then pslot = nbits + 1 end
  local last = nbits + nstop
  if pslot > 0 then last = last + 1 end

  local val, bv = 0, 1
  local slot

  local hib, lob = 1, 0
  if invert then hib, lob = 0, 1 end

  for slot = 0, last do
    local x = t0 + (slot + 0.5) * T
    local ic = floor(x + 0.5)
    if ic < 1 or ic > n then return nil, 'truncated' end
    local vc = rd[ic]
    if vc == nil then return nil, 'truncated' end

    local b
    if three then
      local cb = 0
      if vc >= thr then cb = 1 end
      local ones, votes = cb, 1
      local settled = false
      local i = floor(x - off + 0.5)
      if i >= 1 and i <= n then
        local v = rd[i]
        if v ~= nil then
          votes = 2
          if v >= thr then
            ones = ones + 1
            if cb == 1 then settled = true end
          elseif cb == 0 then settled = true end
        end
      end
      if not settled then
        i = floor(x + off + 0.5)
        if i >= 1 and i <= n then
          local v = rd[i]
          if v ~= nil then
            votes = votes + 1
            if v >= thr then ones = ones + 1 end
          end
        end
      end
      if ones * 2 > votes then b = hib
      elseif ones * 2 < votes then b = lob
      elseif vc >= thr then b = hib
      else b = lob end
    elseif vc >= thr then b = hib
    else b = lob end

    if slot == 0 then
      if b ~= 0 then return nil, 'start' end
    elseif slot <= nbits then
      if b == 1 then val = val + bv end
      bv = bv * 2
    elseif slot == pslot then
      local pe = math.mod(sdec.ua_popcount(val), 2)
      local want
      if par == sdec.PAR_EVEN then want = pe else want = 1 - pe end
      if b ~= want then
        if msb then val = sdec.ua_revbits(val, nbits) end
        return val, 'parity'
      end
    else
      if b ~= 1 then
        if msb then val = sdec.ua_revbits(val, nbits) end
        return val, 'framing'
      end
    end
  end

  if msb then val = sdec.ua_revbits(val, nbits) end
  return val, nil
end

sdec.ua_resid_frac = sdec.ua_resid_frac or 0.25
sdec.ua_resid_min  = sdec.ua_resid_min  or 20

-- Sequential decode of a whole capture
--   [...]
-- the share over any threshold by chance -- a 13-byte capture was losing its first byte to a vote
-- taken over 12 frames. A capture worth voting on has hundreds: 20000 samples at 9600 baud holds
-- about 190 frames, and the ranking probe's 4000-sample window about 38.
function sdec.ua_run(rd, n, T, nbits, par, nstop, invert, tmin0, msb)
  if msb == nil then msb = sdec.force_msb end
  local parbits = 0
  if par ~= sdec.PAR_NONE then parbits = 1 end
  local framebits = 1 + nbits + parbits + nstop

  local r = {nf = 0, ngood = 0, nbad = 0, nfalse = 0, vals = {}, errs = {},
             tpos = {}, framebits = framebits}

  local ne, ei, es = sdec.ne, sdec.ei, sdec.es
  if ne == nil or ne < 1 then return r end

  local want = 0
  if invert then want = 1 end

  local anchor = nil
  if tmin0 == nil then
    if T > 0 and ne >= framebits then
      local h, base = {}, ei[1]
      for k = 0, framebits - 1 do h[k] = 0 end
      for k = 1, ne do
        if es[k] == want then
          local rsd = math.mod(math.floor((ei[k] - base) / T + 0.5), framebits)
          h[rsd] = h[rsd] + 1
        end
      end
      local bestr, bestn, second = nil, -1, 0
      for k = 0, framebits - 1 do
        if h[k] > bestn then second = bestn; bestr, bestn = k, h[k]
        elseif h[k] > second then second = h[k] end
      end
      if second < 0 then second = 0 end
      if bestn >= sdec.ua_resid_min and (bestn - second) >= sdec.ua_resid_frac * bestn then
        for k = 1, ne do
          if es[k] == want
             and math.mod(math.floor((ei[k] - base) / T + 0.5), framebits) == bestr then
            anchor = k
            break
          end
        end
      end
    end
    if anchor == nil then
      for k = 1, ne do
        if es[k] == want and ei[k] <= n then
          local markrun
          if k == 1 then markrun = ei[1] - 1 else markrun = ei[k] - ei[k-1] end
          if markrun >= 1.5 * T then anchor = k; break end
        end
      end
    end
    if anchor == nil then
      for k = 1, ne do
        if es[k] == want then anchor = k; break end
      end
    end
  else
    anchor = 1
  end
  if anchor == nil then return r end

  local tmin = -1
  if tmin0 ~= nil then tmin = tmin0 end
  local prev = nil          -- t0 of the previous emitted frame, for the idle test below
  for k = anchor, ne do
    if es[k] == want and ei[k] >= tmin then
      local t0 = ei[k]
      local val, err = sdec.ua_frame(rd, n, t0, T, nbits, par, nstop, invert, msb)
      if err == 'truncated' then break end

      if err == 'start' then
        r.nfalse = r.nfalse + 1
      else

      local nf = r.nf + 1
      r.nf = nf
      r.vals[nf] = val
      r.errs[nf] = err
      r.tpos[nf] = t0
      if err == nil then r.ngood = r.ngood + 1 else r.nbad = r.nbad + 1 end
      tmin = t0 + (framebits - 0.5) * T

      if r.idle1 == nil and prev ~= nil and (t0 - prev) >= 2 * framebits * T then
        r.idle1 = nf
      end
      prev = t0

      end
    end
  end

  if r.idle1 ~= nil and r.idle1 > 1 then
    local nh, nt, i = 0, 0, nil
    for i = 1, r.nf do
      if r.errs[i] ~= nil then
        if i < r.idle1 then nh = nh + 1 else nt = nt + 1 end
      end
    end
    if nh > 0 and nt == 0 then r.headsusp = r.idle1 - 1 end
  end

  return r
end

sdec.ua_edge_frames = 3     -- head frames the framer may spend resynchronising

-- Framing errors away from the window edges, i.e. the ones that are real faults.
function sdec.ua_bad_interior(r)
  if r == nil or r.errs == nil then return 0, 0 end
  local nin, nedge, i = 0, 0, nil
  local lo = sdec.ua_edge_frames + 1
  for i = 1, r.nf do
    if r.errs[i] ~= nil then
      if i < lo or i == r.nf then nedge = nedge + 1 else nin = nin + 1 end
    end
  end
  return nin, nedge
end

-- How far a misaligned head reaches: the last flagged frame inside headsusp, or 0. headsusp is a
-- region, not a count of damage, so quoting it over-claims. `hs` overrides r.headsusp for a tail.
function sdec.ua_head_bad(r, hs)
  if r == nil or r.errs == nil then return 0 end
  if hs == nil then hs = r.headsusp end
  if hs == nil then return 0 end
  local last, i = 0, nil
  if hs > r.nf then hs = r.nf end
  for i = 1, hs do
    if r.errs[i] ~= nil then last = i end
  end
  return last
end

-- Bytes you cannot trust, not frames that failed a check: in a misaligned head the bit boundaries are
-- wrong, so a frame can pass parity and stop by luck. An identified head counts in full and the
-- resync exclusion is dropped across it; the final frame stays excluded.
function sdec.ua_err_count(r, hb)
  if r == nil or r.errs == nil then return 0 end
  if hb == nil then hb = sdec.ua_head_bad(r) end
  if hb > r.nf then hb = r.nf end
  local lo, n, i = sdec.ua_edge_frames, hb, nil
  if hb > lo then lo = hb end
  for i = lo + 1, r.nf do
    if i ~= r.nf and r.errs[i] ~= nil then n = n + 1 end
  end
  return n
end

-- Bytes a reader would take for text: A-Z, a-z, 0-9, and how many good frames were looked at. Good
-- frames only, a flagged frame's value being untrustworthy by definition. Ties break on this in
-- ua_best_end, which needs the denominator as well as the count.
function sdec.ua_textn(r)
  if r == nil or r.vals == nil or r.errs == nil then return 0, 0 end
  local c, g, i = 0, 0, nil
  for i = 1, r.nf do
    if r.errs[i] == nil then
      local v = r.vals[i]
      g = g + 1
      if (v >= 48 and v <= 57) or (v >= 65 and v <= 90) or (v >= 97 and v <= 122) then
        c = c + 1
      end
    end
  end
  return c, g
end

-- Rank a decode: good frames less three times the bad ones.
function sdec.ua_score(r)
  return r.ngood - 3 * r.nbad
end

sdec.rarewidth = 8

sdec.polmargin = 4

-- The bias multiplies the proportional term only, never the floor.
function sdec.ua_margin(sc, nbits)
  local m = 0
  if sc > 0 then m = 0.6 * sc end
  if nbits ~= nil and nbits < 7 then m = m * sdec.rarewidth end
  if m < 2 then m = 2 end
  return m
end

-- Fraction of a decode's values that read as text. The last resort when two polarities tie, and it
-- has to stay last: on a random payload it points the wrong way, 40.2 % for the inverted reading
-- against 34.1 % for the truth. docs/MEASUREMENTS.md, 'The polarity tiebreak'.
function sdec.ua_printfrac(r)
  if r == nil or (r.nf or 0) < 1 then return 0 end
  local ok, tot = 0, 0
  local i
  for i = 1, r.nf do
    local v = r.vals[i]
    if v ~= nil then
      tot = tot + 1
      if (v >= 32 and v < 127) or v == 9 or v == 10 or v == 13 then ok = ok + 1 end
    end
  end
  if tot == 0 then return 0 end
  return ok / tot
end

sdec.ua_polnftol = 0.1
sdec.ua_textmin = 0.25

-- One run at a fixed format, with the fields ua_pick_pol and the caller read filled in.
function sdec.ua_run_fmt(rd, n, T, nbits, par, nstop, inv)
  local r = sdec.ua_run(rd, n, T, nbits, par, nstop, inv)
  r.score = sdec.ua_score(r)
  r.nbits, r.par, r.nstop, r.invert = nbits, par, nstop, inv
  return r
end

-- Choose between the two polarities of one capture, prior first. The prior keeps the decision unless
--   [...]
-- one in both directions. Text reads 97.8 % against 58.9 % on the same pair and is right both times.
-- The error count still breaks a tie text cannot see, which is a payload with no alphabet to read.
-- docs/MEASUREMENTS.md, 'The polarity tiebreak'.
function sdec.ua_pick_pol(a, b, weak)
  if a == nil then return b, 'only' end
  if b == nil then return a, 'only' end
  local m = sdec.ua_margin(a.score)
  if weak then m = m * sdec.polmargin end
  if b.score > a.score + m then return b, 'score' end
  if not weak then return a, 'prior' end
  local na, nb = a.nf or 0, b.nf or 0
  local big = na
  if nb > big then big = nb end
  if big < 1 or math.abs(na - nb) > sdec.ua_polnftol * big then return a, 'prior' end
  local fa, fb = sdec.ua_printfrac(a), sdec.ua_printfrac(b)
  if fb > fa + sdec.ua_textmin then return b, 'text' end
  if fa > fb + sdec.ua_textmin then return a, 'text' end
  if (b.nbad or 0) < (a.nbad or 0) then return b, 'errors' end
  return a, 'prior'
end

-- Search every format at one polarity, also returning those within the margin, the UI's ambiguity.
function sdec.ua_search_pol(rd, n, T, inv)
  local widths = sdec.ua_widths()
  local pars = sdec.ua_parities()
  local stops = sdec.ua_stops()
  local nnb = table.getn(widths)
  local npa = table.getn(pars)
  local nst = table.getn(stops)
  local best, alts = nil, {}
  local na = 0
  local b, c, d

  for b = 1, nnb do
    local nbits = widths[b]
    for c = 1, npa do
      local par = pars[c]
      for d = 1, nst do
        local nstop = stops[d]
        local r = sdec.ua_run(rd, n, T, nbits, par, nstop, inv)
        if r.ngood >= 1 then
          local sc = sdec.ua_score(r)
          na = na + 1
          alts[na] = {sc = sc, nbits = nbits, par = par, nstop = nstop}
          if best == nil or sc > best.score + sdec.ua_margin(best.score, nbits) then
            r.score  = sc
            r.nbits  = nbits
            r.par    = par
            r.nstop  = nstop
            r.invert = inv
            best = r
          end
        end
      end
    end
  end

  if best ~= nil then best.alts, best.nalts = alts, na end
  return best
end

-- Try both polarities and keep the better. Returns the result table with nbits/par/nstop/invert/score
-- filled in, or nil.
function sdec.ua_autoformat(rd, n, T)
  sdec.fmt_note = nil
  sdec.polwhy = nil

  if sdec.force_invert ~= nil then
    return sdec.ua_search_pol(rd, n, T, sdec.force_invert)
  end

  local first, second
  if sdec.idle == 0 then first, second = true, false else first, second = false, true end

  local ra = sdec.ua_search_pol(rd, n, T, first)
  local rb = sdec.ua_search_pol(rd, n, T, second)
  local best, why = sdec.ua_pick_pol(ra, rb, sdec.idle_weak)
  sdec.polwhy = why
  return best
end

sdec.plaustol = 0.02

-- Is this bit time inside the samples-per-bit range the instrument can carry?
function sdec.ua_plausible(T, n)
  if T == nil then return false end
  if T < sdec.minsabit * (1 - sdec.plaustol) then return false end
  if T > n / 8 then return false end               -- no room for even one frame
  if sdec.wmed ~= nil and sdec.wmed > 0 and T > 1.15 * sdec.wmed then return false end
  local fs = sdec.acq_fs or sdec.fs
  local b = fs / T
  return b >= sdec.minbaud * (1 - sdec.plaustol)
     and b <= sdec.maxbaud * (1 + sdec.plaustol)
end

sdec.submult_minpulses = sdec.submult_minpulses or 20
sdec.submult_oddfrac   = sdec.submult_oddfrac   or 0.10

-- Is this candidate bit time a sub-multiple of the one that generated the pulses? The mirror of
-- ua_plausible's too-long test, and a prior on real traffic rather than a structural proof. Gates
-- candidates only, never the fit. docs/MEASUREMENTS.md, 'ua_submultiple: the odd-multiple test'.
function sdec.ua_submultiple(T)
  if T == nil or T <= 0 then return false end
  local nw = sdec.nw or 0
  if nw < sdec.submult_minpulses then return false end
  local odd, seen = 0, 0
  local i
  for i = 1, nw do
    local k = math.floor(sdec.w[i] / T + 0.5)
    if k >= 1 and k <= sdec.maxmult then
      seen = seen + 1
      if math.mod(k, 2) == 1 then odd = odd + 1 end
    end
  end
  if seen < sdec.submult_minpulses then return false end
  return odd < sdec.submult_oddfrac * seen
end

sdec.ua_submult_minsc = sdec.ua_submult_minsc or 15

sdec.submult_maxrunlo = sdec.submult_maxrunlo or 2.5

-- Does this candidate claim the shortest pulse on the wire is several bit times long? Covers the odd
-- divisors ua_submultiple cannot, on the 5th percentile rather than the minimum, and gates candidates
-- only, never the fit. Armed by ua_fit_mults below rather than by snap1 alone, which left every odd
-- multiple admitted on a non-standard commanded rate. docs/MEASUREMENTS.md, 'submult_maxrunlo = 2.5'.
function sdec.ua_minrun_absurd(T)
  if T == nil or T <= 0 then return false end
  if (sdec.nw or 0) < sdec.submult_minpulses then return false end
  local lo = sdec.wshort
  if lo == nil or lo <= 0 then return false end
  return lo / T > sdec.submult_maxrunlo
end

sdec.ua_submult_minmults = sdec.ua_submult_minmults or 4

-- How many separate pulse multiples the fit explains, bounded by maxmult. A fit that accounts for the
--   [...]
-- reachable only as a 1/k rescaling. A fit seeing several distinct multiples is doing real work on
-- real traffic, and there it is the sub-multiple candidate that should be doubted.
-- docs/MEASUREMENTS.md, 'Arming the sub-multiple gates'.
function sdec.ua_fit_mults(T)
  if T == nil or T <= 0 then return 0 end
  local seen, n = {}, 0
  local i
  for i = 1, (sdec.nw or 0) do
    local k = math.floor(sdec.w[i] / T + 0.5)
    if k >= 1 and k <= sdec.maxmult and seen[k] == nil then
      seen[k] = true
      n = n + 1
    end
  end
  return n
end

-- Whether the fit is consistent with the pulse-width distribution it came from, which separates "the
-- line is faster than this instrument" from "impulse noise captured the fit".
-- docs/MEASUREMENTS.md, 'ua_fit_corrupt: med/Tfit separates two faults'.
function sdec.ua_fit_corrupt(Tfit)
  local med = sdec.wmed
  if med == nil or med <= 0 or Tfit == nil or Tfit <= 0 then return true end
  return med > 2.5 * Tfit
end

-- Why no bit time was usable, in the operator's terms: "too fast for this sample rate" and "nothing
-- resembling a frame" call for different actions. Every limit named here is the one ua_plausible
-- refused with, constant for constant, or the sentence blames a limit that did not fire.
function sdec.ua_implausible_why(T)
  if T == nil or T <= 0 then return 'no bit timing' end
  local fs = sdec.acq_fs or sdec.fs
  if fs == nil or fs <= 0 then return 'no sample rate' end
  local b = fs / T
  if b > sdec.maxbaud * (1 + sdec.plaustol) then
    return string.format('%.0f baud is past the %d kBd ceiling', b or 0, sdec.maxbaud / 1000)
  end
  if T < sdec.minsabit * (1 - sdec.plaustol) then
    return string.format('%.1f samples/bit -- %.0f baud needs a faster capture than %.0f kSa/s',
                         T or 0, b or 0, fs / 1000)
  end
  if b < sdec.minbaud * (1 - sdec.plaustol) then
    return string.format('%.0f baud is below the %d baud floor', b or 0, sdec.minbaud or 0)
  end
  return string.format('no frame fits a %.1f sample bit time', T or 0)
end

-- Bit times worth scoring: the fit rescaled by sdec.ratios, plus median-derived candidates for the
-- failure mode the ladder cannot cover. docs/MEASUREMENTS.md, 'Why ua_cands adds median-derived
-- candidates'.
function sdec.ua_cands(Tfit)
  local c, m = {}, 0
  local i
  local nr = table.getn(sdec.ratios)
  for i = 1, nr do
    m = m + 1
    c[m] = {T = Tfit * sdec.ratios[i], r = sdec.ratios[i]}
  end
  local med = sdec.wmed
  if med ~= nil and med > 0 and Tfit ~= nil and Tfit > 0 then
    local k
    for k = 1, 6 do
      local T = med / k
      if T < 0.97 * Tfit or T > 1.03 * Tfit then
        m = m + 1
        c[m] = {T = T, r = T / Tfit}
      end
    end
  end
  return c, m
end

sdec.ua_probe_n = sdec.ua_probe_n or 4000

sdec.ua_alt_margin = sdec.ua_alt_margin or 3
sdec.ua_alt_badfrac = sdec.ua_alt_badfrac or 0.1

sdec.ua_tie_margin = sdec.ua_tie_margin or 1

sdec.ua_textmin  = sdec.ua_textmin  or 16      -- letters, absolute
sdec.ua_textfrac = sdec.ua_textfrac or 0.25    -- share of good frames; chance alone reaches 0.242

-- Best score any probe format reaches at one candidate bit time, or nil if none frames.
function sdec.ua_probe(rd, n, T)
  local cap = sdec.ua_probe_n
  if cap ~= nil and cap > 0 then
    local n0 = 1
    if sdec.ne ~= nil and sdec.ne >= 1 and sdec.ei ~= nil and sdec.ei[1] ~= nil then
      n0 = sdec.ei[1]
    end
    if n - n0 > cap then n = n0 + cap end
  end
  local npn = table.getn(sdec.probe_nbits)
  local npa = table.getn(sdec.try_par)
  local sc, scbad, scgood = nil, nil, nil
  local snb, spar, sinv = nil, nil, nil
  local j, c, k
  for j = 1, npn do
    for c = 1, npa do
      for k = 0, 1 do
        local r = sdec.ua_run(rd, n, T, sdec.probe_nbits[j], sdec.try_par[c], 1, (k == 1))
        if r.ngood >= 1 then
          local s = sdec.ua_score(r)
          if sc == nil or s > sc then
            sc, scbad, scgood = s, r.nbad, r.ngood
            snb, spar, sinv = sdec.probe_nbits[j], sdec.try_par[c], (k == 1)
          end
        end
      end
    end
  end
  return sc, scbad, scgood, snb, spar, sinv
end

-- Returns bittime, ratio. The width fit is trusted whenever it snaps to a standard rate and frames
--   [...]
--   ua_best_probe  scores one candidate -- the expensive unit
--   ua_best_end    the decision logic over whatever the probes found
-- `st` holds what the three share: one table, the 200-active-locals ceiling being real here.
function sdec.ua_best_begin(rd, n, Tfit)
  local fs = sdec.acq_fs or sdec.fs
  sdec.baud_note = nil

  local _, snap1 = sdec.sig_snap(fs / Tfit)

  local mayrescale = sdec.ua_plausible(Tfit, n) or sdec.ua_fit_corrupt(Tfit)

  local cands, nc = sdec.ua_cands(Tfit)
  local i

  local qbest = 0
  for i = 1, nc do
    if sdec.ua_plausible(cands[i].T, n) then
      local _, q = sdec.sig_fit(sdec.w, sdec.nw, cands[i].T)
      cands[i].q = q or 0
      if cands[i].q > qbest then qbest = cands[i].q end
    end
  end
  local qmin = sdec.qgate * qbest

  local sc1, q1, bad1, good1 = nil, nil, nil, nil
  local fnb, fpar, finv = nil, nil, nil
  local adm = false
  if sdec.ua_plausible(Tfit, n) then
    local _, qq = sdec.sig_fit(sdec.w, sdec.nw, Tfit)
    q1 = qq or 0
    if q1 >= qmin then
      adm = true
      sc1, bad1, good1, fnb, fpar, finv = sdec.ua_probe(rd, n, Tfit)
    end
  end

  local armrun = snap1 or sdec.ua_fit_mults(Tfit) >= sdec.ua_submult_minmults
  local armsub = armrun or (sc1 or 0) >= sdec.ua_submult_minsc

  return {rd = rd, n = n, Tfit = Tfit, fs = fs, snap1 = snap1,
          mayrescale = mayrescale, cands = cands, nc = nc, qmin = qmin,
          sc1 = sc1, bad1 = bad1, good1 = good1, adm = adm,
          armsub = armsub, armrun = armrun,
          fnb = fnb, fpar = fpar, finv = finv,
          i = 0, altT = nil, altsc = nil, altr = nil}
end

-- Score the next candidate; false once every candidate has been scored. One call is one slice, and
-- the caller decides how many to run before handing the panel back.
function sdec.ua_best_probe(st)
  if st == nil or st.i >= st.nc then return false end
  st.i = st.i + 1
  local i = st.i
  local T, ratio, q = st.cands[i].T, st.cands[i].r, st.cands[i].q
  if st.mayrescale and ratio ~= 1 and q ~= nil and q >= st.qmin
     and sdec.ua_plausible(T, st.n)
     and not (st.armsub and sdec.ua_submultiple(T))
     and not (st.armrun and sdec.ua_minrun_absurd(T)) then
    local _, snapped = sdec.sig_snap(st.fs / T)
    if snapped then
      local sc, _, _, anb, apar, ainv = sdec.ua_probe(st.rd, st.n, T)
      if sc ~= nil and (st.altsc == nil or sc > st.altsc) then
        st.altT, st.altsc, st.altr = T, sc, ratio
        st.anb, st.apar, st.ainv = anb, apar, ainv
      end
    end
  end
  return true
end

-- How many candidates there are, for a "searching 3/12" status row.
function sdec.ua_best_progress(st)
  if st == nil then return 0, 0 end
  return st.i, st.nc
end

-- Text a bit time yields over the whole capture, for the format ua_probe already ranked best.
-- ua_probe reads sdec.ua_probe_n samples, which at 8 samples a bit is ~47 bytes -- too few to see
-- text in a capture whose head is padding. One run, not the 18-way search again.
function sdec.ua_textat(rd, n, T, nb, par, inv)
  if T == nil or nb == nil then return 0, 0 end
  return sdec.ua_textn(sdec.ua_run(rd, n, T, nb, par, 1, inv))
end

-- Decide between the width fit and the best rescaling, and report an ambiguity if there is one.
function sdec.ua_best_end(st)
  local rd, n, Tfit, fs = st.rd, st.n, st.Tfit, st.fs
  local snap1, sc1 = st.snap1, st.sc1
  local altT, altsc, altr = st.altT, st.altsc, st.altr
  local bad1, good1 = st.bad1, st.good1

  if snap1 and sc1 ~= nil and sc1 > 0 then
    if altsc ~= nil and altsc > sc1 then
      local ab = sdec.sig_snap(fs / altT)
      local failing = bad1 ~= nil and good1 ~= nil and good1 > 0 and
                      bad1 >= (sdec.ua_alt_badfrac or 0.1) * (good1 + bad1)
      if failing and altsc >= (sdec.ua_alt_margin or 3) * sc1 then
        sdec.baud_note = string.format(
          '%s baud fits far better than %s (score %d vs %d, %d framing error(s))',
          tostring(ab), tostring((sdec.sig_snap(fs / Tfit))), altsc or 0, sc1 or 0, bad1 or 0)
        return altT, altr
      end
      sdec.baud_note = string.format('%s baud also fits this waveform (score %d vs %d)',
                                     tostring(ab), altsc or 0, sc1 or 0)
    end
    return Tfit, 1
  end

  if altT == nil then
    if not st.adm then
      return nil, 1, sdec.ua_implausible_why(Tfit)
    end
    return Tfit, 1
  end
  if snap1 and sc1 ~= nil and altsc ~= nil and altsc <= 0 then return Tfit, 1 end
  if sc1 ~= nil and altsc ~= nil and altsc <= sc1 then return Tfit, 1 end
  if sc1 ~= nil and altsc ~= nil and (altsc - sc1) <= sdec.ua_tie_margin then
    if sdec.tick ~= nil then sdec.tick() end
    local t1, g1 = sdec.ua_textat(rd, n, Tfit, st.fnb, st.fpar, st.finv)
    local t2 = sdec.ua_textat(rd, n, altT, st.anb, st.apar, st.ainv)
    if t1 > t2 and t1 >= sdec.ua_textmin and t1 >= sdec.ua_textfrac * g1 then
      sdec.baud_note = string.format('%s baud fits as well and decodes less text (%d vs %d letters)',
                                     tostring((sdec.sig_snap(fs / altT))), t2, t1)
      return Tfit, 1
    end
  end
  return altT, altr
end

-- The unchunked form. Every current caller uses this; the stepper exists for the panel.
function sdec.ua_best(rd, n, Tfit)
  local st = sdec.ua_best_begin(rd, n, Tfit)
  while sdec.ua_best_probe(st) do
    if sdec.tick ~= nil then sdec.tick() end
  end
  return sdec.ua_best_end(st)
end

-- Collapse data bits that are 1 in every frame into the stop bit. Only an always-one bit qualifies,
-- and the collapse is reported rather than silent, 7 data bits plus mark parity genuinely putting a
-- constant 1 there. Guards match ua_refine_parity: >= 6 good frames and >= 3 distinct values in the
-- bits kept. docs/MEASUREMENTS.md, 'Collapsing an always-one top data bit'.
function sdec.ua_refine_width(r, rd, n, T)
  if r == nil or r.par ~= sdec.PAR_NONE then return r end
  if sdec.force_nbits ~= nil then return r end
  if r.ngood < 6 then return r end
  local mod = math.mod
  local want, dropped = r.nbits, 0
  local floorw = 5
  if not sdec.widths_any then floorw = 7 end

  while want > floorw do
    local top  = 2 ^ (want - 1)
    local span = 2 ^ want
    local allone, seen, ndist = true, {}, 0
    local i
    for i = 1, r.nf do
      if r.errs[i] == nil then
        local v = r.vals[i]
        if v == nil then allone = false; break end
        local eff = mod(v, span)
        if eff < top then allone = false; break end
        local low = mod(eff, top)
        if seen[low] == nil then seen[low] = true; ndist = ndist + 1 end
      end
    end
    if not allone or ndist < 3 then break end
    want = want - 1
    dropped = dropped + 1
  end

  local blocked = nil
  if want == floorw and floorw > 5 and r.ngood >= 6 then
    local top, span = 2 ^ (want - 1), 2 ^ want
    local allone, i = true, nil
    for i = 1, r.nf do
      if r.errs[i] == nil then
        local v = r.vals[i]
        if v == nil or mod(v, span) < top then allone = false; break end
      end
    end
    if allone then
      blocked = string.format('bit %d was 1 in every frame -- this may be %dN%d; set Data Bits to "Auto (any width)"',
                              want - 1, want - 1, r.nstop or 0)
    end
  end

  if dropped < 1 then
    if blocked ~= nil then sdec.fmt_note = blocked end
    return r
  end

  local r2 = sdec.ua_run(rd, n, T, want, r.par, r.nstop, r.invert)
  if r2 == nil or r2.ngood < r.ngood then return r end
  r2.score  = sdec.ua_score(r2)
  r2.nbits  = want
  r2.par    = r.par
  r2.nstop  = r.nstop
  r2.invert = r.invert
  r2.alts, r2.nalts = r.alts, r.nalts
  sdec.fmt_note = string.format('%s also fits; chose %s (the top %d data bit(s) were 1 in every frame)',
                                tostring(sdec.ua_fmt_name(r.nbits, r.par, r.nstop)),
                                tostring(sdec.ua_fmt_name(want, r.par, r.nstop)), dropped or 0)
  if blocked ~= nil then sdec.fmt_note = sdec.fmt_note .. '; ' .. blocked end
  return r2
end

sdec.par_skiphead = sdec.par_skiphead or 3
sdec.par_skiptail = sdec.par_skiptail or 1
sdec.par_minfrac      = sdec.par_minfrac      or 0.95
sdec.par_minvote_all  = sdec.par_minvote_all  or 6
sdec.par_minvote_frac = sdec.par_minvote_frac or 20
sdec.par_minboth = sdec.par_minboth or 2

-- Votes required in each bit-7 state, which stops a restricted alphabet faking parity.
-- docs/MEASUREMENTS.md, 'par_minboth: both bit-7 states, or it is not evidence of parity'.
function sdec.ua_refine_parity(r, rd, n, T)
  if r == nil then return r end
  if sdec.force_par ~= nil then return r end
  if r.nbits ~= 8 or r.par ~= sdec.PAR_NONE then return r end
  if r.ngood < 6 then return r end

  local i0 = sdec.par_skiphead + 1
  local i1 = r.nf - sdec.par_skiptail
  if r.headsusp ~= nil and r.headsusp + 1 > i0 then
    local hs = r.headsusp + 1
    if i1 - hs + 1 >= sdec.par_minvote_all then
      i0 = hs
    else
      local hb = sdec.ua_head_bad(r) + 1
      if hb > i0 then i0 = hb end
    end
  end

  local mod = math.mod
  local nev, nod, nvote = 0, 0, 0
  local seen, ndist = {}, 0
  local ntop0, ntop1 = 0, 0
  local i
  for i = i0, i1 do
    if r.errs[i] == nil then
      nvote = nvote + 1
      local v = r.vals[i]
      local top = 0
      if v >= 128 then top = 1 end
      if top == 1 then ntop1 = ntop1 + 1 else ntop0 = ntop0 + 1 end
      local low = mod(v, 128)
      if seen[low] == nil then seen[low] = true; ndist = ndist + 1 end
      local pe = mod(sdec.ua_popcount(low), 2)
      if top == pe then nev = nev + 1 end
      if top == 1 - pe then nod = nod + 1 end
    end
  end

  if ndist < 3 then return r end
  if nvote < sdec.par_minvote_all then return r end
  if ntop0 < sdec.par_minboth or ntop1 < sdec.par_minboth then return r end

  local need = sdec.par_minfrac * nvote
  if nvote < sdec.par_minvote_frac then need = nvote end
  local par, pname, nagree = nil, nil, 0
  if nev >= need and nev >= nod then
    par, pname, nagree = sdec.PAR_EVEN, 'even', nev
  elseif nod >= need then
    par, pname, nagree = sdec.PAR_ODD, 'odd', nod
  end
  if par == nil then return r end

  local strict = (nagree == nvote)
  local note = string.format(
      '8N1 also fits; chose 7%s1 (bit 7 tracked %s parity in %d of %d frames)',
      tostring(string.upper(string.sub(pname, 1, 1))), tostring(pname), nagree or 0, nvote or 0)

  if not strict then
    if rd == nil or n == nil or T == nil then return r end
    local r2 = sdec.ua_run(rd, n, T, 7, par, r.nstop, r.invert)
    if r2 == nil then return r end
    r2.score = sdec.ua_score(r2)
    if r.headsusp ~= nil and (r2.headsusp == nil or r.headsusp > r2.headsusp) then
      r2.headsusp = r.headsusp
    end
    r2.nbits, r2.par, r2.nstop, r2.invert = 7, par, r.nstop, r.invert
    sdec.fmt_note = note
    return r2
  end

  for i = 1, r.nf do
    local v = r.vals[i]
    if v ~= nil then r.vals[i] = mod(v, 128) end
  end
  r.nbits = 7
  r.par   = par
  sdec.fmt_note = note
  return r
end

sdec.ua_stop_tol   = sdec.ua_stop_tol   or 0.25   -- bits either side of 0 or 1 to count a pair
sdec.ua_stop_min   = sdec.ua_stop_min   or 20     -- clean adjacent pairs before any verdict
sdec.ua_stop_frac  = sdec.ua_stop_frac  or 0.8    -- share of them that must agree

-- -> 1, 2, or nil when the capture cannot say. Reads the result only; decodes nothing.
function sdec.ua_stopseen(r, T)
  if r == nil or T == nil or T <= 0 then return nil end
  if r.tpos == nil or r.nf == nil or r.nf < 3 then return nil end
  if r.nbits == nil then return nil end
  local parbits = 0
  if r.par ~= nil and r.par ~= sdec.PAR_NONE then parbits = 1 end
  local used = 1 + r.nbits + parbits + 1
  local n1, n2, i = 0, 0, nil
  for i = 1, r.nf - 1 do
    if r.errs[i] == nil and r.errs[i + 1] == nil
       and r.tpos[i] ~= nil and r.tpos[i + 1] ~= nil then
      local extra = (r.tpos[i + 1] - r.tpos[i]) / T - used
      if extra > -sdec.ua_stop_tol and extra < sdec.ua_stop_tol then
        n1 = n1 + 1
      elseif extra > 1 - sdec.ua_stop_tol and extra < 1 + sdec.ua_stop_tol then
        n2 = n2 + 1
      end
    end
  end
  local tot = n1 + n2
  if tot < sdec.ua_stop_min then return nil end
  if n2 >= tot * sdec.ua_stop_frac then return 2 end
  if n1 >= tot * sdec.ua_stop_frac then return 1 end
  return nil
end

sdec.msb_textmin  = sdec.msb_textmin  or 8     -- letters MSB must find before it may win
sdec.msb_margin   = sdec.msb_margin   or 2.0   -- and the multiple of LSB's count it must clear
sdec.msb_distinct = sdec.msb_distinct or 4     -- and how many DIFFERENT letters, so a mirror cannot

-- Letters in a result, and how many distinct values among them. The second is what makes a repeated
-- byte fail the text test it would otherwise pass outright.
function sdec.ua_textdistinct(r)
  if r == nil or r.vals == nil or r.errs == nil then return 0, 0 end
  local seen, nd, nc, i = {}, 0, 0, nil
  for i = 1, r.nf do
    if r.errs[i] == nil then
      local v = r.vals[i]
      if v ~= nil and ((v >= 48 and v <= 57) or (v >= 65 and v <= 90)
                       or (v >= 97 and v <= 122)) then
        nc = nc + 1
        if seen[v] == nil then seen[v] = true; nd = nd + 1 end
      end
    end
  end
  return nc, nd
end

function sdec.ua_refine_bitorder(r, rd, n, T)
  if r == nil then return r end
  if sdec.force_msb ~= nil then
    sdec.msb_used = (sdec.force_msb == true)
    return r
  end
  sdec.msb_used = false
  if rd == nil or n == nil or T == nil then return r end
  if r.nbits == nil or r.nbits < 2 then return r end
  local clsb = sdec.ua_textn(r)
  local r2 = sdec.ua_run(rd, n, T, r.nbits, r.par, r.nstop, r.invert, nil, true)
  if r2 == nil then return r end
  local cmsb, dmsb = sdec.ua_textdistinct(r2)
  if cmsb < sdec.msb_textmin then return r end
  if dmsb < sdec.msb_distinct then return r end
  if cmsb < clsb * sdec.msb_margin then return r end
  if cmsb - clsb < sdec.msb_textmin then return r end
  r2.score = sdec.ua_score(r2)
  if r.headsusp ~= nil and (r2.headsusp == nil or r.headsusp > r2.headsusp) then
    r2.headsusp = r.headsusp
  end
  r2.nbits, r2.par, r2.nstop, r2.invert = r.nbits, r.par, r.nstop, r.invert
  r2.msb = true
  sdec.msb_used = true
  sdec.bitorder_note = string.format(
      'MSB first (%d text bytes against %d decoding LSB first)', cmsb or 0, clsb or 0)
  return r2
end

-- ua_refine_parity: docs/MEASUREMENTS.md, 'ua_alts must run before ua_refine_parity'.
function sdec.ua_alts(r)
  local names, m = {}, 0
  if r == nil or r.alts == nil then return names, 0 end
  if (r.ngood or 0) < sdec.alt_minframes then return names, 0 end
  local lim = r.score - sdec.ua_margin(r.score)
  local i
  for i = 1, r.nalts do
    local a = r.alts[i]
    if a.sc >= lim and not (a.nbits == r.nbits and a.par == r.par) then
      m = m + 1
      if m <= 3 then names[m] = sdec.ua_fmt_name(a.nbits, a.par, a.nstop) end
    end
  end
  return names, m
end

-- Fold the alternatives into sdec.fmt_note, keeping whatever ua_refine_parity put there. Candidates
-- naming the chosen format are dropped: after a 7E1 reclassification the list still holds that 7E1.
function sdec.ua_note_fmt(r, names, m)
  if m == nil or m < 1 then return end
  local now = sdec.ua_fmt_name(r.nbits, r.par, r.nstop)
  local keep, k = {}, 0
  local i
  for i = 1, math.min(m, 3) do
    if names[i] ~= now then k = k + 1; keep[k] = names[i] end
  end
  if k < 1 then return end
  local s = 'also fits: ' .. table.concat(keep, ' ', 1, k)
  if sdec.fmt_note == nil then sdec.fmt_note = s
  else sdec.fmt_note = sdec.fmt_note .. '; ' .. s end
end

-- Decode an arbitrary sample array. serial_core's sig_levels / sig_edges / sig_idle must have run
-- over the same array first. Returns ok, reason.
function sdec.decode_from(rd, n)
  sdec.res, sdec.fmt_note, sdec.baud_note = nil, nil, nil
  sdec.bitorder_note, sdec.msb_used = nil, nil
  sdec.baud_probe = nil                 -- set only by giveup(), and only for THIS call
  if rd == nil or n == nil or n < 2 then return false, 'nothing captured' end
  local fs = sdec.acq_fs or sdec.fs

  -- A failure past the bit-time stage must retract the bit time: a rate that frames nothing is noise.
  local function giveup(why)
    sdec.baud_probe = sdec.baud
    sdec.baud, sdec.baud_raw, sdec.bittime = nil, nil, nil
    sdec.snapped, sdec.fitq, sdec.snapfirm = false, 0, true
    return false, why
  end

  local T
  if sdec.force_baud ~= nil then
    T = fs / sdec.force_baud
    if T < sdec.minsabit * (1 - sdec.plaustol) then
      return giveup(sdec.ua_implausible_why(T))
    end
    sdec.bittime, sdec.fitratio, sdec.fitq = T, 1, 1
  sdec.baud, sdec.baud_raw, sdec.snapped, sdec.snapfirm = sdec.force_baud, sdec.force_baud, true, true

    sdec.rate_note = nil
    local keepT, keepR, keepQ = sdec.bittime, sdec.fitratio, sdec.fitq
    local keepB, keepRaw, keepSnap = sdec.baud, sdec.baud_raw, sdec.snapped
    local keepFirm = sdec.snapfirm
    local function ratenote()
      local Tm = sdec.sig_bittime()
      if Tm == nil or Tm <= 0 then return end
      local ratio = Tm / T
      local near = nil
      local k
      for k = 1, 6 do
        if math.abs(ratio * k - 1) < 0.12 then near = k end
        if math.abs(ratio / k - 1) < 0.12 then near = k end
      end
      if near ~= nil and near > 1 then
        local other = sdec.force_baud * near
        if ratio > 1 then other = sdec.force_baud / near end
        sdec.rate_note = string.format(
          'WARNING: bytes may be WRONG if the device runs at %.0f baud, %dx the %g you set',
          other, near, sdec.force_baud)
        return
      end
      local err = ratio - 1
      if math.abs(err) > (sdec.ratemargin or 0.04) then
        local meas = fs / Tm
        sdec.rate_note = string.format(
          'WARNING: bytes may be WRONG -- wire is %.0f baud, not the %g you set (%+.0f %%)',
          meas, sdec.force_baud, err * 100)
      end
    end
    ratenote()
    sdec.bittime, sdec.fitratio, sdec.fitq = keepT, keepR, keepQ
    sdec.baud, sdec.baud_raw, sdec.snapped = keepB, keepRaw, keepSnap
    sdec.snapfirm = keepFirm
  else
    local Tfit, why = sdec.sig_bittime()
    if Tfit == nil then return giveup(why or 'no bit timing') end
    local ratio, badwhy
    T, ratio, badwhy = sdec.ua_best(rd, n, Tfit)
    if T == nil then return giveup(badwhy or 'no usable bit time') end
    local _, q = sdec.sig_fit(sdec.w, sdec.nw, T)
    sdec.fitq = q or 0
    sdec.bittime  = T
    sdec.fitratio = ratio
    sdec.baud_raw = fs / T
    sdec.baud, sdec.snapped, sdec.snapfirm = sdec.sig_snap(sdec.baud_raw)
  end
  if T == nil or T <= 0 then return giveup('no bit timing') end

  local r
  if sdec.force_nbits ~= nil then
    local par = sdec.force_par or sdec.PAR_NONE
    local nstop = sdec.force_nstop or 1
    if sdec.force_invert ~= nil then
      r = sdec.ua_run_fmt(rd, n, T, sdec.force_nbits, par, nstop, sdec.force_invert)
      sdec.polwhy = nil
    else
      local prior = (sdec.idle == 0)
      local why
      r, why = sdec.ua_pick_pol(sdec.ua_run_fmt(rd, n, T, sdec.force_nbits, par, nstop, prior),
                                sdec.ua_run_fmt(rd, n, T, sdec.force_nbits, par, nstop, not prior),
                                sdec.idle_weak)
      sdec.polwhy = why
    end
    if r.nf == 0 then return giveup('the forced format found no frames') end
  else
    r = sdec.ua_autoformat(rd, n, T)
    if r == nil then return giveup('no frame format fits the capture') end
    local anames, na = sdec.ua_alts(r)
    r = sdec.ua_refine_width(r, rd, n, T)
    r = sdec.ua_refine_parity(r, rd, n, T)
    r = sdec.ua_refine_bitorder(r, rd, n, T)
    if r ~= nil then r.nstop_seen = sdec.ua_stopseen(r, T) end
    sdec.ua_note_fmt(r, anames, na)
  end

  sdec.res = r
  if r.invert then sdec.idle = 0 else sdec.idle = 1 end
  return true
end

sdec.relock_badfrac   = 0.25     -- interior frames in error before the lock is doubted
sdec.relock_minframes = 8        -- fewer frames than this and a bad fraction is not evidence

sdec.force_conflict = sdec.force_conflict or 'adopt'

-- Fraction of interior frames that failed, or nil when there are too few to judge. Interior, because
-- head resync and a clipped tail fail on healthy captures too.
function sdec.ua_badfrac(r)
  if r == nil or (r.nf or 0) < 1 then return nil end
  local ninter = r.nf - sdec.ua_edge_frames - 1
  if ninter < 1 then return nil end
  local nin = sdec.ua_bad_interior(r)
  return nin / ninter
end

-- Runs the whole chain on an already-acquired capture. serial_core.acquire() leaves the levels, edges
-- and idle level in place; this adds bit timing, format and bytes. Returns ok, reason.
function sdec.decode()
  if sdec.smp == nil then return false, 'nothing captured' end
  local ok, why = sdec.decode_from(sdec.smp, sdec.nread)

  if sdec.force_baud == nil or sdec.rate_note == nil then return ok, why end

  if sdec.proto ~= nil and sdec.proto ~= 'uart' then return ok, why end
  local bf = sdec.ua_badfrac(sdec.res)
  if bf == nil or bf < sdec.relock_badfrac then return ok, why end
  if (sdec.res.nf or 0) < sdec.relock_minframes then return ok, why end

  local was, bf0 = sdec.force_baud, bf
  sdec.force_baud = nil
  sdec.rate_note = nil
  local ok2, why2 = sdec.decode_from(sdec.smp, sdec.nread)
  local bf2 = sdec.ua_badfrac(sdec.res)
  if ok2 and bf2 ~= nil and bf2 < sdec.relock_badfrac and sdec.baud ~= nil then
    local found = sdec.baud
    if sdec.force_conflict == 'adopt' then
      if sdec.snapfirm == false and sdec.baud_raw ~= nil then found = sdec.baud_raw end
      local adopt = sdec.baud_round(found)
      sdec.force_baud = adopt
      sdec.baud, sdec.snapped, sdec.snapfirm = adopt, true, true
      sdec.relocked = string.format('%g baud fit nothing -- now locked to %.0f, which this capture reads',
                                    was or 0, adopt or 0)
      return ok2, why2
    end
    sdec.force_baud = was
    sdec.res = nil
    sdec.rate_offer, sdec.rate_offer_from = found, was
    sdec.rate_refused = string.format(
        '%g baud fits nothing -- this capture reads %.0f. Options > Baud 0 restores detection.',
        was or 0, found or 0)
    return false, string.format('%g baud fits nothing; this capture reads %.0f', was or 0, found or 0)
  end
  sdec.relocked = string.format('%g baud fits nothing, and no other rate fit either -- ' ..
                                'back to auto-detect', was or 0)
  sdec.rate_backoff = true
  sdec.force_baud = nil
  if sdec.autolock_set ~= nil then
    if sdec.autolock_set.nbits  then sdec.force_nbits  = nil end
    if sdec.autolock_set.par    then sdec.force_par    = nil end
    if sdec.autolock_set.nstop  then sdec.force_nstop  = nil end
    if sdec.autolock_set.invert then sdec.force_invert = nil end
    sdec.autolock_set = nil
  end
  return ok2, why2
end

-- Presentation
--   [...]
-- and parities and a bit-order letter on each would be noise. fmt_text() passes it, which is the one
-- place the operator reads the format actually in use: the FORMAT cell, the status notes and the
-- header of every message written to the key.
function sdec.ua_fmt_name(nbits, par, nstop, order)
  local p = 'N'
  if par == sdec.PAR_EVEN then p = 'E' end
  if par == sdec.PAR_ODD  then p = 'O' end
  local s = string.format('%d%s%d', nbits or 0, tostring(p), nstop or 0)
  if order ~= nil then s = s .. order end
  return s
end

-- Falls back to the forced format, so a streaming capture names the format it is decoding with: the
-- modes that produce a file have no sdec.res, and '--' is wrong for the two values the operator set.
function sdec.fmt_text()
  local r = sdec.res
  if r ~= nil then
    local o = nil
    if r.msb then o = 'M' end
    return sdec.ua_fmt_name(r.nbits, r.par, r.nstop_seen or r.nstop, o)
  end
  if sdec.force_nbits ~= nil then
    local o = nil
    if sdec.force_msb == true then o = 'M' end
    return sdec.ua_fmt_name(sdec.force_nbits, sdec.force_par or sdec.PAR_NONE,
                            sdec.force_nstop or 1, o)
  end
  return '--'
end

-- The baud rate as the panel shows it, falling back to a forced value.
function sdec.baud_text()
  if sdec.baud == nil and sdec.force_baud ~= nil then
    return string.format('%.0f baud', sdec.force_baud or 0)
  end
  if sdec.baud == nil then return '--' end
  if sdec.snapped and sdec.snapfirm ~= false then return string.format('%.0f baud', sdec.baud or 0) end
  return string.format('%.0f baud?', sdec.baud or 0)
end

-- One printable character per byte; '.' for control and high-bit values so the column grid never
-- shifts, '?' for a frame that failed its stop or parity bit.
function sdec.ua_char(v, err)
  if err ~= nil then return '?' end
  if v == nil then return ' ' end
  if v >= 32 and v <= 126 then return string.char(v) end
  return '.'
end

-- The three summary lines, split so each fits the width: what the protocol is, what the wire looks
-- like, and how well it went.
function sdec.summary(i)
  local r = sdec.res

  if i == 1 then
    if r == nil then return sdec.baud_text() end
    local idle = 'HIGH'
    if r.invert then idle = 'LOW' end
    return string.format('%s  %s  idle %s', tostring(sdec.baud_text()), tostring(sdec.fmt_text()), tostring(idle))
  end

  if i == 2 then
    if sdec.lo == nil then return 'no signal' end
    local spb = ''
    if sdec.bittime ~= nil then
      spb = string.format('  %.1f sa/bit', sdec.bittime or 0)
    end
    return string.format('%s  %.2f/%.2f V  thr %.2f V%s',
                         tostring(sdec.family), sdec.lo or 0, sdec.hi or 0, sdec.thr or 0, tostring(spb))
  end

  if i == 3 then
    if r == nil then return '0 bytes' end
    local fs = sdec.acq_fs or sdec.fs
    return string.format('%d bytes  %d err  fit %.2f  %.0f kS/s',
                         r.nf or 0, r.nbad or 0, sdec.fitq or 0, (fs or 0) / 1000)
  end

  return ''
end

-- A row of the ASCII view: ncol characters starting at byte i0 (1-based).
function sdec.ua_text_line(i0, ncol)
  local r = sdec.res
  if r == nil then return '' end
  local t, m = {}, 0
  local i
  for i = i0, i0 + ncol - 1 do
    if i > r.nf then break end
    m = m + 1
    t[m] = sdec.ua_char(r.vals[i], r.errs[i])
  end
  return table.concat(t)
end

sdec.ua_hexgroup = 8         -- bytes per group; 0 disables grouping
sdec.ua_hexgap   = 2         -- EXTRA spaces at a group boundary, on top of the normal one

-- Join formatted cells, widening the separator at each group boundary. `sep` is '' for the
-- file form, whose cells carry their own leading space, and ' ' for the screen form.
function sdec.ua_hexjoin(cells, m, sep)
  local grp = sdec.ua_hexgroup or 0
  local extra = sdec.ua_hexgap or 0
  local wide = sep .. string.rep(' ', extra)
  local out, k, i = {}, 0, 0
  for i = 1, m do
    if i > 1 then
      k = k + 1
      if grp > 0 and extra > 0 and math.mod(i - 1, grp) == 0 then out[k] = wide
      else out[k] = sep end
    end
    k = k + 1
    out[k] = cells[i]
  end
  return table.concat(out)
end

-- Width in characters of one hex group of `ncol` bytes: two chars each plus one separator between, so
-- the layout derives its columns. The gap between groups is layout (sdec.ui_col_gap2), not spaces.
function sdec.ua_hexwidth(ncol)
  local grp = sdec.ua_hexgroup or 0
  local extra = sdec.ua_hexgap or 0
  local w = ncol * 3 - 1                     -- 2 chars per byte + 1 separator between
  if grp > 0 and extra > 0 and ncol > 1 then
    w = w + extra * math.floor((ncol - 1) / grp)
  end
  return w
end

-- One hex+ASCII row as a single string, for a file or the debug log. Total for any vals content,
-- which is load-bearing rather than defensive, and a type test alone is not enough.
-- docs/MEASUREMENTS.md, 'ua_hexrow is total for any vals content'.
function sdec.ua_hexrow(vals, errs, nf, i0, ncol, base)
  if base == nil then base = 0 end
  local hx, as = {}, {}
  local i, m = 0, 0
  for i = i0, i0 + ncol - 1 do
    m = m + 1
    if i > nf then
      hx[m] = '   '
      as[m] = ' '
    else
      local v = vals[i]
      local bad = type(v) ~= 'number'
      if not bad then
        bad = v ~= v or v < 0 or v > 255 or math.floor(v) ~= v
      end
      if bad then
        hx[m] = ' --'
        as[m] = sdec.ua_char(nil, errs[i])
      else
        hx[m] = string.format(' %02X', v)
        as[m] = sdec.ua_char(v, errs[i])
      end
    end
  end
  return string.format('%04d %s  |%s|', base + i0 - 1, tostring(sdec.ua_hexjoin(hx, m, '')),
                       tostring(table.concat(as)))
end

-- The same row as separate pieces, for the on-screen dump's fixed-x text fields. Separate from
-- ua_hexrow rather than built on it: the file form keeps its '|ascii|' delimiters, and the screen
-- form drops them because vertical rule objects do that job at a fixed x.
function sdec.ua_hexparts(vals, errs, nf, i0, ncol, base)
  if base == nil then base = 0 end
  local hx, as = {}, {}
  local i, m = 0, 0
  for i = i0, i0 + ncol - 1 do
    m = m + 1
    if i > nf then
      hx[m] = '  '
      as[m] = ' '
    else
      local v = vals[i]
      if v == nil then hx[m] = '--' else hx[m] = string.format('%02X', v or 0) end
      as[m] = sdec.ua_char(v, errs[i])
    end
  end
  local half = math.floor(m / 2)
  local a, b, k = {}, {}, 0
  for k = 1, m do
    if k <= half then a[k] = hx[k] else b[k - half] = hx[k] end
  end
  return string.format('%04d', base + i0 - 1),
         table.concat(a, ' '), table.concat(b, ' '), table.concat(as)
end

-- The offset column is absolute, which for a frame capture is the same as relative and for a stream
-- tail is not: labelling a tail's first row 0000 makes the panel disagree with the file the same run
-- wrote. res.first is the tail's 1-based absolute start; a frame result has none, so the base is 0.
function sdec.ua_base(r)
  if r == nil or r.first == nil then return 0 end
  return r.first - 1
end

-- One row of the current result as four pieces, for the panel's four fixed columns.
function sdec.ua_hex_parts_line(i0, ncol)
  local r = sdec.res
  if r == nil or i0 > r.nf then return '', '', '', '' end
  return sdec.ua_hexparts(r.vals, r.errs, r.nf, i0, ncol, sdec.ua_base(r))
end

-- One row of the current result as a single string.
function sdec.ua_hex_line(i0, ncol)
  local r = sdec.res
  if r == nil or i0 > r.nf then return '' end
  return sdec.ua_hexrow(r.vals, r.errs, r.nf, i0, ncol, sdec.ua_base(r))
end


-- ================= tsp/chunk_decode.tsp =================
sdec = sdec or {}

sdec.ck_win_n = 20000

sdec.ck_ovframes = 3

sdec.ck_level_n = 20000

sdec.ck_probes = 8

sdec.ck_maxbytes = 32768

-- Over a plain Lua array: the test path, and the way to chunk a capture already in memory.
function sdec.ck_reader_table(rd, ntotal)
  return function(dst, from, count, step)
    if step == nil then step = 1 end
    local m = 0
    if step == 1 then
      local last = from + count - 1
      if last > ntotal then last = ntotal end
      local a
      for a = from, last do
        local v = rd[a]
        if v == nil then break end
        m = m + 1
        dst[m] = v
      end
      return m
    end
    local last = from + (count - 1) * step
    if last > ntotal then last = ntotal end
    local a
    for a = from, last, step do
      local v = rd[a]
      if v == nil then break end
      m = m + 1
      dst[m] = v
    end
    return m
  end
end

-- Over a reading buffer. buf.readings is a firmware proxy, so each index is an IPC round trip at
-- 21.73 us. docs/MEASUREMENTS.md, 'Reading a sample out of a reading buffer'.
function sdec.ck_reader_buffer(buf, ntotal)
  local rdp = buf.readings
  local off = 0
  if sdec.acq_first ~= nil then off = sdec.acq_first(buf, ntotal) - 1 end
  return function(dst, from, count, step)
    if step == nil then step = 1 end
    local m = 0
    if step == 1 then
      local last = from + count - 1
      if last > ntotal then last = ntotal end
      local a
      for a = from, last do
        local p = a + off
        if p > ntotal then p = p - ntotal end
        local v = rdp[p]
        if v == nil then break end
        m = m + 1
        dst[m] = v
      end
      return m
    end
    local last = from + (count - 1) * step
    if last > ntotal then last = ntotal end
    local a
    for a = from, last, step do
      local p = a + off
      if p > ntotal then p = p - ntotal end
      local v = rdp[p]
      if v == nil then break end
      m = m + 1
      dst[m] = v
    end
    return m
  end
end

-- Window geometry
-- How much the windows must overlap. Getting it wrong loses one byte per seam, and a byte lost
-- mid-file is hard to notice. The floor is one frame, framebits * T; the extra two frames and maxback
-- cover sig_cross's truncated back-walk. docs/MEASUREMENTS.md, 'Overlap'.
function sdec.ck_overlap(T, framebits)
  if T == nil or framebits == nil then return nil end
  return math.ceil(sdec.ck_ovframes * framebits * T) + sdec.maxback
end

-- Window size, overlap and stride for a bit time, or nil plus a reason. Refuses rather than clamps
-- when the window cannot hold enough frames: at 1200 baud with fs at 1 MSa/s, T is 833 samples and
-- three 12-bit frames do not fit, so the stride would go negative. The refusal names the sample rate.
function sdec.ck_geometry(T, framebits)
  local W = sdec.ck_win_n
  local ov = sdec.ck_overlap(T, framebits)
  if ov == nil then return nil, nil, nil, 'no bit time' end
  local need = math.ceil((sdec.ck_ovframes + 2) * framebits * T) + sdec.maxback
  if W < need then
    return nil, nil, nil,
           string.format('%.0f samples/frame needs a window of %d, not %d -- ' ..
                         'sample slower', framebits * T, need or 0, W or 0)
  end
  local stride = W - ov
  return W, ov, stride, nil
end

-- How many windows a capture takes at this stride. Exact, because the stride is constant, which buys
-- a window count known before the run starts. docs/MEASUREMENTS.md, 'Constant stride'.
function sdec.ck_nwin(ntotal, W, stride)
  if ntotal == nil or W == nil or stride == nil or stride < 1 then return nil end
  if ntotal <= W then return 1 end
  return 1 + math.ceil((ntotal - W) / stride)
end

-- Priming: measure the line once
--   [...]
-- docs/MEASUREMENTS.md, 'Levels are an amplitude statistic; edges are a time statistic'.
-- The decimated attempt alone, so priming can spend one press on it. Returns ok, why, fatal; fatal
-- means the source gave nothing, so the contiguous probes cannot help either.
function sdec.ck_levels_dec(reader, ntotal, win)
  if reader == nil then return false, 'no sample source', true end
  local N = sdec.ck_level_n
  if sdec.ck_level_max ~= nil and sdec.ck_level_max < N then N = sdec.ck_level_max end
  local step = 1
  if ntotal ~= nil and ntotal > N then step = math.ceil(ntotal / N) end
  local cnt = reader(win, 1, N, step)
  if cnt == nil or cnt < 2 then return false, 'nothing captured', true end
  local ok, why = sdec.sig_levels(win, cnt)
  if ok then sdec.ck_levelsrc = 'decimated' end
  return ok, why, false
end

-- One contiguous level probe, k = 0..ck_probes-1. Decimation can alias past a sparse burst, so the
-- fallback reads whole windows spaced across the recording; the decimated view is still tried first.
-- docs/MEASUREMENTS.md, 'Why the contiguous fallback is spaced across the recording'.
function sdec.ck_levels_probe(reader, ntotal, win, k)
  if reader == nil then return false end
  local W = sdec.ck_win_n
  if ntotal ~= nil and ntotal < W then W = ntotal end
  local nprobe = sdec.ck_probes or 1
  local total = ntotal or W
  local span = total - W
  if span < 0 then span = 0 end
  local from = 1
  if nprobe > 1 and span > 0 then
    from = 1 + math.floor(span * k / (nprobe - 1))
  end
  local c2 = reader(win, from, W, 1)
  if c2 == nil or c2 < 2 then return false end
  if not sdec.sig_levels(win, c2) then return false end
  sdec.ck_levelsrc, sdec.ck_levelat = 'contiguous', from
  return true
end

-- Levels for a whole recording: decimated first, then contiguous probes. Returns ok, reason.
function sdec.ck_levels(reader, ntotal, win)
  local ok, why, fatal = sdec.ck_levels_dec(reader, ntotal, win)
  if ok then return true end
  if fatal then return false, why end
  local k
  for k = 0, (sdec.ck_probes or 1) - 1 do
    if sdec.ck_levels_probe(reader, ntotal, win, k) then return true end
  end
  sdec.ck_levelsrc, sdec.ck_levelat = nil, nil
  return false, why
end

-- How many windows the format search may spend, from the silence an armed record opens with: the first
-- window can be entirely the pre-trigger wait, so a search that looks there and nowhere else refuses a
-- recording whose bytes are all present. leadmax is the caller's and cannot be derived from ntotal,
-- the reserve coming out of the buffer's capacity; nil means no reserve. docs/MEASUREMENTS.md, 'An
-- armed record opens on silence' and 'ck_prime_tries = floor(leadmax / W) + 2'.
function sdec.ck_prime_tries(leadmax)
  local W = sdec.ck_win_n
  if W == nil or W < 1 then return 1 end
  if leadmax == nil or leadmax < 0 then leadmax = 0 end
  return math.floor(leadmax / W) + 2
end

function sdec.ck_prime_new(reader, ntotal, win, leadmax)
  if reader == nil then return nil, 'no sample source' end
  return {reader = reader, ntotal = ntotal, win = win, phase = 'lvd', probe = 0,
          cnt = 0, at = 1, try = 1, tries = sdec.ck_prime_tries(leadmax),
          leadmax = leadmax,
          why = nil, label = 'levels'}, nil
end

-- One priming sub-operation. Returns done, fmt, err; fmt is set only on the last call.
function sdec.ck_prime_step(pr)
  if pr == nil then return true, nil, 'no priming state' end

  if pr.phase == 'lvd' then
    local ok, why, fatal = sdec.ck_levels_dec(pr.reader, pr.ntotal, pr.win)
    if ok then
      pr.phase, pr.label = 'read', 'reading'
      return false, nil, nil
    end
    if fatal then return true, nil, why end
    pr.why, pr.phase, pr.probe = why, 'lvp', 0
    pr.label = string.format('levels 1/%d', sdec.ck_probes or 1)
    return false, nil, nil
  end

  if pr.phase == 'lvp' then
    if sdec.ck_levels_probe(pr.reader, pr.ntotal, pr.win, pr.probe) then
      pr.phase, pr.label = 'read', 'reading'
      return false, nil, nil
    end
    pr.probe = pr.probe + 1
    if pr.probe >= (sdec.ck_probes or 1) then
      sdec.ck_levelsrc, sdec.ck_levelat = nil, nil
      return true, nil, pr.why or 'no clear logic levels'
    end
    pr.label = string.format('levels %d/%d', pr.probe + 1, sdec.ck_probes or 1)
    return false, nil, nil
  end

  if pr.phase == 'read' then
    local W = sdec.ck_win_n
    local left = nil
    if pr.ntotal ~= nil then left = pr.ntotal - pr.at + 1 end
    if left ~= nil and left < W then W = left end
    local cnt = nil
    if W >= 2 then cnt = pr.reader(pr.win, pr.at, W, 1) end
    if cnt == nil or cnt < 2 then return true, nil, pr.fmtwhy or 'nothing captured' end
    pr.cnt, pr.W, pr.phase, pr.label = cnt, W, 'edge', 'edges'
    return false, nil, nil
  end

  if pr.phase == 'edge' then
    sdec.sig_edges(pr.win, pr.cnt)
    sdec.acq_pretrig = (pr.leadmax ~= nil and pr.leadmax > 0)
    sdec.sig_idle(pr.win, pr.cnt)
    pr.phase, pr.label = 'fmt', 'format'
    return false, nil, nil
  end

  local ok, why = sdec.decode_from(pr.win, pr.cnt)
  local r = sdec.res
  if ok and (r == nil or sdec.bittime == nil) then ok, why = false, 'no format' end
  if not ok then
    local nxt = pr.at + pr.W
    if pr.try < (pr.tries or 1) and pr.ntotal ~= nil and nxt < pr.ntotal then
      pr.try, pr.at, pr.fmtwhy = pr.try + 1, nxt, why
      pr.phase = 'read'
      pr.label = string.format('format %d/%d', pr.try, pr.tries)
      return false, nil, nil
    end
    return true, nil, why
  end
  local parbits = 0
  if r.par ~= sdec.PAR_NONE then parbits = 1 end
  pr.phase, pr.label = 'done', nil
  return true, {T = sdec.bittime, nbits = r.nbits, par = r.par, nstop = r.nstop,
                invert = r.invert, framebits = 1 + r.nbits + parbits + r.nstop}, nil
end

-- The one-shot form: prime to completion in one call. Returns fmt, reason. The guard is a backstop on
-- the phase machine, not on the signal, so exceeding it is a coding fault. Derived rather than
-- constant: one sized for ck_bufmax's reserve is no backstop at the ck_win_min floor, where the same
-- reserve asks for an order of magnitude more tries. bufmax_for() can lower the cap at runtime.
function sdec.ck_prime(reader, ntotal, win, leadmax)
  local pr, perr = sdec.ck_prime_new(reader, ntotal, win, leadmax)
  if pr == nil then return nil, perr end
  local done, fmt, err, guard = false, nil, nil, 0
  local gmax = 4 + (sdec.ck_probes or 1) + 3 * (pr.tries or 1)
  while not done do
    done, fmt, err = sdec.ck_prime_step(pr)
    guard = guard + 1
    if guard > gmax then return nil, 'priming did not converge' end
  end
  if fmt == nil then return nil, err end
  return fmt, nil
end

sdec.ck_smp_us = 73               -- worst-phase cost per sample, microseconds, MEASURED at 4 sa/bit
sdec.ck_win_max = 20000           -- and never wider than this, whatever the budget allows
sdec.ck_win_min = 2000            -- nor narrower: below this the per-window seam overhead dominates
sdec.ck_win_ref = 20000           -- the width the phase timings above were taken at

sdec.ck_budget_frac = 0.9

sdec.ck_win_us = 48
sdec.ck_slice_n = 1

-- The widest window whose every phase fits `budget_s`; nil means the fixed maximum, no panel to protect.
function sdec.ck_win_for(budget_s)
  local wmax = sdec.ck_win_max or 20000
  if budget_s == nil or budget_s <= 0 then return wmax end
  local b = budget_s * (sdec.ck_budget_frac or 1)
  local w = math.floor(b / ((sdec.ck_smp_us or 52) * 1e-6))
  local wd = math.floor(b / ((sdec.ck_slice_n or 1) *
                             (sdec.ck_win_us or sdec.ck_smp_us or 52) * 1e-6))
  if wd < w then w = wd end
  if w > wmax then w = wmax end
  if w < (sdec.ck_win_min or 2000) then w = sdec.ck_win_min or 2000 end
  return w
end

-- How many windows fit in a latency budget, never fewer than one. per_us defaults to the worst phase.
function sdec.ck_slice_win(budget_s, W, per_us)
  if budget_s == nil or budget_s <= 0 then return nil end       -- nil = unlimited
  local per = (W or sdec.ck_win_ref or 20000) * ((per_us or sdec.ck_smp_us or 52) * 1e-6)
  if per <= 0 then return nil end
  local n = math.floor(budget_s / per)
  if n < 1 then n = 1 end
  return n
end

-- Walk a capture window by window, emitting bytes to a sink; resumable via opts.resume. Returns a
-- totals table, or nil plus a reason.
function sdec.ck_decode(reader, ntotal, fmt, sink, opts)
  if reader == nil then return nil, 'no sample source' end
  if fmt == nil or fmt.T == nil then return nil, 'no format' end
  if opts == nil then opts = {} end
  local win = opts.win
  if win == nil then return nil, 'no window table' end

  local T, framebits = fmt.T, fmt.framebits
  local W, ov, stride, why = sdec.ck_geometry(T, framebits)
  if W == nil then return nil, why end

  local maxbytes = opts.maxbytes
  if maxbytes == nil and not opts.nocap then maxbytes = sdec.ck_maxbytes end
  local progress = opts.progress
  local nwin = sdec.ck_nwin(ntotal, W, stride)

  local tot = {nf = 0, ngood = 0, nbad = 0, nfalse = 0, nwin = 0, nwin_est = nwin,
               nsmp = 0, stopped = nil, W = W, overlap = ov, stride = stride}

  local endpos = nil
  local off = 0                 -- absolute 0-based offset of the current window

  if opts.resume ~= nil then
    off = opts.resume.off or 0
    endpos = opts.resume.endpos
    if opts.resume.tot ~= nil then tot = opts.resume.tot end
    tot.suspended = nil
    tot.nwin_est = nwin
  end

  local slice = sdec.ck_slice_win(opts.budget_s, W, sdec.ck_win_us)
  local spent = 0

  local primed = opts.primed
  opts.primed = nil
  local reuse = (primed ~= nil and off == 0 and opts.resume == nil and primed.W == W and
                 primed.at == 1)

  while true do
    local cnt
    if reuse then
      cnt, reuse = primed.cnt, false
    else
      cnt = reader(win, off + 1, W)
    end
    if cnt == nil or cnt < 2 then break end

    sdec.sig_edges(win, cnt)

    local tmin0 = nil
    if endpos ~= nil then tmin0 = endpos - off end
    local r = sdec.ua_run(win, cnt, T, fmt.nbits, fmt.par, fmt.nstop, fmt.invert,
                          tmin0)

    tot.nwin = tot.nwin + 1
    tot.nsmp = off + cnt
    tot.nfalse = tot.nfalse + r.nfalse

    local m = r.nf
    if m > 0 and maxbytes ~= nil and tot.nf + m > maxbytes then
      m = maxbytes - tot.nf
      if m < 0 then m = 0 end
      tot.stopped = 'cap'
    end

    if m > 0 then
      local i
      for i = 1, m do
        if r.errs[i] == nil then tot.ngood = tot.ngood + 1
        else tot.nbad = tot.nbad + 1 end
      end
      if tot.nf == 0 and r.headsusp ~= nil and r.headsusp > 0 then
        tot.headsusp = r.headsusp
        local hb, hn, hi = 0, 0, nil
        for hi = 1, r.headsusp do
          if r.errs[hi] ~= nil then
            hb = hi
            hn = hn + 1
          end
        end
        if hb > 0 then
          tot.headbad = hb
          tot.headnbad = hn
        end
      end
      local sok = true
      if sink ~= nil then sok = sink(r.vals, r.errs, m, tot.nf) end
      tot.nf = tot.nf + m
      if sok == false then
        tot.stopped = 'sink'
        break
      end
      endpos = off + r.tpos[m] + (framebits - 0.5) * T
    end

    if tot.stopped == 'cap' then break end

    if progress ~= nil then
      if progress(tot.nf, tot.nwin, nwin) == false then
        tot.stopped = 'stopped'
        break
      end
    end

    if ntotal ~= nil and off + cnt >= ntotal then break end
    if cnt < W then
      tot.stopped = 'short read'
      break
    end
    off = off + stride

    spent = spent + 1
    if slice ~= nil and spent >= slice then
      tot.suspended = {off = off, endpos = endpos, tot = tot}
      return tot, nil
    end
  end

  if tot.stopped == nil and maxbytes ~= nil and tot.nf >= maxbytes then
    tot.stopped = 'cap'
  end
  return tot, nil
end

-- Sinks
-- Accumulate into caller-supplied arrays, for a dry run and for the offline suite. Positions come from
-- `base`, the offset ck_decode has committed to, so a mis-stepped seam is a wrong byte at a known index.
function sdec.ck_sink_collect(vals, errs)
  return function(v, e, m, base)
    local i
    for i = 1, m do
      vals[base + i] = v[i]
      if errs ~= nil then errs[base + i] = e[i] end
    end
    return true
  end
end

-- Append to a file on the USB key, as the same hex+ASCII rows the panel and the debug log use, so a row
-- compares across all three. Rows are 16 bytes and a window boundary is not, so leftover bytes are
-- carried rather than emitted short, which would skew every offset after the seam. Returns sink, finish.
function sdec.ck_sink_file(path, ncol)
  if ncol == nil then ncol = 16 end
  local fh, owhy = ulog.open_write(path, file.MODE_APPEND)
  if fh == nil then return nil, nil, 'cannot append to ' .. tostring(path) end
  local hdr = string.format('---- stream  %s %s\r\n',
                            sdec.baud_text and sdec.baud_text() or '?',
                            sdec.fmt_text and sdec.fmt_text() or '?')
  file.write(fh, hdr)
  if ulog ~= nil and ulog.keyok ~= nil and not ulog.keyok() then
    file.close(fh)
    return nil, nil, 'cannot write the stream header to ' .. tostring(path)
  end

  local cv, ce, cn = {}, {}, 0     -- carry: bytes not yet a full row
  local cbase = 0                  -- stream offset of cv[1]
  local dead = false

  -- ua_hexrow pads ncol - nrow, so the file's last row keeps its ASCII gutter in column.
  local function emit(nrow)
    local line = sdec.ua_hexrow(cv, ce, nrow, 1, ncol, cbase)
    if not dead and ulog ~= nil and ulog.keyok ~= nil and not ulog.keyok() then dead = true end
    if not dead then file.write(fh, line .. '\r\n') end
    local i
    for i = nrow + 1, cn do
      cv[i - nrow] = cv[i]
      ce[i - nrow] = ce[i]
    end
    cn = cn - nrow
    cbase = cbase + nrow
  end

  local sink = function(v, e, m, base)
    if dead then return false end
    if cn == 0 then cbase = base end
    local i
    for i = 1, m do
      cn = cn + 1
      cv[cn] = v[i]
      ce[cn] = e[i]
    end
    sdec.flog_bytes = (sdec.flog_bytes or 0) + m
    while cn >= ncol and not dead do emit(ncol) end
    return not dead
  end

  local finished = false
  local finish = function()
    if finished then return not dead end
    finished = true
    if not dead and cn > 0 then
      if not pcall(emit, cn) then dead = true end
    end
    file.flush(fh)
    file.close(fh)
    fh = nil
    if not dead and ulog ~= nil and ulog.keyok ~= nil and not ulog.keyok() then dead = true end
    return not dead
  end

  return sink, finish, nil
end

sdec.ck_keep = 8192

-- A fixed-size ring for the last bytes of a stream, so RAM does not grow with the run.
function sdec.ck_tail_new(cap)
  if cap == nil then cap = sdec.ck_keep end
  if cap == nil or cap < 1 then return nil end
  return {v = {}, e = {}, n = 0, w = 0, cap = cap}
end

-- Tee, not replacement: called alongside the run's own sink, so a write failure still propagates.
function sdec.ck_tail_push(tl, vals, errs, m, base)
  if tl == nil or m == nil or m < 1 then return end
  local i = 1
  if m > tl.cap then
    i = m - tl.cap + 1
    tl.w = tl.w + (i - 1)
    tl.n = tl.cap                      -- the skipped bytes are 'seen', and the ring is now full
  end
  while i <= m do
    local j = math.mod(tl.w, tl.cap) + 1
    tl.v[j], tl.e[j] = vals[i], errs[i]
    tl.w = tl.w + 1
    if tl.n < tl.cap then tl.n = tl.n + 1 end
    i = i + 1
  end
  if base ~= nil then tl.base = base end
end

-- Linearise into the shape sdec.res has, so every byte-view function works on it unchanged. `first` is
-- absolute, so the dump labels offsets truthfully; tpos is empty because lin_decode still indexes it.
function sdec.ck_tail_result(tl, fmt, ntotal)
  if tl == nil or tl.n < 1 then return nil end
  local r = {nf = tl.n, ngood = 0, nbad = 0, nfalse = 0,
             vals = {}, errs = {}, tpos = {}}
  local start = tl.w - tl.n                 -- 0-based index of the oldest kept byte
  local i
  for i = 1, tl.n do
    local j = math.mod(start + i - 1, tl.cap) + 1
    r.vals[i], r.errs[i] = tl.v[j], tl.e[j]
    if tl.e[j] == nil then r.ngood = r.ngood + 1 else r.nbad = r.nbad + 1 end
  end
  r.first = start + 1
  r.ntotal = ntotal                         -- how many the whole run decoded
  if fmt ~= nil then
    r.nbits, r.par, r.nstop = fmt.nbits, fmt.par, fmt.nstop
    r.invert, r.framebits = fmt.invert, fmt.framebits
  end
  return r
end

-- One call, for the app to hang a button on
-- Prime, then decode, then finish, with one window table shared by both halves so two 20 000-sample
-- arrays are never alive at once. A resumable run, because a 32 kB stream is over half a minute in one
-- button handler and nothing can interrupt it.
-- docs/MEASUREMENTS.md, 'Why ck_job is resumable'.
function sdec.ck_job_new(reader, ntotal, path, opts)
  if opts == nil then opts = {} end
  sdec.smp, sdec.nread = nil, 0

  local win = {}
  local pr, perr = sdec.ck_prime_new(reader, ntotal, win, opts.leadmax)
  if pr == nil then return nil, perr end
  opts.win = win

  return {reader = reader, ntotal = ntotal, path = path, opts = opts,
          prime = pr, phase = pr.label, fmt = nil, sink = nil, finish = nil,
          tail = nil, state = nil, done = false, tot = nil}, nil
end

-- The sink chain, built once priming has succeeded and not before: a recording with no findable format
-- must not have created its file first, leaving an empty numbered log on the key. opts.sink is an extra
-- destination chained ahead of the file, not a replacement, so the offline suite can collect the bytes
-- while the key gets them too; assigning over job.sink would discard the tail tee. Either may stop it.
function sdec.ck_job_sinks(job)
  local opts = job.opts
  local sink = opts.sink
  if job.path ~= nil then
    local fsink, ffin, fe = sdec.ck_sink_file(job.path, opts.ncol)
    if fsink == nil then return false, fe end
    job.finish = ffin
    if sink == nil then
      sink = fsink
    else
      local extra = sink
      sink = function(vals, errs, m, base)
        local a = extra(vals, errs, m, base)
        local b = fsink(vals, errs, m, base)
        return a ~= false and b ~= false
      end
    end
  end

  local tail = sdec.ck_tail_new(opts.keep)
  job.tail = tail
  if tail ~= nil then
    local inner = sink
    sink = function(vals, errs, m, base)
      sdec.ck_tail_push(tail, vals, errs, m, base)
      if inner == nil then return true end
      return inner(vals, errs, m, base)
    end
  end
  job.sink = sink
  return true, nil
end

-- One slice. Returns done, tot, err; done false means call again, repainting the panel in between.
function sdec.ck_job_step(job)
  if job == nil then return true, nil, 'no job' end
  if job.done then return true, job.tot, nil end

  if job.prime ~= nil then
    local pok, pa, pb, pc = pcall(sdec.ck_prime_step, job.prime)
    local pdone, fmt, perr = true, nil, nil
    if pok then
      pdone, fmt, perr = pa, pb, pc
    else
      perr = tostring(pa)
    end
    job.phase = job.prime.label
    if not pdone then return false, nil, nil end
    if job.prime.W ~= nil then
      job.opts.primed = {cnt = job.prime.cnt, W = job.prime.W, at = job.prime.at}
    end
    job.prime = nil
    if fmt == nil then
      job.done, job.tot = true, nil
      return true, nil, tostring(perr or 'cannot prime the decode')
    end
    job.fmt = fmt
    local sok, serr = sdec.ck_job_sinks(job)
    if not sok then
      job.done, job.tot = true, nil
      return true, nil, tostring(serr or 'cannot open the log file')
    end
    job.phase = nil
    return false, nil, nil
  end

  job.opts.resume = job.state
  local tot, terr, praise = nil, nil, nil
  local pok, pa, pb = pcall(sdec.ck_decode, job.reader, job.ntotal, job.fmt, job.sink, job.opts)
  local perr = nil
  if pok then tot, terr = pa, pb else perr = pa end
  job.opts.resume = nil               -- unconditionally: a raise must not leave it set
  if tot ~= nil then
    if job.headsusp == nil then job.headsusp = tot.headsusp end
    if job.headbad == nil then job.headbad = tot.headbad end
    if job.headnbad == nil then job.headnbad = tot.headnbad end
    tot.headsusp, tot.headbad = job.headsusp, job.headbad
    tot.headnbad = job.headnbad
  end
  if not pok then
    tot, praise = nil, perr
  end

  if tot == nil then
    if job.finish ~= nil then pcall(job.finish) end
    job.done, job.tot, job.state = true, nil, nil
    return true, nil, tostring(praise or terr or 'chunked decode failed')
  end

  if tot.suspended ~= nil then
    job.state = tot.suspended
    job.tot = tot                     -- partial totals, so the panel can show real progress
    return false, tot, nil
  end

  job.done, job.tot, job.state = true, tot, nil
  tot.suspended = nil                 -- and drop the self-referential checkpoint
  if job.finish ~= nil then
    local fpok, fv = pcall(job.finish)
    local fok = fpok and fv
    if not fpok or not fok then tot.stopped = 'write failed' end
  end
  tot.fmt = job.fmt
  tot.path = job.path
  tot.tail = sdec.ck_tail_result(job.tail, job.fmt, tot.nf)
  if tot.tail ~= nil then tot.tail.headsusp = tot.headsusp end
  return true, tot, nil
end

-- Abandon a job that will not be finished -- a Mode press, a stop, a mode change. Closes the file so
-- the rows already decoded survive, and returns the tail so they can still be shown.
function sdec.ck_job_abandon(job)
  if job == nil then return nil end
  if job.finish ~= nil and not job.done then pcall(job.finish) end
  job.done, job.state, job.prime = true, nil, nil
  local tot = job.tot
  if tot ~= nil then
    tot.suspended = nil
    tot.stopped = tot.stopped or 'stopped'
    tot.fmt = job.fmt
    tot.path = job.path
    tot.tail = sdec.ck_tail_result(job.tail, job.fmt, tot.nf)
  end
  return tot
end

-- The unchunked form, kept because most callers want it: with no opts.budget_s, one slice runs.
function sdec.ck_run(reader, ntotal, path, opts)
  local job, jerr = sdec.ck_job_new(reader, ntotal, path, opts)
  if job == nil then return nil, jerr end
  local done, tot, err = false, nil, nil
  while not done do
    done, tot, err = sdec.ck_job_step(job)
  end
  if tot == nil then return nil, err end
  return tot, nil
end

-- One line for the panel and the log. A file that stopped at the cap is a window onto a longer stream.
function sdec.ck_summary(tot)
  if tot == nil then return 'no stream' end
  local extra = ''
  if tot.stopped == 'cap' then
    extra = string.format(' -- stopped at the %d byte cap; the stream may continue',
                          tot.nf or 0)
  elseif tot.stopped == 'exhausted' then
    extra = ' -- the CAPTURE BUFFER ran out before the cap; sample slower for more bytes'
  elseif tot.stopped == 'short read' then
    extra = ' -- the sample source ended early; part of the capture was never scanned'
  elseif tot.stopped == 'stopped' then
    if tot.path == nil then
      extra = ' -- STOPPED by the operator; nothing was recorded, the panel holds the tail'
    else
      extra = ' -- STOPPED by the operator; the file holds what was decoded so far'
    end
  elseif tot.stopped == 'sink' or tot.stopped == 'write failed' then
    extra = ' -- WRITE FAILED part-way through'
  end
  return string.format('%d bytes  %d err  %d win  %d samples%s',
                       tot.nf or 0, tot.nbad or 0, tot.nwin or 0, tot.nsmp or 0, tostring(extra))
end


-- ================= tsp/serial_ui.tsp =================
sdec = sdec or {}

sdec.ui_title    = 'SERIAL DECODE'

sdec.ui_ink = 12
sdec.ui_ink_med = 17
sdec.ui_lab_y = 14
sdec.ui_val_y = 32
sdec.ui_fields = {
  {lab = 'BAUD',   x = 8,   c = 0x00DCFF, med = true, dy = 2, wid = '115200'},
  {lab = 'FORMAT', x = 115, c = 0x00DCFF, med = true, dy = 2, labdx = -4, wid = '8N1M'},
  {lab = 'IDLE',   x = 188, c = 0xFFFFFF, wid = 'HIGH'},
  {lab = 'LOGIC',  x = 241, c = 0xFFFFFF, wid = '3V3 CMOS'},
  {lab = 'THRESH', x = 334, c = 0xFFFFFF, wid = '-6.00 V'},
  {lab = 'SA/BIT', x = 417, c = 0xFFFFFF, wid = '10.42'},
  {lab = 'RATE',   x = 490, c = 0xFFFFFF, wid = '80 kS/s'},
  {lab = 'BYTES',  x = 573, c = 0x80FF80, wid = '999999'},
  {lab = 'ERR',    x = 636, c = 0x80FF80, labdx = -2, wid = '999'},
  {lab = 'FIT',    x = 679, c = 0xFFFFFF, wid = '1.00'},
  {lab = 'S/N',    x = 721, c = 0xFFFFFF, wid = '>99 dB'},
}

-- The ink band of one value cell, [top, bottom] inclusive, as one function so the panel and
-- test_serial cannot disagree. It must account for the font and fd.dy, or the tallest cells go
-- unguarded.
function sdec.ui_field_band(j)
  local fd = sdec.ui_fields[j]
  local y = sdec.ui_val_y + (fd.dy or 0)
  local ink = sdec.ui_ink
  if fd.med then ink = sdec.ui_ink_med end
  return y - ink + 1, y
end

sdec.ui_adv_upper = 10       -- uppercase, measured 9.67 worst case
sdec.ui_adv_btn = 14
sdec.ui_adv_mixed = 8        -- digits and mixed-case, measured 7.80 worst case
sdec.ui_c_lab  = 0xA8A8A8                    -- the label row
sdec.ui_lockfields = {baud = 1, fmt = 2, idle = 3}
sdec.ui_c_locked  = 0x40FF40   -- green:  the operator pinned this
sdec.ui_c_auto    = 0xFFC000   -- amber:  the app worked it out
sdec.ui_c_unknown = 0xFF6060   -- red:    nothing to lock -- no decode
sdec.ui_errfield  = 9
sdec.ui_snfield   = 11
sdec.ui_fitfield  = 10
sdec.ui_fit_good  = 0.90
sdec.ui_fit_bad   = 0.72
sdec.ui_sn_good   = 30       -- at or above: green
sdec.ui_sn_bad    = 15       -- below: red. Between the two: amber
sdec.ui_c_sn_ok   = 0x80FF80 -- green:  the same "all clear" green BYTES and ERR carry
sdec.ui_c_sn_warn = 0xFFFF00 -- yellow: margin, but not much
sdec.ui_c_sn_bad  = 0xFF6060 -- red:    the same red ERR goes when it has something to report
sdec.ui_c_rule = 0xA8A8A8
sdec.ui_c_hide = 0x000A0D
sdec.ui_rule_top = 1
sdec.ui_rule_hdr = 15
sdec.ui_rule_mid = 37                        -- under the value ink (medium 18..34 on the dy cells)
sdec.ui_rule_bot = 56                        -- one clear row under the descender tip at 55
sdec.ui_rule_x0  = 1
sdec.ui_rule_x1  = 797
sdec.ui_note_lab_x = 8
sdec.ui_trigsrc = {
  edge  = {name = 'Start bit',   c = 0x40FF40},
  free  = {name = 'Free run',    c = 0xFFFF00},
  front = {name = 'Trigger key', c = 0x00FFFF},
}
sdec.ui_note_val_x = 112
sdec.ui_pgind_x  = 788
sdec.ui_pgind_dig = '99'
sdec.ui_pgind_gap = 6
sdec.ui_note_gap = 20

sdec.ui_note_y   = 51
sdec.ui_row_y0   = 71                        -- first dump row
sdec.ui_row_dy   = 18                        -- row pitch (see docs/panel-ref-rows.png)
sdec.ui_nrow     = 15
sdec.ui_stat_y   = 344
sdec.ui_stat_top = 330   -- above the status ink (333..344)
sdec.ui_stat_bot = 349   -- below it, one clear row under the descender tip at 347
sdec.ui_stat_div = 472
sdec.ui_prog_x = 339
sdec.ui_prog_y = sdec.ui_stat_top + 2
sdec.ui_prog_h = sdec.ui_stat_bot - 2 - sdec.ui_prog_y + 1
sdec.ui_prog_w = sdec.ui_stat_div - 3 - sdec.ui_prog_x
sdec.ui_prog_lw = 10
sdec.ui_prog_wmax = sdec.ui_prog_w - 2
sdec.ui_prog_pad  = math.floor((sdec.ui_prog_h - 2 - sdec.ui_prog_lw) / 2)
sdec.ui_prog_ly   = sdec.ui_prog_y + 1 + sdec.ui_prog_pad + math.floor(sdec.ui_prog_lw / 2)
sdec.ui_trig_div = 666
sdec.ui_trig_x   = 675
sdec.ui_btn_y    = 362
sdec.ui_btn_h    = 58                        -- for layout arithmetic, not passed to the API
sdec.ui_x        = 8

sdec.ui_ch_w     = 8                         -- character advance, ESTIMATE
sdec.ui_col_gap  = 8                         -- clear space each side of a vertical rule
sdec.ui_ixn      = 5                         -- offset field, '%04d', five digits past 9999
sdec.ui_hxn      = sdec.ua_hexwidth(8)      -- ONE group of 8 bytes: 8*3 - 1 = 23 chars
sdec.ui_col_gap2 = 12                       -- clear space BETWEEN the two hex groups
sdec.ui_asn      = 16                        -- ASCII block, one char per byte

sdec.ui_col_ix   = sdec.ui_x
sdec.ui_ix_gap   = 12
sdec.ui_vr1_x    = sdec.ui_col_ix + sdec.ui_ixn * sdec.ui_ch_w + sdec.ui_ix_gap
sdec.ui_col_hx   = sdec.ui_vr1_x + sdec.ui_ix_gap
sdec.ui_col_hx2  = sdec.ui_col_hx + sdec.ui_hxn * sdec.ui_ch_w + sdec.ui_col_gap2
sdec.ui_vr2_x    = sdec.ui_stat_div
sdec.ui_as_gap   = 16
sdec.ui_col_as   = sdec.ui_vr2_x + sdec.ui_as_gap
sdec.ui_vr3_x    = sdec.ui_col_as + sdec.ui_asn * sdec.ui_ch_w + sdec.ui_col_gap
sdec.ui_vr_y0    = sdec.ui_rule_bot + 1
sdec.ui_vr_y1    = sdec.ui_stat_top

if sdec.ui_sb_show == nil then sdec.ui_sb_show = false end
sdec.ui_sb_x   = 778
sdec.ui_sb_w   = 12
sdec.ui_sb_n   = sdec.ui_nrow                -- segments, one per dump row -- BY CONSTRUCTION
sdec.ui_sb_h   = 17                          -- segment height, 3 px of gap at 20 px pitch

sdec.ui_modes = {
  {id = 'frame', name = 'FRAME',  cap = nil,   log = true, view = true, title = '240B FRAME',
   c = 0xB0B0B0, desc = 'capture, show, and append to the message log'},
  {id = 'sml',   name = '8 kB',   cap = 8192,  log = true, view = false, title = '8K CAPTURE',
   needbaud = true, idlexit = true, c = 0x40C0FF,
   desc = 'shorter capture window -- quicker to bytes, more credits'},
  {id = 'med',   name = '32 kB',  cap = 32768, log = true, view = false, title = '32K CAPTURE',
   needbaud = true, idlexit = true, c = 0xFFC000,
   desc = 'long capture, decoded to a file'},
  n = 3,
}
sdec.capmode = sdec.capmode or 'frame'    -- operator state, hence `or`

sdec.idle_exit_s = sdec.idle_exit_s or 1

-- Arm/Idle Wait itself, never below the floor above: 10 s at the default, 2 s at the minimum, 120 s at
--   [...]
-- startup banner stops for seconds at a time, and a fixed 1 s ends the recording inside the first of
-- those pauses with the interesting part still to come. One setting the operator can see on the glass
-- beats two they have to read about.
function sdec.idle_exit()
  local floor = sdec.idle_exit_s
  if floor == nil or floor <= 0 then return floor end
  local w = sdec.arm_wait_s()
  if w ~= nil and w > floor then return w end
  return floor
end

sdec.ui_latency_s = sdec.ui_latency_s or 0.5

sdec.ck_press_budget_s = sdec.ck_press_budget_s or 8.0

-- The mode in force, never nil: an unrecognised id falls back to frame.
function sdec.mode_cur()
  local i
  for i = 1, sdec.ui_modes.n do
    if sdec.ui_modes[i].id == sdec.capmode then return sdec.ui_modes[i] end
  end
  return sdec.ui_modes[1]
end

sdec.ui_tick_s = sdec.ui_tick_s or 0.5

-- Stop and start the tick around work that will hold the interpreter. -> true if it acted.
-- Clearing the handler is the off switch, and nothing else is: an invisible timer still fires, and a
-- busy run defers ticks rather than suppressing them. sdec.options() calls ui_tick_off() explicitly
-- and every exit re-arms, which is a no-op if a sibling screen stops the timer and the fix if it
-- does not -- docs/MEASUREMENTS.md, 'Clearing the handler is the only timer off switch'.
function sdec.ui_tick_off()
  if sdec.ui_tick_obj == nil then return false end
  display.setevent(sdec.ui_tick_obj, display.EVENT_PRESS, '')
  return true
end

function sdec.ui_tick_on()
  if sdec.ui_tick_obj == nil then return false end
  display.setevent(sdec.ui_tick_obj, display.EVENT_PRESS, 'sdec.guard(sdec.ui_tick)')
  return true
end

-- Look for a key that has come or gone, and make the panel agree. -> true if anything moved.
-- The shared body of the tick and of the three presses that want an answer now, so Capture, View
-- and Mode each act on the key state at the press. It does not re-open the log, and must not:
-- ulog.resume() allows one open attempt per insertion, and spending it half a second after
-- insertion spends it when it is least likely to succeed. Guarded -- a raise here reaches firmware.
function sdec.ui_keypoll()
  if sdec.ui_scr == nil then return false end
  local moved = false
  pcall(function()
    if not sdec.ui_usb_btns() then return end
    moved = true
    if sdec.ui_log_owned() then return end
    sdec.ui_set(sdec.ui_log_t, sdec.flog_status())
  end)
  return moved
end

-- Is the status row's right-hand cell currently a run's, rather than the log's? -> true or false.
-- It must track ui_refresh()'s branch for that cell, because ui_keypoll() writes the same object
-- from a press; tools/test_streamfix.lua walks eleven states and asserts the two agree in each.
function sdec.ui_log_owned()
  local md = sdec.mode_cur()
  if md == nil then return false end
  if md.view and sdec.ck_tot == nil and not sdec.ck_running then return false end
  if sdec.strm_recording then return true end
  if sdec.ck_job ~= nil then return true end
  if sdec.ck_running or sdec.strm_inflight then return true end
  return false
end

-- What that cell says, decided in one place because three callers write it: ui_refresh paints it, a
-- press writes it through ui_keypoll, and an armed record takes it for an armnote and has to give it
-- back. Not owned by a run means the log's own status, which is what both ui_refresh branches said.
function sdec.ui_runnote()
  if not sdec.ui_log_owned() then return sdec.flog_status() end
  if sdec.strm_recording then return 'Capture or Mode = Stop' end
  if sdec.ck_job ~= nil then return 'Capture=step  Mode=Stop' end
  if sdec.ck_running or sdec.strm_inflight then return 'no stop until it ends' end
  return sdec.flog_status()
end

-- Give the control cell back once the trigger has fired. record_run()'s refresh is the last full one
-- of the run and the arm paints over that cell afterwards, so without this an armed 8 kB or 32 kB
-- record keeps 'waiting Ns for N.NNV' on screen through the acquisition and the decode as well.
function sdec.armnote_clear()
  if sdec.ui_log_t == nil then return false end
  return sdec.ui_set(sdec.ui_log_t, sdec.ui_runnote())
end

-- One tick of sdec.ui_tick_obj: the unattended half of ui_keypoll(). It must not act while the app
-- is busy, a tick being dispatched like a press and so arriving in a burst after a capture. The
-- press route needs no such test: a handler executing at all proves no run is.
function sdec.ui_tick()
  if sdec.ui_scr == nil then return false end
  if sdec.busy or sdec.ck_running or sdec.strm_recording then return false end
  return sdec.ui_keypoll()
end

-- Will anything the app writes reach the key? -> true or false. Asked before a capture, so it
-- cannot read sdec.flog_why; unknown counts as yes, so a build without usb_log.tsp still reads right.
function sdec.log_live()
  local live = true
  if ulog ~= nil and ulog.keyok ~= nil then
    live = ulog.keyok()
  end
  return live
end

-- Whether mode `m` suits the current rate. Always true; mode_why() is what refuses, with a reason.
function sdec.mode_suits(m)
  return true
end

-- Why mode `m` cannot run right now, as a sentence for the note line, or nil if it can. Called when
-- capture is pressed, so a mode can be lined up before the rate is known.
function sdec.mode_why(m)
  if m == nil then m = sdec.mode_cur() end
  if m.needbaud and (sdec.force_baud == nil or sdec.force_baud <= 0) then
    return 'lock the baud rate in Options -- streaming picks the sample rate from it'
  end
  if m.needbaud and sdec.force_baud ~= nil and sdec.force_baud > 0 and
     sdec.fs_for_burst ~= nil and sdec.fs_for_burst(sdec.force_baud) == nil then
    local dl = nil
    if sdec.rates ~= nil and sdec.fs_delivered ~= nil then
      dl = sdec.fs_delivered(sdec.rates[table.getn(sdec.rates)])
    end
    if dl ~= nil and dl > 0 then
      return string.format('%.0f Bd: a recording gets %.1f samples/bit, under the %d floor -- '
                           .. 'use FRAME', sdec.force_baud or 0, dl / sdec.force_baud, sdec.minsabit or 0)
    end
    return string.format('%.0f Bd is too fast to stream -- no sample rate delivers %d ' ..
                         'samples/bit; use FRAME', sdec.force_baud or 0, sdec.minsabit or 0)
  end
  return nil
end

-- Three states, distinguished by the padlock's colour:
--   'locked'   green  -- at least one wire parameter is forced
--   'auto'     amber  -- nothing forced, and there is a decode, so there is something to lock
--   'unknown'  red    -- nothing forced and nothing decoded: nothing to lock yet
function sdec.lock_state()
  if sdec.force_baud ~= nil and sdec.force_baud > 0 then return 'locked' end
  if sdec.force_nbits ~= nil or sdec.force_par ~= nil or
     sdec.force_nstop ~= nil or sdec.force_invert ~= nil then return 'locked' end
  if sdec.baud == nil or sdec.res == nil then return 'unknown' end
  return 'auto'
end

-- The title bar's text: the app's name and the capture mode, in the largest type on the screen.
-- Bounded at 31 characters, the firmware's limit, over which it raises 1707 and truncates silently.
function sdec.ui_title_text()
  local md = sdec.mode_cur()
  local s = sdec.ui_title
  if md ~= nil and md.title ~= nil then s = s .. ' - ' .. md.title end
  if string.len(s) > 31 then s = string.sub(s, 1, 31) end
  return s
end

function sdec.lock_colour()
  local st = sdec.lock_state()
  if st == 'locked' then return sdec.ui_c_locked end
  if st == 'auto' then return sdec.ui_c_auto end
  return sdec.ui_c_unknown
end

sdec.ui_views = {
  {mode = 'text', name = 'TEXT', unit = 'bytes', cols = 80},
  {mode = 'hex',  name = 'HEX',  unit = 'bytes', cols = 16},
  {mode = 'midi', name = 'MIDI', unit = 'msg',   cols = 1, res = 'midi',
   label = 'MIDI messages', nrows = 'mi_nrows', line = 'mi_line',
   parse = 'mi_parse', summary = 'mi_summary'},
  {mode = 'lin',  name = 'LIN',  unit = 'frame', cols = 1, res = 'lin',
   label = 'LIN frames', nrows = 'li_nrows', line = 'li_line',
   parse = 'li_parse', summary = 'li_summary'},
}

-- Whether view `v` is available in this build: a protocol view needs its module loaded. The entries
-- stay in ui_views so that restoring either is one line in package_tspa.py modules.
function sdec.ui_view_avail(v)
  if v == nil then return false end
  if v.res == nil then return true end          -- text and hex need no module
  return v.parse ~= nil and sdec[v.parse] ~= nil
end

-- How many views this build offers, so the button never lands on a view that can only be empty.
function sdec.ui_nviews()
  local n, i = 0, nil
  for i = 1, table.getn(sdec.ui_views) do
    if sdec.ui_view_avail(sdec.ui_views[i]) then n = n + 1 end
  end
  return n
end

-- The nth byte view this build offers.
function sdec.ui_view_nth(k)
  local n, i = 0, nil
  for i = 1, table.getn(sdec.ui_views) do
    if sdec.ui_view_avail(sdec.ui_views[i]) then
      n = n + 1
      if n == k then return sdec.ui_views[i] end
    end
  end
  return nil
end

-- The ui_views entry for `mode`, or nil if absent here. Callers that must have one use ui_cur().
function sdec.ui_view(mode)
  if mode == nil then mode = sdec.ui_mode end
  local i
  for i = 1, table.getn(sdec.ui_views) do
    if sdec.ui_views[i].mode == mode then
      if sdec.ui_view_avail(sdec.ui_views[i]) then return sdec.ui_views[i] end
      return nil
    end
  end
  return nil
end

-- The view in force, never nil: an unrecognised sdec.ui_mode falls back to text.
function sdec.ui_cur()
  return sdec.ui_view() or sdec.ui_views[1]
end

sdec.ui_c_dim  = 0xB0B0B0    -- grey: secondary detail
sdec.ui_c_off  = 0x808080
sdec.ui_c_warn = 0xFFC000    -- amber: ambiguity and warnings
sdec.ui_c_data = 0xFFFFFF    -- white: the decoded bytes
sdec.ui_c_err  = 0xFF6060    -- red: a row containing a framing or parity error
sdec.ui_c_sb_off = 0x282828  -- position bar, outside the current page
sdec.ui_c_sb_on  = 0x00DCFF  -- position bar, current page
sdec.ui_c_pgnum  = 0xFFFFFF    -- the numerals: 100 %
sdec.ui_c_pgword = 0xA8A8A8    -- 'page' and 'of': 66 %
sdec.ui_c_prog     = 0x00FFFF
sdec.ui_c_prog_box = 0xCCCCCC
sdec.ui_c_extin  = 0x40FF40   -- green: an input, armed
sdec.ui_c_extout = 0xFFC000   -- amber: an output, pulsing a credit per capture
sdec.ui_c_extio  = 0x00FFFF   -- cyan:  both directions live

sdec.ui_mode = sdec.ui_mode or 'text'    -- 'text', 'hex' or 'midi'
sdec.ui_page = sdec.ui_page or 0          -- 0-based page index
sdec.ui_paged = sdec.ui_paged or false
sdec.ui_status = sdec.ui_status or 'ready'
-- Say the panel is waiting on purpose, called by acq_triggered() before it blocks on an
-- arm-from-silence: the wait can be 120 s and nothing can interrupt it. The offline harnesses
-- install no armnote.
function sdec.armnote(wait, level, keyed)
  if sdec.ui_log_t == nil then return false end
  local tail = ''
  if keyed then tail = ' -- TRIGGER=go' end
  return sdec.ui_set(sdec.ui_log_t,
                     string.format('waiting %.0fs for %.2fV%s', wait or 0, level or 0, tail))
end

sdec.ui_opt_y0 = 8
sdec.ui_opt_dy = 100
sdec.ui_opt_edit_h  = 50
sdec.ui_opt_edit_dy = 4
sdec.ui_opt_btn_y   = 360
sdec.ui_opt_btn_gap = 24
sdec.ui_opt_x  = 185   -- the label is RIGHT-ALIGNED and ends here, so this is its width
sdec.ui_opt_y_adj = -8
sdec.ui_opt_cols = 2
sdec.ui_opt_x_c2 = 552
sdec.ui_opt_px = 96

sdec.ui_log_px = sdec.ui_trig_div - (sdec.ui_stat_div + 6)

-- Width of an option entry under that model.
function sdec.ui_optw(s)
  if s == nil then return 0 end
  local _, nup = string.gsub(s, '%u', '')
  local n = string.len(s)
  return nup * (sdec.ui_adv_upper or 10) + (n - nup) * (sdec.ui_adv_mixed or 8)
end

-- Small helpers
-- settext `txt` on `h`, but only when the text changed. Returns true if it wrote.
function sdec.ui_set(h, txt)
  if h == nil then return false end
  if sdec.ui_last == nil then sdec.ui_last = {} end
  if sdec.ui_last[h] == txt then return false end
  display.settext(h, txt)
  sdec.ui_last[h] = txt
  return true
end

-- Set an object's colour, tolerating a handle the build never created.
function sdec.ui_color(h, c)
  if h == nil then return false end
  display.setcolor(h, c)
  return true
end

-- How many entries the instrument's log holds, or nil where it cannot be asked. The one signal a
-- display call gives: the firmware raises nothing and returns nothing, so a refusal is visible only as
-- a new entry. Read ONLY from teardown and launch -- never from a capture or a decode, because reading
-- the log in a performance-critical place is a cost the instrument charges for.
function sdec.evcount()
  if eventlog == nil or eventlog.getcount == nil then return nil end
  return eventlog.getcount()
end

-- Delete object `h`, counting a refusal rather than assuming it worked. Returns whether it went.
--   [...]
-- on hardware anyway. Where something else posts during the call it reads as a refusal: that keeps the
-- handle and refuses a rebuild, so the false positive errs toward the safe side rather than toward
-- building over a leak.
function sdec.del_obj(h)
  if h == nil then return true end
  local before = sdec.evcount()
  display.delete(h)
  local after = sdec.evcount()
  local ok = (before == nil or after == nil or after <= before)
  if not ok then
    sdec.delfails = (sdec.delfails or 0) + 1
    sdec.orphans = sdec.orphans or {}
    sdec.orphans[table.getn(sdec.orphans) + 1] = h
  end
  return ok
end

-- Retry every handle a previous teardown could not delete. Returns how many are still live.
function sdec.del_orphans()
  local o = sdec.orphans
  if o == nil then return 0 end
  local keep, nk, i = {}, 0, nil
  for i = 1, table.getn(o) do
    local before = sdec.evcount()
    display.delete(o[i])
    local after = sdec.evcount()
    if before ~= nil and after ~= nil and after > before then nk = nk + 1; keep[nk] = o[i] end
  end
  if nk < 1 then sdec.orphans = nil else sdec.orphans = keep end
  return nk
end

-- Recolour rect `h` to `c`. -> false only for a nil handle: the firmware cannot refuse this in a way
-- a caller could see, so there is nothing else to report.
-- Colour a rect with setcolor, not setfill: a 24-bit colour is refused with 1130, and enough
-- refusals per refresh raise a modal dialog over the panel. setfill does nothing to a rect at all.
function sdec.ui_fill(h, c)
  if h == nil then return false end
  display.setcolor(h, c)
  return true
end

-- Make a rect paint: 100 % foreground, once per rect at build time.
function sdec.ui_fill_solid(h)
  if h == nil then return false end
  display.setfill(h, 100)
  return true
end

-- Show or hide object `h`. The only way to take a rect or a line off the glass: recolouring one to
-- ui_c_hide does not hide it, and that works for the dump rules only because they are 1 px wide.
function sdec.ui_setstate(h, st)
  if h == nil then return false end
  display.setstate(h, st)
  return true
end

-- Paint the acquire/decode bar at `pct` (0..100), or hide it when pct is nil -- every state with no
--   [...]
--   0     the grey frame alone: a run has started and has nothing to show yet.
--   > 0   the frame plus a cyan bar out to pct.
-- A thick OBJ_LINE in an OBJ_RECT frame, cached -- docs/MEASUREMENTS.md, 'The progress bar extents'.
function sdec.ui_progbar_set(pct)
  if sdec.ui_progbox == nil or sdec.ui_progline == nil then return false end
  if pct ~= nil then
    pct = math.floor(pct + 0.5)
    if pct < 0 then pct = 0 end
    if pct > 100 then pct = 100 end
  end
  local vis = 0
  if pct ~= nil then vis = 1 end
  if pct ~= nil and pct > 0 then vis = 2 end
  if vis ~= sdec.ui_progvis then
    local on, off = display.STATE_ENABLE, display.STATE_INVISIBLE
    local boxst, barst = off, off
    if vis > 0 then boxst = on end
    if vis > 1 then barst = on end
    sdec.ui_setstate(sdec.ui_progbox, boxst)
    sdec.ui_setstate(sdec.ui_progline, barst)
    sdec.ui_progvis = vis
  end
  if pct ~= sdec.ui_progpct then
    if pct ~= nil and pct > 0 then
      local w = math.floor(pct * sdec.ui_prog_wmax / 100 + 0.5)
      if w < 1 then w = 1 end
      local x0 = sdec.ui_prog_x + 1
      display.setposition(sdec.ui_progline, x0, sdec.ui_prog_ly, x0 + w - 1, sdec.ui_prog_ly)
    end
    sdec.ui_progpct = pct
  end
  return true
end

-- Items per page, and per row. A protocol view is one message or frame per row, so cols is 1.
function sdec.ui_bytes_per_page()
  local cols = sdec.ui_cur().cols or 80
  return cols * sdec.ui_nrow, cols
end

-- What the current view is paging through: bytes, MIDI messages or LIN frames.
function sdec.ui_nitems()
  local v = sdec.ui_cur()
  if v.nrows ~= nil then
    local fn = sdec[v.nrows]
    if fn == nil then return 0 end
    return fn()
  end
  if sdec.res == nil then return 0 end
  return sdec.res.nf
end

-- Pages the current result needs at the current view.
function sdec.ui_npages()
  local per = sdec.ui_bytes_per_page()
  local n = sdec.ui_nitems()
  if n <= 0 then return 1 end
  return math.floor((n + per - 1) / per)
end

-- 'bytes', 'msg' or 'frame', for the status row.
function sdec.ui_unit()
  return sdec.ui_cur().unit or 'bytes'
end

-- The ERR field's number, in one place: the value and its colour were computed apart and by
-- different rules, so a head-damaged run showed a non-zero ERR in green. Takes the table, not ck_tot.
function sdec.ck_err_n(t)
  if t == nil then return 0 end
  local n = t.nbad or 0
  local hb = t.headbad or 0
  if hb > 0 then n = n - (t.headnbad or 0) + hb end
  return n
end

function sdec.ui_err_n()
  local ct = sdec.ck_tot
  if ct ~= nil then
    return sdec.ck_err_n(ct)
  end
  if sdec.res == nil then return nil end
  if sdec.ua_err_count == nil then return sdec.res.nbad end
  return sdec.ua_err_count(sdec.res)
end

-- The colour header value `j` is drawn in; the three lockable fields carry the lock state too.
function sdec.ui_field_colour(j)
  local fd = sdec.ui_fields[j]
  if j == sdec.ui_lockfields.baud or j == sdec.ui_lockfields.fmt or
     j == sdec.ui_lockfields.idle then
    local st = sdec.lock_state()
    if st == 'locked' then return sdec.ui_c_locked end
    if st == 'unknown' then return fd.c end   -- the value is '--' already; red would shout
    return fd.c                               -- auto: the column's own colour, unchanged
  end
  if j == sdec.ui_errfield then
    local n = sdec.ui_err_n()
    if n ~= nil and n > 0 then return sdec.ui_c_err end
    return fd.c
  end
  if j == sdec.ui_fitfield then
    local q = sdec.fitq
    if q == nil then return fd.c end
    q = math.floor(q * 100 + 0.5) / 100
    if q < sdec.ui_fit_bad then return sdec.ui_c_sn_bad end
    if q < sdec.ui_fit_good then return sdec.ui_c_sn_warn end
    return sdec.ui_c_sn_ok
  end
  if j == sdec.ui_snfield then
    local db = sdec.snr_db
    if db == nil then return fd.c end
    db = math.floor(db + 0.5)
    if db < sdec.ui_sn_bad then return sdec.ui_c_sn_bad end
    if db < sdec.ui_sn_good then return sdec.ui_c_sn_warn end
    return sdec.ui_c_sn_ok
  end
  return fd.c
end

-- The header values, in sdec.ui_fields order. Kept short: a value that outgrows its column collides.
function sdec.ui_field_values()
  local r = sdec.res
  local v = {}

  if sdec.baud == nil and sdec.force_baud ~= nil then
    v[1] = string.format('%.0f', sdec.force_baud or 0)
  elseif sdec.baud == nil then v[1] = '--'
  elseif sdec.snapped and sdec.snapfirm ~= false then v[1] = string.format('%.0f', sdec.baud or 0)
  else v[1] = string.format('%.0f?', sdec.baud or 0) end

  v[2] = sdec.fmt_text()

  if r ~= nil then
    if r.invert then v[3] = 'LOW' else v[3] = 'HIGH' end
  elseif sdec.force_invert ~= nil then
    if sdec.force_invert then v[3] = 'LOW' else v[3] = 'HIGH' end
  else v[3] = '--' end

  v[4] = sdec.family or '--'

  if sdec.lo == nil then
    v[5] = '--'
  else
    v[5] = string.format('%.2f V', sdec.thr or 0)
  end

  if sdec.bittime == nil then v[6] = '--'
  else v[6] = string.format('%.1f', sdec.bittime or 0) end

  local fs = sdec.acq_fs or sdec.fs
  if fs == nil then v[7] = '--'
  elseif fs >= 1000000 then v[7] = string.format('%.0f MS/s', fs / 1000000)
  else v[7] = string.format('%.0f kS/s', fs / 1000) end

  local ct = sdec.ck_tot
  if (ct ~= nil or sdec.ck_running) then
    if sdec.ck_running then
      if sdec.ck_nbytes == nil or sdec.ck_nbytes < 1 then v[8] = '--'
      else v[8] = tostring(sdec.ck_nbytes) end
      v[9] = '--'                     -- not known until the run finishes
    else
      v[8] = tostring(ct.nf)
      v[9] = tostring(sdec.ui_err_n())
    end
  elseif r == nil then v[8], v[9] = '--', '--'
  else
    v[8] = tostring(r.nf)
    v[9] = tostring(sdec.ui_err_n())
  end

  if sdec.fitq == nil then
    v[10] = '--'
  else
    v[10] = string.format('%.2f', sdec.fitq or 0)
  end
  if sdec.snr_db == nil then
    v[11] = '--'
  elseif sdec.snr_db >= 99 then
    v[11] = '>99 dB'
  else
    v[11] = string.format('%.0f dB', sdec.snr_db or 0)
  end
  return v
end

-- How far a misaligned head reaches, and whether it is on screen. Returns extent, onscreen --
--   [...]
-- ERR counts it, and the hex rows covering it are red. Asked separately, the colour asked the
-- narrower question -- did this byte fail a check -- and reddened only part of a named head. A
-- recording's head may be off screen, a 32 kB run showing its retained tail, so res.first == 1.
function sdec.ui_head_extent()
  local hs = nil
  if sdec.res ~= nil and sdec.res.headsusp ~= nil and sdec.res.headsusp > 0 then
    hs = sdec.res.headsusp
  elseif sdec.ck_tot ~= nil and sdec.ck_tot.headsusp ~= nil and sdec.ck_tot.headsusp > 0 then
    hs = sdec.ck_tot.headsusp
  end
  if hs == nil then return nil, true, false end
  local onscreen = (sdec.res == nil or sdec.res.first == nil or sdec.res.first <= 1)
  local measured = false
  if onscreen and sdec.res ~= nil and sdec.res.errs ~= nil then
    local last = sdec.ua_head_bad(sdec.res, hs)
    if last > 0 then hs, measured = last, true end
  elseif sdec.ck_tot ~= nil and sdec.ck_tot.headbad ~= nil
         and sdec.ck_tot.headbad > 0 then
    hs, measured = sdec.ck_tot.headbad, true
  end
  return hs, onscreen, measured
end

-- The note / warning line
-- Every note that applies, most important first. Returns the list and its count.
-- A list, not a fall-through chain: seventeen sources feed one cell, and a chain shows one of them
-- with nothing to say the others exist. The cell shows the one that fits and says how many more
-- there are; ulog and the saved file get all of them. Ordered by how badly an absence would mislead.
function sdec.ui_notes()
  local t, m = {}, 0
  local function add(s)
    if s ~= nil and s ~= '' then m = m + 1; t[m] = s end
  end

  if sdec.lasterr ~= nil then add('NOTE: ' .. tostring(sdec.lasterr)) end
  if sdec.savedas ~= nil then add('saved to ' .. tostring(sdec.savedas)) end
  if sdec.stickyerr ~= nil then add('NOTE: ' .. tostring(sdec.stickyerr)) end

  if sdec.trigext and sdec.trigmode == 'free' then
    add('Rear BNC = Trig In is set but IGNORED -- Free run means do not wait for anything')
  end

  if sdec.mode_exited ~= nil and sdec.mode_exitbad then add(tostring(sdec.mode_exited)) end
  if sdec.lognote ~= nil then add(tostring(sdec.lognote)) end
  if sdec.strm_releveled ~= nil then add(tostring(sdec.strm_releveled)) end
  if sdec.relocked ~= nil then add(tostring(sdec.relocked)) end
  if sdec.rate_refused ~= nil then add(tostring(sdec.rate_refused)) end

  local md = sdec.mode_cur()
  if not md.view then
    local mw = sdec.mode_why(md)
    if mw ~= nil then add('WARNING: ' .. mw) end
  end

  if sdec.ck_tot ~= nil and sdec.res ~= nil and sdec.ck_tot.nf > sdec.res.nf then
    local first, tot = sdec.res.first, sdec.res.ntotal or sdec.ck_tot.nf
    if sdec.ck_tot.path == nil then
      local why = 'NOT RECORDED'
      if sdec.flog_why == nil then why = 'NOT RECORDED -- no USB key' end
      if first ~= nil and first > 1 then
        add(string.format('panel shows bytes %d-%d of %d -- the rest was DISCARDED, %s',
                          first or 0, first + (sdec.res.nf or 0) - 1, tot or 0, tostring(why)))
      else
        add(string.format('panel shows the first %d of %d bytes -- the rest was DISCARDED, %s',
                          sdec.res.nf or 0, tot or 0, tostring(why)))
      end
    else
      local base = string.gsub(tostring(sdec.ck_tot.path), '^.*/', '')
      if first ~= nil and first > 1 then
        add(string.format('panel shows bytes %d-%d of %d; all are in %s',
                          first or 0, first + (sdec.res.nf or 0) - 1, tot or 0, tostring(base)))
      else
        add(string.format('panel shows the first %d bytes of the stream; all %d are in %s',
                          sdec.res.nf or 0, tot or 0, tostring(base)))
      end
    end
  end

  if sdec.bittime ~= nil then
    local _, warn = sdec.sig_quality()
    if warn ~= nil then add('WARNING: ' .. warn) end
  end

  local lw = sdec.sig_levelwarn()
  if lw ~= nil then add('WARNING: ' .. lw) end

  if sdec.autolocknote ~= nil then add(sdec.autolocknote) end
  if sdec.probe_note ~= nil then add(sdec.probe_note) end

  if sdec.proto == 'lin' and sdec.li_levelnote ~= nil then
    local ln = sdec.li_levelnote()
    if ln ~= nil then add('WARNING: ' .. ln) end
  end

  if sdec.proto == 'lin' and sdec.li_breaknote ~= nil then
    add(sdec.li_breaknote())
  end

  local hs, onscreen, hmeas = sdec.ui_head_extent()
  if hs ~= nil then
    local isv, arev = 'is', 'are'
    if not hmeas then isv, arev = 'may be', 'may be' end
    if onscreen then
      if hs == 1 then
        add('began mid-byte -- the first byte ' .. isv .. ' misaligned.')
      else
        add(string.format('began mid-byte -- the first %d bytes %s misaligned.', hs or 0, arev))
      end
    else
      local where = ', in the file.'
      if sdec.ck_tot ~= nil and sdec.ck_tot.path == nil then
        where = ', and were NOT recorded.'
      end
      if hs == 1 then
        add('the run began mid-byte -- its first byte ' .. isv .. ' misaligned' .. where)
      else
        add(string.format('the run began mid-byte -- its first %d bytes %s misaligned%s',
                          hs or 0, arev, tostring(where)))
      end
    end
  end

  if sdec.res ~= nil and sdec.res.nfalse ~= nil and sdec.res.nfalse > 0 then
    add(string.format('%d false start(s) rejected -- impulse noise; "err" counts framing only',
                      sdec.res.nfalse or 0))
  end

  if sdec.proto_why ~= nil then add('WARNING: ' .. tostring(sdec.proto_why)) end

  if sdec.acq_fs_est then
    add(string.format('sample rate NOT measured from this capture -- showing the requested %g S/s; '
                      .. 'every timing figure derives from it', sdec.fs or 0))
  end

  if sdec.flog_why ~= nil then add('NOT LOGGING: ' .. tostring(sdec.flog_why)) end

  add(sdec.rate_note)
  add(sdec.baud_note)
  add(sdec.fmt_note)

  local istail = (sdec.res ~= nil and sdec.res.first ~= nil)
  if sdec.res ~= nil and sdec.res.nf > 0 and not istail then
    local cap = sdec.window_bytes(sdec.baud, sdec.res.nbits, sdec.res.par,
                                  sdec.res.nstop)
    if cap ~= nil and cap > 0 and sdec.res.nf >= cap then
      if sdec.force_baud == nil then
        add(string.format('capture FULL at %d bytes -- the message may continue; ' ..
                          'lock the baud rate for a longer window', cap or 0))
      else
        add(string.format('capture FULL at %d bytes -- the message may continue', cap or 0))
      end
    end
  end

  if sdec.force_nbits ~= nil and sdec.force_par == nil then
    add('parity was ASSUMED none, not detected -- a forced width skips the search')
  end

  if sdec.res ~= nil and sdec.res.nbad == 0 and sdec.force_nbits == nil then
    add('stop-bit count is not observable from the wire; shown as 1')
  end
  return t, m
end

sdec.ui_cw = '55699?<3667:5655999999999955:::9'
          .. 'A<<==<:>=59<9?=><>=<:=<@<<:55589'
          .. '6999995993393?999969599=999656:'
sdec.ui_cw_def = 9        -- anything outside 32..126, which notes do not contain

-- Rendered width of `s` in px.
function sdec.ui_textw(s)
  if s == nil then return 0 end
  local w, i, n = 0, 1, string.len(s)
  local tab, def = sdec.ui_cw, sdec.ui_cw_def
  while i <= n do
    local b = string.byte(s, i)
    if b >= 32 and b <= 126 then
      w = w + string.byte(tab, b - 31) - 48
    else
      w = w + def
    end
    i = i + 1
  end
  return w
end

sdec.ui_fit_slack = 1.04

-- `s` clipped to fit `maxpx`, with '...' marking that it was clipped. The firmware clips at the
-- panel edge and says nothing, so an over-long string is cut without a mark.
function sdec.ui_fit(s, maxpx)
  if s == nil then return '' end
  maxpx = math.floor(maxpx / sdec.ui_fit_slack)
  if sdec.ui_textw(s) <= maxpx then return s end
  local ell = sdec.ui_textw('...')
  local budget = maxpx - ell
  if budget <= 0 then return '' end
  local w, i, n = 0, 1, string.len(s)
  while i <= n do
    local b = string.byte(s, i)
    local cw = sdec.ui_cw_def
    if b >= 32 and b <= 126 then cw = string.byte(sdec.ui_cw, b - 31) - 48 end
    if w + cw > budget then break end
    w = w + cw
    i = i + 1
  end
  return string.sub(s, 1, i - 1) .. '...'
end

sdec.ui_note_px = sdec.ui_rule_x1 - sdec.ui_note_val_x

-- 'page N of M' for the note row, or '' when there is nothing worth saying. 1-based, since 'page 0
-- of 35' names a page no button can reach, and computed rather than cached: ui_note_text reserves
-- room from this, and a second copy could describe a string that has left the screen.
function sdec.ui_pgind_text()
  if not sdec.ui_paged then return '' end
  local npg = sdec.ui_npages()
  if npg <= 1 then return '' end
  return string.format('page %d of %d', sdec.ui_page + 1, npg or 0)
end

-- Where the counter's four pieces go, right to left from ui_pgind_x. Returns x_page, x_n, x_of, x_m,
-- the two number x's being right edges (JUST_RIGHT) and the two word x's left edges.
function sdec.ui_pgind_layout()
  local g = sdec.ui_pgind_gap
  local wn = sdec.ui_textw(sdec.ui_pgind_dig)
  local xm = sdec.ui_pgind_x
  local xof = xm - wn - g - sdec.ui_textw('of')
  local xn = xof - g
  local xpage = xn - wn - g - sdec.ui_textw('page')
  return xpage, xn, xof, xm
end

-- How much of the note cell the counter holds. The fixed group extent, not today's string.
function sdec.ui_pgind_px()
  if sdec.ui_pgind_text() == '' then return 0 end
  local xpage = sdec.ui_pgind_layout()
  return (sdec.ui_pgind_x - xpage) + sdec.ui_note_gap
end

-- The one note the cell has room for, plus how many others there are. Both parts are fitted and the
-- marker wins when they compete, or a long note pushes '(+N more)' off the panel and nothing says a
-- second note exists. The page counter's width comes off the cell too; the firmware overlaps them.
function sdec.ui_note_text()
  local t, m = sdec.ui_notes()
  if m < 1 then return '' end
  local px = sdec.ui_note_px - sdec.ui_pgind_px()
  if m == 1 then return sdec.ui_fit(t[1], px) end
  local mk = string.format('  (+%d more)', m - 1)
  return sdec.ui_fit(t[1], px - sdec.ui_textw(mk)) .. mk
end

-- Main screen
--   [...]
-- omission brings the object back at its create-time colour while the stale cache suppresses the
-- write, so a capture with framing errors shows its error count in green. Keeping the caches few is
-- what makes the list maintainable, and ui_page is not one: it is view state.
function sdec.ui_invalidate()
  sdec.ui_last, sdec.ui_rowc = nil, nil
  sdec.ui_vrc = nil
  sdec.ui_sbc = nil
  sdec.ui_fvalc, sdec.ui_trigsrcc, sdec.ui_logc = nil, nil, nil
  sdec.ui_trigc = nil
  sdec.ui_lockc = nil
  sdec.ui_progpct, sdec.ui_progvis = nil, nil
  sdec.ui_titletxt = nil
  return true
end

-- Delete every main-screen object and nil its handle.
function sdec.ui_destroy()
  if sdec.ui_scr ~= nil or sdec.ui_loadscr ~= nil then
    display.changescreen(display.SCREEN_HOME)
  end
  local i
  if sdec.ui_row ~= nil then
    for i = 1, table.getn(sdec.ui_row) do sdec.del_obj(sdec.ui_row[i]) end
  end
  if sdec.ui_rhx ~= nil then
    for i = 1, table.getn(sdec.ui_rhx) do sdec.del_obj(sdec.ui_rhx[i]) end
    if sdec.ui_rhx2 ~= nil then
      for i = 1, table.getn(sdec.ui_rhx2) do sdec.del_obj(sdec.ui_rhx2[i]) end
    end
  end
  if sdec.ui_ras ~= nil then
    for i = 1, table.getn(sdec.ui_ras) do sdec.del_obj(sdec.ui_ras[i]) end
  end
  if sdec.ui_vr ~= nil then
    for i = 1, table.getn(sdec.ui_vr) do sdec.del_obj(sdec.ui_vr[i]) end
  end
  if sdec.ui_flab ~= nil then
    for i = 1, table.getn(sdec.ui_flab) do sdec.del_obj(sdec.ui_flab[i]) end
  end
  if sdec.ui_fval ~= nil then
    for i = 1, table.getn(sdec.ui_fval) do sdec.del_obj(sdec.ui_fval[i]) end
  end
  if sdec.ui_allbtn ~= nil then
    local ai
    for ai = 1, table.getn(sdec.ui_allbtn) do sdec.del_obj(sdec.ui_allbtn[ai]) end
    sdec.ui_allbtn = nil
  end
  sdec.ui_pgbtn = nil
  sdec.ui_lockbtn = nil
  if sdec.ui_sb ~= nil then
    for i = 1, table.getn(sdec.ui_sb) do sdec.del_obj(sdec.ui_sb[i]) end
  end
  if sdec.ui_rule ~= nil then
    for i = 1, table.getn(sdec.ui_rule) do sdec.del_obj(sdec.ui_rule[i]) end
  end
  sdec.del_obj(sdec.ui_note)
  if sdec.ui_lock ~= nil then
    local li
    for li = 1, table.getn(sdec.ui_lock) do sdec.del_obj(sdec.ui_lock[li]) end
    sdec.ui_lock = nil
  end
  sdec.del_obj(sdec.ui_lockhit)
  sdec.del_obj(sdec.ui_trig_t)
  sdec.del_obj(sdec.ui_trighit)
  sdec.ui_lockbody, sdec.ui_lockc, sdec.ui_lockhit = nil, nil, nil
  sdec.del_obj(sdec.ui_tick_obj)
  sdec.ui_tick_obj = nil
  sdec.del_obj(sdec.ui_page_t)
  sdec.del_obj(sdec.ui_log_t)
  if sdec.ui_pgind ~= nil then
    for i = 1, table.getn(sdec.ui_pgind) do sdec.del_obj(sdec.ui_pgind[i]) end
  end
  sdec.ui_pgind, sdec.ui_pgindtxt = nil, nil
  sdec.ui_pgind_w1, sdec.ui_pgind_n = nil, nil
  sdec.ui_pgind_w2, sdec.ui_pgind_m = nil, nil
  sdec.del_obj(sdec.ui_progbox)
  sdec.del_obj(sdec.ui_progline)
  sdec.ui_progbox, sdec.ui_progline = nil, nil
  sdec.del_obj(sdec.ui_scr)
  sdec.del_obj(sdec.ui_loadtxt)
  sdec.del_obj(sdec.ui_loadscr)
  sdec.ui_loadtxt, sdec.ui_loadscr = nil, nil
  sdec.ui_scr, sdec.ui_note = nil, nil
  sdec.ui_flab, sdec.ui_fval = nil, nil
  sdec.ui_row, sdec.ui_btn = nil, nil
  sdec.ui_rhx, sdec.ui_ras, sdec.ui_vr = nil, nil, nil
  sdec.ui_page_t, sdec.ui_log_t, sdec.ui_logc = nil, nil, nil
  sdec.ui_trig_t, sdec.ui_trighit, sdec.ui_trigc = nil, nil, nil
  sdec.ui_sb, sdec.ui_sbc, sdec.ui_rule = nil, nil, nil
  sdec.ui_invalidate()
  return true
end

-- A screen nobody is looking at, held in front while the real ones are assembled.
-- Creating a screen makes it the active one, which is why the operator can otherwise watch this app
-- build itself, in the wrong order, ending on a jump. Raised after every screen create, not once at
-- the start, and idempotent so the call sites do not have to care. Never fatal: the pool can be
-- exhausted, and a missing cover costs only a visible build.
function sdec.ui_loading_front()
  if sdec.ui_loadscr == nil then return false end
  display.changescreen(sdec.ui_loadscr)
  return true
end

function sdec.ui_loading_raise()
  if sdec.ui_loadscr == nil then
    local h = display.create(display.ROOT, display.OBJ_SCREEN, 'SERIAL DECODE')
    if h == nil then return false end
    sdec.ui_loadscr = h
    sdec.ui_loadtxt = display.create(h, display.OBJ_TEXT, 261, 214,
                                     'Loading, please wait...', 0xFFFFFF, display.FONT_MEDIUM)
  end
  display.changescreen(sdec.ui_loadscr)
  return true
end

-- Put the real screen in front and take the loading screen away. Switch first, delete second, the
-- rule ui_destroy follows. The switch is unconditional: a nil `showscr` read as "do not switch"
-- left the panel displaying a deleted object, so it falls back to SCREEN_HOME.
function sdec.ui_loading_clear(showscr)
  if showscr == nil then showscr = display.SCREEN_HOME end
  display.changescreen(showscr)
  if sdec.ui_loadscr == nil then return false end
  sdec.del_obj(sdec.ui_loadtxt)
  sdec.del_obj(sdec.ui_loadscr)
  sdec.ui_loadtxt, sdec.ui_loadscr = nil, nil
  return true
end

-- Build the main screen: status fields, dump rows, rules and buttons. `hold` keeps the loading
-- screen up for the caller, which only start() needs, it alone building a second screen afterwards.
function sdec.ui_build(hold)
  sdec.ui_destroy()
  sdec.ui_invalidate()

  local create = display.create
  local small, med = display.FONT_SMALL, display.FONT_MEDIUM
  local left = display.JUST_LEFT
  local x = sdec.ui_x

  sdec.ui_scr = create(display.ROOT, display.OBJ_SCREEN, sdec.ui_title_text())

  if sdec.ui_scr == nil then
    error('display object pool exhausted -- power cycle the instrument. (The firmware posts '
          .. 'event 1701 only once, then display.create returns nil silently.)', 0)
  end

  sdec.ui_loading_raise()

  sdec.ui_rule = {}
  local nr = 0
  local function rule(rx, ry, rw, rh)
    local h = create(sdec.ui_scr, display.OBJ_RECT, rx, ry, rw, rh)
    if h ~= nil then
      nr = nr + 1
      sdec.ui_rule[nr] = h
      sdec.ui_fill_solid(h)
      sdec.ui_fill(h, sdec.ui_c_rule)
    end
  end
  local rw = sdec.ui_rule_x1 - sdec.ui_rule_x0
  rule(sdec.ui_rule_x0, sdec.ui_stat_top, rw, 1)
  rule(sdec.ui_rule_x0, sdec.ui_stat_bot, rw, 1)
  rule(sdec.ui_rule_x0, sdec.ui_stat_top, 1, sdec.ui_stat_bot - sdec.ui_stat_top)
  rule(sdec.ui_rule_x1, sdec.ui_stat_top, 1, sdec.ui_stat_bot - sdec.ui_stat_top)
  rule(sdec.ui_stat_div, sdec.ui_stat_top, 1, sdec.ui_stat_bot - sdec.ui_stat_top)
  rule(sdec.ui_trig_div, sdec.ui_stat_top, 1, sdec.ui_stat_bot - sdec.ui_stat_top)
  rule(sdec.ui_rule_x0, sdec.ui_rule_top, rw, 1)
  rule(sdec.ui_rule_x0, sdec.ui_rule_hdr, rw, 1)
  rule(sdec.ui_rule_x0, sdec.ui_rule_mid, rw, 1)
  rule(sdec.ui_rule_x0, sdec.ui_rule_bot, rw, 1)
  rule(sdec.ui_rule_x0, sdec.ui_rule_top, 1, sdec.ui_rule_bot - sdec.ui_rule_top)
  rule(sdec.ui_rule_x1, sdec.ui_rule_top, 1, sdec.ui_rule_bot - sdec.ui_rule_top)
  rule(sdec.ui_fields[2].x - 9, sdec.ui_rule_mid, 1,
       sdec.ui_rule_bot - sdec.ui_rule_mid)

  sdec.ui_vr = {}
  local vi, vx
  for vi, vx in ipairs({sdec.ui_vr1_x, sdec.ui_vr2_x}) do
    local h = create(sdec.ui_scr, display.OBJ_RECT, vx, sdec.ui_vr_y0, 1,
                     sdec.ui_vr_y1 - sdec.ui_vr_y0)
    if h ~= nil then
      sdec.ui_fill_solid(h)
      sdec.ui_vr[vi] = h
    end
  end

  sdec.ui_flab, sdec.ui_fval = {}, {}
  sdec.ui_lockhit = nil

  local nf = table.getn(sdec.ui_fields)
  local j
  for j = 2, nf do
    rule(sdec.ui_fields[j].x - 9, sdec.ui_rule_top,
         1, sdec.ui_rule_mid - sdec.ui_rule_top)
  end
  for j = 1, nf do
    local fd = sdec.ui_fields[j]
    sdec.ui_flab[j] = create(sdec.ui_scr, display.OBJ_TEXT, fd.x + (fd.labdx or 0), sdec.ui_lab_y,
                             fd.lab, sdec.ui_c_lab, small, left)
    local fnt = small
    if fd.med then fnt = med end
    sdec.ui_fval[j] = create(sdec.ui_scr, display.OBJ_TEXT, fd.x, sdec.ui_val_y + (fd.dy or 0),
                             '--', fd.c, fnt, left)
  end
  local lx = 95
  sdec.ui_lock = {}
  local function lockpart(rx, ry, rw, rh)
    local h = create(sdec.ui_scr, display.OBJ_RECT, rx, ry, rw, rh)
    if h ~= nil then
      sdec.ui_lock[table.getn(sdec.ui_lock) + 1] = h
      sdec.ui_fill_solid(h)
      sdec.ui_fill(h, sdec.ui_c_auto)
    end
    return h
  end
  local lock_y = sdec.ui_lab_y + 5
  lockpart(lx + 2, lock_y + 0, 5, 1)     -- shackle: top bar
  lockpart(lx + 2, lock_y + 1, 1, 4)     -- shackle: left post
  lockpart(lx + 6, lock_y + 1, 1, 4)     -- shackle: right post
  sdec.ui_lockbody = lockpart(lx, lock_y + 5, 9, 7)   -- body

  sdec.ui_trigsrc_t = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_note_lab_x,
                             sdec.ui_note_y, sdec.ui_trigsrc.edge.name, sdec.ui_c_dim, small, left)
  sdec.ui_flab[nf + 1] = sdec.ui_trigsrc_t
  sdec.ui_note = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_note_val_x,
                        sdec.ui_note_y, '', sdec.ui_c_warn, small, left)

  sdec.ui_row, sdec.ui_rhx, sdec.ui_rhx2, sdec.ui_ras = {}, {}, {}, {}
  local i
  for i = 1, sdec.ui_nrow do
    local y = sdec.ui_row_y0 + (i - 1) * sdec.ui_row_dy
    sdec.ui_row[i] = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_col_ix, y, '',
                            sdec.ui_c_off, small, left)
    sdec.ui_rhx[i] = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_col_hx, y, '',
                            sdec.ui_c_data, small, left)
    sdec.ui_rhx2[i] = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_col_hx2, y, '',
                             sdec.ui_c_data, small, left)
    sdec.ui_ras[i] = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_col_as, y, '',
                            sdec.ui_c_data, small, left)
  end

  sdec.ui_sb = {}
  for i = 1, sdec.ui_sb_show and sdec.ui_sb_n or 0 do
    local sy = sdec.ui_row_y0 + (i - 1) * sdec.ui_row_dy
    local h = create(sdec.ui_scr, display.OBJ_RECT, sdec.ui_sb_x, sy,
                     sdec.ui_sb_w, sdec.ui_sb_h)
    sdec.ui_sb[i] = h
    sdec.ui_fill_solid(h)
    sdec.ui_fill(h, sdec.ui_c_sb_off)
  end
  sdec.ui_sbc = {}

  sdec.ui_progbox = create(sdec.ui_scr, display.OBJ_RECT, sdec.ui_prog_x, sdec.ui_prog_y,
                           sdec.ui_prog_w, sdec.ui_prog_h)
  sdec.ui_fill(sdec.ui_progbox, sdec.ui_c_prog_box)
  display.setthickness(sdec.ui_progbox, 1)
  sdec.ui_progline = create(sdec.ui_scr, display.OBJ_LINE, sdec.ui_prog_x + 1, sdec.ui_prog_ly,
                            sdec.ui_prog_x + 1, sdec.ui_prog_ly)
  sdec.ui_fill(sdec.ui_progline, sdec.ui_c_prog)
  display.setthickness(sdec.ui_progline, sdec.ui_prog_lw)
  sdec.ui_progbar_set(nil)

  local tobj = display.create(sdec.ui_scr, display.OBJ_TIMER, sdec.ui_tick_s,
                              display.TIMER_FOREVER)
  sdec.ui_tick_obj = nil
  if tobj ~= nil then sdec.ui_tick_obj = tobj end
  if sdec.ui_tick_obj ~= nil then
    display.setevent(sdec.ui_tick_obj, display.EVENT_PRESS, 'sdec.guard(sdec.ui_tick)')
  end

  sdec.ui_page_t = create(sdec.ui_scr, display.OBJ_TEXT, x, sdec.ui_stat_y, '',
                          sdec.ui_c_dim, small, left)
  sdec.ui_log_t = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_stat_div + 6,
                         sdec.ui_stat_y, '',
                         sdec.ui_c_dim, small, left)
  sdec.ui_trighit = nil
  sdec.ui_trig_t = create(sdec.ui_scr, display.OBJ_TEXT, sdec.ui_trig_x, sdec.ui_stat_y,
                          'TRIG', sdec.ui_c_warn, small, left)

  local by = sdec.ui_btn_y
  sdec.ui_btn = {}
  sdec.ui_allbtn = {}
  local b
  local bdef = {
    {x = 8,   w = 120, t = 'Capture',    e = 'sdec.capture'},
    {x = 152, w = 90,  t = 'View',       e = 'sdec.view_toggle'},
    {x = 266, w = 100, t = 'Mode',       e = 'sdec.mode_cycle'},
    {x = 390, w = 112, t = 'NewLog',     e = 'sdec.log_new', hide = 'ui_newlogbtn'},
    {x = 526, w = 112, t = 'Save',       e = 'sdec.save', hide = 'ui_savebtn'},
    {x = 662, w = 112, t = 'Options',    e = 'sdec.options'},
  }
  local pbw, lbw, mbw = 56, 140, 80
  local pdef = {
    {x = 785 - pbw, y = 58,  w = pbw, t = 'Up',        e = 'sdec.page_prev',  pg = true},
    {x = 785 - mbw, y = 126, w = mbw, t = 'Msgs',      e = 'sdec.msgs_show',  msg = true},
    {x = 785 - lbw, y = 194, w = lbw, t = 'Lock Rate', e = 'sdec.lock_toggle'},
    {x = 785 - pbw, y = 262, w = pbw, t = 'Dn',        e = 'sdec.page_next',  pg = true},
  }
  local pk, npg = nil, 0
  sdec.ui_pgbtn = {}
  for pk = 1, table.getn(pdef) do
    local pd = pdef[pk]
    local pb = create(sdec.ui_scr, display.OBJ_BUTTON, pd.x, pd.y, pd.t, pd.w)
    if pb ~= nil then
      display.setevent(pb, display.EVENT_PRESS, 'sdec.guard(' .. pd.e .. ')')
      sdec.ui_btn[table.getn(bdef) + pk] = pb
      sdec.ui_allbtn[table.getn(sdec.ui_allbtn) + 1] = pb
      if pd.pg then
        npg = npg + 1
        sdec.ui_pgbtn[npg] = pb
      elseif pd.msg then
        sdec.ui_msgbtn = pb
      else
        sdec.ui_lockbtn = pb
      end
    end
  end
  local xpage, xn, xof, xm = sdec.ui_pgind_layout()
  local ny = sdec.ui_note_y
  sdec.ui_pgind = {}
  local function pgpiece(px, pc, pj)
    local h = create(sdec.ui_scr, display.OBJ_TEXT, px, ny, '', pc, small, pj)
    if h ~= nil then sdec.ui_pgind[table.getn(sdec.ui_pgind) + 1] = h end
    return h
  end
  sdec.ui_pgind_w1 = pgpiece(xpage, sdec.ui_c_pgword, left)
  sdec.ui_pgind_n  = pgpiece(xn,    sdec.ui_c_pgnum,  display.JUST_RIGHT)
  sdec.ui_pgind_w2 = pgpiece(xof,   sdec.ui_c_pgword, left)
  sdec.ui_pgind_m  = pgpiece(xm,    sdec.ui_c_pgnum,  display.JUST_RIGHT)
  sdec.ui_pgindtxt = nil
  sdec.ui_pgvis = nil
  sdec.ui_lockvis = nil
  sdec.ui_savevis = nil
  sdec.ui_msgvis = nil
  sdec.ui_savebtn = nil
  sdec.ui_newlogbtn = nil
  local k
  local nb = 0
  for k = 1, table.getn(bdef) do
    local bd = bdef[k]
    b = create(sdec.ui_scr, display.OBJ_BUTTON, bd.x, by, bd.t, bd.w)
    if b ~= nil then
      display.setevent(b, display.EVENT_PRESS, 'sdec.guard(' .. bd.e .. ')')
      sdec.ui_btn[k] = b
      if bd.hide ~= nil then sdec[bd.hide] = b end
      sdec.ui_allbtn[table.getn(sdec.ui_allbtn) + 1] = b
      nb = nb + 1
    end
  end

  if nb < table.getn(bdef) then
    error(string.format('only %d of %d buttons could be created -- display object pool exhausted. '
                        .. 'Power cycle the instrument.', nb or 0, table.getn(bdef) or 0), 0)
  end

  if not hold then sdec.ui_loading_clear(sdec.ui_scr) end

  return sdec.ui_scr
end

-- Save and NewLog, shown only when something the app writes could reach the key. -> true if the
-- visibility changed. Its own function because two callers need it and one guard must not gate
-- both: ui_page_btns() returns early on a build whose Page buttons failed to create, and this block
-- sat after that return. ui_savevis is written here and nowhere else.
function sdec.ui_usb_btns()
if sdec.ui_savebtn ~= nil or sdec.ui_newlogbtn ~= nil then
  local sw = sdec.log_live()
  if sw ~= sdec.ui_savevis then
    local sst = display.STATE_INVISIBLE
    if sw then sst = display.STATE_ENABLE end
    if sdec.ui_savebtn ~= nil then
      display.setstate(sdec.ui_savebtn, sst)
    end
    if sdec.ui_newlogbtn ~= nil then
      display.setstate(sdec.ui_newlogbtn, sst)
    end
    sdec.ui_savevis = sw
    return true
  end
end
  return false
end

function sdec.ui_page_btns()
  sdec.ui_usb_btns()
  if sdec.ui_msgbtn ~= nil then
    local mw = sdec.msg_hidden()
    if mw ~= sdec.ui_msgvis then
      local mst = display.STATE_INVISIBLE
      if mw then mst = display.STATE_ENABLE end
      display.setstate(sdec.ui_msgbtn, mst)
      sdec.ui_msgvis = mw
    end
  end

  local t = sdec.ui_pgbtn
  if t == nil then return false end
  local npg = sdec.ui_npages()
  local want = false
  if npg > 1 then want = true end
  if sdec.ui_pgind_n ~= nil then
    local ptxt = sdec.ui_pgind_text()
    if ptxt ~= sdec.ui_pgindtxt then
      local w1, nn, w2, mm = '', '', '', ''
      if ptxt ~= '' then
        w1, w2 = 'page', 'of'
        nn, mm = tostring(sdec.ui_page + 1), tostring(npg)
      end
      sdec.ui_set(sdec.ui_pgind_w1, w1)
      sdec.ui_set(sdec.ui_pgind_n, nn)
      sdec.ui_set(sdec.ui_pgind_w2, w2)
      sdec.ui_set(sdec.ui_pgind_m, mm)
      sdec.ui_pgindtxt = ptxt
    end
  end
  if want ~= sdec.ui_pgvis then
    local st = display.STATE_INVISIBLE
    if want then st = display.STATE_ENABLE end
    local i
    for i = 1, table.getn(t) do
      display.setstate(t[i], st)
    end
    sdec.ui_pgvis = want
  end

  if sdec.ui_lockbtn ~= nil then
    local lw = false
    if sdec.lock_state ~= nil and sdec.lock_state() == 'auto' then lw = true end
    if lw ~= sdec.ui_lockvis then
      local lst = display.STATE_INVISIBLE
      if lw then lst = display.STATE_ENABLE end
      display.setstate(sdec.ui_lockbtn, lst)
      sdec.ui_lockvis = lw
    end
  end

  return true
end

-- Repaint from the current decode result. settext only, which keeps a refresh cheap.
function sdec.ui_refresh_do()
  sdec.ui_page_btns()
  if sdec.ui_scr == nil then return false end
  local set = sdec.ui_set

  local fv = sdec.ui_field_values()
  local j
  if sdec.ui_fvalc == nil then sdec.ui_fvalc = {} end
  for j = 1, table.getn(sdec.ui_fval) do
    set(sdec.ui_fval[j], fv[j] or '--')
    local want = sdec.ui_field_colour(j)
    if sdec.ui_fvalc[j] ~= want then
      sdec.ui_color(sdec.ui_fval[j], want)
      sdec.ui_fvalc[j] = want
    end
  end
  local lc = sdec.lock_colour()
  if sdec.ui_lockc ~= lc then
    local li
    for li = 1, table.getn(sdec.ui_lock or {}) do
      sdec.ui_fill(sdec.ui_lock[li], lc)
    end
    sdec.ui_lockc = lc
  end

  local tsrc = sdec.ui_trigsrc[sdec.trigmode or 'edge'] or sdec.ui_trigsrc.edge
  set(sdec.ui_trigsrc_t, tsrc.name)
  if sdec.ui_trigsrcc ~= tsrc.c then
    sdec.ui_color(sdec.ui_trigsrc_t, tsrc.c)
    sdec.ui_trigsrcc = tsrc.c
  end
  local ttl = sdec.ui_title_text()
  if sdec.ui_titletxt ~= ttl then
    display.settext(sdec.ui_scr, ttl)
    sdec.ui_titletxt = ttl
  end
  set(sdec.ui_note, sdec.ui_note_text())

  local per, cols = sdec.ui_bytes_per_page()
  local npg = sdec.ui_npages()
  if sdec.ui_page >= npg then sdec.ui_page = npg - 1 end
  if sdec.ui_page < 0 then sdec.ui_page = 0 end
  local base = sdec.ui_page * per

  local mode = sdec.ui_mode
  local vw = sdec.ui_cur()
  local r = sdec.res
  local hext, honscr = sdec.ui_head_extent()
  if not honscr then hext = nil end
  local i
  for i = 1, sdec.ui_nrow do
    local i0 = base + (i - 1) * cols + 1
    local txt, bad, hxs, hxs2, ass

    if vw.line ~= nil then
      txt = ''
      bad = false
      local fn = sdec[vw.line]
      if fn ~= nil then txt = fn(i0) end
      local pr = sdec[vw.res]
      if pr ~= nil and pr.kind ~= nil then bad = (pr.kind[i0] == 'err') end
    else
      if mode == 'hex' then txt, hxs, hxs2, ass = sdec.ua_hex_parts_line(i0, cols)
      else txt = sdec.ua_text_line(i0, cols) end
      bad = false
      if hext ~= nil and i0 <= hext then bad = true end
      if r ~= nil then
        local j
        for j = i0, i0 + cols - 1 do
          if j <= r.nf and r.errs[j] ~= nil then bad = true end
        end
      end
    end

    set(sdec.ui_row[i], txt)
    set(sdec.ui_rhx[i], hxs or '')
    set(sdec.ui_rhx2[i], hxs2 or '')
    set(sdec.ui_ras[i], ass or '')
    local want = sdec.ui_c_data
    if bad then want = sdec.ui_c_err end
    if sdec.ui_rowc == nil then sdec.ui_rowc = {} end
    if sdec.ui_rowo == nil then sdec.ui_rowo = {} end
    local woff = want
    if mode == 'hex' then
      woff = sdec.ui_c_off
      if bad then woff = want end
    end
    if sdec.ui_rowc[i] ~= want or sdec.ui_rowo[i] ~= woff then
      sdec.ui_rowo[i] = woff
      sdec.ui_color(sdec.ui_row[i], woff)
      sdec.ui_color(sdec.ui_rhx[i], want)
      sdec.ui_color(sdec.ui_rhx2[i], want)
      sdec.ui_color(sdec.ui_ras[i], want)
      sdec.ui_rowc[i] = want
    end
  end

  local vwant = sdec.ui_c_hide
  if mode == 'hex' then
    vwant = sdec.ui_c_rule
  end
  if sdec.ui_vrc ~= vwant then
    local vi
    for vi = 1, table.getn(sdec.ui_vr or {}) do
      sdec.ui_fill(sdec.ui_vr[vi], vwant)
    end
    sdec.ui_vrc = vwant
  end

  sdec.ui_bar(npg)

  local nit = sdec.ui_nitems()
  local mname = vw.name or 'TEXT'
  local st = sdec.ui_status
  if sdec.proto ~= nil and sdec.proto ~= 'uart' then
    st = string.upper(sdec.proto) .. ' ' .. st
  end
  local warn = ''
  if (sdec.delfails or 0) > 0 then
    warn = string.format('  del?%d', sdec.delfails or 0)
  end
  local md = sdec.mode_cur()
  if md.view and sdec.ck_tot == nil and not sdec.ck_running then
    local capn = nil
    if sdec.res ~= nil then
      capn = sdec.window_bytes(sdec.baud, sdec.res.nbits, sdec.res.par, sdec.res.nstop)
    end
    local wintxt = ''
    if capn ~= nil and capn > 0 then wintxt = string.format(' win %d', capn or 0) end
    set(sdec.ui_page_t, string.format('%s %s pg %d/%d %s %d-%d/%d%s [%s]%s',
        tostring(md.name), tostring(mname), sdec.ui_page + 1, npg or 0, tostring(sdec.ui_unit()),
        math.min(base + 1, nit), math.min(base + per, nit), nit or 0, tostring(wintxt), tostring(st), tostring(warn)))
  else
    set(sdec.ui_page_t, string.format('%s  %s%s', tostring(md.name), tostring(sdec.ck_status()), tostring(warn)))
  end
  sdec.ui_progbar_set(sdec.ck_pct())
  local trigtxt, trigcol = '', sdec.ui_c_dim
  local tin, tout = (sdec.trigext == true), (sdec.fc_out == true)
  if tin and tout then trigtxt, trigcol = 'TRIG I/O', sdec.ui_c_extio
  elseif tin then trigtxt, trigcol = 'TRIG IN', sdec.ui_c_extin
  elseif tout then trigtxt, trigcol = 'TRIG OUT', sdec.ui_c_extout
  end
  if tin and sdec.trigmode == 'free' then trigtxt = trigtxt .. '?' end
  set(sdec.ui_trig_t, trigtxt)
  if sdec.ui_trigc ~= trigcol then
    sdec.ui_color(sdec.ui_trig_t, trigcol)
    sdec.ui_trigc = trigcol
  end

  set(sdec.ui_log_t, sdec.ui_runnote())
  return true
end

-- Refresh the panel, and never raise doing it. -> true, or false if the body gave up part way.
-- One guard here, not one at each call site: sixteen callers wrapped this in a pcall of their own,
-- which guards app code rather than a firmware boundary, where what they feared was this body
-- formatting a nil. A refresh is cosmetic and must not cost its caller a correct capture.
function sdec.ui_refresh()
  return (pcall(sdec.ui_refresh_do))
end

-- The byte log, for the status row: which file is being appended to, and how many BYTES are in it
-- so far. Both, always, in every mode, the app's promise being that no decoded byte is lost.
-- It has 188 px and the obvious form does not fit, so the '.txt' goes and the name gives way,
-- trimmed from the left with a '~'; the count never does, being what audits the promise --
-- docs/MEASUREMENTS.md, 'The three status row cells'.
function sdec.flog_status()
  if sdec.flog_why ~= nil then return 'log: NOT LOGGING' end
  if not sdec.log_live() then return 'log: no USB key' end
  local path, n = sdec.flog_path, sdec.flog_bytes or 0
  if path == nil then
    local gen = (ulog ~= nil and ulog.keygen) or 0
    if sdec.flog_last == nil or sdec.flog_lastgen ~= gen then return 'log: on first capture' end
    path, n = sdec.flog_last, sdec.flog_lastbytes or 0
  end
  local base = string.gsub(tostring(path), '^.*/', '')
  base = string.gsub(base, '%.txt$', '')
  local s = string.format('log: %s  %d B', tostring(base), n)
  local first = true
  while sdec.ui_textw(s) > sdec.ui_log_px and string.len(base) > 4 do
    if first then base = string.sub(base, 5) else base = string.sub(base, 2) end
    first = false
    s = string.format('log: ~%s  %d B', tostring(base), n or 0)
  end
  return s
end

-- The streaming modes' status text: progress while running, then the outcome. Separate from
-- ui_refresh so sdec.progress() can write the same object once a second without touching the other
-- ~20, every display call being an IPC round trip.
function sdec.ck_status()
  local t = sdec.ck_tot
  local md = sdec.mode_cur()
  if sdec.ck_running then
    if sdec.strm_recording then return 'recording -- press Capture to stop' end
    local wtxt = ''
    if sdec.fc_out then
      wtxt = string.format(' win %d/%d', (sdec.fc_win or 0) + 1, sdec.fc_maxwin or 32)
    end
    if sdec.ck_nbytes == nil or sdec.ck_nbytes < 1 then
      local have, want = sdec.ck_acq_have or 0, sdec.ck_acq_want or 0
      local pct = 0
      if want > 0 then pct = math.floor(100 * have / want) end
      if wtxt ~= '' then return string.format('recording...%s %d %%', tostring(wtxt), pct or 0) end
      return string.format('recording... %d %% of the buffer', pct)
    end
    local cap = md.cap
    if cap ~= nil then
      if wtxt ~= '' then
        return string.format('decoding...%s %d/%d', tostring(wtxt), sdec.ck_nbytes or 0, cap or 0)
      end
      return string.format('decoding... %d/%d bytes', sdec.ck_nbytes or 0, cap or 0)
    end
    if wtxt ~= '' then return string.format('decoding...%s %d', tostring(wtxt), sdec.ck_nbytes or 0) end
    return string.format('decoding... %d bytes', sdec.ck_nbytes or 0)
  end
  if t == nil then
    if sdec.mode_why(md) ~= nil then return 'not armed -- see the note' end
    if md.cap ~= nil then
      if not sdec.log_live() then
        local keep = sdec.ck_keep
        if keep ~= nil and keep < md.cap then
          return string.format('ready -- %d bytes, panel keeps the last %d', md.cap or 0, keep or 0)
        end
        return string.format('ready -- %d bytes, panel only (no USB key)', md.cap or 0)
      end
      return string.format('ready -- %d bytes to a file, no stop once started', md.cap or 0)
    end
    return 'ready -- no cap'
  end
  local base = 'NOT recorded'
  if t.path ~= nil then base = string.gsub(tostring(t.path), '^.*/', '') end
  if (sdec.fc_win or 0) > 1 then
    return string.format('%d bytes in %d windows -> %s  [%s]',
                         sdec.fc_bytes or 0, sdec.fc_win or 0, tostring(base),
                         sdec.fc_end or t.stopped or 'done')
  end
  return string.format('%d bytes  %d err  %d win  -> %s  [%s]',
                       t.nf or 0, sdec.ck_err_n(t) or 0, t.nwin or 0, tostring(base), t.stopped or 'done')
end

-- The fraction the progress bar shows, 0..100, or nil when no honest one exists. The two phases
-- have different denominators, as ck_status's text does: per cent of the buffer, then bytes against
-- the cap. nil for a press-driven recording, where a bar would hold 0 for the whole run.
function sdec.ck_pct()
  if not sdec.ck_running then return nil end
  if sdec.strm_recording then return nil end
  if sdec.ck_nbytes == nil or sdec.ck_nbytes < 1 then
    local want = sdec.ck_acq_want or 0
    if want <= 0 then return nil end
    return 100 * (sdec.ck_acq_have or 0) / want
  end
  local cap = sdec.mode_cur().cap
  if cap == nil or cap <= 0 then return nil end
  return 100 * sdec.ck_nbytes / cap
end

-- The streaming status row: its text and its bar, written together so the two cannot disagree about
-- which phase the run is in. sdec.progress and sdec.progress_samples are the callers, one per phase.
-- Never raises, and the one guard that promises it lives here, not at either call site:
-- ck_status() is a 130-line text builder, so "this cannot raise" is a proof that would have to be
-- redone at every edit, and this row is painted from the capture loop, which cannot afford depth.
function sdec.progress_row()
  return (pcall(sdec.progress_row_do))
end

-- The row itself: one settext and one setfill. -> ui_progbar_set's verdict.
function sdec.progress_row_do()
  local md = sdec.mode_cur()
  sdec.ui_set(sdec.ui_page_t, string.format('%s  %s', tostring(md.name), tostring(sdec.ck_status())))
  return sdec.ui_progbar_set(sdec.ck_pct())
end

-- One settext and one setfill, at ~1 Hz. A bare call: progress_row() carries the guard.
function sdec.progress(nbytes)
  sdec.ck_nbytes = nbytes
  return sdec.progress_row()
end

-- Light the segments covering the current page; a single-page capture lights the whole bar.
function sdec.ui_bar(npg)
  if sdec.ui_sb == nil or table.getn(sdec.ui_sb) == 0 then return false end
  if npg == nil or npg < 1 then npg = 1 end
  local n = sdec.ui_sb_n
  local floor = math.floor

  local a = floor(sdec.ui_page * n / npg) + 1
  local b = floor((sdec.ui_page + 1) * n / npg)
  if b < a then b = a end          -- more pages than segments: at least one lit
  if a < 1 then a = 1 end
  if b > n then b = n end

  if sdec.ui_sbc == nil then sdec.ui_sbc = {} end
  local i
  for i = 1, n do
    local want = sdec.ui_c_sb_off
    if i >= a and i <= b then want = sdec.ui_c_sb_on end
    if sdec.ui_sbc[i] ~= want then
      if sdec.ui_fill(sdec.ui_sb[i], want) then sdec.ui_sbc[i] = want end
    end
  end
  return true
end

sdec.opt_bits_v  = {nil, nil, 5, 6, 7, 8, 9, n = 7}
sdec.opt_par_v   = {nil, 0, 1, 2, n = 4}             -- entry 1 = Auto
sdec.opt_msb_v   = {nil, false, true, n = 3}
sdec.opt_proto_all = {
  {v = 'uart', label = 'UART', need = nil},
  {v = 'midi', label = 'MIDI', need = 'mi_parse'},
  {v = 'lin',  label = 'LIN',  need = 'li_parse'},
  n = 3,
}

-- The subset this build can offer, values and labels. Computed on demand for the same ordering
-- reason as sdec.ui_view_avail(): the offline harnesses load the protocol modules after serial_ui.
function sdec.opt_proto_list()
  local vals, labs, n, i = {}, {}, 0, nil
  for i = 1, sdec.opt_proto_all.n do
    local e = sdec.opt_proto_all[i]
    if e.need == nil or sdec[e.need] ~= nil then
      n = n + 1
      vals[n] = e.v
      labs[n] = e.label
    end
  end
  vals.n, labs.n = n, n
  return vals, labs
end
sdec.opt_trig_v  = {'edge', 'free', 'front', n = 3}
sdec.opt_rear_v  = {{false, false}, {true, false}, {false, true}, {true, true}, n = 4}

-- Which Protocol entry `name` sits at. A reverse lookup, not a second list that would drift.
function sdec.opt_proto_i(name)
  local vals = sdec.opt_proto_list()
  local i
  for i = 1, vals.n do
    if vals[i] == name then return i end
  end
  return 1
end

-- Read one options field back as the value it stands for.
function sdec.opt_pick(tbl, idx)
  if tbl == nil then return nil end
  local n = tbl.n or table.getn(tbl)
  if type(idx) ~= 'number' then return tbl[1] end
  local i = math.floor(idx + 0.5)
  if i < 1 then i = 1 end
  if i > n then i = n end
  return tbl[i]
end

sdec.msg_nrow   = 21
sdec.msg_row_y0 = 8
sdec.msg_row_dy = 18
sdec.msg_cols   = 80
sdec.msg_page   = 0
sdec.msg_btn_y  = sdec.ui_btn_y
sdec.msg_settle = sdec.msg_settle or 0.2

-- Is the note cell withholding anything? -> true/false, and the note count. The one source of truth
--   [...]
-- would eventually disagree with the cell it describes.
-- The page counter takes width off the same cell (ui_pgind_px), so one note can fit at 'page 1 of 1'
-- and be clipped at 'page 9 of 35'. Not a glitch: by then it genuinely is cut off.
function sdec.msg_hidden()
  local t, m = sdec.ui_notes()
  if m < 1 then return false, 0 end
  if m > 1 then return true, m end
  local px = sdec.ui_note_px - sdec.ui_pgind_px()
  return sdec.ui_fit(t[1], px) ~= t[1], m
end

-- The last space at or before `room`, so a note breaks between words; `room` itself when there is no
-- space to break at, which hard-wraps a long unbroken token rather than looping for ever.
function sdec.msg_wrap_at(s, room)
  if room < 1 then return 1 end
  local i
  for i = room + 1, 2, -1 do
    if string.sub(s, i, i) == ' ' then return i - 1 end
  end
  return room
end

-- EVERY NOTE WRAPPED INTO ROWS -> a flat list of row strings, and how many.
-- Wrapped and not fitted: truncating here would reproduce the exact problem this screen exists to
-- solve. Numbered once per note, with continuations indented, so a wrapped tail is not mistaken for
-- a new message.
function sdec.msg_lines()
  local t, m = sdec.ui_notes()
  local out, n, i = {}, 0, nil
  for i = 1, m do
    local s, pre = tostring(t[i]), string.format('%2d  ', i)
    local guard = 0
    while guard < 20 do
      guard = guard + 1
      local room = sdec.msg_cols - string.len(pre)
      if string.len(s) <= room then
        n = n + 1
        out[n] = pre .. s
        break
      end
      local cut = sdec.msg_wrap_at(s, room)
      n = n + 1
      out[n] = pre .. string.sub(s, 1, cut)
      s = string.sub(s, cut + 1)
      while string.sub(s, 1, 1) == ' ' do s = string.sub(s, 2) end
      pre = '    '
      if s == '' then break end
    end
  end
  return out, n
end

-- One row per wrapped line, so a page is rows.
function sdec.msg_per_page()
  return sdec.msg_nrow
end

function sdec.msg_npages()
  local _, nl = sdec.msg_lines()
  if nl == nil or nl <= 0 then return 1 end
  local per = sdec.msg_per_page()
  return math.floor((nl + per - 1) / per)
end

-- Delete every object this screen owns and nil its handles, in creation order's reverse: children
-- before the screen, each visited exactly once. The object-lifetime rule -- delete, nil, then create.
function sdec.destroy_msgs()
  local i
  if sdec.msg_row ~= nil then
    for i = 1, table.getn(sdec.msg_row) do sdec.del_obj(sdec.msg_row[i]) end
  end
  sdec.msg_row = nil
  sdec.del_obj(sdec.msg_ind)
  sdec.del_obj(sdec.msg_up)
  sdec.del_obj(sdec.msg_dn)
  sdec.del_obj(sdec.msg_back)
  sdec.msg_ind, sdec.msg_up, sdec.msg_dn, sdec.msg_back = nil, nil, nil, nil
  sdec.del_obj(sdec.msgscr)
  sdec.msgscr = nil
  return true
end

-- Build it. -> the screen handle, or nil with sdec.msg_why set. No raise and no pcall: display.create
-- returns nil when the pool is gone and posts nothing, so the refusal is a return value to check.
function sdec.build_msgs()
  sdec.destroy_msgs()
  local create = display.create
  sdec.msg_why = nil
  sdec.msgscr = create(display.ROOT, display.OBJ_SCREEN, 'SERIAL DECODE MESSAGES')
  if sdec.msgscr == nil then
    sdec.msg_why = 'display object pool exhausted -- power cycle the instrument'
    return nil
  end
  local small, left = display.FONT_SMALL, display.JUST_LEFT
  sdec.msg_row = {}
  local i
  for i = 1, sdec.msg_nrow do
    local y = sdec.msg_row_y0 + (i - 1) * sdec.msg_row_dy
    local h = create(sdec.msgscr, display.OBJ_TEXT, sdec.ui_x, y, '', sdec.ui_c_data, small, left)
    if h == nil then
      sdec.msg_nrow = i - 1
      break
    end
    sdec.msg_row[i] = h
  end
  if sdec.msg_nrow < 1 then
    sdec.destroy_msgs()
    sdec.msg_why = 'no display objects left for a message row'
    return nil
  end
  sdec.msg_ind = create(sdec.msgscr, display.OBJ_TEXT, sdec.ui_x,
                        sdec.msg_btn_y - sdec.msg_row_dy - 4, '', sdec.ui_c_pgword, small, left)
  local bw = 110
  sdec.msg_up   = create(sdec.msgscr, display.OBJ_BUTTON, 8,   sdec.msg_btn_y, 'Up',   bw)
  sdec.msg_dn   = create(sdec.msgscr, display.OBJ_BUTTON, 132, sdec.msg_btn_y, 'Dn',   bw)
  sdec.msg_back = create(sdec.msgscr, display.OBJ_BUTTON, 662, sdec.msg_btn_y, 'Back', 112)
  if sdec.msg_up   ~= nil then display.setevent(sdec.msg_up,   display.EVENT_PRESS,
                                                'sdec.guard(sdec.msgs_prev)') end
  if sdec.msg_dn   ~= nil then display.setevent(sdec.msg_dn,   display.EVENT_PRESS,
                                                'sdec.guard(sdec.msgs_next)') end
  if sdec.msg_back ~= nil then display.setevent(sdec.msg_back, display.EVENT_PRESS,
                                                'sdec.guard(sdec.msgs_close)') end
  return sdec.msgscr
end

-- Write the current page into the rows. Separate from the build so paging costs no allocation.
function sdec.msgs_refresh()
  if sdec.msg_row == nil then return false end
  local npg = sdec.msg_npages()
  if sdec.msg_page >= npg then sdec.msg_page = npg - 1 end
  if sdec.msg_page < 0 then sdec.msg_page = 0 end
  local base = sdec.msg_page * sdec.msg_per_page()
  local ls, nl = sdec.msg_lines()
  local i
  for i = 1, sdec.msg_nrow do
    local k = base + i
    local s = ''
    if ls ~= nil and k <= nl then s = ls[k] end
    display.settext(sdec.msg_row[i], s)
  end
  if sdec.msg_up ~= nil and sdec.msg_dn ~= nil then
    local pst = display.STATE_INVISIBLE
    if npg > 1 then pst = display.STATE_ENABLE end
    display.setstate(sdec.msg_up, pst)
    display.setstate(sdec.msg_dn, pst)
  end

  if sdec.msg_ind ~= nil then
    local _, nm = sdec.ui_notes()
    local last = base + sdec.msg_per_page()
    if last > nl then last = nl end
    local shown = base + 1
    if nl < 1 then shown = 0 end
    display.settext(sdec.msg_ind,
                    string.format('page %d of %d   line %d-%d of %d   (%d note%s)',
                                  sdec.msg_page + 1, npg, shown, last, nl, nm,
                                  nm == 1 and '' or 's'))
  end
  return true
end

-- Open it, from the Msgs button in the margin.
--   [...]
-- case and nothing reached the event log, so only a grab could find it, and it did so after the
-- offline suite had passed. The main screen never needed this: its 2 Hz tick refreshes again within
-- 500 ms, so a lost write there repairs itself. This screen refreshes only when asked.
function sdec.msgs_show()
  if sdec.build_msgs() == nil then
    sdec.lasterr = sdec.msg_why or 'could not build the messages screen'
    return false
  end
  sdec.msg_page = 0
  display.changescreen(sdec.msgscr)
  delay(sdec.msg_settle)
  sdec.msgs_refresh()
  return true
end

function sdec.msgs_next()
  if sdec.msg_page + 1 < sdec.msg_npages() then sdec.msg_page = sdec.msg_page + 1 end
  return sdec.msgs_refresh()
end

function sdec.msgs_prev()
  if sdec.msg_page > 0 then sdec.msg_page = sdec.msg_page - 1 end
  return sdec.msgs_refresh()
end

-- Back to the main screen, and the order is the object-lifetime rule: switch away FIRST, then delete.
-- Deleting the screen while the panel is showing it is the case the front panel cannot recover from.
function sdec.msgs_close()
  local to = sdec.ui_scr
  if to == nil then to = display.SCREEN_HOME end
  display.changescreen(to)
  sdec.destroy_msgs()
  return true
end

function sdec.destroy_options()
  if sdec.optscr ~= nil then
    local scr = sdec.ui_scr
    if scr == nil then scr = display.SCREEN_HOME end
    display.changescreen(scr)
    if sdec.ui_scr ~= nil then sdec.ui_tick_on() end
  end
  sdec.del_obj(sdec.opt_proto)
  sdec.del_obj(sdec.opt_baud)
  sdec.del_obj(sdec.opt_bits)
  sdec.del_obj(sdec.opt_par)
  sdec.del_obj(sdec.opt_msb)
  sdec.del_obj(sdec.opt_pol)
  sdec.del_obj(sdec.opt_trig)
  sdec.del_obj(sdec.opt_ext)
  sdec.del_obj(sdec.opt_armv)
  sdec.del_obj(sdec.opt_armw)
  sdec.del_obj(sdec.opt_over)
  if sdec.opt_btn ~= nil then
    local i
    for i = 1, table.getn(sdec.opt_btn) do sdec.del_obj(sdec.opt_btn[i]) end
    sdec.opt_btn = nil
  end
  sdec.del_obj(sdec.optscr)
  sdec.optscr, sdec.opt_proto, sdec.opt_baud = nil, nil, nil
  sdec.opt_bits, sdec.opt_par, sdec.opt_pol = nil, nil, nil
  sdec.opt_msb = nil
  sdec.opt_trig, sdec.opt_ext = nil, nil
  sdec.opt_armv, sdec.opt_armw = nil, nil
  sdec.opt_over = nil
  return true
end

-- Build the options screen, its edit fields and its four buttons. Returns the screen handle.
function sdec.build_options()
  sdec.destroy_options()
  local create = display.create
  local y0, dy, x = sdec.ui_opt_y0, sdec.ui_opt_dy, sdec.ui_opt_x
  local pv, pl = sdec.opt_proto_list()
  local nf = 10
  if pl.n >= 2 then nf = 11 end
  local eh, edy = sdec.ui_opt_edit_h, sdec.ui_opt_edit_dy
  local ncols = sdec.ui_opt_cols or 1
  if ncols < 1 then ncols = 1 end
  local nrows = math.ceil(nf / ncols)
  local maxdy = math.floor((sdec.ui_opt_btn_y - (sdec.ui_opt_btn_gap or 0) - y0 - edy - eh) /
                           (nrows - 1))
  if dy > maxdy then dy = maxdy end
  local used = (nrows - 1) * dy + eh + edy
  local spare = sdec.ui_opt_btn_y - used - y0
  if spare > 0 then y0 = y0 + math.floor(spare / 2) end
  local adj = sdec.ui_opt_y_adj or 0
  if y0 + adj >= 0 then y0 = y0 + adj end
  if dy < eh then
    dy = eh
    y0 = sdec.ui_opt_btn_y - edy - eh - (nrows - 1) * dy
    if y0 < 0 then y0 = 0 end
  end
  sdec.ui_opt_dy_used, sdec.ui_opt_nf_used, sdec.ui_opt_y0_used = dy, nf, y0
  local row = 0
  local function nextpos()
    local c = math.floor(row / nrows)
    if c > ncols - 1 then c = ncols - 1 end
    local fx = x
    if c > 0 then fx = sdec.ui_opt_x_c2 end
    local fy = y0 + (row - c * nrows) * dy
    row = row + 1
    return fx, fy
  end

  sdec.optscr = create(display.ROOT, display.OBJ_SCREEN, 'SERIAL DECODE OPTIONS')

  if sdec.optscr == nil then
    error('display object pool exhausted building the options screen -- power cycle the '
          .. 'instrument.', 0)
  end

  local covermine = false
  if sdec.ui_loadscr == nil then
    covermine = sdec.ui_loading_raise()
  else
    sdec.ui_loading_front()
  end

  if pl.n >= 3 then
    local fx1, fy1 = nextpos()
    sdec.opt_proto = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx1, fy1,
                            'Protocol', 'wire parameters',
                            pl[1], pl[2], pl[3])
  elseif pl.n == 2 then
    local fx2, fy2 = nextpos()
    sdec.opt_proto = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx2, fy2,
                            'Protocol', 'sets the wire parameters', pl[1], pl[2])
  end
  local fx3, fy3 = nextpos()
  sdec.opt_baud = create(sdec.optscr, display.OBJ_EDIT_NUMBER, fx3, fy3,
                         'Baud Rate', '0 = auto-detect',
                         display.NFORMAT_PREFIX, 0, 0, 1000000, 'Bd')
  local fx4, fy4 = nextpos()
  sdec.opt_bits = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx4, fy4,
                         'Data Bits', 'auto, or fix it',
                         'Auto (7/8)', 'Auto (any)', '5', '6', '7', '8', '9')
  local fx5, fy5 = nextpos()
  sdec.opt_par = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx5, fy5,
                        'Parity', 'auto or fixed',
                        'Auto', 'None', 'Even', 'Odd')
  local fx6b, fy6b = nextpos()
  sdec.opt_msb = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx6b, fy6b,
                        'Bit Order', 'LSB unless told',
                        'Auto', 'LSB first', 'MSB first')
  local fx6, fy6 = nextpos()
  sdec.opt_pol = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx6, fy6,
                        'Polarity', 'idle level',
                        'Auto', 'Idle high', 'Idle low')
  local fx7, fy7 = nextpos()
  sdec.opt_trig = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx7, fy7,
                         'Trigger', 'capture start',
                         sdec.ui_trigsrc[sdec.opt_trig_v[1]].name,
                         sdec.ui_trigsrc[sdec.opt_trig_v[2]].name,
                         sdec.ui_trigsrc[sdec.opt_trig_v[3]].name)
  local fx8, fy8 = nextpos()
  sdec.opt_ext = create(sdec.optscr, display.OBJ_EDIT_OPTION, fx8, fy8,
                        'Rear BNC', 'trig in / FC out',
                        'Off', 'Trig In', 'FC Out', 'In + FC Out')

  local fx9, fy9 = nextpos()
  sdec.opt_armv = create(sdec.optscr, display.OBJ_EDIT_NUMBER, fx9, fy9,
                         'Arm At', 'wake-up level',
                         display.NFORMAT_PREFIX, sdec.arm_level_v(),
                         sdec.armlevel_min, sdec.armlevel_max, 'V', 4)
  local fx10, fy10 = nextpos()
  sdec.opt_armw = create(sdec.optscr, display.OBJ_EDIT_NUMBER, fx10, fy10,
                         'Arm/Idle Wait', 'max wait, frozen',
                         display.NFORMAT_PREFIX, sdec.arm_wait_s(),
                         sdec.armwait_min, sdec.armwait_max, 's', 4)
  local fx12, fy12 = nextpos()
  sdec.opt_over = create(sdec.optscr, display.OBJ_EDIT_NUMBER, fx12, fy12,
                         'Over-read', '0 off, idle margin',
                         display.NFORMAT_PREFIX, (sdec.strm_overread or 0) * 100,
                         0, (sdec.overread_max or 0.5) * 100, '%', 4)

  sdec.opt_btn = {}
  local odef = {
    {i = 4, x = 22,  w = 200, t = 'Auto Detect',   e = 'sdec.options_auto'},
    {i = 1, x = 234, w = 220, t = 'Lock Detected', e = 'sdec.options_lock'},
    {i = 2, x = 466, w = 150, t = 'Apply',         e = 'sdec.options_apply'},
    {i = 3, x = 628, w = 150, t = 'Cancel',        e = 'sdec.options_cancel'},
  }
  local ok, nob = nil, 0
  for ok = 1, table.getn(odef) do
    local od = odef[ok]
    local ob = create(sdec.optscr, display.OBJ_BUTTON, od.x, sdec.ui_opt_btn_y, od.t, od.w)
    if ob ~= nil then
      display.setevent(ob, display.EVENT_PRESS, 'sdec.guard(' .. od.e .. ')')
      sdec.opt_btn[od.i] = ob
      nob = nob + 1
    end
  end
  if nob < table.getn(odef) then
    error(string.format('only %d of %d options buttons could be created -- display object pool '
                        .. 'exhausted. Power cycle the instrument.', nob or 0, table.getn(odef) or 0), 0)
  end

  display.setevent(sdec.optscr, display.EVENT_ENDAPP, 'sdec.guard(sdec.cleanup)')

  if covermine then sdec.ui_loading_clear(sdec.optscr) end
  return sdec.optscr
end


-- ================= tsp/serial_app.tsp =================
sdec = sdec or {}

sdec.delfails  = sdec.delfails or 0
sdec.errcount  = sdec.errcount or 0
sdec.busy      = sdec.busy or false
sdec.usbdir    = sdec.usbdir or (ulog ~= nil and ulog.usbdir) or '/usb1/SERDEC'
sdec.logpath   = sdec.logpath or (sdec.usbdir .. '/serial_decode_log.txt')
sdec.flogpfx   = sdec.flogpfx or (sdec.usbdir .. '/bytes')
sdec.savepfx   = sdec.savepfx or (sdec.usbdir .. '/serial_')
if sdec.logpath == '/usb1/serial_decode_log.txt' then
  sdec.logpath = sdec.usbdir .. '/serial_decode_log.txt'
end
if sdec.flogpfx == '/usb1/bytes' then sdec.flogpfx = sdec.usbdir .. '/bytes' end
if sdec.savepfx == '/usb1/serial_' then sdec.savepfx = sdec.usbdir .. '/serial_' end
sdec.saveext   = sdec.saveext or '.txt'
sdec.proto     = sdec.proto or 'uart'
if sdec.strm_press == nil then sdec.strm_press = false end
sdec.strm_maxsec = sdec.strm_maxsec or 1200
sdec.strm_fallback_s = sdec.strm_fallback_s or 20
sdec.strm_overread = sdec.strm_overread or 0.10
sdec.overread_max = sdec.overread_max or 0.50
-- Drop a decode result a later pass has invalidated, and nothing else. Returns true.
-- A pass failing at acquire() returns before any decode, so the previous pass's result survives beside
-- the failed capture's rate. docs/MEASUREMENTS.md, 'A failed re-capture leaves a stale fit'. Not
-- clear_result(), whose probe_note and lasterr are the only record of what failed here.
function sdec.drop_stale_result()
  sdec.res, sdec.midi, sdec.lin = nil, nil, nil
  sdec.baud, sdec.baud_raw, sdec.bittime = nil, nil, nil
  sdec.snapped, sdec.fitq, sdec.snapfirm = false, 0, true
  sdec.fmt_note, sdec.baud_note, sdec.rate_note = nil, nil, nil
  return true
end

function sdec.clear_result()
  sdec.res, sdec.midi, sdec.lin = nil, nil, nil
  sdec.baud, sdec.baud_raw, sdec.bittime = nil, nil, nil
  sdec.snapped, sdec.fitq, sdec.snapfirm = false, 0, true
  sdec.lo, sdec.hi, sdec.family = nil, nil, '?'
  sdec.vmin, sdec.vmax, sdec.wlo, sdec.whi = nil, nil, nil, nil
  sdec.thr, sdec.hyst, sdec.swing = 0, 0, 0
  sdec.ne, sdec.ei, sdec.es = 0, nil, nil
  sdec.smp, sdec.nread = nil, 0
  sdec.fmt_note, sdec.baud_note, sdec.rate_note = nil, nil, nil
  sdec.lasterr, sdec.savedas, sdec.probe_idle = nil, nil, nil
  sdec.clear_measured()
  sdec.mode_exited, sdec.lognote, sdec.autolocknote = nil, nil, nil
  sdec.mode_exitbad = false
  sdec.strm_releveled, sdec.proto_why = nil, nil
  sdec.probe_note = nil                 -- set by autoset() when it had to re-capture slower
  collectgarbage()
  return true
end

-- Drop the whole lock -- every forced setting, not just the rate. Returns true. All five or none:
-- clearing force_baud alone leaves the format pinned, because autolock_try() sets nbits, par and nstop
-- with the rate, and the app then decides the format from the previous capture's answer.
function sdec.unlock_all()
  sdec.force_baud, sdec.force_nbits = nil, nil
  sdec.force_par, sdec.force_nstop, sdec.force_invert = nil, nil, nil
  sdec.autolock_set = nil
  return true
end

-- Everything the app and the decoder learned, back to a known value, before any attempt to determine
-- a baud rate or decode. Returns true. Called once per press at the top of capture().
-- What it adds over clear_result() plus clear_measured() is the requested sample rate, which they must
-- not touch. docs/MEASUREMENTS.md, 'fs_want: the second pass of autoset'. It does not unlock: a forced
-- rate is the operator's, and a harness that wants a virgin app calls sdec.unlock_all() first.
function sdec.detect_reset()
  sdec.clear_result()
  sdec.fs_want = nil
  sdec.fs_select()
  return true
end

-- Capture orchestration
-- The one armed capture a silent line gets. Reached from autoset() when the probe ladder found no
-- transitions and the trigger mode is one that waits. Returns ok, reason.
-- No second pass and no octave retry, unlike the tail of autoset(): a re-capture is more data everywhere
-- else and strictly less here, because the opening bytes exist only in the window that caught them.
function sdec.arm_capture()
  local fs = sdec.arm_fs()
  sdec.fs, sdec.fs_want = fs, fs
  sdec.probe_note = string.format(
    'armed at %g kS/s on a line that has not started -- lock the baud rate for a longer window',
    fs / 1000)
  local ok, why = sdec.acquire()
  if not ok then sdec.drop_stale_result() return false, why end
  local dok, dwhy = sdec.decode()
  if dok then return true end
  if sdec.arm_fit_prior() then return true end
  sdec.drop_stale_result()
  return false, dwhy
end

-- Is this candidate bit time compatible with the pulses actually on the wire? The filter the prior
-- ladder applies before spending a decode. docs/MEASUREMENTS.md, 'The prior ladder needs the
-- pulse-width filter'. It fails closed with no evidence, so sig_bittime() must run first.
function sdec.arm_try_ok(T, n)
  if T == nil or T <= 0 then return false end
  if sdec.wmed == nil or sdec.wmed <= 0 then return false end
  if (sdec.nw or 0) < sdec.submult_minpulses then return false end
  if not sdec.ua_plausible(T, n) then return false end
  if sdec.ua_submultiple(T) then return false end
  if sdec.ua_minrun_absurd(T) then return false end
  return true
end

sdec.arm_badfrac = 0.02

-- Is this decode clean enough to publish an invented rate on? A wrong bit time will still frame
-- bytes; what it cannot do is frame most of them cleanly. The frame floor is relock_minframes.
function sdec.arm_fit_ok()
  local r = sdec.res
  if r == nil then return false end
  if (r.nf or 0) < sdec.relock_minframes then return false end
  local bf = sdec.ua_badfrac(r)
  if bf == nil then return false end
  return bf < sdec.arm_badfrac
end

-- Fit the operator's prior to samples already in hand. Called by arm_capture() when a blind armed
--   [...]
-- Uniqueness, not the first fit, because clean frames at a wrong rate are the normal outcome:
-- docs/MEASUREMENTS.md, 'Uniqueness, not first fit, for a guessed rate'. decode_from(), not decode(),
-- whose fallback measurement already failed.
function sdec.arm_fit_prior()
  local rd, n = sdec.smp, sdec.nread
  if rd == nil or n == nil or n < 2 then return false end
  local fs = sdec.acq_fs or sdec.fs
  if fs == nil or fs <= 0 then return false end
  sdec.sig_bittime()
  local was, won, alt = sdec.force_baud, nil, nil
  pcall(function()
    local i
    for i = 1, table.getn(sdec.arm_try) do
      local b = sdec.arm_try[i]
      if sdec.arm_try_ok(fs / b, n) then
        sdec.force_baud = b
        if sdec.decode_from(rd, n) and sdec.arm_fit_ok() then
          if won == nil then won = b else alt = b end
        end
      end
    end
  end)
  sdec.force_baud = was
  if won == nil then return false end
  if alt ~= nil then
    sdec.probe_note = string.format(
      'this capture fits %d Bd AND %d Bd equally -- lock the rate in Options to decide', won, alt)
    return false
  end
  sdec.force_baud = won
  local ok = false
  pcall(function() ok = sdec.decode_from(rd, n) end)
  sdec.force_baud = was
  if not ok then return false end
  sdec.probe_note = string.format(
    'no bit time could be measured -- decoded at an ASSUMED %d Bd; lock the rate to be sure', won)
  return true
end

-- Pick the sample rate, capture, and decode. Returns ok, reason.
function sdec.autoset()
  local target = sdec.force_baud
  local captured = false
  sdec.baud_probe = nil

  if target == nil then
    sdec.fs = sdec.rates[table.getn(sdec.rates)]      -- top rate: 1 MS/s
    local savetrig = sdec.trigmode
    sdec.trigmode = 'free'
    local ok, why, tries = false, nil, 0
    local ladder = sdec.probe_fs or {1000000, 100000, 10000}
    local nlad = table.getn(ladder)
    sdec.trig_restore = savetrig
    local lok, lerr = pcall(function()
      while tries < nlad do
        tries = tries + 1
        sdec.fs, sdec.fs_want = ladder[tries], ladder[tries]
        ok, why = sdec.acquire()
        if ok then
          ok, why = sdec.decode()
          if ok or sdec.baud_probe ~= nil then break end
        end
      end
    end)
    sdec.trigmode = savetrig
    sdec.trig_restore = nil
    if not lok then error(lerr, 0) end
    if tries > 1 then
      sdec.probe_note = string.format(
        'probe took %d looks to catch traffic (down to %g kS/s)', tries or 0, ladder[tries] / 1000)
    end
    if not ok then
      if sdec.baud_probe == nil then
        if sdec.arm_silent() and savetrig ~= 'free' then return sdec.arm_capture() end
        sdec.drop_stale_result() return false, why
      end
      target = sdec.baud_probe
      sdec.probe_note = string.format(
        'too slow to frame at 1 MS/s -- re-captured at the rate the probe measured (%.0f Bd)',
        target or 0)
    else
      captured = true
      target = sdec.baud
    end
    if target == nil then return true end
  end

  local want = sdec.pick_fs(target, 8)
  if captured and want >= sdec.fs then return true end

  sdec.fs = want
  sdec.fs_want = want
  local ok, why = sdec.acquire()
  if not ok then sdec.drop_stale_result() return false, why end
  local dok, dwhy = sdec.decode()
  if not dok and sdec.baud_probe ~= nil and sdec.baud_probe > 0 then
    local w3 = sdec.pick_fs(sdec.baud_probe, 8)
    if w3 ~= nil and w3 > sdec.fs then
      sdec.probe_note = string.format(
        'probe fitted %.0f Bd, wire is %.0f -- re-captured at %g kS/s to get samples per bit',
        target or 0, sdec.baud_probe or 0, w3 / 1000)
      sdec.fs, sdec.fs_want = w3, w3
      local ok3, why3 = sdec.acquire()
      if not ok3 then sdec.drop_stale_result() return false, why3 end
      dok, dwhy = sdec.decode()
    end
  end
  if not dok then sdec.drop_stale_result() return false, dwhy end

  if sdec.baud ~= nil and sdec.baud > 0 then
    local w2 = sdec.pick_fs(sdec.baud, 8)
    if w2 ~= nil and w2 < sdec.fs then
      sdec.probe_note = string.format(
        'probe fitted %.0f Bd, wire is %.0f -- re-captured at %g kS/s for the full window',
        target or 0, sdec.baud or 0, w2 / 1000)
      sdec.fs, sdec.fs_want = w2, w2
      local ok2, why2 = sdec.acquire()
      if not ok2 then sdec.drop_stale_result() return false, why2 end
      local d2ok, d2why = sdec.decode()
      if not d2ok then sdec.drop_stale_result() return false, d2why end
      return d2ok, d2why
    end
  end
  return true
end

-- The byte log
-- One file, shared by every mode, and separate from the debug log, which is a trace of notes and
-- refusals. The name is chosen once per session, so successive captures append to one file. Decoded
-- bytes only, never samples -- a 32 kB stream is 3.4 M samples, ~34 MB of text against 32 kB.
-- Allocate the byte log's filename. Returns the path, or nil with sdec.flog_why set.
function sdec.flog_alloc()
  ulog.keyok()
  if sdec.flog_keygen ~= (ulog.keygen or 0) then
    sdec.flog_path, sdec.flog_n, sdec.flog_why = nil, nil, nil
    sdec.flog_keygen = ulog.keygen or 0
  end
  if sdec.flog_path ~= nil then return sdec.flog_path end
  sdec.flog_path = ulog.next_free(sdec.flogpfx, '.txt', 1000)
  if sdec.flog_path == nil then
    sdec.flog_why = tostring(ulog.idx_why or
                             ('no free ' .. string.gsub(sdec.flogpfx, '^.*/', '') .. 'NNN.txt name'))
    return nil
  end
  sdec.flog_n, sdec.flog_bytes = 0, 0
  return sdec.flog_path
end

-- Append one capture to the byte log: a header line, then its text lines, then its hex lines.
function sdec.frame_log()
  if sdec.res == nil or sdec.res.nf < 1 then return false end
  if sdec.flog_alloc() == nil then return false end
  local fh, fwhy = ulog.open_write(sdec.flog_path, file.MODE_APPEND)
  if fh == nil then
    sdec.flog_why = 'cannot append to ' .. tostring(sdec.flog_path)
    return false
  end
  sdec.fh_unwind = fh
  local nfr = 0
  if sdec.res ~= nil then nfr = sdec.res.nf end
  local msgno = (sdec.flog_n or 0) + 1
  file.write(fh, string.format('---- msg %d  %s %s  %d bytes %d err\r\n',
                               msgno or 0, tostring(sdec.baud_text()), tostring(sdec.fmt_text()),
                               sdec.res.nf or 0, sdec.res.nbad or 0))
  local i = 1
  while i <= sdec.res.nf do
    file.write(fh, sdec.ua_text_line(i, 64) .. '\r\n')
    i = i + 64
  end
  i = 1
  while i <= sdec.res.nf do
    file.write(fh, sdec.ua_hex_line(i, 16) .. '\r\n')
    i = i + 16
  end
  file.flush(fh)
  file.close(fh)
  sdec.fh_unwind = nil
  if not ulog.keyok() then
    sdec.flog_why = 'write failed part-way through ' ..
                    string.gsub(tostring(sdec.flog_path), '^.*/', '')
    return false
  end
  sdec.flog_n = msgno
  sdec.flog_bytes = (sdec.flog_bytes or 0) + nfr
  sdec.flog_why = nil
  return true
end

-- Streaming capture
--   [...]
-- nothing of ours runs -- so the panel stays live, but the quiet-line watchdog only advances while
-- sdec.stream() is polling. Every entry point here is guarded end to end and returns ok, reason.
-- Size a streaming capture, allocate its buffer, learn the levels and arm the idle watchdog.
function sdec.stream_begin()
  local md = sdec.mode_cur()
  local why = sdec.mode_why(md)
  if why ~= nil then return false, why end
  if sdec.ck_run == nil then
    return false, 'this build omits chunk_decode.tsp -- the streaming modes need it'
  end

  sdec.hw_config()                      -- picks fs from the locked baud rate
  local fs = sdec.fs
  local nsmp = sdec.stream_samples(md, fs)
  if nsmp == nil then return false, 'cannot size the capture for this rate' end

  local sizefor = nsmp
  if (sdec.strm_overread or 0) > 0 then
    sizefor = math.ceil(nsmp * (1 + sdec.strm_overread))
  end
  local cap = sizefor + 100
  if sdec.trigmode ~= 'free' and (sdec.pretrig or 0) > 0 then
    cap = math.ceil(sizefor * 100 / (100 - sdec.pretrig)) + 100
    if sdec.ck_bufmax ~= nil and cap > sdec.ck_bufmax then
      cap = sdec.ck_bufmax
      nsmp = math.floor(cap * (100 - sdec.pretrig) / 100)
      if (sdec.strm_overread or 0) > 0 then
        nsmp = math.floor(nsmp / (1 + sdec.strm_overread))
      end
    end
  end
  sdec.acq_make_buffer(cap)
  if sdec.buf == nil then
    local rswept, rsweptwhat = sdec.buf_sweep()
    if rswept > 0 then
      ulog.line(string.format('swept %d readings to make room mid-session: %s', rswept, rsweptwhat))
    end
    local rdid, rwhat = sdec.buf_reclaim()
    if rdid then
      ulog.line('reclaimed ' .. rwhat .. ' to make room mid-session -- its readings are discarded')
    end
    if rswept > 0 or rdid then
      sdec.ck_bufmax, sdec.ck_bigbuf, sdec.ck_bigcap = sdec.bufmax_for()
      sdec.acq_make_buffer(cap)
    end
  end
  if sdec.buf == nil then
    local _, bigname, bigcap = sdec.bufmax_for()
    local why
    if bigname ~= nil then
      why = string.format('cannot allocate %d readings -- %s still holds %d of the %d the '
                          .. 'instrument has, and resizing the default buffers down did not '
                          .. 'free enough.', cap or 0, bigname, bigcap or 0, sdec.ck_bufpool)
    else
      why = string.format('cannot allocate %d readings, and the default buffer capacities could '
                          .. 'not be read, so there is nothing to resize', cap or 0)
    end
    sdec.lasterr = why
    ulog.line('recording refused: ' .. why)
    return false, why
  end

  sdec.ck_watch = false
  local pn = sdec.probe_n
  if pn > nsmp then pn = nsmp end
  local budget = 0.25 * (sdec.ui_latency_s or 0.5)
  local pmax = math.floor((sdec.fs or 1000) * budget)
  if pmax < 200 then pmax = 200 end
  if pn > pmax then pn = pmax end
  sdec.probe_idle = nil
  sdec.arm_thr, sdec.arm_idle = nil, nil
  local pok = pcall(sdec.acq_free, pn, nil, true)
  if pok and sdec.nread ~= nil and sdec.nread > 1 then
    local lok, lwhy = sdec.sig_levels(sdec.smp, sdec.nread)
    if lok and sdec.thr ~= nil and (sdec.swing or 0) >= sdec.minswing then
      sdec.ck_watch = true
    else
      sdec.probe_idle = lwhy or 'line is idle (no transitions)'
    end
  end
  if not sdec.ck_watch and sdec.lvl_thr ~= nil and
     (sdec.lvl_swing or 0) >= sdec.minswing then
    sdec.thr, sdec.hyst, sdec.swing = sdec.lvl_thr, sdec.lvl_hyst, sdec.lvl_swing
    sdec.ck_watch = true
    sdec.strm_lvlreuse = true
  else
    sdec.strm_lvlreuse = nil
  end
  if sdec.probe_idle ~= nil then
    local kthr, khyst, kidle = sdec.thr, sdec.hyst, sdec.idle
    if sdec.arm_threshold() and sdec.strm_lvlreuse then
      sdec.thr, sdec.hyst, sdec.idle = kthr, khyst, kidle
    end
  end
  sdec.smp = nil

  sdec.ck_running, sdec.ck_stop, sdec.ck_nbytes, sdec.ck_tot = true, false, 0, nil
  sdec.ck_endwhy = nil
  sdec.arm_expired_at = nil
  sdec.ck_cancel = nil
  sdec.progress(0)

  sdec.strm_nsmp = nsmp
  return true
end

-- The one-shot form: begin, poll to the end, then decode, all in one call.
function sdec.stream()
  local ok, why = sdec.stream_begin()
  if not ok then return false, why end
  local got = 0
  local aok, ares = pcall(sdec.stream_acquire, sdec.strm_nsmp)
  if aok then got = ares or 0 end
  sdec.ck_running = false
  sdec.strm_empty = nil
  if not aok then
    return false, 'recording failed: ' .. tostring(ares or 'unknown')
  end
  if got < 2 then
    sdec.strm_empty = true
    return false, 'long capture returned nothing'
  end
  if sdec.ck_stop then sdec.ck_stop = false end
  return sdec.stream_decode(got)
end

sdec.fc_maxwin = sdec.fc_maxwin or 32
sdec.fc_maxsec = sdec.fc_maxsec or 1200

-- One press, one whole transmission: record, decode and save, and under flow control keep issuing credits
-- until the device stops. Returns the run's verdict and, on a failure, its reason.
function sdec.record_run()
  sdec.cancel_clear()
  sdec.ck_cancel, sdec.fc_end, sdec.strm_empty = nil, nil, nil
  sdec.fc_win, sdec.fc_bytes, sdec.fc_secs = 0, 0, 0
  sdec.strm_stopped_by_press = nil
  timer.cleartime()
  sdec.ui_refresh()
  local keep = nil                 -- the last window that actually decoded something
  local ok, why = false, nil
  while true do
    sdec.ck_tot = nil
    ok, why = sdec.stream()
    sdec.fc_win = sdec.fc_win + 1
    sdec.fc_secs = sdec.fc_secs + (sdec.strm_waited or 0)
    if sdec.ck_tot ~= nil then
      sdec.fc_bytes = sdec.fc_bytes + (sdec.ck_tot.nf or 0)
      keep = sdec.ck_tot
    end
    if not sdec.fc_out then break end
    if sdec.ck_cancel then
      sdec.fc_end = 'cancelled'
      if not ok and sdec.strm_empty and sdec.fc_bytes > 0 then ok, why = true, nil end
      break
    end
    if not ok then
      if sdec.strm_empty and sdec.fc_bytes > 0 then
        ok, why, sdec.fc_end = true, nil, 'quiet'
      end
      break
    end
    if sdec.ck_stop then sdec.fc_end = 'stopped'; break end
    if sdec.ck_endwhy == 'quiet' then sdec.fc_end = 'quiet'; break end
    if sdec.fc_win >= (sdec.fc_maxwin or 32) then sdec.fc_end = 'bound'; break end
    local el = sdec.fc_secs
    local t = timer.gettime()
    if t ~= nil and t > el then el = t end
    if sdec.fc_maxsec ~= nil and sdec.fc_maxsec > 0 and el >= sdec.fc_maxsec then
      sdec.fc_secs = el
      sdec.fc_end = 'timebound'
      break
    end
  end
  if sdec.ck_tot == nil and keep ~= nil then
    sdec.ck_tot, sdec.ck_nbytes = keep, keep.nf
  end
  sdec.ck_running = false
  return ok, why
end

-- Arm and return, for the press-driven path. The buffer fills in hardware from here.
function sdec.stream_start()
  sdec.fc_win, sdec.fc_bytes, sdec.fc_end, sdec.fc_secs = 0, 0, nil, 0
  local ok, why = sdec.stream_begin()
  if not ok then return false, why end
  local aok = sdec.stream_arm(sdec.strm_nsmp)
  if not aok then
    sdec.ck_running = false
    return false, 'could not arm the recording'
  end
  sdec.strm_recording = true
  return true
end

-- Stop the recording and decode what it collected.
function sdec.stream_stop()
  sdec.strm_recording = nil
  local got, gerr = 0, nil
  local sok, s1, s2 = pcall(sdec.stream_settle)
  if sok then got, gerr = s1, s2 end
  sdec.ck_running = false
  if sok and gerr ~= nil then
    sdec.ck_endwhy = 'readfail'
    return false, 'recording failed: ' .. tostring(gerr)
  end
  if not sok then
    sdec.ck_endwhy = 'readfail'
    return false, 'recording failed: ' .. tostring(s1 or 'unknown')
  end
  sdec.ck_endwhy = 'stopped'
  if got < 2 then return false, 'recording collected nothing' end
  return sdec.stream_decode(got)
end

-- Decode a completed recording, shared by both paths. got is the reading count it collected.
function sdec.stream_decode(got)
  local md = sdec.mode_cur()

  local path = sdec.flog_alloc()
  local opts = {maxbytes = md.cap, nocap = (md.cap == nil),
                progress = sdec.ck_progress}
  if sdec.strm_armed and sdec.buf ~= nil then
    opts.leadmax = sdec.acq_leadmax(sdec.buf)
  end
  local rdr, nrd = sdec.ck_reader_buffer(sdec.buf, got), got
  sdec.ck_nrd = nrd
  if sdec.strm_press then
    opts.budget_s = sdec.ck_press_budget_s or sdec.ui_latency_s
    local W = sdec.ck_win_for(sdec.ui_latency_s)
    sdec.ck_win_n, sdec.ck_level_max = W, W
    local job, jerr = sdec.ck_job_new(rdr, nrd, path, opts)
    if job == nil then return false, tostring(jerr or 'cannot start the decode') end
    sdec.ck_job, sdec.ck_job_md = job, md
    sdec.ck_running = true
    return sdec.decode_step()
  end
  sdec.ck_win_n, sdec.ck_level_max = 20000, nil
  local tot, terr = nil, nil
  local dok = pcall(function()
    tot, terr = sdec.ck_run(rdr, nrd, path, opts)
  end)
  if not dok or tot == nil then
    return false, tostring(terr or 'chunked decode failed')
  end
  if tot.stopped == nil and sdec.ck_endwhy == 'full' and md.cap ~= nil and
     tot.nf < md.cap then
    tot.stopped = 'exhausted'
  end
  sdec.ck_tot = tot
  sdec.ck_nbytes = tot.nf
  if tot.tail ~= nil then sdec.res = tot.tail end
  if tot.stopped == 'write failed' or tot.stopped == 'sink' then
    return false, string.format('%s -- %d bytes decoded but the file is incomplete',
                                tostring(tot.stopped), tot.nf or 0)
  end
  return true
end

-- Decode one slice, put the progress on the status row, and hand the panel back. Returns the decode's
-- VERDICT, not its progress: true for a pending slice and for a clean finish, false when the step raised,
-- produced no totals or failed its write. Whether work remains is sdec.ck_job ~= nil.
function sdec.decode_step()
  local job = sdec.ck_job
  if job == nil then return false end
  local done, tot, err = true, nil, nil
  local pok, p1, p2, p3 = pcall(sdec.ck_job_step, job)
  if pok then
    done, tot, err = p1, p2, p3
  else
    done, err = true, tostring(p1)
  end

  if not done then
    sdec.ck_nbytes = (tot and tot.nf) or 0
    local est = (tot and tot.nwin_est) or 0
    if job.phase ~= nil then
      sdec.ui_status = string.format('preparing: %s -- press Capture', tostring(job.phase))
    else
      sdec.ui_status = string.format('decoding %d bytes (window %d/%d) -- press Capture',
                                     sdec.ck_nbytes or 0, (tot and tot.nwin) or 0, est or 0)
    end
    sdec.ui_refresh()
    return true
  end

  sdec.ck_job, sdec.ck_running = nil, false
  if tot == nil then
    sdec.errcount = sdec.errcount + 1
    sdec.lasterr = tostring(err or 'decode failed')
    sdec.ui_status = 'error'
    ulog.line(sdec.lasterr)
  else
    local md = sdec.ck_job_md or sdec.mode_cur()
    if tot.stopped == nil and sdec.ck_endwhy == 'full' and md.cap ~= nil and
       tot.nf < md.cap then
      tot.stopped = 'exhausted'
    end
    sdec.ck_tot, sdec.ck_nbytes = tot, tot.nf
    if tot.tail ~= nil then sdec.res = tot.tail end
    if tot.stopped == 'write failed' or tot.stopped == 'sink' then
      sdec.errcount = sdec.errcount + 1
      sdec.lasterr = string.format('%s -- %d bytes decoded but the file is incomplete',
                                   tostring(tot.stopped), tot.nf or 0)
      sdec.ui_status = 'error'
    else
      sdec.ui_status = 'done'
    end
    ulog.line(sdec.ck_summary(tot))
  end
  sdec.ck_job_md = nil
  local dok = (tot ~= nil and tot.stopped ~= 'write failed' and tot.stopped ~= 'sink')
  sdec.mode_exit(sdec.strm_exit_why(sdec.ck_endwhy, dok, sdec.lasterr), not dok)
  sdec.ui_refresh()
  return dok
end

-- Abandon a decode in progress -- Mode pressed, or a mode change. Closes the partial file and
-- keeps whatever was decoded, so the bytes already on the key are not lost.
function sdec.decode_abandon()
  if sdec.ck_job == nil then return false end
  local tot = nil
  tot = sdec.ck_job_abandon(sdec.ck_job)
  sdec.ck_job, sdec.ck_job_md, sdec.ck_running = nil, nil, false
  if tot ~= nil then
    sdec.ck_tot, sdec.ck_nbytes = tot, tot.nf
    if tot.tail ~= nil then sdec.res = tot.tail end
  end
  return true
end

-- Arm the trigger model and return; the buffer fills in hardware from here. nsmp is the reading count
-- SimpleLoop is asked for, and the return says whether the model took the configuration -- false is the
-- caller's cue to fall back to a free-running read. Guarded at its own firmware boundaries.
function sdec.stream_arm(nsmp)
  sdec.strm_armed = nil
  local buf = sdec.buf
  if buf == nil then return false end
  if not sdec.bufclear(buf) then return false end
  sdec.acq_fillmode(buf)
  if sdec.dig == nil then return false end
  local dcount = 1
  if sdec.arm_silent() and sdec.trigmode ~= 'free' then dcount = nsmp end
  if not pcall(function() sdec.dig.count = dcount end) then return false end
  local armed = (sdec.arm_silent() and sdec.trigmode ~= 'free')
  sdec.acq_posloaded = nil
  local ok = false
  if armed then
    local ev, useanalog = sdec.arm_source()
    if ev == nil then
      armed = false
    else
      if useanalog and (sdec.arm_thr == nil or
                        not sdec.arm_comparator(useanalog, sdec.arm_slope())) then
        armed = false
      end
      if armed then
        local pos = sdec.pretrig
        if sdec.acq_bufperm then pos = sdec.acq_pospct(nsmp, buf) end
        ok = pcall(trigger.model.load, 'LoopUntilEvent', ev, pos,
                   trigger.CLEAR_ENTER, 0, buf)
        if ok then sdec.acq_posloaded = pos end
      end
      if not ok then armed = false end
    end
  end
  sdec.strm_armed = armed
  if not armed then ok = pcall(trigger.model.load, 'SimpleLoop', nsmp, 0, buf) end
  if ok then
    local cok = sdec.bufclear(buf)
    if not cok then
      ok = false
      sdec.lasterr = 'could not clear the record before arming'
    end
  end
  if ok then ok = pcall(trigger.model.initiate) end
  if ok and armed then
    local spun, saw = 0, false
    while spun < (sdec.arm_settle_s or 0.25) do
      if sdec.trig_waiting() == true then saw = true break end
      delay(0.01)
      spun = spun + 0.01
    end
    if not saw then armed = false end
  end
  sdec.strm_armed = armed
  if ok and sdec.fc_out then
    sdec.fc_credit()
  end
  return ok
end

-- Stop the hardware and publish what it collected. -> the reading count, and a second return naming the
-- failure when the buffer could not be read at all, which is what keeps a fault from reading as an
-- empty recording: buf.n raises on a buffer the firmware has dropped, and 0 reads as 'collected nothing'.
function sdec.stream_settle()
  trigger.model.abort()
  local buf = sdec.buf
  sdec.nread = 0
  if buf ~= nil then
    local n = nil
    local ok, perr = pcall(function() n = buf.n end)
    if not ok then return 0, tostring(perr or 'the buffer could not be read') end
    sdec.nread = n or 0
    sdec.acq_fs = sdec.acq_fs_or_requested(buf, sdec.nread)
  end
  return sdec.nread
end

-- Re-measure the levels from the newest samples in buf when the watchdog is about to end a run on REUSED
-- levels. buf holds `have` readings; iw is the window. Returns true if the reused threshold is wrong and a
-- better one is in force, so the caller should keep going.
function sdec.strm_relevel(buf, have, iw)
  if not sdec.strm_lvlreuse then return false end
  if buf == nil or have == nil or have < 3 then return false end
  local from = have - iw + 1
  if from < 1 then from = 1 end
  local win, m = {}, 0
  local rok = pcall(function()
    m = sdec.ck_reader_buffer(buf, have)(win, from, iw, 1)
  end)
  if not rok then return false, true end
  if m < 3 then return false, true end
  local oldthr, oldhyst, oldswing = sdec.thr, sdec.hyst, sdec.swing
  local oldlo, oldhi = sdec.lo, sdec.hi
  local olvthr, olvhyst, olvswing = sdec.lvl_thr, sdec.lvl_hyst, sdec.lvl_swing
  local function unmeasure()
    sdec.thr, sdec.hyst, sdec.swing = oldthr, oldhyst, oldswing
    sdec.lo, sdec.hi = oldlo, oldhi
    sdec.lvl_thr, sdec.lvl_hyst, sdec.lvl_swing = olvthr, olvhyst, olvswing
  end
  local lok = sdec.sig_levels(win, m)
  if not lok or sdec.thr == nil or (sdec.swing or 0) < sdec.minswing then
    unmeasure()
    return false
  end
  local band = sdec.hyst
  if band == nil or band <= 0 then
    band = 0.1 * ((sdec.hi or 0) - (sdec.lo or 0))
  end
  if oldthr ~= nil and sdec.lo ~= nil and sdec.hi ~= nil and
     oldthr > sdec.lo + band and oldthr < sdec.hi - band then
    unmeasure()
    return false
  end
  sdec.strm_lvlreuse = nil
  sdec.strm_releveled = string.format('threshold re-measured mid-recording: %.3f V, not the %.3f V '
                                      .. 'a previous capture measured', sdec.thr or 0, oldthr or 0)
  ulog.line(sdec.strm_releveled)
  return true
end

-- Arm, poll until full or quiet or stopped, then settle. nsmp is the target sample count;
-- returns the reading count collected.
function sdec.stream_acquire(nsmp)
  local buf = sdec.buf
  if (sdec.strm_overread or 0) > 0 then
    nsmp = sdec.acq_fit(math.ceil(nsmp * (1 + sdec.strm_overread)), buf)
  end
  sdec.strm_target = nsmp
  sdec.strm_waited = 0
  local ok = sdec.stream_arm(nsmp)
  if not ok then
    sdec.ck_endwhy = 'full'
    local fs = sdec.fs or 1000
    local cap = math.floor(fs * (sdec.strm_fallback_s or 20))
    if cap < 2000 then cap = 2000 end
    if cap > nsmp then cap = nsmp end
    if cap < nsmp then
      sdec.lasterr = string.format('trigger model unavailable; recorded %.0f s free-running '
                                   .. 'without the idle watchdog, and TRIGGER cannot stop it',
                                   cap / fs)
    else
      sdec.lasterr = 'trigger model unavailable; captured without the idle watchdog'
    end
    sdec.strm_waited = cap / fs
    return sdec.acq_free(cap, sdec.n)
  end

  local quiet, seen, step = 0, 0, sdec.ck_poll_s
  local qexit = sdec.idle_exit()
  local seenend = -1
  local iw = sdec.idle_window(sdec.fs)
  local waited = 0
  local armdone = true
  if sdec.strm_armed then
    armdone = false
    if sdec.armnote ~= nil then
      pcall(sdec.armnote, sdec.arm_wait_s(), sdec.arm_thr or sdec.thr or sdec.arm_level_v(),
            sdec.armkeyed)
    end
  end
  local rfail, rlast = 0, nil
  sdec.strm_readfail = nil
  local limit = sdec.stream_limit(nsmp, sdec.fs)
  if sdec.strm_armed then limit = limit + sdec.arm_wait_s() end
  while true do
    local have = buf.n or 0
    if not armdone and sdec.trig_waiting() ~= true then
      armdone = true
      quiet = 0
      seen, seenend = 0, -1
      if sdec.armnote_clear ~= nil then pcall(sdec.armnote_clear) end
    end
    if sdec.strm_armed then
      if armdone and sdec.trig_done(buf) then sdec.ck_endwhy = 'full'; break end
    elseif have >= nsmp then
      sdec.ck_endwhy = 'full'
      break
    end
    if sdec.cancel_asked() then sdec.ck_endwhy = 'stopped'; break end
    if not armdone and waited >= sdec.arm_wait_s() then
      sdec.arm_expired_at = sdec.arm_thr or sdec.thr
      sdec.ck_endwhy = 'noarm'
      break
    end
    if waited >= limit then sdec.ck_endwhy = 'full'; break end

    local eidx = sdec.acq_end(buf)
    local fresh = (have > seen)
    if eidx ~= nil then fresh = (eidx ~= seenend) end
    if fresh then
      local from = have - iw + 1
      if from < 1 then from = 1 end
      local win, m = {}, 0
      local rok, rerr = pcall(function()
        m = sdec.ck_reader_buffer(buf, have)(win, from, iw, 1)
      end)
      if not rok then
        rfail = rfail + 1
        rlast = rerr
        if rfail >= 20 then
          sdec.strm_readfail = tostring(rlast or 'buffer read failed')
          sdec.ck_endwhy = 'readfail'
          break
        end
      elseif m > 1 and sdec.smp_active(win, m, sdec.thr, sdec.hyst) then
        quiet = 0
        rfail = 0
      else
        quiet = quiet + step
        rfail = 0
      end
      seen = have
      seenend = eidx
    else
      quiet = quiet + step
    end

    if armdone and sdec.ck_watch and qexit ~= nil and qexit > 0 and quiet >= qexit then
      local adopted, unmeasurable = sdec.strm_relevel(buf, have, iw)
      if adopted then
        quiet = 0
      elseif unmeasurable then
        sdec.strm_readfail = 'the capture buffer could not be re-measured to confirm a quiet line'
        sdec.ck_endwhy = 'readfail'
        break
      else
        sdec.ck_endwhy = 'quiet'
        break
      end
    end

    if armdone then sdec.progress_samples(have, nsmp) end
    delay(step)
    waited = waited + step
    sdec.strm_waited = waited
  end

  return (sdec.stream_settle())
end

sdec.ck_poll_s = 0.5

-- A hard ceiling on the wait for nsmp samples at fs: twice the fill time, floored at 10 s, capped at 1200.
function sdec.stream_maxwait(nsmp, fs)
  if fs == nil or fs <= 0 then return 600 end
  local t = 2 * nsmp / fs
  if t < 10 then t = 10 end
  if t > 1200 then t = 1200 end
  return t
end

-- The wall-clock ceiling a recording runs under.
--   [...]
-- cut off having recorded a fraction of what was asked, reported as a full buffer. The standing ceiling is the
-- right bound there, and it is still a bound: the fill test, the quiet-line exit and the operator all end the
-- run before it.
function sdec.stream_limit(nsmp, fs)
  local limit = sdec.stream_maxwait(nsmp, fs)
  if sdec.strm_maxsec ~= nil and sdec.strm_maxsec > 0 and limit > sdec.strm_maxsec then
    limit = sdec.strm_maxsec
  end
  return limit
end

function sdec.progress_samples(have, want)
  sdec.ck_acq_have, sdec.ck_acq_want = have, want
  return sdec.progress_row()
end

sdec.ck_bufwant = 4076503

sdec.ck_bufmax = sdec.ck_bufwant

sdec.ck_bufpool_default = 7080255
sdec.ck_bufpool = sdec.ck_bufpool_default
sdec.ck_bufpool_model = {{'7510', 7500000}, {'2461', 6875000}}

-- Resolve the pool from the model number. -> the figure now in force. Assigns unconditionally from a local,
-- so the answer depends on the model and not on call order. Bare read: localnode is documented on every
-- supported model. Substring, since neither key can collide.
function sdec.buf_pool_resolve()
  local p = sdec.ck_bufpool_default
  local m = localnode.model
  if type(m) == 'string' then
    local i
    for i = 1, table.getn(sdec.ck_bufpool_model) do
      local e = sdec.ck_bufpool_model[i]
      if string.find(m, e[1], 1, true) ~= nil then
        p = e[2]
        break
      end
    end
  end
  sdec.ck_bufpool = p
  return p
end
sdec.buf_pool_resolve()

sdec.ck_bufguard = 6000000
sdec.ck_bufmargin = 50000

sdec.ck_bufmin = 898347

-- The ceiling the live defbuffers leave, which is a query and not the policy: buf_reclaim() is what
-- changes them. One pcall for both reads, because this is an outbound firmware boundary and the pcall
-- budget counts sites. Returns the ceiling, then the name and capacity of the larger default buffer,
-- which the refusals must quote or they send the operator at the wrong one.
function sdec.bufmax_for()
  local ok, d1, d2 = pcall(function() return defbuffer1.capacity, defbuffer2.capacity end)
  if not ok or type(d1) ~= 'number' or type(d2) ~= 'number' then
    return sdec.ck_bufwant, nil, nil
  end
  local bigname, bigcap = 'defbuffer1', d1
  if d2 > d1 then bigname, bigcap = 'defbuffer2', d2 end
  local n = sdec.ck_bufwant
  if sdec.ck_bufguard < n then n = sdec.ck_bufguard end
  local held, rcap = sdec.acq_bufheld()
  if rcap ~= nil then held = held - rcap end
  local avail = sdec.ck_bufpool - d1 - d2 - held - sdec.ck_bufmargin
  if avail < n then n = avail end
  if rcap ~= nil and rcap < n then n = rcap end
  if n < 0 then n = 0 end
  return n, bigname, bigcap
end

sdec.ck_defbufcap = 100000

sdec.ck_defbufmin = 10

-- One default buffer's capacity, written and answered for. -> true if the instrument took it. One
-- guarded site for every capacity write this app makes, because the pcall budget counts sites.
-- Per buffer is not a style choice: one pcall spanning both writes is not atomic, so defbuffer2's
-- readings were discarded while buf_reclaim reported false. A whitelist, and named exactly, or the else
-- would resize defbuffer2 for anything.
function sdec.defbuf_set(name, cap)
  if name ~= 'defbuffer1' and name ~= 'defbuffer2' then return false end
  local ok = pcall(function()
    if name == 'defbuffer1' then
      defbuffer1.capacity = cap
    else
      defbuffer2.capacity = cap
    end
  end)
  return ok
end

-- Resize both default buffers to the minimum for the app's whole run, because the reading memory is one pool
--   [...]
-- defbuffer2 first, then defbuffer1, which is the default active buffer and so the one likely to hold the
-- operator's readings. A resize discards every reading whatever the new capacity is, so the sizes are
-- recorded here and buf_restore() puts them back at teardown. -> did_reclaim, and text naming what moved.
function sdec.buf_reclaim()
  local ok, d1, d2 = pcall(function() return defbuffer1.capacity, defbuffer2.capacity end)
  if not ok or type(d1) ~= 'number' or type(d2) ~= 'number' then return false, nil end
  local dc = sdec.ck_defbufmin
  local n1, n2 = nil, nil
  if d2 > dc then n2 = dc end
  if d1 > dc then n1 = dc end
  if n1 == nil and n2 == nil then return false, nil end
  local what = nil
  if n2 ~= nil and sdec.defbuf_set('defbuffer2', n2) then
    if sdec.ck_defbufwas == nil then sdec.ck_defbufwas = {} end
    sdec.ck_defbufwas.defbuffer2 = d2
    what = string.format('defbuffer2 %d -> %d', d2, n2)
  end
  if n1 ~= nil and sdec.defbuf_set('defbuffer1', n1) then
    if sdec.ck_defbufwas == nil then sdec.ck_defbufwas = {} end
    sdec.ck_defbufwas.defbuffer1 = d1
    local s = string.format('defbuffer1 %d -> %d', d1, n1)
    if what == nil then what = s else what = what .. ' and ' .. s end
  end
  if what == nil then return false, nil end
  collectgarbage()
  return true, what
end

sdec.buf_skip = {}
do
  local nm = {'defbuffer1', 'defbuffer2',
              '_G', '_LOADED', 'acal', 'beeper', 'bit', 'buffer', 'cal', 'channel', 'coroutine',
              'dataqueue', 'debug', 'define', 'diagnostics', 'digio', 'display', 'dmm', 'enum',
              'errorqueue', 'eventlog', 'fan', 'file', 'format', 'fs', 'gpib', 'io', 'ki', 'lan',
              'localnode', 'math', 'memory', 'node', 'os', 'scan', 'scpi', 'script', 'serial',
              'slot', 'smu', 'status', 'string', 'table', 'timer', 'trigger', 'tsplink', 'tspnet',
              'uncertainty', 'upgrade', 'userstring'}
  local i
  for i = 1, table.getn(nm) do sdec.buf_skip[nm[i]] = true end
end

-- Buffers this app did not make hold the same pool, so they are swept before the default buffers are
--   [...]
-- every name in sdec.buf_skip are skipped.
-- Collect, then delete, never interleaved: writing to the global table while next() walks it is
-- undefined, and dropping the handle first strands the buffer. -> freed_readings, and text.
function sdec.buf_sweep()
  local names, nn = {}, 0
  pcall(function()
    local bt = type(defbuffer1)
    local k, v = next(_G, nil)
    while k ~= nil do
      if type(k) == 'string' and not sdec.buf_skip[k]
         and type(v) == bt and v ~= sdec.buf and not sdec.acq_isours(v) then
        local c = v.capacity
        if type(c) == 'number' and type(v.n) == 'number' then
          nn = nn + 1
          names[nn] = k
          names[k] = c
        end
      end
      k, v = next(_G, k)
    end
  end)
  if nn == 0 then return 0, nil end
  local freed, gone = 0, nil
  local i
  for i = 1, nn do
    local nm = names[i]
    local dok = pcall(function()
      buffer.delete(_G[nm])
      _G[nm] = nil
    end)
    if dok then
      freed = freed + names[nm]
      local s = string.format('%s (%d)', nm, names[nm])
      if gone == nil then gone = s else gone = gone .. ', ' .. s end
    end
  end
  if freed > 0 then collectgarbage() end
  return freed, gone
end

-- Hand the capacities back -- the sizes are the operator's setting and only the readings were lost. Runs
-- in stop() after the capture buffer is freed, because until then there is no room to grow them. Not
-- fatal and not retried: failing the teardown over it costs a reinstall. -> text, or nil for nothing.
function sdec.buf_restore()
  if sdec.ck_relaunching then
    sdec.ck_relaunching = nil
    return nil
  end
  local was = sdec.ck_defbufwas
  if was == nil then return nil end
  local what, left = nil, nil
  if was.defbuffer2 ~= nil then
    if sdec.defbuf_set('defbuffer2', was.defbuffer2) then
      what = string.format('defbuffer2 to %d', was.defbuffer2)
      was.defbuffer2 = nil
    else
      left = 'defbuffer2'
    end
  end
  if was.defbuffer1 ~= nil then
    if sdec.defbuf_set('defbuffer1', was.defbuffer1) then
      local s = string.format('defbuffer1 to %d', was.defbuffer1)
      if what == nil then what = s else what = what .. ' and ' .. s end
      was.defbuffer1 = nil
    else
      if left == nil then left = 'defbuffer1' else left = left .. ' and defbuffer1' end
    end
  end
  if left == nil then
    sdec.ck_defbufwas = nil
    return what
  end
  local why = 'could not restore ' .. left .. ' -- kept for the next teardown'
  if what ~= nil then why = what .. '; ' .. why end
  return why
end

-- Samples to record for mode md at sample rate fs. Returns nil when the rate or the locked baud
-- rate cannot size a capture.
function sdec.stream_samples(md, fs)
  if fs == nil or fs <= 0 then return nil end
  local baud = sdec.force_baud
  if baud == nil or baud <= 0 then return nil end
  if md.cap == nil then return sdec.ck_bufmax end
  local nbits = sdec.force_nbits or 8
  local parbits = 0
  if sdec.force_par ~= nil and sdec.force_par ~= sdec.PAR_NONE then parbits = 1 end
  local framebits = 1 + nbits + parbits + (sdec.force_nstop or 1)
  local n = math.ceil(md.cap * framebits * (fs / baud))
  if n > sdec.ck_bufmax then n = sdec.ck_bufmax end
  if n < 100 then n = 100 end
  return n
end

-- ck_decode's progress hook: show nbytes decoded in window nwin of nwin_est, and return false
-- to abort the run.
function sdec.ck_progress(nbytes, nwin, nwin_est)
  sdec.ck_running = true
  sdec.progress(nbytes)
  if sdec.ck_stop then return false end
  if sdec.cancel_asked() then return false end
  return true
end

-- Poll the TRIGGER key and record it as a stop request. True once a cancel is in force, including one seen by
-- a previous poll -- the blender's latch auto-resets on read, so a caller that polls twice and expects the
-- same answer loses the press.
function sdec.cancel_asked()
  if sdec.ck_stop then return true end
  if not sdec.cancel_pressed() then return false end
  sdec.ck_stop = true
  sdec.ck_cancel = true
  return true
end

-- Use the detected rate. Clears the lock instead of writing the detected number into it: detection found
-- this rate unaided and will again, where a locked number freezes one measurement.
function sdec.rate_accept()
  if sdec.rate_offer == nil then return false, 'no rate was offered' end
  sdec.force_baud = nil
  sdec.rate_offer, sdec.rate_offer_from, sdec.rate_refused = nil, nil, nil
  return sdec.capture()
end

-- Keep the rate the operator set. The question goes; the lock and the refusal both stand, so the panel
-- does not fall back to looking like an ordinary empty capture with nothing to explain it.
function sdec.rate_decline()
  if sdec.rate_offer == nil then return false, 'no rate was offered' end
  local why = sdec.rate_refused
  sdec.rate_offer, sdec.rate_offer_from = nil, nil
  return true, why
end

-- The body of the Capture press: start a capture, or stop or step one already in progress. Fully guarded,
-- and returns a verdict rather than raising. Not the handler -- sdec.capture() wraps this to hold the tick.
function sdec.capture_run()
  ulog.resume()
  if sdec.ck_running and not sdec.strm_recording and sdec.ck_job == nil then
    if sdec.ck_stop then
      sdec.ck_running, sdec.ck_stop = false, false
      sdec.stickyerr = 'a previous run did not finish (aborted?) -- run flag cleared'
      ulog.line(sdec.stickyerr)
    else
      sdec.ck_stop = true                 -- second press during a stream = Stop
      sdec.ui_status = 'stopping'
      return sdec.ui_refresh()
    end
  end

  if sdec.press_absorbed('Capture') then return true end
  sdec.relocked = nil
  sdec.rate_backoff = nil
  sdec.rate_offer, sdec.rate_offer_from, sdec.rate_refused = nil, nil, nil

  if not sdec.strm_recording and sdec.ck_job == nil then
    sdec.res, sdec.midi, sdec.lin = nil, nil, nil
    sdec.ck_tot, sdec.ck_nbytes = nil, nil
    sdec.lasterr, sdec.savedas = nil, nil
    sdec.fmt_note, sdec.baud_note, sdec.rate_note = nil, nil, nil
    sdec.mode_exited, sdec.lognote, sdec.autolocknote = nil, nil, nil
    sdec.ui_status = 'capturing'
    sdec.ui_refresh()
  end
  if sdec.busy then
    sdec.lasterr = 'previous capture did not finish (aborted?) -- starting a new one'
    ulog.line(sdec.lasterr)
  end
  sdec.busy = true

  local md = sdec.mode_cur()
  if not md.view and sdec.strm_recording then
    local sok, swhy = false, nil
    local pok, r1, r2 = pcall(sdec.stream_stop)
    sok, swhy = (pok and r1), r2
    if not pok then swhy = r1 end
    sdec.busy = false
    if not pok or not sok then
      sdec.errcount = sdec.errcount + 1
      sdec.lasterr = tostring(swhy or 'recording failed')
      sdec.ui_status = 'error'
      ulog.line(sdec.lasterr)
      sdec.mode_exit('recording failed', true)
    end
    sdec.ui_refresh()
    return sok
  end

  if sdec.ck_job ~= nil then
    sdec.busy = false
    return sdec.decode_step()
  end

  if not md.view and sdec.strm_press then
    sdec.detect_reset()
    local sok, swhy = false, nil
    local pok, r1, r2 = pcall(sdec.stream_start)
    sok, swhy = (pok and r1), r2
    if not pok then swhy = r1 end
    sdec.busy = false
    if not pok or not sok then
      sdec.errcount = sdec.errcount + 1
      sdec.lasterr = tostring(swhy or 'could not start recording')
      sdec.ui_status = 'refused'
      ulog.line(sdec.lasterr)
      sdec.mode_exit(sdec.lasterr, true)
    else
      sdec.ui_status = 'recording -- press Capture to stop'
    end
    sdec.ui_refresh()
    return sok
  end

  if not md.view then
    sdec.detect_reset()
    sdec.ui_status = 'capturing'
    sdec.strm_inflight = true
    local sok, swhy = false, nil
    local pok, r1, r2 = pcall(sdec.record_run)
    sok, swhy = (pok and r1), r2
    if not pok then swhy = r1 end
    sdec.strm_inflight = nil
    sdec.busy, sdec.ck_running = false, false
    if not pok then
      sdec.errcount = sdec.errcount + 1
      sdec.lasterr = 'stream raised: ' .. tostring(swhy)
      sdec.ui_status = 'error'
      ulog.line(sdec.lasterr)
    elseif not sok then
      sdec.errcount = sdec.errcount + 1
      sdec.lasterr = tostring(swhy)
      sdec.ui_status = 'refused'
      ulog.line('stream refused: ' .. tostring(swhy))
    else
      sdec.ui_status = 'done'
      ulog.line(sdec.ck_summary(sdec.ck_tot))
      if sdec.ck_tot ~= nil and sdec.ck_tot.tail ~= nil then
        sdec.res = sdec.ck_tot.tail
      end
    end
    sdec.mode_exit(sdec.strm_exit_why(sdec.ck_endwhy, sok, sdec.lasterr), not sok)
    sdec.ui_refresh()
    sdec.strm_absorb_arm()
    return sok, swhy
  end

  sdec.ck_tot, sdec.ck_nbytes = nil, nil
  sdec.fc_win, sdec.fc_bytes, sdec.fc_end, sdec.fc_secs = nil, nil, nil, nil
  sdec.detect_reset()
  sdec.ui_status = 'capturing'
  sdec.ui_refresh()

  local ok, why = sdec.autoset()

  local rb = sdec.rate_backoff
  sdec.rate_backoff = nil
  if rb then
    ulog.line('rate back-off: ' .. tostring(sdec.relocked))
    sdec.ui_status = 'retrying'
    sdec.ui_refresh()
    local keep = sdec.relocked
    ok, why = sdec.autoset()
    if sdec.relocked == nil then sdec.relocked = keep end
    sdec.rate_backoff = nil
  end
  sdec.busy = false

  if not ok then
    sdec.errcount = sdec.errcount + 1
    if sdec.lasterr == nil then sdec.lasterr = tostring(why) end
    sdec.ui_status = 'no decode'
    ulog.line('no decode: ' .. tostring(why))
  else
    sdec.ui_status = 'done'
    sdec.ui_page = 0
    ulog.line(sdec.summary(1))
    ulog.line(sdec.summary(2))
    ulog.line(sdec.summary(3))
    sdec.proto_parse()
    sdec.autolock_try()
    local nt, nn = sdec.ui_notes()
    local ni
    for ni = 1, nn do ulog.line('note: ' .. nt[ni]) end
    if sdec.res ~= nil then
      local i, per = 1, 16
      while i <= sdec.res.nf do
        ulog.line(sdec.ua_hex_line(i, per))
        i = i + per
      end
    end
    if md.log then sdec.frame_log() end
  end

  sdec.ui_refresh()
  return ok
end

-- The half-second tick is off for the whole press. A tick is dispatched exactly like a press, so work
-- that holds the interpreter defers ticks rather than suppressing them. A wrapper rather than an edit
-- into the body, because capture_run() has a dozen returns and a missed one would leave no tick.
-- The body is not guarded, and a raise reaches the caller: `pcall(sdec.capture)` is how two callers ask
-- whether the press faulted, and what a raise would skip, sdec.unwind restores.
function sdec.capture()
  sdec.ui_keypoll()
  sdec.ui_tick_off()
  sdec.drop_pending = true
  local a, b = sdec.capture_run()
  sdec.drop_pending = nil
  sdec.ui_tick_on()
  return a, b
end

sdec.autolock_min  = 8      -- frames required before a detection may be locked
sdec.autolock_run  = 0.6
sdec.autolock_fitq = 0.9    -- least-squares fit quality required
if sdec.autolock == nil then sdec.autolock = true end

-- Suppress auto-lock for the NEXT capture only. Returns true.
function sdec.autolock_defer()
  sdec.autolock_skip = true
  return true
end

-- Lock the detected rate if the capture is good enough to trust. Returns whether it locked.
function sdec.autolock_try()
  if not sdec.autolock then return false end
  if sdec.autolock_skip then
    sdec.autolock_skip = nil
    return false
  end
  if sdec.force_baud ~= nil then return false end       -- already locked, nothing to do
  local r = sdec.res
  if r == nil or sdec.baud == nil then return false end
  local lockfrom = sdec.baud
  if sdec.snapped and sdec.snapfirm == false and sdec.baud_raw ~= nil then lockfrom = sdec.baud_raw end
  local lockb, lockok = sdec.baud_round(lockfrom)
  if not sdec.snapped and not lockok then return false end
  local nf = r.nf or 0
  local best, cur, i = 0, 0, nil
  for i = 1, nf do
    if r.errs[i] == nil then
      cur = cur + 1
      if cur > best then best = cur end
    else
      cur = 0
    end
  end
  if best < sdec.autolock_min then return false end
  if best < sdec.autolock_run * nf then return false end
  if (r.ngood or 0) < sdec.autolock_min then return false end
  if (sdec.fitq or 0) < sdec.autolock_fitq then return false end
  if sdec.sig_levelwarn ~= nil and sdec.sig_levelwarn() ~= nil then return false end

  sdec.autolock_set = {}
  sdec.force_baud   = lockb
  sdec.autolock_set.baud = true
  if sdec.force_nbits == nil then sdec.force_nbits = r.nbits; sdec.autolock_set.nbits = true end
  if sdec.force_par   == nil then sdec.force_par   = r.par;   sdec.autolock_set.par   = true end
  if sdec.force_nstop == nil then sdec.force_nstop = r.nstop; sdec.autolock_set.nstop = true end
  if sdec.force_invert == nil and r.invert ~= nil and
     (sdec.idle_weak == false or (sdec.polwhy ~= nil and sdec.polwhy ~= 'prior')) then
    sdec.force_invert = r.invert
    sdec.autolock_set.invert = true
  end

  sdec.baud, sdec.snapped, sdec.snapfirm = sdec.force_baud, true, true
  local fs = sdec.fs_for_baud(sdec.force_baud)
  local nb = sdec.window_bytes(sdec.force_baud, r.nbits, r.par, r.nstop)
  sdec.autolocknote = string.format(
    'auto-locked %s %s: next %g kS/s ~%d B (Options > Baud Rate = 0 re-detects)',
    tostring(sdec.baud_text()), tostring(sdec.fmt_text()), (fs or 0) / 1000, nb or 0)
  return true
end

-- Protocol layer
-- Run one protocol layer's parser over the bytes just decoded. mode names the view. -> whether it ran.
function sdec.proto_parse1(mode)
  local v = sdec.ui_view(mode)
  if v == nil or v.parse == nil then return false end
  local fn = sdec[v.parse]
  if fn == nil then return false end
  local ok, perr = pcall(fn)
  if not ok then
    sdec[v.res] = nil
    sdec.proto_why = string.format('%s decode failed (%s) -- the bytes below are still the '
                                   .. 'decoded UART stream', tostring(mode),
                                   tostring(perr or 'unknown'))
    ulog.line('proto: ' .. sdec.proto_why)
    return false
  end
  if sdec[v.res] ~= nil then
    local sm = sdec[v.summary]
    if sm ~= nil then pcall(function() ulog.line(tostring(mode) .. ': ' .. tostring(sm())) end) end
  end
  return ok
end

-- Parse the layers the panel is about to need: the one selected on the options form, and the one being
-- viewed when that is a different one. `which` parses that layer alone. Returns whether any parser ran.
function sdec.proto_parse(which)
  if which ~= nil then return sdec.proto_parse1(which) end
  local did = false
  if sdec.proto ~= nil and sdec.proto ~= 'uart' then
    did = sdec.proto_parse1(sdec.proto)
  end
  if sdec.ui_mode ~= sdec.proto then
    if sdec.proto_parse1(sdec.ui_mode) then did = true end
  end
  return did
end

-- The inbound firmware boundary
--   [...]
-- Separate from sdec.guard because not every raise reaches the boundary: a frame that catches one to
-- make a decision of its own, like lock_toggle, has to do this too or the cleanup does not happen.
-- Raise-free by construction, and it does not log -- a full key is the condition that brought the app here.
function sdec.unwind(why)
  sdec.busy = false
  sdec.ck_running = false
  if sdec.trig_restore ~= nil then
    sdec.trigmode = sdec.trig_restore
    sdec.trig_restore = nil
  end
  if sdec.drop_pending then
    sdec.drop_pending = nil
    if sdec.drop_stale_result ~= nil then sdec.drop_stale_result() end
  end
  if sdec.fh_unwind ~= nil then
    local h = sdec.fh_unwind
    sdec.fh_unwind = nil
    file.close(h)
  end
  if sdec.ui_tick_on ~= nil then sdec.ui_tick_on() end
  sdec.errcount = (sdec.errcount or 0) + 1
  sdec.lasterr = tostring(why)
  sdec.ui_status = 'error'
  if sdec.ui_refresh ~= nil then sdec.ui_refresh() end
  return false
end

-- Run a panel handler so a raise cannot reach the firmware. -> true if it returned. The one place a
-- pcall may wrap this app's own code, and a firmware boundary like any other: the instrument calls these by
-- name out of a display event string, and an escaping raise becomes a modal dialog over the app.
function sdec.guard(f)
  local ok, err = pcall(f)
  if ok then return true end
  return sdec.unwind(err)
end

-- Save the decoded stream to the USB key
-- Write a self-describing file: the wire parameters, the capture as hex + ASCII, then every parsed
-- protocol list. Returns ok.
function sdec.save()
  sdec.savedas = nil
  if sdec.res == nil or sdec.res.nf == 0 then
    sdec.lasterr = 'nothing to save -- capture first'
    sdec.ui_refresh()
    return false
  end

  local L, n = {}, 0
  local function add(s) n = n + 1; L[n] = s end
  add('DMM6500 serial decode')
  add('')
  add('baud       ' .. sdec.baud_text())
  add('format     ' .. sdec.fmt_text())
  local idle = 'HIGH'
  if sdec.res.invert then idle = 'LOW' end
  add('idle       ' .. idle)
  add('levels     ' .. tostring(sdec.family) .. string.format('  %.3f / %.3f V',
      sdec.lo or 0, sdec.hi or 0))
  add(string.format('threshold  %.3f V', sdec.thr or 0))
  add(string.format('sample rate %.0f S/s', sdec.acq_fs or sdec.fs or 0))
  add(string.format('samples/bit %.2f', sdec.bittime or 0))
  add(string.format('bytes      %d   framing errors %d', sdec.res.nf or 0, sdec.res.nbad or 0))
  if sdec.res.nfalse ~= nil and sdec.res.nfalse > 0 then
    add(string.format('false starts rejected %d  (impulse noise)', sdec.res.nfalse or 0))
  end
  local nt, nn = sdec.ui_notes()
  local ni
  for ni = 1, nn do add('NOTE       ' .. nt[ni]) end
  add('')
  add('"framing errors" counts stop/parity failures only. A noise spike on a data')
  add('bit corrupts the byte with no error indication.')
  add('')
  local i, per = 1, 16
  while i <= sdec.res.nf do
    add(sdec.ua_hex_line(i, per))
    i = i + per
  end

  local vi
  for vi = 1, table.getn(sdec.ui_views) do
    local v = sdec.ui_views[vi]
    if v.res ~= nil then
      local pr = sdec[v.res]
      if pr ~= nil and pr.n > 0 then
        local sm = sdec[v.summary]
        add('')
        add((v.label or v.name) .. ' -- ' .. (sm and sm() or ''))
        add('')
        for i = 1, pr.n do add(pr.msg[i]) end
      end
    end
  end

  local path = ulog.next_free(sdec.savepfx, sdec.saveext)
  local ok, why = ulog.write_file(path, L, n)
  if ok then
    sdec.savedas = path
    sdec.lasterr = nil
    ulog.line('saved ' .. tostring(path))
  else
    if path == nil and ulog.idx_why ~= nil then why = ulog.idx_why end
    sdec.lasterr = 'save failed: ' .. tostring(why)
  end
  sdec.ui_refresh()
  return ok
end

-- View handlers
-- Advance through the views this build has -- text -> hex -> text in version 1, where ui_view_avail()
-- hides the MIDI and LIN entries that would always be empty.
function sdec.view_toggle()
  sdec.ui_keypoll()
  local n = sdec.ui_nviews()
  if n < 1 then return false end
  local at, i, k = 0, nil, 0
  for i = 1, table.getn(sdec.ui_views) do
    if sdec.ui_view_avail(sdec.ui_views[i]) then
      k = k + 1
      if sdec.ui_views[i].mode == sdec.ui_mode then at = k end
    end
  end
  local nx = sdec.ui_view_nth(math.mod(at, n) + 1)
  if nx == nil then return false end
  sdec.ui_mode = nx.mode
  if nx.res ~= nil and sdec[nx.res] == nil then sdec.proto_parse(nx.mode) end
  sdec.ui_page = 0
  sdec.ui_rowc = nil          -- force a colour re-evaluation on the new layout
  return sdec.ui_refresh()
end

-- Show the next page of bytes. Bound to the 'Dn' button down the dump area's right margin, with page_prev() as
-- 'Up' above it; the host drives both over the socket. ui_paged is set even when the page does not move,
-- because it is what puts 'page N of M' on the note row and the last page is when that matters.
function sdec.page_next()
  sdec.ui_paged = true
  if sdec.ui_page + 1 < sdec.ui_npages() then sdec.ui_page = sdec.ui_page + 1 end
  return sdec.ui_refresh()
end

function sdec.page_prev()
  sdec.ui_paged = true
  if sdec.ui_page > 0 then sdec.ui_page = sdec.ui_page - 1 end
  return sdec.ui_refresh()
end

-- Start a new byte log, so one device's or one test's messages are separated from the next.
function sdec.log_new()
  local was = sdec.flog_path
  ulog.flush()
  sdec.flog_path, sdec.flog_n, sdec.flog_why = nil, nil, nil
  sdec.flog_bytes = nil        -- or the next file reports the previous file's byte total
  sdec.flog_last, sdec.flog_lastbytes, sdec.flog_lastgen = nil, nil, nil
  if was ~= nil then
    local base = string.gsub(tostring(was), '^.*/', '')
    sdec.lognote = string.format('closed %s -- the next capture starts a new file', tostring(base))
  else
    sdec.lognote = 'no message log open yet -- the next capture starts one'
  end
  ulog.line(sdec.lognote)
  return sdec.ui_refresh()
end

-- Clear every forced setting and re-capture: the inverse of Lock Detected, which is the button
-- beside it on the options form.
function sdec.options_auto()
  sdec.unlock_all()
  ulog.line('auto-detect: all forced settings cleared')
  sdec.options_seed()
  local md = sdec.mode_cur()
  if md.needbaud then
    sdec.mode_exit('auto-detect is FRAME-mode only')
    sdec.capmode = 'frame'
  end
  return sdec.options_apply()
end

-- The padlock's action: amber (auto) locks the detected settings and goes green, green (locked) unlocks back
-- to auto, red (nothing decoded) refuses with a reason. Either way it re-captures.
function sdec.lock_toggle()
  if sdec.busy then return false end
  local st = sdec.lock_state()
  local note = nil
  if st == 'locked' then
    sdec.unlock_all()
    sdec.autolock_defer()
    note = 'unlocked -- auto-detecting again, back to the top sample rate'
    if sdec.mode_cur().needbaud then
      sdec.mode_exit('unlocked the baud rate')
      sdec.capmode = 'frame'
    end
  elseif st == 'auto' then
    local r = sdec.res
    if r == nil or sdec.baud == nil then
      sdec.lasterr = 'nothing decoded yet -- capture first, then lock'
      return sdec.ui_refresh()
    end
    sdec.force_baud   = math.floor(sdec.baud_round(sdec.baud) + 0.5)
    sdec.force_nbits  = r.nbits
    sdec.force_par    = r.par
    sdec.force_nstop  = r.nstop
    sdec.force_invert = r.invert
    sdec.autolock_set = nil
  sdec.baud, sdec.snapped, sdec.snapfirm = sdec.force_baud, true, true
    note = string.format('locked %s %s', tostring(sdec.baud_text()), tostring(sdec.fmt_text()))
  else
    sdec.lasterr = 'nothing decoded yet -- capture first, then lock'
    return sdec.ui_refresh()
  end

  local pok, cres = pcall(sdec.capture)
  local cok = pok and cres
  if not pok then sdec.unwind('capture raised: ' .. tostring(cres)) end
  if note ~= nil and not (pok and cok) then
    sdec.lognote = note .. ' -- but the re-capture failed, so the figures above are the previous one'
    note = nil
  end
  if note ~= nil then
    local fs = sdec.fs
    if fs ~= nil and fs > 0 then
      if fs >= 1000000 then note = string.format('%s -- now sampling at %.0f MS/s', tostring(note), fs / 1000000)
      else note = string.format('%s -- now sampling at %.0f kS/s', tostring(note), fs / 1000) end
    end
    sdec.lognote = note
  end
  ulog.line(tostring(sdec.lognote or sdec.lasterr))
  sdec.options_seed()
  return sdec.ui_refresh()
end

-- Toggle the external trigger from the status row.
function sdec.trigext_toggle()
  if sdec.busy then return false end
  sdec.trigext = not sdec.trigext
  if sdec.trigext and sdec.trigmode == 'free' then
    sdec.lognote = 'external trigger ON but IGNORED -- Free run means do not wait'
  elseif sdec.trigext then
    sdec.lognote = 'external trigger ON -- the rear BNC also starts a capture'
  else
    sdec.lognote = 'external trigger OFF'
  end
  ulog.line(tostring(sdec.lognote))
  sdec.options_seed()
  return sdec.ui_refresh()
end

-- The note-row wording for a finished recording. endwhy is sdec.ck_endwhy; ok and err are the
-- run's verdict and its message.
function sdec.strm_exit_why(endwhy, ok, err)
  if ok == false and not (sdec.ck_cancel and sdec.strm_empty) then
    return 'run failed: ' .. tostring(err or 'unknown')
  end
  if sdec.ck_cancel then
    if (sdec.fc_win or 0) > 1 then
      return string.format('stopped with the TRIGGER key after %d windows', sdec.fc_win or 0)
    end
    return 'stopped with the TRIGGER key'
  end
  if sdec.fc_end == 'bound' then
    return string.format('reached the %d-window limit -- Mode, then Capture, resumes in a new file',
                         sdec.fc_maxwin or 32)
  elseif sdec.fc_end == 'timebound' then
    return string.format('reached the %g-minute limit after %d window(s) -- Mode, then Capture, '
                         .. 'resumes in a new file', (sdec.fc_maxsec or 1200) / 60, sdec.fc_win or 1)
  end
  if (sdec.fc_win or 0) > 1 and sdec.fc_end ~= nil then
    if sdec.fc_end == 'quiet' then
      return string.format('%d windows, then the device stopped sending', sdec.fc_win or 0)
    elseif sdec.fc_end == 'stopped' then
      return string.format('stopped after %d windows', sdec.fc_win or 0)
    end
  end
  if endwhy == 'readfail' then
    return 'recording failed: ' .. tostring(sdec.strm_readfail or 'the capture buffer could not be read')
  end
  if endwhy == 'noarm' then
    return string.format('nothing crossed %.2f V in %g s -- raise Arm/Idle Wait or lower Arm At',
                         sdec.arm_expired_at or sdec.thr or sdec.arm_level_v(), sdec.arm_wait_s())
  end
  if endwhy == 'quiet' then
    return string.format('%g s with no line activity', sdec.idle_exit() or 0)
  elseif endwhy == 'stopped' then
    if sdec.ck_cancel then return 'stopped with the TRIGGER key' end
    return 'stopped from the panel'
  elseif endwhy == 'full' then
    return 'buffer full -- the stream may continue'
  end
  return 'finished'
end


sdec.strm_absorb_s = sdec.strm_absorb_s or 1.0

-- Arm the queued-press absorb after a run that held the interpreter. On every ending, including 'stopped':
-- returning early because a press was SEEN assumes nothing is queued behind it, which is true of one press and
-- false of an operator who presses Capture, TRIGGER, Capture.
function sdec.strm_absorb_arm()
  sdec.strm_stopped_by_press = nil
  sdec.strm_nabsorbed = 0
  timer.cleartime()
  sdec.strm_stopped_by_press = true
end

-- True while still inside the window in which a press must have been queued.
function sdec.strm_absorb_due()
  if not sdec.strm_stopped_by_press then return false end
  local el = timer.gettime()
  if el == nil then return false end
  return el <= sdec.strm_absorb_s
end

-- The one gate every handler that matters consults: was this press queued behind a run that has
--   [...]
-- in the instrument's one global timer -- so anything taking the timer disarms first, as record_run()
-- does. Capture only, and narrowed by measurement: only Capture starts an uninterruptible run and wipes
-- the result, where a dead Mode button is worse than an unwanted mode change.
function sdec.press_absorbed(what)
  if not sdec.strm_absorb_due() then
    sdec.strm_stopped_by_press = nil
    sdec.strm_absorbed = nil
    return false
  end
  local n = (sdec.strm_nabsorbed or 0) + 1
  sdec.strm_nabsorbed = n
  sdec.lasterr = nil
  if n == 1 then
    sdec.strm_absorbed = string.format('%s taken as the Stop for the recording that just '
                                       .. 'ended -- press again to use it',
                                       tostring(what or 'the press'))
  else
    sdec.strm_absorbed = string.format('%d presses within a second of the run ending were '
                                       .. 'discarded -- press again to capture', n or 0)
  end
  ulog.line(sdec.strm_absorbed)
  sdec.ui_refresh()
  return true
end

-- Flush the current capture mode's files and say why. `why` goes on the note row. Returns the mode that
--   [...]
-- protected failure gets narrowed to a boolean nobody checks, which is this app's dominant defect class.
-- Never raises for any measured failure, so every caller calls it bare; see ulog.line for the one
-- unmeasured case.
function sdec.mode_exit(why, bad)
  local was = sdec.capmode
  local md = sdec.mode_cur()
  local running = sdec.ck_running
  local pressdriven = (sdec.ck_job ~= nil) or (sdec.strm_recording == true)
  if sdec.ck_job ~= nil then sdec.decode_abandon() end
  if sdec.strm_recording then
    sdec.strm_recording = nil
    sdec.stream_settle()
  end
  if pressdriven then
    running = false
    sdec.ck_running, sdec.ck_stop = false, false
  end
  ulog.flush()
  if sdec.flog_path ~= nil and (sdec.flog_bytes or 0) > 0 then
    sdec.flog_last, sdec.flog_lastbytes = sdec.flog_path, sdec.flog_bytes
    sdec.flog_lastgen = sdec.flog_keygen
  else
    sdec.flog_last, sdec.flog_lastbytes, sdec.flog_lastgen = nil, nil, nil
  end
  sdec.flog_path, sdec.flog_n, sdec.flog_why = nil, nil, nil
  sdec.flog_bytes = nil        -- or the next file reports the previous file's byte total
  if running then
    sdec.ck_stop = true
  else
    sdec.ck_running, sdec.ck_stop = false, false
  end
  sdec.mode_exited, sdec.mode_exitbad = nil, false
  if md.id ~= 'frame' then
    sdec.mode_exited = string.format('%s run ended (%s)', tostring(md.name), tostring(why or 'exited'))
    sdec.mode_exitbad = (bad == true)
    ulog.line(sdec.mode_exited)
  end
  return was
end

-- Which mode an idle Mode press advances to -- the entry, not the id.
-- Factored out so the panel can name it: a label that names the wrong destination is this app's
-- recurring defect, so the label and the action read the same function. Skips any mode that cannot be
-- right at the locked rate, bounded by n steps, because a table where nothing suits must not spin.
function sdec.mode_next()
  local n = sdec.ui_modes.n
  local at, i = 0, nil
  for i = 1, n do
    if sdec.ui_modes[i].id == sdec.capmode then at = i end
  end
  local step
  for step = 1, n do
    local cand = sdec.ui_modes[math.mod(at + step - 1, n) + 1]
    if sdec.mode_suits(cand) then return cand end
  end
  return sdec.ui_modes[1]
end

-- The Mode button. Two behaviours, and which applies turns on whether a run is in progress:
--   running  -> abort. Stop the stream and flush, in one press, staying in the mode.
--   idle     -> advance to the next mode, flushing the one being left on the way out.
-- The running branch does not land in FRAME: mode_exit() is a flush, so an abort leaves the setting.
function sdec.mode_cycle()
  sdec.ui_keypoll()
  sdec.rate_offer, sdec.rate_offer_from, sdec.rate_refused = nil, nil, nil
  if sdec.ck_running then
    sdec.mode_exit('Mode pressed')
    sdec.ck_tot, sdec.ck_nbytes = nil, nil
    sdec.ck_running, sdec.ck_stop = false, false
    sdec.ui_status = 'stopped'
    return sdec.ui_refresh()
  end

  local n = sdec.ui_modes.n
  local at, i = 0, nil
  for i = 1, n do
    if sdec.ui_modes[i].id == sdec.capmode then at = i end
  end
  local nxt = sdec.mode_next().id
  sdec.mode_exit('switching')
  sdec.capmode = nxt
  sdec.ck_tot, sdec.ck_nbytes = nil, nil
  ulog.line('mode = ' .. sdec.capmode)
  return sdec.ui_refresh()
end

-- The idle watchdog
-- Is there any activity in rd[1..n]? thr and hyst default to the current capture's. -> true if the line
-- crossed, false if it sat still.
function sdec.smp_active(rd, n, thr, hyst)
  if rd == nil or n == nil or n < 2 then return false end
  if thr == nil then thr = sdec.thr end
  if hyst == nil then hyst = sdec.hyst or 0 end
  local hiT, loT = thr + hyst, thr - hyst
  local st, i = nil, 0
  for i = 1, n do
    local v = rd[i]
    if v ~= nil then
      if st == nil then
        if v >= thr then st = 1 else st = 0 end
      elseif st == 1 then
        if v < loT then return true end
      else
        if v > hiT then return true end
      end
    end
  end
  return false
end

-- How many samples the idle watchdog looks at per poll, at sample rate fs.
function sdec.idle_window(fs)
  if fs == nil or fs <= 0 then return 2000 end
  local n = math.floor(fs / 10)
  if n < 200 then n = 200 end
  if n > 4000 then n = 4000 end
  return n
end

-- Options
-- Seed the form fields from the current force_* settings, on every open and after anything that changes
-- them, so the form always shows what is in effect without rebuilding it.
function sdec.options_seed()
  return pcall(function()
    if sdec.opt_proto ~= nil then
      display.setvalue(sdec.opt_proto, sdec.opt_proto_i(sdec.proto))
    end
    display.setvalue(sdec.opt_baud, sdec.force_baud or 0)
    local bi = 1
    if sdec.widths_any then bi = 2 end
    if sdec.force_nbits ~= nil then bi = sdec.force_nbits - 2 end
    display.setvalue(sdec.opt_bits, bi)
    local pi = 1
    if sdec.force_par ~= nil then pi = sdec.force_par + 2 end
    display.setvalue(sdec.opt_par, pi)
    local mi = 1
    if sdec.force_msb == false then mi = 2 end
    if sdec.force_msb == true then mi = 3 end
    display.setvalue(sdec.opt_msb, mi)
    local li = 1
    if sdec.force_invert == false then li = 2 end
    if sdec.force_invert == true then li = 3 end
    display.setvalue(sdec.opt_pol, li)
    local ti = 1
    local tk
    for tk = 1, sdec.opt_trig_v.n do
      if sdec.opt_trig_v[tk] == sdec.trigmode then ti = tk end
    end
    local xi, rk = 1, nil
    for rk = 1, sdec.opt_rear_v.n do
      if sdec.opt_rear_v[rk][1] == sdec.trigext and
         sdec.opt_rear_v[rk][2] == sdec.fc_out then xi = rk end
    end
    display.setvalue(sdec.opt_ext, xi)
    display.setvalue(sdec.opt_trig, ti)
    display.setvalue(sdec.opt_armv, sdec.arm_level_v())
    display.setvalue(sdec.opt_armw, sdec.arm_wait_s())
    display.setvalue(sdec.opt_over, (sdec.strm_overread or 0) * 100)
  end)
end

-- Snapshot everything the form can change, so Cancel can undo it. Returns true.
function sdec.options_save()
  sdec.opt_snap = {baud = sdec.force_baud, nbits = sdec.force_nbits,
                   par = sdec.force_par, nstop = sdec.force_nstop,
                   invert = sdec.force_invert, msb = sdec.force_msb, proto = sdec.proto,
                   any = sdec.widths_any, trig = sdec.trigmode,
                   ext = sdec.trigext, fc = sdec.fc_out, view = sdec.ui_mode,
                   aset = sdec.autolock_set,
                   armv = sdec.armlevel, armw = sdec.armwait,
                   over = sdec.strm_overread,
                   dhas = true, dbaud = sdec.baud,
                   dsnap = sdec.snapped, dfirm = sdec.snapfirm}
  return true
end

-- Put back the settings options_save() snapshotted. Returns false if there is no snapshot.
function sdec.options_restore()
  local s = sdec.opt_snap
  if s == nil then return false end
  sdec.force_baud, sdec.force_nbits = s.baud, s.nbits
  sdec.force_par, sdec.force_nstop, sdec.force_invert = s.par, s.nstop, s.invert
  sdec.force_msb = s.msb
  sdec.proto, sdec.widths_any = s.proto, s.any
  sdec.trigmode, sdec.trigext, sdec.fc_out = s.trig, s.ext, s.fc
  sdec.ui_mode = s.view
  sdec.autolock_set = s.aset
  if type(s.armv) == 'number' then sdec.armlevel = s.armv end
  if type(s.armw) == 'number' then sdec.armwait = s.armw end
  if type(s.over) == 'number' then sdec.strm_overread = s.over end
  if s.dhas then
    sdec.baud, sdec.snapped, sdec.snapfirm = s.dbaud, s.dsnap, s.dfirm
  end
  return true
end

-- Show the options screen, building it first if it does not exist yet.
function sdec.options()
  if sdec.optscr == nil then
    local bok, berr = pcall(sdec.build_options)
    if not bok or sdec.optscr == nil then
      sdec.lasterr = tostring(berr or 'the options screen could not be built')
      ulog.line('options: ' .. sdec.lasterr)
      return sdec.ui_refresh()
    end
  end
  sdec.options_save()     -- so Cancel has something to go back to
  local sok = sdec.options_seed()
  if not sok then
    sdec.lasterr = 'the Options form could not be filled in with the current settings -- not opening '
                   .. 'it, because Apply would then apply values you were not shown'
    ulog.line('options: ' .. sdec.lasterr)
    return sdec.ui_refresh()
  end
  sdec.ui_tick_off()
  local ok = pcall(display.changescreen, sdec.optscr)
  if not ok then sdec.ui_tick_on() end
  return ok
end

-- Copy what the last capture detected into the forced fields and re-seed the form. Does NOT
-- re-capture: the values are there to be reviewed, then applied with Apply.
function sdec.options_lock()
  if sdec.res == nil or sdec.baud == nil then
    sdec.lasterr = 'nothing detected yet -- capture first'
    sdec.ui_refresh()
    return false
  end
  sdec.force_baud  = math.floor(sdec.baud_round(sdec.baud) + 0.5)
  sdec.force_nbits = sdec.res.nbits
  sdec.force_par   = sdec.res.par
  sdec.force_nstop = sdec.res.nstop
  sdec.force_invert = sdec.res.invert
  sdec.autolock_set = nil
  sdec.baud, sdec.snapped, sdec.snapfirm = sdec.force_baud, true, true
  sdec.options_seed()
  ulog.fmt('locked: baud=%s bits=%s par=%s inv=%s', tostring(sdec.force_baud),
           tostring(sdec.force_nbits), tostring(sdec.force_par),
           tostring(sdec.force_invert))
  return true
end

-- Read every options field back, apply it, return to the main screen and capture.
function sdec.options_apply()
  local readok, readerr = pcall(function()
    sdec.autolock_set = nil
    local b = display.getvalue(sdec.opt_baud)
    if type(b) == 'number' and b >= 110 then sdec.force_baud = math.floor(b + 0.5)
    else
      if sdec.force_baud ~= nil then sdec.autolock_defer() end
      sdec.force_baud = nil
    end

    local bi = display.getvalue(sdec.opt_bits)
    sdec.force_nbits = sdec.opt_pick(sdec.opt_bits_v, bi)
    sdec.widths_any = (type(bi) == 'number' and math.floor(bi + 0.5) == 2)
    sdec.force_par   = sdec.opt_pick(sdec.opt_par_v, display.getvalue(sdec.opt_par))

    local mi2 = display.getvalue(sdec.opt_msb)
    if mi2 == 2 then sdec.force_msb = false
    elseif mi2 == 3 then sdec.force_msb = true
    else sdec.force_msb = nil end

    local li = display.getvalue(sdec.opt_pol)
    if li == 2 then sdec.force_invert = false
    elseif li == 3 then sdec.force_invert = true
    else sdec.force_invert = nil end

    local ti = display.getvalue(sdec.opt_trig)
    sdec.trigmode = sdec.opt_pick(sdec.opt_trig_v, ti) or 'edge'
    local ri = sdec.opt_rear_v[display.getvalue(sdec.opt_ext)] or sdec.opt_rear_v[1]
    sdec.trigext, sdec.fc_out = ri[1], ri[2]

    local av = display.getvalue(sdec.opt_armv)
    if type(av) == 'number' then sdec.armlevel = av end
    local aw = display.getvalue(sdec.opt_armw)
    if type(aw) == 'number' then sdec.armwait = aw end
    local ov = display.getvalue(sdec.opt_over)
    if type(ov) == 'number' then
      local f = ov / 100
      if f < 0 then f = 0 end
      if f > sdec.overread_max then f = sdec.overread_max end
      sdec.strm_overread = f
    end
  end)
  if not readok then
    sdec.options_restore()
    sdec.lasterr = 'Options could not be read in full -- nothing was changed (' ..
                   tostring(readerr) .. ')'
    ulog.line(sdec.lasterr)
    display.changescreen(sdec.ui_scr)
    sdec.ui_tick_on()
    sdec.ui_refresh()
    return false
  end

  local was = sdec.proto or 'uart'
  if sdec.opt_proto ~= nil then
    pcall(function()
      sdec.proto = sdec.opt_pick(sdec.opt_proto_list(),
                                 display.getvalue(sdec.opt_proto))
                or 'uart'
    end)
  end
  if sdec.proto ~= was and was == 'midi' then
    sdec.force_baud = nil
    sdec.autolock_defer()
  end

  if sdec.proto == 'midi' then
    sdec.force_baud, sdec.force_nbits = 31250, 8
    sdec.force_par, sdec.force_nstop = sdec.PAR_NONE, 1
    sdec.autolock_set = nil
    sdec.ui_mode = 'midi'
  elseif sdec.proto == 'lin' then
    sdec.force_nbits, sdec.force_par, sdec.force_nstop = 8, sdec.PAR_NONE, 1
    sdec.force_invert = false
    sdec.ui_mode = 'lin'
  elseif was ~= 'uart' then
    sdec.unlock_all()
    sdec.autolock_defer()
    if sdec.ui_view() ~= nil and sdec.ui_view().res ~= nil then sdec.ui_mode = 'text' end
  end

  ulog.line(string.format('options: proto=%s baud=%s bits=%s any=%s par=%s inv=%s trig=%s',
            tostring(sdec.proto),
            tostring(sdec.force_baud), tostring(sdec.force_nbits),
            tostring(sdec.widths_any),
            tostring(sdec.force_par), tostring(sdec.force_invert),
            tostring(sdec.trigmode)))

  display.changescreen(sdec.ui_scr)
  sdec.ui_tick_on()
  return sdec.capture()
end

-- Leave the options screen without applying anything.
function sdec.options_cancel()
  sdec.options_restore()
  sdec.options_seed()
  sdec.ui_refresh()
  local ok = pcall(display.changescreen, sdec.ui_scr)
  sdec.ui_tick_on()
  return ok
end

-- Lifecycle
-- Hook End App on screen scr, so leaving the app tears it down. Returns whether the hook took.
function sdec.install_cleanup(scr)
  local ok = pcall(display.setevent, scr, display.EVENT_ENDAPP, 'sdec.guard(sdec.cleanup)')
  if not ok then
    sdec.stickyerr = 'End App is not hooked -- exiting will not clean up'
    ulog.line(sdec.stickyerr)
  end
  return ok
end

-- Tear the app down: release the job, stop the hardware, delete objects, close the log. Never raises for
-- any measured failure, so every caller calls it bare; each firmware touch below carries its own guard.
-- It is also the End App event string, through sdec.cleanup(), where a raise reaches the firmware.
function sdec.stop()
  sdec.ui_tick_off()
  if sdec.ck_job ~= nil then sdec.decode_abandon() end
  if sdec.strm_recording then
    sdec.strm_recording = nil
    sdec.stream_settle()
  end
  sdec.ck_running, sdec.ck_stop = false, false
  trigger.model.abort()
  if sdec.digitizing() and sdec.atrig ~= nil then
    sdec.atrig.mode = sdec.k.MODE_OFF
  end
  sdec.cancel_ok = false
  local bl = trigger.blender
  if bl ~= nil and bl[sdec.cancel_blender] ~= nil then
    pcall(bl[sdec.cancel_blender].reset)
  end
  sdec.destroy_options()
  sdec.ui_destroy()
  if sdec.acq_bufs ~= nil and next(sdec.acq_bufs) ~= nil then
    sdec.acq_buffree()
    if next(sdec.acq_bufs) ~= nil then
      sdec.delfails = (sdec.delfails or 0) + 1
      sdec.stickyerr = 'a capture buffer could not be freed -- power cycle the instrument'
    end
  end
  if sdec.buf ~= nil then
    sdec.trig_settle()
    local b = sdec.buf
    local delok = sdec.bufdel(b)
    if delok then
      sdec.buf = nil
    else
      sdec.delfails = (sdec.delfails or 0) + 1
      sdec.stickyerr = 'the capture buffer could not be freed -- power cycle the instrument'
    end
  end
  local restored = sdec.buf_restore()
  if restored ~= nil then ulog.line('default buffer capacities: ' .. restored) end
  sdec.smp, sdec.nread = nil, 0
  sdec.res, sdec.midi, sdec.lin = nil, nil, nil
  sdec.ei, sdec.es, sdec.ne = nil, nil, 0
  sdec.w, sdec.nw = nil, 0
  sdec.ui_rowc = nil
  if not sdec.mode_restore() then
    ulog.line('entry mode could not be restored -- the digitize function is still selected')
  end
  ulog.close()
  return true
end

-- End App handler: stop the app and hand the screen back to the instrument.
function sdec.cleanup()
  local r = sdec.stop()
  collectgarbage()
  return r
end

-- Entry point: open the log, build the UI, and hook End App. Takes NO capture -- the app comes up idle. THE
-- BUILD is under pcall; cleanup(), del_orphans() and stop() on the failure path are not, and there is no guard
-- above launch. Returns false and a reason if a rebuild is refused or the build fails.
function sdec.start()
  sdec.ck_relaunching = nil
  local swept, sweptwhat = sdec.buf_sweep()
  local reclaimed, reclaimwhat = sdec.buf_reclaim()
  sdec.ck_swept, sdec.ck_sweptwhat = swept, sweptwhat
  sdec.ck_reclaimwhat = nil
  if reclaimed then sdec.ck_reclaimwhat = reclaimwhat end
  sdec.ck_bufmax, sdec.ck_bigbuf, sdec.ck_bigcap = sdec.bufmax_for()
  if sdec.ck_bufmax < sdec.ck_bufmin then
    local why = string.format('%d readings left for a recording and the smallest mode needs %d: '
                              .. '%s holds %d of the %d the instrument has, and resizing the '
                              .. 'default buffers back to %d %s.',
                              sdec.ck_bufmax, sdec.ck_bufmin,
                              sdec.ck_bigbuf or 'a default buffer',
                              sdec.ck_bigcap or 0, sdec.ck_bufpool, sdec.ck_defbufmin,
                              reclaimed and 'did not free enough' or 'was refused')
    local back = sdec.buf_restore()
    if back ~= nil then ulog.line('launch refused, so capacities handed back: ' .. back) end
    sdec.lasterr = why
    ulog.line('start refused: ' .. why)
    return false, why
  end
  if sdec.built then
    sdec.ck_relaunching = true
    sdec.cleanup()
    sdec.ck_relaunching = nil
    local left = 0
    left = sdec.del_orphans()
    if left < 1 then sdec.delfails = 0 end
    local nfail = sdec.delfails or 0
    if nfail > 0 and not sdec.allow_rebuild then
      local why = string.format('teardown left %d object(s) undeleted -- rebuilding over leaked '
                                .. 'handles risks a firmware panic. Power cycle, or set '
                                .. 'sdec.allow_rebuild = true to override.', nfail or 0)
      sdec.lasterr = why
      ulog.line('start refused: ' .. why)
      return false, why
    end
    ulog.line('rebuilding: previous UI torn down cleanly')
  end
  sdec.quiet_events()
  local binit, bwhy = sdec.acq_bufinit()
  if not binit then
    ulog.line('static buffers unavailable, falling back to per-capture allocation: ' ..
              tostring(bwhy))
  else
    ulog.line(string.format('static buffers: %s of %s, %s of %s frame rung(s), %s scratch(es), %s in force',
                            tostring(sdec.acq_bufnok), tostring(sdec.acq_bufplan.n),
                            tostring(sdec.acq_rungok), tostring(sdec.acq_rungwant),
                            tostring(sdec.acq_scrgot), tostring(sdec.acq_bufgot)))
  end
  sdec.built = true

  local ok, err = pcall(function()
    ulog.tag = 'SDEC'
    ulog.ensuredir()
    ulog.open(sdec.logpath)

    if (sdec.ck_swept or 0) > 0 then
      ulog.line(string.format('swept %d readings of buffers this app did not make: %s',
                              sdec.ck_swept, tostring(sdec.ck_sweptwhat)))
    end
    if sdec.ck_reclaimwhat ~= nil then
      ulog.line('reclaimed ' .. sdec.ck_reclaimwhat
                .. ' -- the resize discarded the readings those buffers held')
    end

    if sdec.ck_bigbuf == nil then
      ulog.line(string.format('recording ceiling: %d readings -- the default buffer capacities '
                              .. 'could not be read, so this is the static ceiling',
                              sdec.ck_bufmax))
    else
      ulog.line(string.format('recording ceiling: %d readings of %d, %s at %d, margin %d',
                              sdec.ck_bufmax, sdec.ck_bufpool, sdec.ck_bigbuf,
                              sdec.ck_bigcap, sdec.ck_bufmargin))
    end

    if sdec.mode_save() then
      ulog.line('entry mode: ' .. tostring(sdec.entrymode.side) .. ' '
                .. tostring(sdec.entrymode.func) .. ' -- restored on exit')
    else
      ulog.line('entry mode could not be read -- exiting will leave the digitize function selected')
    end

    sdec.reset_options()
    ulog.line('options reset: proto uart, FRAME mode, text view, baud auto, bits auto 7/8, '
              .. 'parity auto, polarity auto, trigger Start bit, rear BNC off')

    sdec.cancel_setup()
    sdec.ui_build(true)   -- hold the loading screen: build_options() is still to come
    sdec.install_cleanup(sdec.ui_scr)
    sdec.build_options()

    sdec.ui_loading_clear(sdec.ui_scr)
    sdec.ui_status = 'ready -- press Capture'
    sdec.ui_refresh()
  end)

  if not ok then
    sdec.lasterr = tostring(err)
    ulog.line('start failed: ' .. sdec.lasterr)
    sdec.stop()
    sdec.built = false
    return false, err
  end

  return true
end



loadscript Serial_Decode
-- $Title: Serial Protocol Decode
-- $Product: DMM6500
-- $Tag: Serial, UART, Decode, Digitize
-- $Description: BETA. Decodes an asynchronous serial line with the instrument's own digitizer: recovers baud rate, frame format and bytes, shows them as text or hex, streams every byte to a USB key, and saves the capture. Everything auto-detects; everything can be locked down.
-- $Version: 0.9
-- $Requires: 1.7.0
-- $Author: Ian Ameline
-- $License: MIT
-- $Icon: sdec_icon


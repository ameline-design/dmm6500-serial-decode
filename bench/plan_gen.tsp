-- plan_gen.tsp -- draw the soak plan ON THE INSTRUMENT, so a lap needs no host at all.
--
-- WHAT THIS CHANGES. Until 2026-10-22 the plan could only be drawn by tools/soakplan.py and pushed to
-- the key, and BRUN.md argued the instrument must never draw one: "a plan drawn twice is two
-- different experiments wearing one name", because the amplitude, the offset and the wait are all
-- keyed off a vector's INDEX. That objection is real and it is answered by construction rather than
-- by care:
--
--   * THE GENERATOR IS NOT A SECOND COPY. bench/plan_rand.tsp is the module tools/test_soakrand.py
--     holds to CPython's own sequence, moved rather than duplicated.
--   * THE DATA IS NOT A SECOND COPY. bench/plan_data.tsp is emitted BY soakplan.py, so the vector
--     list -- whose order is what vi keys on -- and every constant are the host's own values.
--   * THE LADDER IS NOT A COPY EITHER. sdec.rates, sdec.stdbaud and sdec.flatfloor are read live
--     here and read out of tsp/serial_core.tsp there, so neither side holds a snapshot.
--   * AND THE DRAW ITSELF IS CHECKED, not reasoned about. tools/test_plan_gen.lua runs this file
--     under BOTH Luas and compares the emitted CSV against soakplan.py --emit-csv byte for byte.
--     The arithmetic here is a port; the test is what makes it one draw rather than two.
--
-- SO THE REMAINING RISK IS NAMED: this is an independent implementation whose equivalence is
-- established by test rather than by sharing code. A plan drawn here and a plan drawn on the host are
-- the same experiment exactly as long as that test runs. It is wired into release_sweep.py.
--
-- WHY NOT JUST SHIP A PLAN IN THE ARCHIVE. A plan is per-iteration and a fortnight is ~272 000 rows;
-- the archive is already 457 kB. Drawing is cheaper than carrying, and it is also the only form that
-- can answer "the key has no plan" at app start.
--
-- PYTHON'S round() IS NOT math.floor(x + 0.5). It rounds the DOUBLE correctly -- round(2.675, 2) is
-- 2.67, because 2.675 is really 2.67499999... -- and half-way cases go to even. string.format does
-- the same thing through the C library, so q() and iround() below go through it rather than through
-- arithmetic. This matters: the quantised amplitude feeds back into the offset interval, so a
-- rounding that differs in the last place moves the offset of the cell and then every byte after it.

bplan = bplan or {}

bplan.path = bplan.path or '/usb1/SERDEC/PLAN.CSV'

-- The provenance line. NOT the host's wording: a reader of a plan has to be able to tell which draw
-- made it, and the test below compares every line BUT this one.
bplan.banner = '# generated by bench/plan_gen.tsp on the instrument; '
               .. 'one row per cell, streamed by bench_run.tsp'

bplan.cols = 'iter,cell,vid,arb,baud,kind,amp_vpp,ofst_v,srate,wait_ms'

-- ---------------------------------------------------------------------------
-- Rounding that matches Python's
-- ---------------------------------------------------------------------------
-- q(x, 3) is round(x, 3). iround(x) is int(round(x)). Both go through string.format so the decimal
-- conversion is the C library's correctly-rounded one, which is what CPython's round() also uses.
function bplan.q(x, nd)
  return tonumber(string.format('%.' .. nd .. 'f', x))
end

function bplan.iround(x)
  return tonumber(string.format('%.0f', x))
end

-- ---------------------------------------------------------------------------
-- The rate axis, read LIVE out of sdec
-- ---------------------------------------------------------------------------
-- standard_rates(): sdec.stdbaud inside [baudlo, baudhi], less the two soakplan drops.
function bplan.stdrates()
  local out, n = {}, 0
  local i = 1
  while sdec.stdbaud[i] ~= nil do
    local b = sdec.stdbaud[i]
    if b >= bplan.c.baudlo and b <= bplan.c.baudhi and bplan.bauddrop[b] == nil then
      n = n + 1
      out[n] = b
    end
    i = i + 1
  end
  return out, n
end

-- ladder_edges(): the baud in each ladder step with the FEWEST samples a bit, floor(fs/8), deduped
-- and ascending. floor and not round: at fs = 2500 the exact edge is 312.5, and 312 still snaps to
-- 2500 for 8.013 samples a bit while 313 snaps up to 5000 for 15.97.
function bplan.edges()
  local seen, out, n = {}, {}, 0
  local i = 1
  while sdec.rates[i] ~= nil do
    local e = math.floor(sdec.rates[i] / 8)
    if e >= bplan.c.baudlo and e <= bplan.c.baudhi and seen[e] == nil then
      seen[e] = true
      n = n + 1
      out[n] = e
    end
    i = i + 1
  end
  table.sort(out)
  return out, n
end

-- One non-standard rate strictly inside (lo, hi). -> baud, why
--
-- LOG-UNIFORM, not linear: what breaks a decode is samples a bit and where the ladder snaps, and both
-- are multiplicative, so a uniform draw in a wide gap sits near the top of it in ratio terms.
function bplan.interstitial(it, gi, lo, hi, edges, nedge)
  local g = bplan.mt.new{bplan.k.magic, it, bplan.k.rate, gi}
  local inside, ni = {}, 0
  local i
  for i = 1, nedge do
    if edges[i] > lo and edges[i] < hi then
      ni = ni + 1
      inside[ni] = edges[i]
    end
  end
  if ni > 0 and g:below(bplan.c.edgeodds) == 0 then
    return inside[g:below(ni) + 1], 'edge'
  end
  local u = g:float()
  local baud = bplan.iround(math.exp(math.log(lo) + u * (math.log(hi) - math.log(lo))))
  -- Clamped OFF the endpoints: a draw landing on a standard rate would silently test it twice and
  -- report one gap as covered when it was not.
  if baud <= lo then baud = lo + 1 end
  if baud >= hi then baud = hi - 1 end
  return baud, 'rand'
end

-- The iteration's rate list, ascending. -> {{baud=, kind=}, ...}, n
--
-- THE SAME RATE LIST FOR EVERY VECTOR IN THE ITERATION, which is what makes a sweep a sweep.
function bplan.rates(it)
  local std, ns = bplan.stdrates()
  local edges, ne = bplan.edges()
  local out, n = {}, 0
  local i
  for i = 1, ns do
    n = n + 1
    out[n] = {baud = std[i], kind = 'std'}
  end
  for i = 1, ns - 1 do
    local lo, hi = std[i], std[i + 1]
    -- Nothing drawn inside a gap that closes at or below interlo, and the test is on `hi` because the
    -- draw is strictly inside the interval: hi <= the floor is exactly the condition that every rate
    -- the gap could yield is under it.
    if hi - lo >= 2 and hi > bplan.c.interlo then
      local baud, why = bplan.interstitial(it, i - 1, lo, hi, edges, ne)
      n = n + 1
      out[n] = {baud = baud, kind = why}
    end
  end
  -- A TOTAL ORDER, because table.sort is not stable and Python sorted() on (baud, kind) tuples breaks
  -- a tie on the kind string. No two entries can share a baud -- the gaps are disjoint and the draw is
  -- strictly inside one -- but a comparator that only looked at baud would be at the mercy of the
  -- sort's internals if one ever did.
  table.sort(out, function(a, b)
    if a.baud ~= b.baud then return a.baud < b.baud end
    return a.kind < b.kind
  end)
  return out, n
end

-- ---------------------------------------------------------------------------
-- The vector axis
-- ---------------------------------------------------------------------------
-- Which random-payload vectors this iteration does NOT play. -> a set, possibly empty
function bplan.rdrop(it, keep)
  local out = {}
  local nr = 0
  while bplan.rvecs[nr + 1] ~= nil do nr = nr + 1 end
  if keep == nil or keep >= nr then return out end
  local t, i = {}, nil
  for i = 1, nr do t[i] = bplan.rvecs[i] end
  local g = bplan.mt.new{bplan.k.magic, it, bplan.k.rsub, 0}
  g:shuffle(t)
  local first = keep
  if first < 1 then first = 1 end
  for i = first + 1, nr do out[t[i]] = true end
  return out
end

-- The vectors every hardware lap leaves out, as a set.
--
-- THE DEFAULT, AND NOT MERELY A CONVENIENCE. soakplan.py's --skip-vectors defaults to these four, so
-- a draw that passed no skip would not be the same plan -- and the skip is applied BEFORE the
-- shuffle, so it would not be a smaller plan either, it would be a different stimulus in every cell.
-- It also matters on its own: v96 WEDGES THE GENERATOR, and this draw exists so a lap can run
-- overnight with nobody at the bench to power cycle it.
function bplan.hwskipset()
  local out, i = {}, 1
  while bplan.hwskip[i] ~= nil do
    out[bplan.hwskip[i]] = true
    i = i + 1
  end
  return out
end

-- The skip set for ONE iteration: the run's own skip plus the random vectors sitting this lap out.
-- ONE PLACE, because two call sites computing a skip themselves is what let a hardware lap and its
-- offline twin drive different waveforms while comparing their results.
--
-- nil MEANS THE HARDWARE SKIP, not "skip nothing" -- that is soakplan's own default. An empty table
-- is how a caller asks for every vector, which is explicit because it drives v96.
function bplan.skipfor(it, skip, rkeep)
  local out = {}
  local k
  if skip == nil then skip = bplan.hwskipset() end
  for k in pairs(skip) do out[k] = true end
  if rkeep ~= nil then
    local d = bplan.rdrop(it, rkeep)
    for k in pairs(d) do out[k] = true end
  end
  return out
end

-- THE ONE PLACE A LAP'S VECTOR ORDER IS DECIDED. -> ordered list, n
--
-- THE SKIP IS APPLIED BEFORE THE SHUFFLE, and that is not a detail: vi is the position in THIS list,
-- and vi keys both the wait and the amplitude/offset pair. Drop two vectors and every remaining
-- vector's index moves, so the whole lap draws a different stimulus. Measured once at 1677 of 1677
-- cells. Filtering after the shuffle would keep vi stable and is not available: the laps already on
-- disk were drawn this way and their receipts are the ground truth.
function bplan.order(it, skip, nvec)
  local keep, n = {}, 0
  local i = 1
  while bplan.vecs[i] ~= nil do
    local v = bplan.vecs[i]
    if skip == nil or skip[v] == nil then
      n = n + 1
      keep[n] = v
    end
    i = i + 1
  end
  local g = bplan.mt.new{bplan.k.magic, it, bplan.k.order, 0}
  g:shuffle(keep)
  if nvec ~= nil and nvec < n then
    local k = nvec
    if k < 1 then k = 1 end
    local out = {}
    for i = 1, k do out[i] = keep[i] end
    return out, k
  end
  return keep, n
end

-- ---------------------------------------------------------------------------
-- The per-cell draws. vi and ri are ZERO-BASED, as Python's enumerate() makes them.
-- ---------------------------------------------------------------------------
-- Seconds to idle before the capture. SCALED TO A BYTE TIME, so the draw means the same thing at
-- every rate: ten byte times is 0.4 ms at 250 kBd and 333 ms at 300 Bd.
--
-- THE FIRST LOOK KEEPS A FOUR-ELEMENT KEY. MT19937 seeds from the whole array, so appending even a
-- zero would change the draw for every cell of every plan already on disk. rep = 0 is spelled as
-- absence, not as a zero.
function bplan.wait(it, vi, ri, baud, rep)
  local key = {bplan.k.magic, it, bplan.k.wait, vi, ri}
  if rep ~= nil and rep ~= 0 then key[6] = rep end
  local g = bplan.mt.new(key)
  return g:float() * bplan.c.waitbt * bplan.c.bitsbyte / baud
end

-- The two vertical draws, each in [0,1). Keyed like the wait, so one cell replays without running the
-- cells before it.
function bplan.ampofst_u(it, vi, ri)
  local ua = bplan.mt.new{bplan.k.magic, it, bplan.k.amp, vi, ri}:float()
  local uo = bplan.mt.new{bplan.k.magic, it, bplan.k.ofst, vi, ri}:float()
  return ua, uo
end

-- A vector's codeword extremes, SIGNED. -> lo, hi
--
-- Derived from the manifest rather than read, because reading the words unsigned turns a small
-- negative excursion into a near-full-scale one: the drift vectors dip below zero, and 45 % of full
-- scale then reads as 100 %, which is the difference between a vector with headroom and one with none.
function bplan.cwspan(vid)
  local s = bplan.span[vid]
  local k = 32767 / (s.amp / 2)
  return bplan.iround((s.lo - s.ofst) * k), bplan.iround((s.hi - s.ofst) * k)
end

-- Map two unit draws to a CLIP-SAFE amplitude and offset. -> amp_vpp, ofst_v
--
-- The amplitude scales the vector's OWN reference, clamped to the generator's ceiling. The offset is
-- then placed inside whatever range keeps both extremes within the rails at that amplitude, so a
-- vector already near the rail gets a narrow range rather than a clipped waveform.
function bplan.ampofst(vid, u_amp, u_ofst)
  local s = bplan.span[vid]
  local lo, hi = bplan.cwspan(vid)
  local ref_span = s.hi - s.lo
  if ref_span < 1e-9 then ref_span = 1e-9 end
  local target = bplan.c.swinglo + u_amp * (bplan.c.swinghi - bplan.c.swinglo)
  local amp = s.amp * target / ref_span
  -- QUANTISE BEFORE THE INTERVAL IS COMPUTED, not after. Rounding an offset that already sat exactly
  -- on the rail pushes it over, which kills a run at the clip check: measured on v48b and v61 at
  -- u_ofst -> 1, which a long soak reaches.
  if amp > bplan.c.sdgmax then amp = bplan.c.sdgmax end
  amp = bplan.q(amp, bplan.c.qdig)
  local dlo, dhi = 0, 0
  local pass
  for pass = 1, 2 do
    local half = amp / 2
    dlo = -bplan.c.vrail - lo / 32767 * half
    dhi = bplan.c.vrail - hi / 32767 * half
    -- AND THE GENERATOR'S ENVELOPE, which is the tighter bound whenever the vector fills part of full
    -- scale: the two lines above bound the DATA band, these bound the NOMINAL pair, because the DAC
    -- span moves with the offset whether the codewords use it or not. Amplitude and offset are
    -- therefore NOT independent -- at 20 Vpp the only legal offset is 0, and the largest-swing cells
    -- lose their offset range entirely. That is not lost coverage; it is coverage that was never
    -- reaching the wire.
    if half > bplan.c.env then
      dlo, dhi = 0, 0
    else
      if dlo < -(bplan.c.env - half) then dlo = -(bplan.c.env - half) end
      if dhi > bplan.c.env - half then dhi = bplan.c.env - half end
    end
    if dhi >= dlo then break end
    -- No offset fits at this amplitude. Shrink rather than clip: a clipped waveform is a different
    -- stimulus that still reports as the one that was asked for.
    local den = hi - lo
    if den < 1 then den = 1 end
    amp = bplan.q(2 * bplan.c.vrail * 2 * 32767 / den, bplan.c.qdig)
  end
  -- A SINGLE-SUPPLY LINE MAY NOT BE DRAWN STRADDLING GROUND. sig_levels decides polarity from the
  -- LEVELS when no run in the window reaches ten bit times, and reads lo < -flatfloor with
  -- hi > +flatfloor as RS-232 marking at its NEGATIVE level. That is right for a real
  -- ground-straddling line and wrong for a logic waveform this draw shifted there -- the decode comes
  -- back inverted, with the right rate and self-consistent bytes matching nothing. MEASURED before
  -- the constraint: 17.3 % of cells were driven straddling ground and they were 86.8 % of every
  -- offline failure. The app was right every time; the stimulus could not exist.
  --
  -- ONLY THE STRADDLING WINDOW IS REMOVED, NOT EVERYTHING BELOW IT. A wholly-negative band is
  -- legitimate and decodes -- offset -6.5 V passes where -3.6 V fails -- so cutting the whole range
  -- below the upper edge threw away 57.5 % of the interval on some vectors. The draw maps onto the two
  -- surviving segments instead. Vectors whose own rendering already goes negative are RS-232-shaped by
  -- construction and exempt.
  local ofst
  local nseg, seg = 0, {}
  if s.lo >= 0 then
    local half_c = amp / 2
    local a_edge = -sdec.flatfloor - lo / 32767 * half_c
    local b_edge = sdec.flatfloor - hi / 32767 * half_c
    if a_edge > b_edge then
      local l1, h1 = dlo, b_edge
      if h1 > dhi then h1 = dhi end
      local l2, h2 = a_edge, dhi
      if l2 < dlo then l2 = dlo end
      if h1 > l1 then nseg = nseg + 1; seg[nseg] = {l1, h1} end
      if h2 > l2 then nseg = nseg + 1; seg[nseg] = {l2, h2} end
    end
  end
  if nseg > 0 then
    local total, i = 0, nil
    for i = 1, nseg do total = total + (seg[i][2] - seg[i][1]) end
    local want = u_ofst * total
    ofst = seg[nseg][2]
    for i = 1, nseg do
      local w = seg[i][2] - seg[i][1]
      if want <= w then
        ofst = seg[i][1] + want
        break
      end
      want = want - w
    end
    ofst = bplan.q(ofst, bplan.c.qdig)
  else
    local w = dhi - dlo
    if w < 0 then w = 0 end
    ofst = bplan.q(dlo + u_ofst * w, bplan.c.qdig)
  end
  -- Rounding may only ever move the offset toward the middle, never past an edge.
  local qstep = 10 ^ (-bplan.c.qdig)
  if ofst > dhi then ofst = math.floor(dhi / qstep) * qstep end
  if ofst < dlo then ofst = math.ceil(dlo / qstep) * qstep end
  return amp, bplan.q(ofst, bplan.c.qdig)
end

-- ---------------------------------------------------------------------------
-- Emitting the file
-- ---------------------------------------------------------------------------
-- WRITTEN IN BLOCKS, not a row at a time and not all at once. A fortnight plan is ~272 000 rows and
-- the whole file as one Lua string is megabytes on a heap that has none to spare; a file.write per row
-- is a syscall per row. A block of 200 rows is about 12 kB.
bplan.block = bplan.block or 200

-- -> ok, nrows, err
--
-- opt = {first=, last=, skip=, rkeep=, reps=, nvec=}. Every field optional; the defaults are the
-- host's own for a soak push -- one iteration, every vector, every random vector, one look each.
function bplan.emit(path, opt)
  if sdec == nil or sdec.stdbaud == nil then
    return false, 0, 'the app is not loaded, so there is no rate ladder to draw against'
  end
  if bplan.vecs == nil or bplan.span == nil then
    return false, 0, 'bench/plan_data.tsp did not load, so there is no vector list'
  end
  opt = opt or {}
  local first = opt.first or 1
  local last  = opt.last or first
  local reps  = opt.reps or 1
  local fh = file.open(path, file.MODE_WRITE)
  if fh == nil then
    return false, 0, 'cannot write ' .. path .. ' -- is the key in and is /usb1/SERDEC there?'
  end
  -- TWO PASSES, because the row count and the lap size go in the HEADER and neither is known until
  -- the rows are built. The alternative is holding the whole file in memory, which is what the block
  -- writer above exists to avoid. A pass is pure arithmetic -- no file and no generator -- so the
  -- cost is CPU and not instrument time.
  local nrows, per, same = 0, nil, true
  local it
  for it = first, last do
    local n = bplan.lapsize(it, opt, reps)
    nrows = nrows + n
    if per == nil then per = n elseif per ~= n then same = false end
  end
  -- PROGRESS, BECAUSE A SILENT DRAW READS AS A HANG. This is thousands of keyed MT19937 streams and
  -- it is not fast: 5.2 s for 1512 rows under the host Lua, and the instrument is slower than the
  -- host. A form that comes up blank for minutes is indistinguishable from a wedged app, and the
  -- operator's only move would be the power cycle this app exists to avoid needing.
  local buf, nb = {}, 0
  local function put(s)
    nb = nb + 1
    buf[nb] = s
    if nb >= bplan.block then
      file.write(fh, table.concat(buf, '\n') .. '\n')
      buf, nb = {}, 0
    end
  end
  put(bplan.banner)
  put('# rows=' .. nrows)
  -- RECORDED IN THE FILE, because a reader cannot otherwise tell a lap that played six random vectors
  -- from one that played them all, and the cell count alone would look like a short plan.
  if opt.rkeep == nil then
    put('# random-per-lap=all')
  else
    put('# random-per-lap=' .. opt.rkeep)
  end
  put('# repeats=' .. reps)
  -- ONLY WHEN EVERY LAP IS THE SAME SIZE. Laps CAN differ: each draws its own interstitial, and a cell
  -- whose sample rate would exceed the generator's ceiling is dropped, so a lap's length depends on
  -- the rates it happened to draw. Declaring one number for laps of two lengths puts a wrong total on
  -- the panel.
  if same and per ~= nil then put('# cells-per-lap=' .. per) end
  put(bplan.cols)
  -- THE CELL NUMBER RESTARTS AT 1 EVERY LAP, and the total is counted separately. It is a LABEL, not
  -- a position: bench_run writes each row as L<iter>C<label>, and a label that kept counting across
  -- laps would number lap 2 from 1513 -- so every cross-lap comparison, and every note naming a cell,
  -- would be against an id the host's own plan does not use. Caught by tools/test_plan_gen.lua on a
  -- three-lap plan whose LINE COUNT matched exactly: lap 1 was byte-identical and laps 2 and 3 were
  -- wrong in every row, which is why the single-iteration cases all passed.
  local total = 0
  for it = first, last do
    local rates, nr = bplan.rates(it)
    local order, nv = bplan.order(it, bplan.skipfor(it, opt.skip, opt.rkeep), opt.nvec)
    local n = 0
    local vi
    for vi = 1, nv do
      local vid = order[vi]
      local s = bplan.span[vid]
      -- A vector with no expected bytes cannot be judged, so it is not drawn at all. This changes the
      -- cell COUNT and not merely an outcome, which is why it is here and not in the engine.
      if s ~= nil and s.exp == 1 then
        local ri
        for ri = 1, nr do
          local srate = bplan.iround(rates[ri].baud * s.spb)
          if srate <= bplan.c.srmax then
            local ua, uo = bplan.ampofst_u(it, vi - 1, ri - 1)
            local amp, ofst = bplan.ampofst(vid, ua, uo)
            local rep
            for rep = 0, reps - 1 do
              n = n + 1
              total = total + 1
              put(string.format('%d,%d,%s,%s,%d,%s,%.4f,%.4f,%d,%.3f',
                                it, n, vid, barb.name[vid], rates[ri].baud, rates[ri].kind,
                                amp, ofst, srate,
                                1000 * bplan.wait(it, vi - 1, ri - 1, rates[ri].baud, rep)))
              -- PER ROW, NOT PER BLOCK, and the caller rate-limits. A block is 200 rows and on the
              -- instrument that is seconds, so a spinner driven off the block boundary would step at
              -- whatever rate a block happens to take -- which is the thing a spinner exists to rule
              -- out. One Lua call per row costs nothing against the three MT19937 seedings above it.
              if opt.progress ~= nil then opt.progress(total, nrows) end
            end
          end
        end
      end
    end
  end
  if nb > 0 then file.write(fh, table.concat(buf, '\n') .. '\n') end
  file.flush(fh)
  file.close(fh)
  -- THE DECLARED COUNT AND THE WRITTEN COUNT, COMPARED. bench_run stops at rows=, so a header that
  -- over-declares sends it past the last row -- and a read past the end posts 2201 'File read error'
  -- as a box on the panel once per pass. The two passes are the same arithmetic, so a disagreement
  -- here is a defect in lapsize and worth refusing over.
  if total ~= nrows then
    return false, total, string.format('the header declared %d row(s) and %d were written -- '
                                       .. 'bplan.lapsize disagrees with bplan.emit', nrows, total)
  end
  return true, total, nil
end

-- How many rows one iteration contributes. THE SAME CONDITIONS emit applies, and nothing else: this
-- exists only so the row count can go in the header.
function bplan.lapsize(it, opt, reps)
  local rates, nr = bplan.rates(it)
  local order, nv = bplan.order(it, bplan.skipfor(it, opt.skip, opt.rkeep), opt.nvec)
  local n, vi = 0, nil
  for vi = 1, nv do
    local s = bplan.span[order[vi]]
    if s ~= nil and s.exp == 1 then
      local ri
      for ri = 1, nr do
        if bplan.iround(rates[ri].baud * s.spb) <= bplan.c.srmax then n = n + reps end
      end
    end
  end
  return n
end

-- ---------------------------------------------------------------------------
-- Is there a usable plan on the key?
-- ---------------------------------------------------------------------------
-- -> ok, rows, why
--
-- COMPLETENESS, NOT MERELY PRESENCE, and the difference is what this is for. A plan truncated by a key
-- pulled mid-push opens, parses, and streams -- and then ends early, so a lap silently runs a prefix
-- and the record looks like a short run rather than a broken file. The declared count is checked
-- against the rows that are actually there.
--
-- IT READS THE WHOLE FILE, which is the cost. There is no seek and no size in this firmware's file
-- API -- open, read a line, read it all, write, flush, close -- so counting rows means reading them.
-- About 6 s for a 6048-row plan, once, at app start.
function bplan.check(path)
  local fh = file.open(path, file.MODE_READ)
  if fh == nil then return false, 0, 'no plan on the key' end
  local want, cols, nrow = nil, false, 0
  local ln = file.read(fh, file.READ_LINE)
  while ln ~= nil and ln ~= '' do
    ln = string.gsub(ln, '[\r\n]', '')
    if ln ~= '' then
      if string.sub(ln, 1, 1) == '#' then
        -- string.find WITH A CAPTURE: 5.0.2 has no string.match, and a module using it passes every
        -- offline suite and then raises -286 on the instrument.
        local _, _, r = string.find(ln, 'rows=(%d+)')
        if r ~= nil then want = tonumber(r) end
      elseif ln == bplan.cols then
        cols = true
      else
        nrow = nrow + 1
      end
    end
    ln = file.read(fh, file.READ_LINE)
  end
  file.close(fh)
  if not cols then
    return false, nrow, 'the plan has no column header, so it is not a plan this engine reads'
  end
  if want == nil then
    return false, nrow, 'the plan declares no row count, so the engine cannot tell where it ends'
  end
  if nrow ~= want then
    return false, nrow, string.format('the plan declares %d row(s) and holds %d -- truncated',
                                      want, nrow)
  end
  if nrow < 1 then return false, 0, 'the plan has a header and no cells' end
  return true, nrow, nil
end

-- Check the key, and draw a plan only if what is there cannot be used. -> ok, rows, why
--
-- THE DEFAULT IS TO LEAVE A GOOD PLAN ALONE, and that is deliberate: a targeted --spec push is a
-- plan the operator chose, and regenerating over it would silently replace the experiment with the
-- full draw. Drawing happens when there is nothing usable, which is the case the bench app exists
-- to cover -- a key with no host behind it.
function bplan.ensure(path, opt)
  path = path or bplan.path
  local ok, rows, why = bplan.check(path)
  if ok then return true, rows, nil end
  bplan.lastwhy = why
  local wok, wrows, werr = bplan.emit(path, opt)
  if not wok then return false, wrows, werr end
  -- RE-READ IT, rather than trusting the write. The key is FAT on a bus that has been pulled mid-run
  -- before, and the whole point of this function is that what is on the key is usable.
  local cok, crows, cwhy = bplan.check(path)
  if not cok then return false, crows, 'drew a plan and it did not read back: ' .. tostring(cwhy) end
  return true, crows, nil
end
